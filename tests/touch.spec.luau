-- Touch mode (docs/mobile-contract.md): gestures classify by time and distance alone, the
-- device is detected from touch/keyboard with a setting override, and the scale is 1 on desktop.
local Client = game:GetService("StarterPlayer").StarterPlayerScripts.EoEClient
local Touch = require(Client.Touch)
local Settings = require(Client.Settings)

test("Touch: tap, drag, hold and hold-drag by time and distance", function()
	local p = "pending"
	p = Touch.phase(p, 0.1, 3)
	assertEq(p, "pending", "a short still press is nothing yet")
	assertEq(Touch.release(p), "tap", "lifted before the hold: a tap")
	assertEq(Touch.phase("pending", 0.1, Touch.DRAG_PX + 1), "drag", "moved early: a drag")
	assertEq(Touch.phase("pending", Touch.HOLD_S, Touch.DRAG_PX), "hold", "still for the hold time: a hold")
	assertEq(Touch.phase("hold", 1, 2), "hold", "a hold stays a hold while still")
	assertEq(Touch.phase("hold", 1, Touch.DRAG_PX + 1), "holdDrag", "moving after a hold: hold-drag")
	assertEq(Touch.phase("drag", 2, 0), "drag", "a drag never turns into a hold")
	assertEq(Touch.phase("holdDrag", 2, 0), "holdDrag", "phases never go back")
	assertEq(Touch.release("drag"), "drag")
	assertEq(Touch.release("hold"), "hold")
end)

test("Touch: detection and the controls override", function()
	assertTrue(Touch.detect(true, false, "auto"), "touch screen, no keyboard")
	assertTrue(not Touch.detect(true, true, "auto"), "a keyboard makes it a desktop (Studio emulator)")
	assertTrue(not Touch.detect(false, true, nil), "desktop")
	assertTrue(Touch.detect(false, true, "touch"), "override on")
	assertTrue(not Touch.detect(true, false, "desktop"), "override off")
	assertEq(Settings.get().controls, "auto", "default setting")
	Settings.set("controls", "gamepad")
	assertEq(Settings.get().controls, "auto", "unknown mode refused")
	Settings.set("controls", "touch")
	assertTrue(Settings.touch(), "the setting drives Settings.touch()")
	Settings.set("controls", "desktop")
	assertTrue(not Settings.touch())
	Settings.set("controls", "auto")
end)

test("Touch: UI scale is 1 on desktop, larger on phones than tablets, and meets 44 px plaques", function()
	assertEq(Touch.scale(1920, 1080, false), 1, "desktop never scales")
	assertEq(Touch.scale(390, 844, false), 1, "a small window on desktop never scales")
	local phone = Touch.scale(844, 390, true)
	local tablet = Touch.scale(1024, 768, true)
	assertTrue(phone >= 1.35, "phones at least 1.35x")
	assertTrue(phone * 30 >= 44, "a 30 px plaque becomes a 44 px tap target")
	assertTrue(tablet > 1 and tablet < phone, "tablets between desktop and phone")
	assertEq(Touch.scale(390, 844, true), phone, "portrait reads the short side")
end)
