-- Touch mode (docs/mobile-contract.md): gestures classify by time and distance alone, the
-- device is detected from touch/keyboard with a setting override, and the scale is 1 on desktop.
local Client = game:GetService("StarterPlayer").StarterPlayerScripts.EoEClient
local Touch = require(Client.Touch)
local Settings = require(Client.Settings)

test("Touch: tap, drag, hold and hold-drag by time and distance", function()
	local p = "pending"
	p = Touch.phase(p, 0.1, 3)
	assertEq(p, "pending", "a short still press is nothing yet")
	assertEq(Touch.release(p), "tap", "lifted before the hold: a tap")
	assertEq(Touch.phase("pending", 0.1, Touch.DRAG_PX + 1), "drag", "moved early: a drag")
	assertEq(Touch.phase("pending", Touch.HOLD_S, Touch.DRAG_PX), "hold", "still for the hold time: a hold")
	assertEq(Touch.phase("hold", 1, 2), "hold", "a hold stays a hold while still")
	assertEq(Touch.phase("hold", 1, Touch.DRAG_PX + 1), "holdDrag", "moving after a hold: hold-drag")
	assertEq(Touch.phase("drag", 2, 0), "drag", "a drag never turns into a hold")
	assertEq(Touch.phase("holdDrag", 2, 0), "holdDrag", "phases never go back")
	assertEq(Touch.release("drag"), "drag")
	assertEq(Touch.release("hold"), "hold")
end)

test("Touch: detection and the controls override", function()
	assertTrue(Touch.detect(true, false, "auto"), "touch screen, no keyboard")
	assertTrue(not Touch.detect(true, true, "auto"), "a keyboard makes it a desktop (Studio emulator)")
	assertTrue(not Touch.detect(false, true, nil), "desktop")
	assertTrue(Touch.detect(false, true, "touch"), "override on")
	assertTrue(not Touch.detect(true, false, "desktop"), "override off")
	assertEq(Settings.get().controls, "auto", "default setting")
	Settings.set("controls", "gamepad")
	assertEq(Settings.get().controls, "auto", "unknown mode refused")
	Settings.set("controls", "touch")
	assertTrue(Settings.touch(), "the setting drives Settings.touch()")
	Settings.set("controls", "desktop")
	assertTrue(not Settings.touch())
	Settings.set("controls", "auto")
end)

test("Touch: UI scale is 1 on desktop, larger on phones than tablets, and meets 44 px plaques", function()
	assertEq(Touch.scale(1920, 1080, false), 1, "desktop never scales")
	assertEq(Touch.scale(390, 844, false), 1, "a small window on desktop never scales")
	local phone = Touch.scale(844, 390, true)
	local tablet = Touch.scale(1024, 768, true)
	assertTrue(phone >= 1.35, "phones at least 1.35x")
	assertTrue(phone * 30 >= 44, "a 30 px plaque becomes a 44 px tap target")
	assertTrue(tablet > 1 and tablet < phone, "tablets between desktop and phone")
	assertEq(Touch.scale(390, 844, true), phone, "portrait reads the short side")
end)

test("Touch: a menu column fits a short screen, compact and shrunk, its buttons still tappable", function()
	assertTrue(select(1, Touch.fitColumn(1080, 640, 400)) == false, "a desktop screen shows the full column")
	assertEq(select(2, Touch.fitColumn(1080, 640, 400)), 1, "unscaled")
	local compact, s = Touch.fitColumn(768, 640, 400)
	assertTrue(not compact and s == 1, "a 768 px laptop still fits the full column")
	-- iPhone 17 Pro in landscape (Studio's simulator): a 381 px column at UI scale 1.5
	compact, s = Touch.fitColumn(381 / 1.5, 640, 340)
	assertTrue(compact, "a phone drops the header")
	assertTrue(s < 1 and 340 * s <= 381 / 1.5, "and shrinks the rest to fit: " .. s)
	assertTrue(40 * s * 1.5 >= 44, "a 40 px menu button stays a 44 px tap target: " .. 40 * s * 1.5)
	compact, s = Touch.fitColumn(572, 640, 340)
	assertTrue(compact and s == 1, "a 600 px tablet fits the compact column unscaled")
end)

test("Touch: a big panel fits the screen's width by scale and its height by its scrolling body", function()
	local k, h = Touch.fitPanel(1920, 1080, 720, 640)
	assertTrue(k == 1 and h == 640, "a desktop screen keeps the panel as designed")
	k, h = Touch.fitPanel(1366, 700, 720, 640)
	assertTrue(k == 1 and h <= 700 - 16, "a short laptop window only loses height: " .. h)
	-- iPhone 17 Pro in landscape: 750 x 381 px at UI scale 1.5
	k, h = Touch.fitPanel(750 / 1.5, 381 / 1.5, 720, 640)
	assertTrue(720 * k <= 750 / 1.5 - 16 + 1e-6, "the width fits: " .. 720 * k)
	assertTrue(h * k <= 381 / 1.5 - 16 + 1e-6, "the height fits: " .. h * k)
	assertTrue(k * 1.5 >= 0.9, "text stays near its desktop size on the phone: " .. k * 1.5)
end)

test("Camera: D pans to the screen's right and A to its left, at any heading", function()
	local Camera = require(Client.Camera)
	-- Roblox's camera right is look x up: looking along +z (yaw 90 degrees) the right is -x
	local x, z = Camera.screenRight(math.pi / 2)
	assertTrue(math.abs(x + 1) < 1e-9 and math.abs(z) < 1e-9, string.format("looking north, right is -x: %.2f %.2f", x, z))
	x, z = Camera.screenRight(0)
	assertTrue(math.abs(x) < 1e-9 and math.abs(z - 1) < 1e-9, string.format("looking +x, right is +z: %.2f %.2f", x, z))
	assertEq(Camera.HEIGHT_KEYS.up, Enum.KeyCode.X, "X raises the camera (Total War)")
	assertEq(Camera.HEIGHT_KEYS.down, Enum.KeyCode.Z, "Z lowers it")
end)

test("Camera: edge scrolling follows a pointer on the window's border, never one outside it", function()
	-- Roblox reports (-1, -1) for a pointer outside the window: read as the top-left corner it panned
	-- the camera off to the map's edge whenever the mouse left the game
	local Camera = require(Client.Camera)
	local function edge(x, y)
		return Camera.edgeScroll(x, y, 1000, 600)
	end
	assertEq(select(1, edge(-1, -1)), 0, "outside the window: no pan")
	assertEq(select(2, edge(-1, -1)), 0)
	assertEq(select(1, edge(2, 300)), -1, "left border pans left")
	assertEq(select(1, edge(998, 300)), 1, "right border pans right")
	assertEq(select(2, edge(500, 3)), 1, "top border pans forward")
	assertEq(select(2, edge(500, 597)), -1, "bottom border pans back")
	assertEq(select(1, edge(500, 300)), 0, "middle: still")
	assertEq(select(1, edge(1200, 300)), 0, "past the right edge (another screen): no pan")
end)

test("Touch: a screen too small for its layout shrinks to its minimum, never grows", function()
	assertEq(Touch.fitScreen(1920, 1022, 600, 260), 1, "a desktop keeps its size")
	local k = Touch.fitScreen(500, 215, 600, 260)
	assertTrue(k < 1 and 500 / k >= 600 - 1e-6 and 215 / k >= 260 - 1e-6, "a phone gets the minimum: " .. k)
end)

test("Touch: the campaign map takes the height it can use, the side panel the rest", function()
	-- desktop: the side panel at its widest, the map everything else
	local map, side = Touch.campaignSplit(1920, 1022, 1.15, 280, 380)
	assertEq(side, 380, "desktop side panel")
	assertEq(map + side + 40, 1920, "the two fill the screen")
	-- a phone after fitScreen (600 x 258): the map as wide as its height allows
	map, side = Touch.campaignSplit(600, 258, 1.15, 280, 380)
	assertTrue(side >= 280 and side <= 380, "side panel within its limits: " .. side)
	assertTrue(math.abs(map - (258 - 32) * 1.15) < 1 or side == 280, "the map uses its height: " .. map)
	assertEq(map + side + 40, 600, "the two fill the screen")
end)
