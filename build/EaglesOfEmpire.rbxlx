	ll(18.5, 38.0), ll(22.0, 36.4), ll(25.5, 38.5), ll(30.0, 37.5), ll(32.0, 44.0), ll(34.0, 41.5), ll(30.0, 46.4),
	ll(6.0, 36.4), ll(11.0, 36.4), ll(-6.5, 36.0),
