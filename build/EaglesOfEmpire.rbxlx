		u("france", "V Corps", "infantry", "34e de Ligne", 600, 1, 760, 320, NORTH),
		u("france", "V Corps", "cavalry", "5e Hussards", 400, 1, 900, 300, NORTH),
		u("prussia", "HQ", "hq", "Prussian HQ", 40, 2, 760, 860, SOUTH, { commander = true }),
		u("prussia", "Grawert", "infantry", "IR Nr. 49 Müffling", 600, 1, 740, 700, SOUTH),
		u("prussia", "Grawert", "artillery", "Batterie Grawert", 120, 1, 820, 740, SOUTH),
	},
	timeLimit = nil,
} :: Scenario

-- Battles in display order; fixtures (stress, skirmish) are not listed.
local DISPLAY_ORDER = { "jena", "auerstedt", "austerlitz", "waterloo" }

function Scenarios.list(): { ListEntry }
	local out: { ListEntry } = {}
	for _, id in DISPLAY_ORDER do
		local s = (Scenarios :: any)[id] :: Scenario
		out[#out + 1] = { id = s.id, name = s.name, date = s.date, map = s.map, factionNames = s.factionNames, summary = s.summary, difficultyNote = s.difficultyNote }
	end
	return out
end

function Scenarios.get(id: string): Scenario?
	local s = (Scenarios :: any)[id]
	if type(s) == "table" and s.units then
		return s
	end
	return nil
end

return Scenarios
]]></ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX00000008"><Properties><bool name="Disabled">false</bool><string name="Name">Types</string><ProtectedString name="Source"><![CDATA[--!strict
-- Shared type definitions. Runtime-free; `require` for types only.

local Vec = require(script.Parent.Vec)

export type Vec = Vec.Vec

export type UnitClass = "infantry" | "cavalry" | "artillery" | "hq"
export type Shape = "line" | "column" | "square" | "travel" | "limbered" | "deployed" | "wedge" | "staff"
export type State = "idle" | "moving" | "reforming" | "firing" | "charging" | "melee" | "retreating" | "routing" | "rallying" | "destroyed" | "exited" | "offmap"
export type MoraleBand = "steady" | "shaken" | "routing" | "shattered"

export type Order = {
	kind: string,
	pos: Vec?,
	heading: number?,
	targetId: number?,
	frontage: number?,
	issuedTick: number,
	anchor: Vec?, -- leash anchor for Engage/AttackMove
}

export type Command = {
	matchId: string,
	requestId: string,
	kind: string,
	ids: { number },
	data: { [string]: any }?,
	-- stamped by the server
	seq: number?,
	effectiveTick: number?,
	faction: string?,
}

export type CommandResult = {
	requestId: string,
	accepted: boolean,
	reason: string?,
	effectiveTick: number?,
}

-- Per-formation public view sent to clients (own side: full; enemy: visible subset).
export type FormationView = {
	id: number,
	faction: string,
	name: string?,
	corps: string?,
	class: UnitClass,
	colour: string?,
	x: number,
	z: number,
	heading: number,
	shape: Shape,
	state: State,
	strength: number,
	startStrength: number,
	morale: number?,
	moraleBand: MoraleBand,
	fatigue: number?,
	ammo: number?,
	reload: number?,
	cohesion: number?,
	width: number,
	depth: number,
	orderKind: string?,
	targetId: number?,
	fireAtWill: boolean?,
	limbered: boolean?,
	status: string?, -- strongest current cause of poor performance
	rallyCd: number?,
	commander: boolean?,
	dest: Vec?,
	destHeading: number?,
	experience: number?,
	ammoMode: string?,
	queue: { Vec }?,
}

export type LastKnown = {
	id: number,
	faction: string,
	class: UnitClass,
	x: number,
	z: number,
	heading: number,
	shape: Shape,
	ageSeconds: number,
	name: string?,
	colour: string?,
	width: number,
	depth: number,
}

export type ObjectiveView = {
	id: string,
	name: string,
	x: number,
	z: number,
	radius: number,
	owner: string?,
	contested: boolean,
	progress: number, -- 0..1 toward the capturing faction
	capturing: string?,
}

export type Event = {
	kind: string, -- volley | cannon | melee | charge | rout | rally | capture | destroyed | message
	x: number?,
	z: number?,
	id: number?,
	targetId: number?,
	faction: string?,
	text: string?,
	tick: number,
	tx: number?,
	tz: number?,
	n: number?,
}

export type Snapshot = {
	matchId: string,
	tick: number,
	seq: number,
	kind: "full" | "delta",
	state: string,
	formations: { FormationView },
	lastKnown: { LastKnown },
	events: { Event },
	objectives: { ObjectiveView },
	clock: number, -- simulation seconds
	timeLimit: number,
	speed: number,
	simLag: number,
	viewer: string,
	removed: { number }?,
	reinforcements: { { id: number, name: string, corps: string, eta: number } }?, -- own side, not yet arrived
	weather: string?, -- key into Config.Weather
}

export type Results = {
	outcome: "victory" | "defeat" | "draw",
	reason: string,
	clock: number,
	objectives: { ObjectiveView },
	sides: {
		[string]: {
			deployed: number,
			casualties: number,
			remaining: number,
			surviving: number,
			routed: number,
			shattered: number,
			destroyed: number,
			exited: number,
			formations: number,
		},
	},
	feedback: { string },
	log: { string },
}

return {}
]]></ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX00000009"><Properties><bool name="Disabled">false</bool><string name="Name">Vec</string><ProtectedString name="Source"><![CDATA[--!strict
-- 2D vectors on the battlefield plane. Pure Luau; no Roblox datatypes.
-- Heading: radians, 0 along +x, increasing toward +z. right(f) = f rotated +90° (toward +z when f = +x).

export type Vec = { x: number, z: number }

local Vec = {}

function Vec.new(x: number, z: number): Vec
	return { x = x, z = z }
end

function Vec.add(a: Vec, b: Vec): Vec
	return { x = a.x + b.x, z = a.z + b.z }
end

function Vec.sub(a: Vec, b: Vec): Vec
	return { x = a.x - b.x, z = a.z - b.z }
end

function Vec.scale(a: Vec, s: number): Vec
	return { x = a.x * s, z = a.z * s }
end

function Vec.dot(a: Vec, b: Vec): number
	return a.x * b.x + a.z * b.z
end

function Vec.cross(a: Vec, b: Vec): number
	return a.x * b.z - a.z * b.x
end

function Vec.len2(a: Vec): number
	return a.x * a.x + a.z * a.z
end

function Vec.len(a: Vec): number
	return math.sqrt(a.x * a.x + a.z * a.z)
end

function Vec.dist(a: Vec, b: Vec): number
	local dx, dz = a.x - b.x, a.z - b.z
	return math.sqrt(dx * dx + dz * dz)
end

function Vec.dist2(a: Vec, b: Vec): number
	local dx, dz = a.x - b.x, a.z - b.z
	return dx * dx + dz * dz
end

function Vec.normalize(a: Vec): Vec
	local l = Vec.len(a)
	if l < 1e-9 then
		return { x = 1, z = 0 }
	end
	return { x = a.x / l, z = a.z / l }
end

function Vec.fromHeading(h: number): Vec
	return { x = math.cos(h), z = math.sin(h) }
end

function Vec.heading(a: Vec): number
	return math.atan2(a.z, a.x)
end

function Vec.right(f: Vec): Vec
	return { x = -f.z, z = f.x }
end

function Vec.rotate(a: Vec, ang: number): Vec
	local c, s = math.cos(ang), math.sin(ang)
	return { x = a.x * c - a.z * s, z = a.x * s + a.z * c }
end

function Vec.lerp(a: Vec, b: Vec, t: number): Vec
	return { x = a.x + (b.x - a.x) * t, z = a.z + (b.z - a.z) * t }
end

-- Smallest signed difference b - a wrapped to [-pi, pi].
function Vec.angleDiff(a: number, b: number): number
	local d = (b - a) % (2 * math.pi)
	if d > math.pi then
		d -= 2 * math.pi
	end
	return d
end

function Vec.wrapAngle(a: number): number
	local d = a % (2 * math.pi)
	if d > math.pi then
		d -= 2 * math.pi
	end
	return d
end

-- Signed angle of point p as seen from a formation at pos facing heading: 0 = dead ahead.
function Vec.bearing(pos: Vec, heading: number, p: Vec): number
	return Vec.angleDiff(heading, Vec.heading(Vec.sub(p, pos)))
end

-- Classify an attack arriving from `from` onto a formation at pos facing heading.
function Vec.attackSide(pos: Vec, heading: number, from: Vec): "front" | "flank" | "rear"
	local b = math.abs(Vec.bearing(pos, heading, from))
	if b <= math.pi / 4 then
		return "front"
	elseif b >= 3 * math.pi / 4 then
		return "rear"
	end
	return "flank"
end

function Vec.clamp(a: Vec, minX: number, minZ: number, maxX: number, maxZ: number): Vec
	return { x = math.clamp(a.x, minX, maxX), z = math.clamp(a.z, minZ, maxZ) }
end

function Vec.isFinite(a: any): boolean
	return type(a) == "table"
		and type(a.x) == "number"
		and type(a.z) == "number"
		and a.x == a.x
		and a.z == a.z
		and math.abs(a.x) ~= math.huge
		and math.abs(a.z) ~= math.huge
end

-- Distance from point p to segment ab.
function Vec.distToSegment(p: Vec, a: Vec, b: Vec): number
	local abx, abz = b.x - a.x, b.z - a.z
	local l2 = abx * abx + abz * abz
	if l2 < 1e-9 then
		return Vec.dist(p, a)
	end
	local t = ((p.x - a.x) * abx + (p.z - a.z) * abz) / l2
	t = math.clamp(t, 0, 1)
	local cx, cz = a.x + abx * t, a.z + abz * t
	local dx, dz = p.x - cx, p.z - cz
	return math.sqrt(dx * dx + dz * dz)
end

return Vec
]]></ProtectedString></Properties></Item></Item></Item><Item class="ServerScriptService" referent="RBX00000032"><Properties><string name="Name">ServerScriptService</string></Properties><Item class="Folder" referent="RBX00000031"><Properties><string name="Name">EoE</string></Properties><Item class="ModuleScript" referent="RBX00000012"><Properties><bool name="Disabled">false</bool><string name="Name">AI</string><ProtectedString name="Source"><![CDATA[--!strict
-- Enemy commander. Pure Luau, deterministic: reads its own formations fully, the enemy only
-- through sim.views[faction] (visible ids + last-known memory), randomness only via sim.rng.
-- Orders go through sim:queueCommand with the same command kinds the player uses.
--
-- Hierarchy: army plan (posture, wing roles, gun/HQ/reserve positions, every ~20 s or on a
-- trigger) -> per-formation decisions each decision tick with commitment so goals do not flap.

local Shared = game:GetService("ReplicatedStorage"):WaitForChild("EoE")
local Config = require(Shared.Config)
local Vec = require(Shared.Vec)
local Grid = require(Shared.Grid)
local Protocol = require(Shared.Protocol)
local MapGen = require(Shared.MapGen)

local Sim = require(script.Parent.Sim)
local Formation = require(script.Parent.Sim.Formation)
local Combat = require(script.Parent.Sim.Combat)
local Nav = require(script.Parent.Sim.Nav)

type Vec = Vec.Vec
type Formation = Formation.Formation
type SimLike = Sim.Sim

-- What the AI knows about one enemy: live when visible (age 0), otherwise a stale memory.
type Known = { id: number, pos: Vec, class: string, heading: number, shape: string, age: number, strength: number }

type Unit = {
	goal: string,
	reason: string,
	role: string, -- left | centre | right | reserve | guns | hq
	commitUntil: number,
	squareUntil: number,
	withdrawUntil: number,
	nextMove: number, -- throttle for maintenance moves / facing
	orderedStep: number, -- decision step of the last command that included this unit
	point: Vec?, -- goal point for guard / exploit goals
}

export type AIState = {
	sim: SimLike,
	faction: string,
	enemy: string,
	reaction: number,
	planQuality: number,
	n: number,
	steps: number,
	budget: number,
	posture: string,
	forward: Vec,
	right: Vec,
	facing: number,
	reserve: Vec,
	hqPos: Vec,
	wingPos: { [string]: Vec },
	gunPos: { [number]: Vec },
	nextPlan: number,
	rolesAssigned: boolean,
	units: { [number]: Unit },
	mine: { Formation },
	visible: { Formation },
	known: { Known },
}

local AI = {}

local PATH_CMDS = { Move = true, AttackMove = true, Engage = true, Charge = true, Retreat = true }
local MAX_PATH_CMDS = 8
local WINGS = { "centre", "left", "right" }
local MUSKET = Config.Units.infantry.musket.range

-- Helpers ------------------------------------------------------------------------------------

local function unitOf(state: AIState, id: number): Unit
	local u = state.units[id]
	if u then
		return u
	end
	local fresh: Unit = { goal = "idle", reason = "", role = "reserve", commitUntil = 0, squareUntil = 0, withdrawUntil = 0, nextMove = 0, orderedStep = -1, point = nil }
	state.units[id] = fresh
	return fresh
end

local function setGoal(state: AIState, id: number, goal: string, reason: string, commit: number?)
	local u = unitOf(state, id)
	u.goal = goal
	u.reason = reason
	u.commitUntil = state.sim.clock + (commit or Config.AI.CommitSeconds) * state.reaction
end

local function committed(state: AIState, u: Unit): boolean
	return state.sim.clock < u.commitUntil
end

-- planQuality < 1: deterministically skip some good choices.
local function quality(state: AIState): boolean
	if state.planQuality >= 1 then
		return true
	end
	return state.sim.rng:chance(state.planQuality)
end

local function walkable(state: AIState, p: Vec): Vec
	local sim = state.sim
	local c = Vec.clamp(p, 16, 16, sim.grid.width - 16, sim.grid.depth - 16)
	return Nav.nearestWalkable(sim.nav, c, 8) or c
end

local function inCover(state: AIState, p: Vec): boolean
	return Grid.terrainAt(state.sim.grid, p.x, p.z).blocksSight
end

local function healthy(f: Formation): boolean
	return not Formation.isBroken(f) and f.moraleBand ~= "shaken"
end

local function damaged(f: Formation): boolean
	return f.strength < f.startStrength * 0.5 or f.moraleBand == "shaken"
end

-- Issue one command the way the player would. Returns true when queued.
local function issue(state: AIState, kind: string, ids: { number }, data: { [string]: any }?): boolean
	local sim = state.sim
	if #ids == 0 or #ids > Config.Net.MaxBatch then
		return false
	end
	local allowed = Protocol.CommandKinds[kind]
	for _, id in ids do
		local f = sim.formations[id]
		if not f or f.faction ~= state.faction or (type(allowed) == "table" and not allowed[f.class]) then
			return false
		end
		if kind == "Shape" and data and not Formation.legalShapes(f)[data.shape] then
			return false
		end
	end
	if PATH_CMDS[kind] and state.budget <= 0 then
		return false
	end
	local cmd = { matchId = sim.matchId, requestId = "ai-" .. (state.n + 1), kind = kind, ids = ids, data = data or {} }
	if not (sim :: any):precheck(cmd) then
		return false
	end
	state.n += 1
	if PATH_CMDS[kind] then
		state.budget -= 1
	end
	for _, id in ids do
		unitOf(state, id).orderedStep = state.steps
	end
	(sim :: any):queueCommand(cmd, state.faction)
	return true
end

local function nearestVisible(state: AIState, pos: Vec, maxDist: number, pred: ((Formation) -> boolean)?): (Formation?, number)
	local best: Formation? = nil
	local bestD = maxDist
	for _, e in state.visible do
		if not pred or pred(e) then
			local d = Vec.dist(pos, e.pos)
			if d < bestD then
				best, bestD = e, d
			end
		end
	end
	return best, bestD
end

local function nearestKnownDist(state: AIState, pos: Vec, maxAge: number): number
	local best = math.huge
	for _, k in state.known do
		if k.age <= maxAge then
			best = math.min(best, Vec.dist(pos, k.pos))
		end
	end
	return best
end

local function nearestOwn(state: AIState, pos: Vec, pred: (Formation) -> boolean): (Formation?, number)
	local best: Formation? = nil
	local bestD = math.huge
	for _, f in state.mine do
		if pred(f) then
			local d = Vec.dist(pos, f.pos)
			if d < bestD then
				best, bestD = f, d
			end
		end
	end
	return best, bestD
end

local function isCav(e: Formation): boolean
	return e.class == "cavalry" and e.state ~= "routing"
end

-- Perception: only what the faction's view exposes. ----------------------------------------------

local function perceive(state: AIState)
	local sim = state.sim
	local view = sim.views[state.faction]
	local mine: { Formation } = {}
	local visible: { Formation } = {}
	local known: { Known } = {}
	for _, id in sim.order do
		local f = sim.formations[id]
		if f and Formation.isActive(f) then
			if f.faction == state.faction then
				mine[#mine + 1] = f
			elseif view.visible[id] then
				visible[#visible + 1] = f
				-- strength as the player sees it (rounded)
				known[#known + 1] = { id = id, pos = f.pos, class = f.class, heading = f.heading, shape = f.shape, age = 0, strength = math.floor(f.strength / 50 + 0.5) * 50 }
			end
		end
	end
	local ids: { number } = {}
	for id in view.lastKnown do
		ids[#ids + 1] = id
	end
	table.sort(ids)
	for _, id in ids do
		local lk = view.lastKnown[id]
		known[#known + 1] = { id = id, pos = { x = lk.x, z = lk.z }, class = lk.class, heading = lk.heading, shape = lk.shape, age = lk.ageSeconds, strength = 0 }
	end
	state.mine, state.visible, state.known = mine, visible, known
end

-- Army plan ----------------------------------------------------------------------------------------

local function desiredPosture(state: AIState): string
	local sim = state.sim
	local ownStr, broken, total, seen = 0, 0, 0, 0
	for _, f in state.mine do
		total += 1
		if Formation.isBroken(f) then
			broken += 1
		else
			ownStr += f.strength
		end
	end
	for _, k in state.known do
		seen += k.strength
	end
	local deployed = sim.deployed[state.faction] or 1
	if total == 0 or broken >= total * 0.5 or ownStr < deployed * 0.45 then
		return "withdraw"
	end
	if seen >= ownStr * 0.4 and ownStr > seen * 1.5 then
		return "attack"
	end
	return "defend"
end

local function lateral(state: AIState, p: Vec): number
	return Vec.dot(p, state.right)
end

-- Gun position: high ground with LOS forward, behind the wing's line, within ~55 of it.
local function pickGunPos(state: AIState, wing: Vec, taken: { Vec }, from: Vec): Vec
	local grid = state.sim.grid
	local probe = Vec.add(wing, Vec.scale(state.forward, 200))
	local best = Vec.sub(wing, Vec.scale(state.forward, 35))
	local bestScore = -math.huge
	for _, d in { 25, 35 } do
		for _, s in { -20, 0, 20 } do
			local p = walkable(state, Vec.add(Vec.sub(wing, Vec.scale(state.forward, d)), Vec.scale(state.right, s)))
			local ok = Vec.dist(p, wing) <= 45
			for _, t in taken do
				if Vec.dist(t, p) < 24 then
					ok = false
				end
			end
			if ok then
				local score = Grid.heightAt(grid, p.x, p.z) + (if Grid.lineOfSight(grid, p, probe) then 20 else 0) - Vec.dist(p, from) / 20
				if score > bestScore then
					best, bestScore = p, score
				end
			end
		end
	end
	return best
end

local function plan(state: AIState)
	local sim = state.sim
	local clock = sim.clock
	local home, enemyHome = sim:homeEdge(state.faction), sim:homeEdge(state.enemy)
	local forward = Vec.normalize(Vec.sub(enemyHome, home))
	state.forward, state.right, state.facing = forward, Vec.right(forward), Vec.heading(forward)
	local posture = desiredPosture(state)
	state.posture = posture
	state.nextPlan = clock + 20 * state.reaction

	-- Line of battle: three wing points.
	local zone = (sim :: any).map.deployZones[state.faction]
	local base: Vec = if zone then { x = (zone.x0 + zone.x1) / 2, z = (zone.z0 + zone.z1) / 2 } else { x = sim.grid.width / 2, z = sim.grid.depth / 2 }
	local wing: { [string]: Vec } = {}
	if posture == "attack" then
		local c, n = { x = 0, z = 0 }, 0
		for _, k in state.known do
			if k.age < 90 then
				c, n = Vec.add(c, k.pos), n + 1
			end
		end
		local target = if n > 0 then Vec.scale(c, 1 / n) else enemyHome
		local ownC, m = { x = 0, z = 0 }, 0
		for _, f in state.mine do
			ownC, m = Vec.add(ownC, f.pos), m + 1
		end
		ownC = Vec.scale(ownC, 1 / math.max(1, m))
		local dir = Vec.normalize(Vec.sub(target, ownC))
		state.facing = Vec.heading(dir)
		local centre = Vec.sub(target, Vec.scale(dir, 70))
		local r = Vec.right(dir)
		wing.centre, wing.left, wing.right = centre, Vec.sub(centre, Vec.scale(r, 150)), Vec.add(centre, Vec.scale(r, 150))
	elseif posture == "withdraw" then
		local centre = Vec.sub(base, Vec.scale(forward, 200))
		wing.centre, wing.left, wing.right = centre, Vec.sub(centre, Vec.scale(state.right, 140)), Vec.add(centre, Vec.scale(state.right, 140))
	else
		local objs: { Vec } = {}
		for _, o in sim.objectives do
			local p = o.def.pos
			local ours = o.owner == nil and (MapGen.inZone((sim :: any).map, state.faction, p) or Vec.dist(p, home) < Vec.dist(p, enemyHome))
			if o.owner == state.faction or ours then
				objs[#objs + 1] = Vec.add(p, Vec.scale(forward, 25))
			end
		end
		table.sort(objs, function(a, b)
			return lateral(state, a) < lateral(state, b)
		end)
		if #objs >= 3 then
			wing.left, wing.centre, wing.right = objs[1], objs[math.ceil(#objs / 2)], objs[#objs]
		elseif #objs == 2 then
			wing.left, wing.right = objs[1], objs[2]
			wing.centre = Vec.lerp(objs[1], objs[2], 0.5)
		else
			local centre = objs[1] or base
			wing.centre, wing.left, wing.right = centre, Vec.sub(centre, Vec.scale(state.right, 140)), Vec.add(centre, Vec.scale(state.right, 140))
		end
	end
	for _, w in WINGS do
		wing[w] = walkable(state, wing[w])
	end
	local moved: { [string]: boolean } = {}
	for _, w in WINGS do
		moved[w] = state.wingPos[w] == nil or Vec.dist(state.wingPos[w], wing[w]) > 20
	end
	state.wingPos = wing
	state.reserve = walkable(state, Vec.sub(wing.centre, Vec.scale(forward, 150)))

	-- HQ: behind the centre, covering as many formations as possible.
	local bestCover, hqPos = -1, state.reserve
	for _, d in { 60, 100, 140 } do
		local p = walkable(state, Vec.sub(wing.centre, Vec.scale(forward, d)))
		local cover = 0
		for _, f in state.mine do
			if Vec.dist(f.pos, p) <= Config.Units.hq.influence.radius then
				cover += 1
			end
		end
		if cover > bestCover then
			bestCover, hqPos = cover, p
		end
	end
	state.hqPos = hqPos

	-- Roles are sticky. First plan: >= 20 % of infantry (those nearest home) in reserve, the rest
	-- split by lateral position into wings; cavalry all reserve. Later plans only rotate a badly
	-- damaged line unit to the reserve and promote a healthy reserve unit into its place.
	local inf: { Formation } = {}
	for _, f in state.mine do
		local u = unitOf(state, f.id)
		if f.class == "infantry" then
			inf[#inf + 1] = f
		elseif f.class == "cavalry" then
			u.role = "reserve"
		elseif f.class == "artillery" then
			u.role = "guns"
		else
			u.role = "hq"
		end
	end
	if not state.rolesAssigned then
		state.rolesAssigned = true
		local nRes = math.ceil(0.2 * #inf)
		table.sort(inf, function(a: Formation, b: Formation)
			local ha, hb = Vec.dot(a.pos, forward), Vec.dot(b.pos, forward)
			if ha ~= hb then
				return ha < hb -- nearer home first
			end
			return a.id < b.id
		end)
		local line: { Formation } = {}
		for i, f in inf do
			if i <= nRes then
				unitOf(state, f.id).role = "reserve"
			else
				line[#line + 1] = f
			end
		end
		table.sort(line, function(a: Formation, b: Formation)
			local la, lb = lateral(state, a.pos), lateral(state, b.pos)
			if la ~= lb then
				return la < lb
			end
			return a.id < b.id
		end)
		local side = #line // 3
		for i, f in line do
			unitOf(state, f.id).role = if i <= side then "left" elseif i > #line - side then "right" else "centre"
		end
	end
	for _, f in inf do
		local u = unitOf(state, f.id)
		if u.role ~= "reserve" and damaged(f) then
			local w = u.role
			u.role = "reserve"
			local fresh = nearestOwn(state, wing[w], function(o)
				return o.class == "infantry" and unitOf(state, o.id).role == "reserve" and healthy(o) and not damaged(o)
			end)
			if fresh then
				unitOf(state, fresh.id).role = w
			end
		end
	end

	-- Gun positions: one wing each, centre first.
	local taken: { Vec } = {}
	local gi = 0
	state.gunPos = {}
	for _, f in state.mine do
		if f.class == "artillery" then
			local w = WINGS[gi % #WINGS + 1]
			gi += 1
			local p = pickGunPos(state, wing[w], taken, f.pos)
			taken[#taken + 1] = p
			state.gunPos[f.id] = p
		end
	end

	-- Group moves per wing / reserve (units that are free to move).
	local function free(f: Formation): boolean
		local u = unitOf(state, f.id)
		local engaged = nearestVisible(state, f.pos, MUSKET + 30) ~= nil
		return (f.state == "idle" or f.state == "moving") and not engaged and f.shape ~= "square" and f.pendingShape == nil and (u.goal == "idle" or string.sub(u.goal, 1, 4) == "line" or u.goal == "reserve" or u.goal == "march")
	end
	local moveKind = if posture == "attack" then "AttackMove" else "Move"
	for _, w in WINGS do
		local ids: { number } = {}
		local far = false
		for _, f in state.mine do
			local u = unitOf(state, f.id)
			if f.class == "infantry" and u.role == w and free(f) then
				ids[#ids + 1] = f.id
				far = far or Vec.dist(f.pos, wing[w]) > 90
			end
		end
		if #ids > 0 and (moved[w] or far) then
			if issue(state, moveKind, ids, { pos = wing[w], heading = state.facing }) then
				for _, id in ids do
					setGoal(state, id, "line:" .. w, posture .. ": " .. w .. " wing")
				end
			end
		end
	end
	for _, cls in { "infantry", "cavalry" } do
		local ids: { number } = {}
		local far = false
		local point = if cls == "cavalry" then walkable(state, Vec.sub(state.reserve, Vec.scale(forward, 50))) else state.reserve
		for _, f in state.mine do
			local u = unitOf(state, f.id)
			if f.class == cls and u.role == "reserve" and free(f) then
				ids[#ids + 1] = f.id
				far = far or Vec.dist(f.pos, point) > 90
			end
		end
		if #ids > 0 and far then
			if issue(state, "Move", ids, { pos = point, heading = state.facing }) then
				for _, id in ids do
					setGoal(state, id, "reserve", "held in reserve")
				end
			end
		end
	end
end

-- A replan is due on schedule, on a posture change, or when a line unit is badly damaged.
local function planTrigger(state: AIState): boolean
	if state.sim.clock >= state.nextPlan then
		return true
	end
	if state.posture ~= "withdraw" and desiredPosture(state) == "withdraw" then
		return true
	end
	for _, f in state.mine do
		local u = unitOf(state, f.id)
		if f.class == "infantry" and u.role ~= "reserve" and damaged(f) then
			return true
		end
	end
	return false
end

-- Army-level reactions each decision tick -------------------------------------------------------

local function availableInfantry(state: AIState, f: Formation): boolean
	local u = unitOf(state, f.id)
	return f.class == "infantry" and f.state == "idle" and healthy(f) and f.shape ~= "square" and (u.goal == "idle" or u.goal == "reserve" or string.sub(u.goal, 1, 4) == "line")
end

-- Every battery in position keeps an infantry formation within 60.
local function guardGuns(state: AIState)
	for _, g in state.mine do
		local ug = unitOf(state, g.id)
		if g.class == "artillery" and (ug.goal == "fire" or ug.goal == "guns" or ug.goal == "unlimbering") then
			local _, d = nearestOwn(state, g.pos, function(f)
				return f.class == "infantry" and not Formation.isBroken(f) and f.id ~= g.id
			end)
			local _, en = nearestOwn(state, g.pos, function(f)
				local uf = unitOf(state, f.id)
				return f.class == "infantry" and uf.goal == "guard" and uf.point ~= nil and Vec.dist(uf.point :: Vec, g.pos) < 50
			end)
			if d > 50 and en == math.huge then
				local best, bd = nearestOwn(state, g.pos, function(f)
					return availableInfantry(state, f) and unitOf(state, f.id).role == "reserve"
				end)
				if not best or bd > 300 then
					best, bd = nearestOwn(state, g.pos, function(f)
						return availableInfantry(state, f)
					end)
				end
				if best and bd <= 300 then
					local u = unitOf(state, best.id)
					local p = walkable(state, Vec.add(g.pos, Vec.scale(state.forward, 35)))
					if issue(state, "Move", { best.id }, { pos = p, heading = state.facing }) then
						u.point = p
						setGoal(state, best.id, "guard", "covering " .. g.name)
					end
				end
			end
		end
	end
end

-- Push the nearest free infantry onto an objective nobody contests.
local function exploit(state: AIState)
	for _, o in state.sim.objectives do
		local p = o.def.pos
		if o.owner ~= state.faction and not o.contested then
			local threatened = false
			for _, k in state.known do
				if k.age < 60 and Vec.dist(k.pos, p) < 120 then
					threatened = true
				end
			end
			local _, inside = nearestOwn(state, p, function(f)
				return (f.class == "infantry" or f.class == "cavalry") and not Formation.isBroken(f)
			end)
			if not threatened and inside > o.def.radius and quality(state) then
				local best, bd = nearestOwn(state, p, function(f)
					return availableInfantry(state, f) and not committed(state, unitOf(state, f.id))
				end)
				if best and bd <= 400 then
					local u = unitOf(state, best.id)
					local dest = walkable(state, Vec.add(p, Vec.scale(state.forward, 15)))
					if issue(state, "Move", { best.id }, { pos = dest, heading = state.facing }) then
						u.point = dest
						setGoal(state, best.id, "exploit", "taking " .. o.def.name)
					end
				end
			end
		end
	end
end

-- Formation behaviour --------------------------------------------------------------------------

local function goalPoint(state: AIState, u: Unit): Vec?
	if u.goal == "guard" or u.goal == "exploit" then
		return u.point
	end
	if u.role == "reserve" then
		return state.reserve
	end
	return state.wingPos[u.role]
end

-- Idle and far from the goal point: walk there (column for long marches, line near the enemy).
local function maintain(state: AIState, f: Formation, u: Unit)
	local sim = state.sim
	local p = goalPoint(state, u)
	if not p or f.state ~= "idle" or sim.clock < u.nextMove then
		return
	end
	local d = Vec.dist(f.pos, p)
	local radius = if string.sub(u.goal, 1, 4) == "line" or u.goal == "reserve" then 100 else 60
	if d <= radius then
		return
	end
	u.nextMove = sim.clock + 10
	if f.class == "infantry" and f.shape == "line" and d > 250 and nearestKnownDist(state, f.pos, 90) > 150 then
		if issue(state, "Shape", { f.id }, { shape = "column" }) then
			u.nextMove = sim.clock + Config.ReformTime.column + 1
			u.reason = "column for the march"
			return
		end
	end
	if issue(state, "Move", { f.id }, { pos = p, heading = state.facing }) then
		u.goal = if u.goal == "guard" or u.goal == "exploit" then u.goal elseif u.role == "reserve" then "reserve" else "line:" .. u.role
		u.reason = string.format("moving to the %s position (%.0f)", u.role, d)
	end
end

local function friendlyCavScreens(state: AIState, f: Formation, threat: Formation): boolean
	local dMe = Vec.dist(f.pos, threat.pos)
	for _, c in state.mine do
		if c.class == "cavalry" and healthy(c) and Vec.dist(c.pos, f.pos) < 120 and Vec.dist(c.pos, threat.pos) < dMe then
			return true
		end
	end
	return false
end

local function infantry(state: AIState, f: Formation)
	local sim = state.sim
	local clock = sim.clock
	local u = unitOf(state, f.id)
	if f.state == "melee" then
		u.goal, u.reason = "melee", "in contact"
		return
	end
	-- Cavalry threat: form square unless friendly cavalry screens.
	local threat, td = nearestVisible(state, f.pos, 140, function(e)
		if not isCav(e) then
			return false
		end
		local d = Vec.dist(f.pos, e.pos)
		local approaching = Vec.dot(Vec.fromHeading(e.heading), Vec.normalize(Vec.sub(f.pos, e.pos))) > 0.3 and (e.state == "charging" or e.state == "moving")
		return d < 90 or approaching
	end)
	if threat and not friendlyCavScreens(state, f, threat) then
		if f.shape ~= "square" and f.pendingShape ~= "square" then
			issue(state, "Shape", { f.id }, { shape = "square" })
		end
		u.squareUntil = clock + Config.AI.CommitSeconds * state.reaction
		setGoal(state, f.id, "square", string.format("cavalry %s at %.0f", threat.name, td))
		return
	end
	if f.shape == "square" or f.pendingShape == "square" then
		local cav = nearestVisible(state, f.pos, 200, isCav)
		if not cav and clock >= u.squareUntil and f.state ~= "reforming" then
			if issue(state, "Shape", { f.id }, { shape = "line" }) then
				setGoal(state, f.id, "reform", "cavalry gone, back to line", 5)
			end
		else
			u.goal, u.reason = "square", "holding square"
		end
		return
	end
	if f.state == "reforming" then
		u.reason = "reforming"
		return
	end
	-- Broken enough: fall back on the reserve.
	if f.moraleBand == "shaken" and f.strength < f.startStrength * 0.6 and u.goal ~= "retreat" then
		if issue(state, "Retreat", { f.id }, { pos = state.reserve }) then
			setGoal(state, f.id, "retreat", "shaken with heavy losses")
			return
		end
	end
	if u.goal == "retreat" and f.state == "retreating" then
		return
	end
	-- Bayonet a shaken enemy close in front (routing ones are left to fire-at-will).
	local weak = nearestVisible(state, f.pos, 60, function(e)
		return Formation.moraleBandOf(e) == "shaken" and e.shape ~= "square" and math.abs(Vec.bearing(f.pos, f.heading, e.pos)) < math.rad(50)
	end)
	local charging = f.state == "charging" or (f.order ~= nil and f.order.kind == "Charge")
	if weak and not charging and not (u.goal == "charge" and committed(state, u)) and quality(state) then
		if issue(state, "Charge", { f.id }, { targetId = weak.id }) then
			setGoal(state, f.id, "charge", "bayonets: " .. weak.name .. " is wavering")
			return
		end
	end
	if charging then
		return
	end
	if u.goal == "charge" or (u.goal == "square" and f.shape ~= "square" and f.pendingShape ~= "square") then
		u.goal = "idle"
	end
	-- Enemy in musket range: engage (attack posture) or face it and let fire-at-will work.
	local tgt, d = nearestVisible(state, f.pos, MUSKET + 10, function(e)
		return e.state ~= "routing"
	end)
	if tgt then
		local goalName = "engage:" .. tgt.id
		if (state.posture == "attack" or Formation.moraleBandOf(tgt) == "shaken") and u.goal ~= goalName and not committed(state, u) then
			if quality(state) and issue(state, "Engage", { f.id }, { targetId = tgt.id }) then
				setGoal(state, f.id, goalName, string.format("engaging %s at %.0f", tgt.name, d))
				return
			end
		end
		if string.sub(u.goal, 1, 6) == "engage" then
			return
		end
		local bearing = Vec.bearing(f.pos, f.heading, tgt.pos)
		if math.abs(bearing) > math.rad(50) and f.state == "idle" and clock >= u.nextMove then
			u.nextMove = clock + 5
			issue(state, "Face", { f.id }, { heading = Vec.heading(Vec.sub(tgt.pos, f.pos)) })
		end
		u.reason = string.format("firing on %s at %.0f", tgt.name, d)
		return
	end
	-- Deploy from column before contact.
	if f.shape == "column" and nearestKnownDist(state, f.pos, 60) < 110 then
		if issue(state, "Shape", { f.id }, { shape = "line" }) then
			u.reason = "deploying into line"
			return
		end
	end
	maintain(state, f, u)
end

local function gunsThreatenedBy(state: AIState, e: Formation): boolean
	for _, g in state.mine do
		if g.class == "artillery" and Vec.dist(g.pos, e.pos) < 150 then
			return true
		end
	end
	return false
end

local function cavalry(state: AIState, f: Formation)
	local u = unitOf(state, f.id)
	local recovering = f.timers.chargeRecover > 0 or (f.state == "melee" and f.timers.meleeSeconds > 15)
	if recovering then
		if u.goal ~= "recover" then
			if issue(state, "Retreat", { f.id }, { pos = state.reserve }) then
				setGoal(state, f.id, "recover", "blown; back to the reserve")
			end
		elseif f.state == "idle" then
			u.reason = "recovering"
		end
		return
	end
	if f.state == "melee" or f.state == "charging" or f.state == "retreating" then
		u.reason = f.state
		return
	end
	if u.goal == "recover" then
		u.goal = "reserve"
	end
	if healthy(f) then
		local best: Formation? = nil
		local bestScore = 0
		for _, e in state.visible do
			local d = Vec.dist(f.pos, e.pos)
			if d <= 250 and not inCover(state, e.pos) and not f.inWoods then
				local s = 0
				if e.state == "routing" then
					s = 100
				elseif e.class == "artillery" then
					s = 90
				elseif e.class == "cavalry" then
					s = if gunsThreatenedBy(state, e) then 85 else 0
				elseif e.class == "hq" then
					s = 60
				elseif e.shape ~= "square" and e.state ~= "reforming" then
					local side = Vec.attackSide(e.pos, e.heading, f.pos)
					s = if side == "rear" then 80 elseif side == "flank" then 70 else 0
				end
				if s > 0 then
					s -= d / 8
					if s > bestScore then
						best, bestScore = e, s
					end
				end
			end
		end
		local charging = f.order ~= nil and f.order.kind == "Charge"
		if best and not charging and (bestScore >= 60 or not committed(state, u)) and quality(state) then
			if issue(state, "Charge", { f.id }, { targetId = best.id }) then
				setGoal(state, f.id, "charge", string.format("charging %s (%s)", best.name, Vec.attackSide(best.pos, best.heading, f.pos)))
				return
			end
		end
	end
	if u.goal == "charge" then
		u.goal = "reserve"
	end
	u.reason = if healthy(f) then "held in reserve" else "shaken; resting"
	maintain(state, f, u)
end

local function artillery(state: AIState, f: Formation)
	local sim = state.sim
	local clock = sim.clock
	local u = unitOf(state, f.id)
	if f.state == "melee" then
		u.goal, u.reason = "melee", "overrun"
		return
	end
	local limbered = Formation.isLimbered(f)
	-- Threats: infantry within 80 with nobody in between, or cavalry within 150.
	local threat = nearestVisible(state, f.pos, 150, function(e)
		if e.state == "routing" then
			return false
		end
		if e.class == "cavalry" then
			return true
		end
		if e.class ~= "infantry" or Vec.dist(f.pos, e.pos) > 80 then
			return false
		end
		local de = Vec.dist(f.pos, e.pos)
		for _, i in state.mine do
			if i.class == "infantry" and not Formation.isBroken(i) and Vec.dist(i.pos, f.pos) < 60 and Vec.dist(i.pos, e.pos) < de then
				return false
			end
		end
		return true
	end)
	if threat then
		u.withdrawUntil = clock + 30 * state.reaction
	end
	if threat or (u.goal == "withdraw" and clock < u.withdrawUntil) then
		if f.pendingLimber ~= nil then
			u.reason = "limbering up"
		elseif not limbered then
			if issue(state, "Limber", { f.id }, { limbered = true }) then
				setGoal(state, f.id, "withdraw", "threatened by " .. (if threat then threat.name else "the enemy"))
			end
		elseif f.state ~= "retreating" and f.state ~= "moving" and Vec.dist(f.pos, state.reserve) > 40 then
			if issue(state, "Retreat", { f.id }, { pos = state.reserve }) then
				setGoal(state, f.id, "withdraw", "pulling back to the reserve")
			end
		end
		return
	end
	if f.state == "reforming" then
		u.reason = if f.pendingLimber == false then "unlimbering" else "limbering"
		return
	end
	local gp = state.gunPos[f.id]
	if limbered then
		if gp and Vec.dist(f.pos, gp) > 24 then
			if f.state == "idle" and clock >= u.nextMove then
				u.nextMove = clock + 10
				if issue(state, "Move", { f.id }, { pos = gp, heading = state.facing }) then
					setGoal(state, f.id, "deploying", "moving into position")
				end
			end
		elseif f.state == "idle" then
			if math.abs(Vec.angleDiff(f.heading, state.facing)) > 0.3 then
				if clock >= u.nextMove then
					u.nextMove = clock + 5
					issue(state, "Face", { f.id }, { heading = state.facing })
				end
			elseif issue(state, "Limber", { f.id }, { limbered = false }) then
				setGoal(state, f.id, "unlimbering", "deploying the guns")
			end
		end
		return
	end
	if f.ammoMode ~= "auto" then
		issue(state, "Ammo", { f.id }, { ammo = "auto" })
	end
	-- Best target it can actually fire at: columns/squares first, then nearest.
	local best: Formation? = nil
	local bestScore = -math.huge
	for _, e in state.visible do
		local r = Combat.fireBlockReason(sim :: any, f, e)
		if r == nil or r == "Reloading" then
			local s = ((Config.Shapes :: any)[e.shape].artillery :: number) * 100 - Vec.dist(f.pos, e.pos) / 4
			if s > bestScore then
				best, bestScore = e, s
			end
		end
	end
	if best then
		if f.targetId ~= best.id and (u.goal ~= "fire" or not committed(state, u)) then
			if issue(state, "Engage", { f.id }, { targetId = best.id }) then
				setGoal(state, f.id, "fire", "firing on " .. best.name)
				return
			end
		end
		u.goal, u.reason = "fire", "firing on " .. best.name
	elseif gp and Vec.dist(f.pos, gp) > 120 and issue(state, "Limber", { f.id }, { limbered = true }) then
		setGoal(state, f.id, "deploying", "relocating the battery")
	else
		u.goal, u.reason = "guns", "in battery, no target"
	end
end

local function hq(state: AIState, f: Formation)
	local clock = state.sim.clock
	local u = unitOf(state, f.id)
	local threat, td = nearestVisible(state, f.pos, 110, function(e)
		return e.state ~= "routing"
	end)
	if threat then
		if f.state ~= "moving" or clock >= u.nextMove then
			u.nextMove = clock + 5
			local away = Vec.normalize(Vec.sub(f.pos, threat.pos))
			local p = walkable(state, Vec.add(f.pos, Vec.scale(away, 150)))
			if issue(state, "Move", { f.id }, { pos = p }) then
				setGoal(state, f.id, "evade", string.format("%s at %.0f", threat.name, td))
			end
		end
		return
	end
	if f.timers.rallyCd <= 0 then
		local cfg = Config.Units.hq.rally
		for _, o in state.mine do
			if o.state == "routing" and not o.shattered and o.timers.routing >= cfg.minRoutingSeconds and Vec.dist(o.pos, f.pos) <= cfg.radius then
				if issue(state, "Rally", { f.id }, {}) then
					setGoal(state, f.id, "rally", "rallying " .. o.name, 5)
					return
				end
			end
		end
	end
	if u.goal == "evade" and f.state == "idle" then
		u.goal = "hq"
	end
	if f.state == "idle" and Vec.dist(f.pos, state.hqPos) > 50 and clock >= u.nextMove then
		u.nextMove = clock + 10
		if issue(state, "Move", { f.id }, { pos = state.hqPos, heading = state.facing }) then
			setGoal(state, f.id, "hq", "following the centre")
			return
		end
	end
	if u.goal ~= "hq" and f.state == "idle" then
		u.goal, u.reason = "hq", "with the centre"
	end
end

-- Public API -----------------------------------------------------------------------------------------

function AI.new(sim: SimLike, faction: string, difficulty: string): AIState
	local diff = (Config.AI.Difficulties :: any)[difficulty] or Config.AI.Difficulties.normal
	return {
		sim = sim,
		faction = faction,
		enemy = if faction == sim.playerFaction then sim.enemyFaction else sim.playerFaction,
		reaction = diff.reaction,
		planQuality = diff.planQuality,
		n = 0,
		steps = 0,
		budget = 0,
		posture = "defend",
		forward = { x = 0, z = -1 },
		right = { x = 1, z = 0 },
		facing = -math.pi / 2,
		reserve = { x = sim.grid.width / 2, z = sim.grid.depth / 2 },
		hqPos = { x = sim.grid.width / 2, z = sim.grid.depth / 2 },
		wingPos = {},
		gunPos = {},
		nextPlan = 0,
		rolesAssigned = false,
		units = {},
		mine = {},
		visible = {},
		known = {},
	}
end

-- Called by the sim every Config.AI.DecisionTicks ticks.
function AI.step(state: AIState)
	local sim = state.sim
	if sim.state ~= "running" then
		return
	end
	state.steps += 1
	state.budget = MAX_PATH_CMDS
	perceive(state)
	if planTrigger(state) then
		plan(state)
	end
	-- easy reacts slower: only every Nth decision tick
	if state.steps % math.max(1, math.floor(state.reaction)) ~= 0 then
		return
	end
	guardGuns(state)
	exploit(state)
	for _, f in state.mine do
		local u = unitOf(state, f.id)
		if f.state == "routing" or f.state == "rallying" then
			u.goal, u.reason = "routing", f.state
		elseif u.orderedStep == state.steps then
			-- already ordered this tick by the plan / guard / exploit pass
		elseif f.class == "infantry" then
			infantry(state, f)
		elseif f.class == "cavalry" then
			cavalry(state, f)
		elseif f.class == "artillery" then
			artillery(state, f)
		else
			hq(state, f)
		end
	end
end

function AI.debugView(state: AIState): { { id: number, goal: string, reason: string } }
	local out = {}
	for _, f in state.mine do
		local u = unitOf(state, f.id)
		out[#out + 1] = { id = f.id, goal = string.format("%s/%s", u.role, u.goal), reason = u.reason }
	end
	return out
end

return AI
]]></ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX00000013"><Properties><bool name="Disabled">false</bool><string name="Name">Campaign</string><ProtectedString name="Source"><![CDATA[--!strict
-- Operational campaign (Release B). Pure Luau, deterministic through `state.rng`; no wall clock,
-- no Roblox APIs. The tactical battle is delegated to the Sim through `battleScenario` and the
-- outcome returns through `applyBattleResult` (idempotent by battle id).
--
-- Turn: player phase (commands) -> endTurn: enemy AI acts with the same rules -> contacts become
-- battle contexts (one per contested region, regions in ascending id order, so an army is in at
-- most one battle and never in two regions) -> uncontested enemy regions are captured -> economy
-- for both factions (income, manpower, upkeep, recruitment completion) -> next turn. While
-- battles are pending the phase is "battle"; apply or auto-resolve every pending battle to get
-- back to "player".
--
-- Supply: upkeep paid in full raises faction supply by SupplyRecovery (cap 100); a shortfall
-- empties the treasury and lowers supply by SupplyShortage; at supply 0 every unit loses
-- AttritionFraction of its strength per turn. Ammunition is not tracked between battles: every
-- battle scenario starts with full ammunition (Formation.fromDef).

local Shared = game:GetService("ReplicatedStorage"):WaitForChild("EoE")
local RNG = require(Shared.RNG)
local MapGen = require(Shared.MapGen)
local Scenarios = require(Shared.Scenarios)
local Types = require(Shared.Types)
local CampaignData = require(Shared.CampaignData)

export type Unit = { key: string, type: string, name: string, strength: number, maxStrength: number, experience: number }
export type Army = { id: number, faction: string, name: string, regionId: string, units: { Unit }, movesLeft: number, supplied: boolean }
export type Recruit = { faction: string, regionId: string, unitType: string, turnsLeft: number, name: string }
export type Battle = { battleId: string, regionId: string, attacker: string, defender: string, turn: number }
export type Applied = { battleId: string, winner: string, outcome: string, turn: number }
export type FactionState = { treasury: number, manpower: number, supply: number }
export type Victory = { outcome: "victory" | "defeat", reason: string }
export type Survivor = { strength: number, experience: number, destroyed: boolean? }
type Placed = { u: Unit, a: Army }

export type State = {
	campaignId: string,
	seed: number,
	restarts: number,
	revision: number,
	rng: RNG.RNG,
	turn: number,
	phase: "player" | "battle" | "ended",
	owners: { [string]: string },
	armies: { Army }, -- ascending id
	factions: { [string]: FactionState },
	recruitment: { Recruit },
	nextArmyId: number,
	nextUnitId: number,
	log: { string },
	pendingBattles: { Battle },
	appliedBattles: { Applied },
	victory: Victory?,
}

export type Command = { kind: string, armyId: number?, regionId: string?, unitType: string?, army: number? }

local Campaign = {}

local PLAYER = CampaignData.Factions.player
local ENEMY = CampaignData.Factions.enemy
local FACTIONS = { PLAYER, ENEMY }
local ECON = CampaignData.Economy
local LOG_MAX = 40
local APPLIED_MAX = 64
local PHASES = { player = true, battle = true, ended = true }

-- Helpers ------------------------------------------------------------------------------------

local function copy(v: any): any
	if type(v) ~= "table" then
		return v
	end
	local out = {}
	for k, x in v do
		out[k] = copy(x)
	end
	return out
end

local function isNum(v: any): boolean
	return type(v) == "number" and v == v and v ~= math.huge and v ~= -math.huge
end

local function region(id: string): CampaignData.Region
	return CampaignData.region(id) or error("unknown region " .. tostring(id))
end

local function sortedRegionIds(): { string }
	local ids = {}
	for _, reg in CampaignData.Regions do
		ids[#ids + 1] = reg.id
	end
	table.sort(ids)
	return ids
end

local function adjacent(a: string, b: string): boolean
	return table.find(region(a).adjacent, b) ~= nil
end

local function other(faction: string): string
	return if faction == PLAYER then ENEMY else PLAYER
end

local function log(state: State, text: string)
	state.log[#state.log + 1] = string.format("T%d: %s", state.turn, text)
	while #state.log > LOG_MAX do
		table.remove(state.log, 1)
	end
end

local function armyById(state: State, id: number): Army?
	for _, a in state.armies do
		if a.id == id then
			return a
		end
	end
	return nil
end

local function armiesIn(state: State, regionId: string, faction: string?): { Army }
	local out = {}
	for _, a in state.armies do
		if a.regionId == regionId and (faction == nil or a.faction == faction) then
			out[#out + 1] = a
		end
	end
	return out
end

local function armiesOf(state: State, faction: string): { Army }
	local out = {}
	for _, a in state.armies do
		if a.faction == faction then
			out[#out + 1] = a
		end
	end
	return out
end

local function removeArmy(state: State, id: number)
	for i, a in state.armies do
		if a.id == id then
			table.remove(state.armies, i)
			return
		end
	end
end

-- Fighting strength (HQ staff excluded), experience weighted.
local function armyStrength(a: Army): number
	local s = 0
	for _, u in a.units do
		if CampaignData.UnitTypes[u.type].class ~= "hq" then
			s += u.strength * (1 + 0.1 * u.experience)
		end
	end
	return s
end

local function strengthIn(state: State, regionId: string, faction: string): number
	local s = 0
	for _, a in armiesIn(state, regionId, faction) do
		s += armyStrength(a)
	end
	return s
end

local function factionStrength(state: State, faction: string): number
	local s = 0
	for _, a in armiesOf(state, faction) do
		for _, u in a.units do
			s += u.strength
		end
	end
	return s
end

local function newArmy(state: State, faction: string, name: string, regionId: string): Army
	local a: Army = { id = state.nextArmyId, faction = faction, name = name, regionId = regionId, units = {}, movesLeft = 0, supplied = true }
	state.nextArmyId += 1
	state.armies[#state.armies + 1] = a
	return a
end

local function newUnit(state: State, unitType: string, name: string, experience: number): Unit
	local def = CampaignData.UnitTypes[unitType]
	local u: Unit = { key = "u" .. state.nextUnitId, type = unitType, name = name, strength = def.strength, maxStrength = def.strength, experience = experience }
	state.nextUnitId += 1
	return u
end

local function queueCount(state: State, faction: string): number
	local n = 0
	for _, q in state.recruitment do
		if q.faction == faction then
			n += 1
		end
	end
	return n
end

local function isApplied(state: State, battleId: string): boolean
	for _, b in state.appliedBattles do
		if b.battleId == battleId then
			return true
		end
	end
	return false
end

local function pendingBattle(state: State, battleId: string): (Battle?, number)
	for i, b in state.pendingBattles do
		if b.battleId == battleId then
			return b, i
		end
	end
	return nil, 0
end

-- Construction ---------------------------------------------------------------------------------

local function build(seed: number, restarts: number): State
	seed = math.floor(seed)
	local state: State = {
		campaignId = string.format("%d-%d", seed, restarts),
		seed = seed,
		restarts = restarts,
		revision = 0,
		rng = RNG.new(seed + restarts * 7919),
		turn = 1,
		phase = "player",
		owners = {},
		armies = {},
		factions = {},
		recruitment = {},
		nextArmyId = 1,
		nextUnitId = 1,
		log = {},
		pendingBattles = {},
		appliedBattles = {},
		victory = nil,
	}
	for _, reg in CampaignData.Regions do
		state.owners[reg.id] = reg.owner
	end
	for _, f in FACTIONS do
		state.factions[f] = { treasury = ECON.StartTreasury[f], manpower = ECON.StartManpower[f], supply = 100 }
	end
	for _, def in CampaignData.StartArmies do
		local a = newArmy(state, def.faction, def.name, def.regionId)
		a.movesLeft = 1
		for _, su in def.units do
			a.units[#a.units + 1] = newUnit(state, su.type, su.name, su.experience)
		end
	end
	log(state, "Campaign opened. Hold Jena, Weimar and Naumburg by turn " .. CampaignData.Victory.TurnLimit .. ".")
	return state
end

function Campaign.new(seed: number): State
	return build(seed, 0)
end

-- Victory ----------------------------------------------------------------------------------------

function Campaign.victory(state: State): Victory?
	if state.victory then
		return state.victory
	end
	local V = CampaignData.Victory
	local held = true
	for _, id in V.Objectives do
		if state.owners[id] ~= PLAYER then
			held = false
		end
	end
	local strength = factionStrength(state, PLAYER)
	if held and strength >= V.MinArmyStrength then
		return { outcome = "victory", reason = "Jena, Weimar and Naumburg are in French hands and the army stands." }
	end
	local owned = 0
	for _, f in state.owners do
		if f == PLAYER then
			owned += 1
		end
	end
	if owned == 0 then
		return { outcome = "defeat", reason = "France holds no region in Thuringia." }
	end
	local cheapest = math.huge
	for _, t in CampaignData.UnitTypes do
		if t.recruitable then
			cheapest = math.min(cheapest, t.cost)
		end
	end
	if #armiesOf(state, PLAYER) == 0 and queueCount(state, PLAYER) == 0 and state.factions[PLAYER].treasury < cheapest then
		return { outcome = "defeat", reason = "The French army is destroyed and the treasury cannot raise another." }
	end
	if #state.pendingBattles == 0 and state.turn > V.TurnLimit then
		return { outcome = "defeat", reason = "Turn " .. V.TurnLimit .. " passed without securing the objectives." }
	end
	return nil
end

local function checkVictory(state: State)
	if state.victory then
		return
	end
	local v = Campaign.victory(state)
	if v then
		state.victory = v
		state.phase = "ended"
		log(state, (if v.outcome == "victory" then "VICTORY: " else "DEFEAT: ") .. v.reason)
	end
end

-- Economy ----------------------------------------------------------------------------------------

-- Restores strength up to maxStrength; costs ReplenishCostPerMan treasury and one manpower per man.
local function replenish(state: State, army: Army): number
	local fs = state.factions[army.faction]
	local restored = 0
	for _, u in army.units do
		local need = u.maxStrength - u.strength
		if need > 0 then
			local n = math.min(need, math.floor(fs.treasury / ECON.ReplenishCostPerMan), fs.manpower)
			if n > 0 then
				u.strength += n
				fs.treasury -= n * ECON.ReplenishCostPerMan
				fs.manpower -= n
				restored += n
			end
		end
	end
	return restored
end

local function deliverRecruit(state: State, q: Recruit)
	if state.owners[q.regionId] ~= q.faction then
		log(state, string.format("%s raised at %s dispersed: the town was lost.", q.name, region(q.regionId).name))
		return
	end
	local target: Army? = nil
	for _, a in armiesIn(state, q.regionId, q.faction) do
		if #a.units < ECON.MaxUnitsPerArmy then
			target = a
			break
		end
	end
	if not target then
		if #armiesOf(state, q.faction) >= ECON.MaxArmies then
			log(state, q.name .. " could not be formed: too many armies.")
			return
		end
		target = newArmy(state, q.faction, "Garrison of " .. region(q.regionId).name, q.regionId)
	end
	local t = target :: Army
	t.units[#t.units + 1] = newUnit(state, q.unitType, q.name, 0)
	log(state, string.format("%s joined %s at %s.", q.name, t.name, region(q.regionId).name))
end

local function economy(state: State, faction: string)
	local fs = state.factions[faction]
	local income, manpower = 0, 0
	for _, reg in CampaignData.Regions do
		if state.owners[reg.id] == faction then
			income += reg.income
			manpower += reg.manpower
		end
	end
	fs.treasury = math.min(ECON.MaxTreasury, fs.treasury + income)
	fs.manpower = math.min(ECON.MaxManpower, fs.manpower + manpower)
	local upkeep = 0
	for _, a in armiesOf(state, faction) do
		for _, u in a.units do
			upkeep += CampaignData.UnitTypes[u.type].upkeep
		end
	end
	if fs.treasury >= upkeep then
		fs.treasury -= upkeep
		fs.supply = math.min(100, fs.supply + ECON.SupplyRecovery)
	else
		fs.treasury = 0
		fs.supply = math.max(0, fs.supply - ECON.SupplyShortage)
		log(state, string.format("%s cannot pay upkeep (%d short); supply falls to %d.", CampaignData.FactionNames[faction], upkeep - fs.treasury, fs.supply))
		if fs.supply == 0 then
			for _, a in armiesOf(state, faction) do
				for i = #a.units, 1, -1 do
					local u = a.units[i]
					u.strength = math.floor(u.strength * (1 - ECON.AttritionFraction))
					if u.strength <= 0 then
						table.remove(a.units, i)
					end
				end
			end
		end
	end
	for _, a in armiesOf(state, faction) do
		a.supplied = fs.supply > 0
	end
	for i = #state.recruitment, 1, -1 do
		local q = state.recruitment[i]
		if q.faction == faction then
			q.turnsLeft -= 1
			if q.turnsLeft <= 0 then
				table.remove(state.recruitment, i)
				deliverRecruit(state, q)
			end
		end
	end
	-- armies emptied by attrition disappear
	for i = #state.armies, 1, -1 do
		if #state.armies[i].units == 0 then
			table.remove(state.armies, i)
		end
	end
end

-- Rules shared by player and AI ------------------------------------------------------------

local function tryMove(state: State, faction: string, armyId: number, regionId: string): (boolean, string?)
	local a = armyById(state, armyId)
	if not a or a.faction ~= faction then
		return false, "notYourArmy"
	end
	if a.movesLeft <= 0 then
		return false, "alreadyMoved"
	end
	if CampaignData.region(regionId) == nil or not adjacent(a.regionId, regionId) then
		return false, "notAdjacent"
	end
	a.regionId = regionId
	a.movesLeft = 0
	return true, nil
end

local function tryRecruit(state: State, faction: string, regionId: string, unitType: string): (boolean, string?)
	local t = CampaignData.UnitTypes[unitType]
	if not t or not t.recruitable then
		return false, "unknownUnit"
	end
	if state.owners[regionId] ~= faction then
		return false, "notYourRegion"
	end
	if queueCount(state, faction) >= ECON.MaxQueue then
		return false, "queueFull"
	end
	local fs = state.factions[faction]
	if fs.treasury < t.cost then
		return false, "insufficientFunds"
	end
	fs.treasury -= t.cost
	local n = 0
	for _, a in armiesOf(state, faction) do
		n += #a.units
	end
	local name = string.format("%s %d", t.name, n + queueCount(state, faction) + 1)
	state.recruitment[#state.recruitment + 1] = { faction = faction, regionId = regionId, unitType = unitType, turnsLeft = t.turns, name = name }
	return true, nil
end

-- Enemy AI ---------------------------------------------------------------------------------------

local function aiTurn(state: State)
	local fs = state.factions[ENEMY]
	local capital = CampaignData.Capitals[ENEMY]
	local mine = armiesOf(state, ENEMY)
	local homeGuard = if #mine > 0 then mine[1].id else nil
	for _, a in mine do
		if state.owners[a.regionId] == ENEMY and fs.treasury > ECON.AIReserve then
			replenish(state, a)
		end
	end
	for _, a in mine do
		if a.movesLeft > 0 then
			local here = region(a.regionId)
			local myStr = armyStrength(a)
			local threat = 0
			for _, adj in here.adjacent do
				threat = math.max(threat, strengthIn(state, adj, PLAYER))
			end
			local hold = (if here.isCity then 20 else 0) + (if threat > 0 and here.isCity then 30 else 0) + (if a.id == homeGuard then 25 else 0)
			local bestId: string? = nil
			local best = hold + state.rng:float() * 10
			for _, adj in here.adjacent do
				local score: number
				local enemyStr = strengthIn(state, adj, PLAYER)
				local adjReg = region(adj)
				if state.owners[adj] == PLAYER then
					if enemyStr == 0 then
						score = 40 + (if adjReg.isCity then 15 else 0)
					elseif myStr > enemyStr * 1.2 then
						score = 50 + (if adjReg.isCity then 10 else 0) - enemyStr / 100
					else
						score = -100
					end
				elseif adjReg.isCity and strengthIn(state, adj, ENEMY) == 0 then
					local threatened = false
					for _, n in adjReg.adjacent do
						threatened = threatened or strengthIn(state, n, PLAYER) > 0
					end
					score = if threatened then 35 else -10
				else
					score = -10
				end
				if a.id == homeGuard and adj ~= capital and not adjacent(adj, capital) then
					score -= 30
				end
				score += state.rng:float() * 10
				if score > best then
					best, bestId = score, adj
				end
			end
			if bestId then
				tryMove(state, ENEMY, a.id, bestId)
				log(state, string.format("%s marches to %s.", a.name, region(bestId).name))
			end
		end
	end
	-- recruit with spare treasury, preferring the capital, then any city, then any owned region
	local recruitAt: string? = nil
	for _, id in sortedRegionIds() do
		if state.owners[id] == ENEMY then
			if id == capital then
				recruitAt = id
				break
			elseif recruitAt == nil or (region(id).isCity and not region(recruitAt).isCity) then
				recruitAt = id
			end
		end
	end
	while recruitAt ~= nil and fs.treasury - ECON.AIReserve >= CampaignData.UnitTypes.line.cost and queueCount(state, ENEMY) < ECON.MaxQueue do
		local r = state.rng:float()
		local t = if r < 0.6 then "line" elseif r < 0.8 then "cavalry" else "artillery"
		if fs.treasury - ECON.AIReserve < CampaignData.UnitTypes[t].cost then
			t = "line"
		end
		if not tryRecruit(state, ENEMY, recruitAt, t) then
			break
		end
	end
end

-- Contacts ---------------------------------------------------------------------------------------

local function resolveContacts(state: State): { Battle }
	local battles = {}
	for _, id in sortedRegionIds() do
		local p = #armiesIn(state, id, PLAYER)
		local e = #armiesIn(state, id, ENEMY)
		local owner = state.owners[id]
		if p > 0 and e > 0 then
			local attacker = if owner == PLAYER then ENEMY else PLAYER
			local b: Battle = { battleId = string.format("%s-t%d-%s", state.campaignId, state.turn, id), regionId = id, attacker = attacker, defender = other(attacker), turn = state.turn }
			state.pendingBattles[#state.pendingBattles + 1] = b
			battles[#battles + 1] = b
			log(state, string.format("Battle at %s: %s attacks.", region(id).name, CampaignData.FactionNames[attacker]))
		elseif p > 0 and owner ~= PLAYER then
			state.owners[id] = PLAYER
			log(state, region(id).name .. " occupied by France.")
		elseif e > 0 and owner ~= ENEMY then
			state.owners[id] = ENEMY
			log(state, region(id).name .. " occupied by Prussia.")
		end
	end
	return battles
end

-- Public turn API ------------------------------------------------------------------------------

function Campaign.endTurn(state: State): (State, { Battle })
	if state.phase ~= "player" then
		return state, {}
	end
	aiTurn(state)
	local battles = resolveContacts(state)
	for _, f in FACTIONS do
		economy(state, f)
	end
	state.turn += 1
	for _, a in state.armies do
		a.movesLeft = 1
	end
	state.phase = if #state.pendingBattles > 0 then "battle" else "player"
	checkVictory(state)
	return state, battles
end

function Campaign.command(state: State, cmd: Command): (boolean, string?)
	if cmd.kind == "restart" then
		local fresh = build(state.seed, state.restarts + 1)
		for k in pairs(state :: any) do
			(state :: any)[k] = nil
		end
		for k, v in pairs(fresh :: any) do
			(state :: any)[k] = v
		end
		return true, nil
	end
	if state.phase ~= "player" then
		return false, "wrongPhase"
	end
	if cmd.kind == "move" then
		if type(cmd.armyId) ~= "number" or type(cmd.regionId) ~= "string" then
			return false, "badArgs"
		end
		local ok, why = tryMove(state, PLAYER, cmd.armyId, cmd.regionId)
		if ok then
			local a = armyById(state, cmd.armyId) :: Army
			log(state, string.format("%s marches to %s.", a.name, region(cmd.regionId).name))
		end
		return ok, why
	elseif cmd.kind == "recruit" then
		if type(cmd.regionId) ~= "string" or type(cmd.unitType) ~= "string" then
			return false, "badArgs"
		end
		local ok, why = tryRecruit(state, PLAYER, cmd.regionId, cmd.unitType)
		if ok then
			local t = CampaignData.UnitTypes[cmd.unitType]
			log(state, string.format("%s ordered at %s: %d treasury, ready in %d turns.", t.name, region(cmd.regionId).name, t.cost, t.turns))
		end
		return ok, why
	elseif cmd.kind == "replenish" then
		local a = if type(cmd.armyId) == "number" then armyById(state, cmd.armyId) else nil
		if not a or a.faction ~= PLAYER then
			return false, "notYourArmy"
		end
		if state.owners[a.regionId] ~= PLAYER then
			return false, "notYourRegion"
		end
		local n = replenish(state, a)
		if n == 0 then
			return false, "nothingToReplenish"
		end
		log(state, string.format("%s took on %d replacements.", a.name, n))
		return true, nil
	elseif cmd.kind == "endTurn" then
		Campaign.endTurn(state)
		return true, nil
	end
	return false, "unknownCommand"
end

-- Battle hand-off --------------------------------------------------------------------------------

local mapCache: { [string]: MapGen.MapData } = {}
local function mapFor(id: string): MapGen.MapData
	local m = mapCache[id]
	if not m then
		m = MapGen.generate(id)
		mapCache[id] = m
	end
	return m
end

local function clampTo(z: MapGen.Rect, x: number, y: number): (number, number)
	local m = 30
	return math.clamp(x, z.x0 + m, z.x1 - m), math.clamp(y, z.z0 + m, z.z1 - m)
end

function Campaign.battleScenario(state: State, battleId: string): Scenarios.Scenario?
	local b = pendingBattle(state, battleId)
	if not b then
		return nil
	end
	local reg = region(b.regionId)
	local map = mapFor(reg.terrain)
	local units: { Scenarios.UnitDef } = {}
	for _, faction in FACTIONS do
		local zone = map.deployZones[faction]
		local ez = map.deployZones[other(faction)]
		local cx, cz = (zone.x0 + zone.x1) / 2, (zone.z0 + zone.z1) / 2
		local dx, dz = (ez.x0 + ez.x1) / 2 - cx, (ez.z0 + ez.z1) / 2 - cz
		local len = math.sqrt(dx * dx + dz * dz)
		dx, dz = dx / len, dz / len
		local heading = math.atan2(dz, dx)
		local px, pz = -dz, dx
		local line: { Placed } = {}
		local hqs: { Placed } = {}
		for _, a in armiesIn(state, b.regionId, faction) do
			for _, u in a.units do
				if CampaignData.UnitTypes[u.type].class == "hq" then
					hqs[#hqs + 1] = { u = u, a = a }
				else
					line[#line + 1] = { u = u, a = a }
				end
			end
		end
		local perRow = 8
		local rows = math.max(1, math.ceil(#line / perRow))
		local function add(pair: Placed, along: number, back: number)
			local u, a = pair.u, pair.a
			local x, z = clampTo(zone, cx + px * along - dx * back, cz + pz * along - dz * back)
			units[#units + 1] = {
				name = u.name,
				class = CampaignData.UnitTypes[u.type].class,
				corps = a.name,
				strength = u.strength,
				experience = u.experience,
				pos = { x = x, z = z },
				heading = heading,
				faction = faction,
				commander = if CampaignData.UnitTypes[u.type].class == "hq" then true else nil,
				key = u.key,
			}
		end
		for i, pair in line do
			local row = math.floor((i - 1) / perRow)
			local inRow = math.min(perRow, #line - row * perRow)
			local col = (i - 1) % perRow
			add(pair, (col - (inRow - 1) / 2) * 90, (row - (rows - 1) / 2) * 70)
		end
		for i, pair in hqs do
			add(pair, (i - 1) * 60, rows * 35 + 60)
		end
	end
	return {
		id = battleId,
		name = "Battle of " .. reg.name,
		map = reg.terrain,
		briefing = string.format("Turn %d. %s attacks %s at %s. Hold the field or break the enemy army.", b.turn, CampaignData.FactionNames[b.attacker], CampaignData.FactionNames[b.defender], reg.name),
		factions = { player = PLAYER, enemy = ENEMY },
		factionNames = CampaignData.FactionNames,
		units = units,
		timeLimit = nil,
	}
end

-- Survivor keys missing from `survivors` are left unchanged; strength <= 0 or destroyed removes.
function Campaign.applyBattleResult(state: State, battleId: string, results: Types.Results, survivors: { [string]: Survivor }): (boolean, string?)
	if isApplied(state, battleId) then
		return true, "alreadyApplied"
	end
	local b, index = pendingBattle(state, battleId)
	if not b then
		return false, "unknownBattle"
	end
	local winner = if results.outcome == "victory" then PLAYER elseif results.outcome == "defeat" then ENEMY else b.defender
	local loser = other(winner)
	for _, a in armiesIn(state, b.regionId) do
		for i = #a.units, 1, -1 do
			local u = a.units[i]
			local s = survivors[u.key]
			if s and (s.destroyed or not isNum(s.strength) or s.strength <= 0) then
				table.remove(a.units, i)
			else
				if s then
					u.strength = math.clamp(math.floor(s.strength), 1, u.maxStrength)
					if isNum(s.experience) then
						u.experience = math.clamp(math.floor(s.experience), 0, 3)
					end
				end
				if a.faction == winner then
					u.experience = math.min(3, u.experience + 1)
				end
			end
		end
	end
	state.owners[b.regionId] = winner
	for _, a in armiesIn(state, b.regionId) do
		if #a.units == 0 then
			removeArmy(state, a.id)
			log(state, a.name .. " was destroyed.")
		elseif a.faction == loser then
			local dest: string? = nil
			local adj = table.clone(region(b.regionId).adjacent)
			table.sort(adj)
			for _, id in adj do
				if state.owners[id] == loser and #armiesIn(state, id, winner) == 0 then
					dest = id
					break
				end
			end
			if dest then
				a.regionId = dest
				a.movesLeft = 0
				log(state, string.format("%s retreats to %s.", a.name, region(dest).name))
			else
				removeArmy(state, a.id)
				log(state, a.name .. " had no line of retreat and surrendered.")
			end
		end
	end
	table.remove(state.pendingBattles, index)
	state.appliedBattles[#state.appliedBattles + 1] = { battleId = battleId, winner = winner, outcome = results.outcome, turn = b.turn }
	while #state.appliedBattles > APPLIED_MAX do
		table.remove(state.appliedBattles, 1)
	end
	log(state, string.format("%s wins at %s (%s).", CampaignData.FactionNames[winner], region(b.regionId).name, results.reason))
	if #state.pendingBattles == 0 and state.phase == "battle" then
		state.phase = "player"
	end
	checkVictory(state)
	return true, nil
end

-- Abstract resolution: p(attacker wins) = A / (A + 1.2 D); loser loses 25-40 %, winner 8-18 %;
-- units under 15 % of authorised strength are destroyed.
function Campaign.autoResolve(state: State, battleId: string): (boolean, string?)
	if isApplied(state, battleId) then
		return true, "alreadyApplied"
	end
	local b = pendingBattle(state, battleId)
	if not b then
		return false, "unknownBattle"
	end
	local att = strengthIn(state, b.regionId, b.attacker)
	local def = strengthIn(state, b.regionId, b.defender)
	local winner = if state.rng:float() < att / math.max(1, att + 1.2 * def) then b.attacker else b.defender
	local loserLoss = 0.25 + state.rng:float() * 0.15
	local winnerLoss = 0.08 + state.rng:float() * 0.10
	local survivors: { [string]: Survivor } = {}
	local sides: { [string]: any } = {}
	for _, f in FACTIONS do
		sides[f] = { deployed = 0, casualties = 0, remaining = 0, surviving = 0, routed = 0, shattered = 0, destroyed = 0, exited = 0, formations = 0 }
	end
	for _, a in armiesIn(state, b.regionId) do
		local loss = if a.faction == winner then winnerLoss else loserLoss
		local side = sides[a.faction]
		for _, u in a.units do
			local keep = math.floor(u.strength * (1 - loss))
			local dead = keep < u.maxStrength * 0.15
			survivors[u.key] = { strength = if dead then 0 else keep, experience = u.experience, destroyed = dead }
			side.deployed += u.strength
			side.formations += 1
			if dead then
				side.destroyed += 1
				side.casualties += u.strength
			else
				side.surviving += 1
				side.remaining += keep
				side.casualties += u.strength - keep
			end
		end
	end
	local results: Types.Results = {
		outcome = if winner == PLAYER then "victory" else "defeat",
		reason = "auto-resolved",
		clock = 0,
		objectives = {},
		sides = sides,
		feedback = {},
		log = {},
	}
	return Campaign.applyBattleResult(state, battleId, results, survivors)
end

-- View -------------------------------------------------------------------------------------------

function Campaign.view(state: State): { [string]: any }
	local regions = {}
	for _, reg in CampaignData.Regions do
		local ids = {}
		for _, a in armiesIn(state, reg.id) do
			ids[#ids + 1] = a.id
		end
		regions[#regions + 1] = { id = reg.id, name = reg.name, pos = reg.pos, adjacent = reg.adjacent, terrain = reg.terrain, isCity = reg.isCity, income = reg.income, manpower = reg.manpower, owner = state.owners[reg.id], armies = ids }
	end
	local objectives = {}
	for _, id in CampaignData.Victory.Objectives do
		objectives[#objectives + 1] = { id = id, name = region(id).name, held = state.owners[id] == PLAYER }
	end
	local recent = {}
	for i = math.max(1, #state.log - 19), #state.log do
		recent[#recent + 1] = state.log[i]
	end
	local fs = state.factions[PLAYER]
	local pending = state.pendingBattles[1]
	return {
		campaignId = state.campaignId,
		turn = state.turn,
		turnLimit = CampaignData.Victory.TurnLimit,
		phase = state.phase,
		treasury = fs.treasury,
		manpower = fs.manpower,
		supply = fs.supply,
		regions = regions,
		armies = copy(state.armies),
		recruitment = copy(state.recruitment),
		unitTypes = copy(CampaignData.UnitTypes),
		objectives = { regions = objectives, armyStrength = factionStrength(state, PLAYER), minArmyStrength = CampaignData.Victory.MinArmyStrength },
		log = recent,
		victory = copy(state.victory),
		pendingBattle = if pending then { battleId = pending.battleId, regionId = pending.regionId, attacker = pending.attacker, defender = pending.defender } else nil,
	}
end

-- Serialization ------------------------------------------------------------------------------

function Campaign.serialize(state: State): { [string]: any }
	return {
		version = 1,
		revision = state.revision,
		campaignId = state.campaignId,
		seed = state.seed,
		restarts = state.restarts,
		rngState = state.rng.state,
		turn = state.turn,
		phase = state.phase,
		owners = copy(state.owners),
		armies = copy(state.armies),
		factions = copy(state.factions),
		recruitment = copy(state.recruitment),
		nextArmyId = state.nextArmyId,
		nextUnitId = state.nextUnitId,
		log = copy(state.log),
		pendingBattles = copy(state.pendingBattles),
		appliedBattles = copy(state.appliedBattles),
		victory = copy(state.victory),
	}
end

local function validArmy(a: any): boolean
	if type(a) ~= "table" or not isNum(a.id) or type(a.faction) ~= "string" or type(a.name) ~= "string" or type(a.units) ~= "table" or not isNum(a.movesLeft) or type(a.supplied) ~= "boolean" then
		return false
	end
	if not CampaignData.region(a.regionId) or not table.find(FACTIONS, a.faction) or #a.units > ECON.MaxUnitsPerArmy then
		return false
	end
	for _, u in a.units do
		if type(u) ~= "table" or type(u.key) ~= "string" or not CampaignData.UnitTypes[u.type] or type(u.name) ~= "string" or not isNum(u.strength) or not isNum(u.maxStrength) or not isNum(u.experience) then
			return false
		end
		if u.strength < 0 or u.strength > u.maxStrength or u.experience < 0 or u.experience > 3 then
			return false
		end
	end
	return true
end

function Campaign.deserialize(profile: any): State?
	local p = profile
	if type(p) ~= "table" or p.version ~= 1 or type(p.campaignId) ~= "string" or not isNum(p.seed) or not isNum(p.rngState) or not isNum(p.turn) or not PHASES[p.phase] then
		return nil
	end
	if type(p.owners) ~= "table" or type(p.armies) ~= "table" or type(p.factions) ~= "table" or type(p.recruitment) ~= "table" or type(p.log) ~= "table" or type(p.pendingBattles) ~= "table" or type(p.appliedBattles) ~= "table" then
		return nil
	end
	if not isNum(p.nextArmyId) or not isNum(p.nextUnitId) or not isNum(p.restarts) then
		return nil
	end
	for _, reg in CampaignData.Regions do
		if not table.find(FACTIONS, p.owners[reg.id]) then
			return nil
		end
	end
	for _, f in FACTIONS do
		local fs = p.factions[f]
		if type(fs) ~= "table" or not isNum(fs.treasury) or not isNum(fs.manpower) or not isNum(fs.supply) then
			return nil
		end
	end
	if #p.armies > ECON.MaxArmies * 2 or #p.recruitment > ECON.MaxQueue * 2 or #p.pendingBattles > #CampaignData.Regions or #p.appliedBattles > APPLIED_MAX then
		return nil
	end
	for _, a in p.armies do
		if not validArmy(a) then
			return nil
		end
	end
	for _, q in p.recruitment do
		if type(q) ~= "table" or not table.find(FACTIONS, q.faction) or not CampaignData.region(q.regionId) or not CampaignData.UnitTypes[q.unitType] or not isNum(q.turnsLeft) or type(q.name) ~= "string" then
			return nil
		end
	end
	for _, b in p.pendingBattles do
		if type(b) ~= "table" or type(b.battleId) ~= "string" or not CampaignData.region(b.regionId) or not table.find(FACTIONS, b.attacker) or not table.find(FACTIONS, b.defender) or not isNum(b.turn) then
			return nil
		end
	end
	for _, b in p.appliedBattles do
		if type(b) ~= "table" or type(b.battleId) ~= "string" or type(b.winner) ~= "string" or type(b.outcome) ~= "string" or not isNum(b.turn) then
			return nil
		end
	end
	if p.victory ~= nil and (type(p.victory) ~= "table" or (p.victory.outcome ~= "victory" and p.victory.outcome ~= "defeat") or type(p.victory.reason) ~= "string") then
		return nil
	end
	local state: State = {
		campaignId = p.campaignId,
		seed = p.seed,
		restarts = p.restarts,
		revision = if isNum(p.revision) then p.revision else 0,
		rng = RNG.fromState(p.rngState),
		turn = p.turn,
		phase = p.phase,
		owners = copy(p.owners),
		armies = copy(p.armies),
		factions = copy(p.factions),
		recruitment = copy(p.recruitment),
		nextArmyId = p.nextArmyId,
		nextUnitId = p.nextUnitId,
		log = copy(p.log),
		pendingBattles = copy(p.pendingBattles),
		appliedBattles = copy(p.appliedBattles),
		victory = copy(p.victory),
	}
	table.sort(state.armies, function(a: Army, b: Army)
		return a.id < b.id
	end)
	while #state.log > LOG_MAX do
		table.remove(state.log, 1)
	end
	return state
end

-- Persistence helpers for the match layer -----------------------------------------------------

type Store = { update: (any, number, number?, (any) -> (any, string?)) -> (boolean, any, string?) }

-- Saves `state` as the pre-battle checkpoint. Requires session ownership and the revision the
-- state was loaded with; on success `state.revision` is advanced.
function Campaign.checkpoint(store: Store, userId: number, sessionId: string, state: State): (boolean, string?)
	local ok, profile, reason = store:update(userId, state.revision, function(old: any): (any, string?)
		if old ~= nil and (type(old.session) ~= "table" or old.session.id ~= sessionId) then
			return nil, "notOwner"
		end
		if old ~= nil and old.campaignId ~= nil and old.campaignId ~= state.campaignId and old.restarts > state.restarts then
			return nil, "campaignMismatch"
		end
		local p = Campaign.serialize(state)
		p.session = if old then old.session else { id = sessionId, expires = 0 }
		return p, nil
	end)
	if ok then
		state.revision = profile.revision
	end
	return ok, reason
end

-- Commits a battle result against the *stored* profile through a pure mutate. Returns the state
-- rebuilt from the committed profile; a repeat commit returns the stored state with
-- "alreadyApplied". Fails with "stale" (profile moved on), "notOwner", "campaignMismatch",
-- "unknownBattle" or "error".
function Campaign.commitBattle(store: Store, userId: number, sessionId: string, state: State, battleId: string, results: Types.Results, survivors: { [string]: Survivor }): (boolean, State?, string?)
	-- Revision is checked here, after the duplicate check, so a retried commit from a caller whose
	-- in-memory state predates the first commit still gets "alreadyApplied" instead of "stale".
	local ok, profile, reason = store:update(userId, nil, function(old: any): (any, string?)
		if old == nil then
			return nil, "noProfile"
		end
		if type(old.session) ~= "table" or old.session.id ~= sessionId then
			return nil, "notOwner"
		end
		if old.campaignId ~= state.campaignId then
			return nil, "campaignMismatch"
		end
		local s = Campaign.deserialize(old)
		if not s then
			return nil, "corrupt"
		end
		if isApplied(s, battleId) then
			return nil, "alreadyApplied"
		end
		if old.revision ~= state.revision then
			return nil, "stale"
		end
		local okA, why = Campaign.applyBattleResult(s, battleId, results, survivors)
		if not okA then
			return nil, why
		end
		local p = Campaign.serialize(s)
		p.session = old.session
		return p, nil
	end)
	if ok or reason == "alreadyApplied" then
		local s = if profile then Campaign.deserialize(profile) else nil
		if not s then
			return false, nil, "corrupt"
		end
		return true, s, if ok then nil else reason
	end
	return false, nil, reason
end

return Campaign
]]></ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX00000014"><Properties><bool name="Disabled">false</bool><string name="Name">CampaignService</string><ProtectedString name="Source"><![CDATA[--!strict
-- Campaign session for the commander: profile load/continue, turns, battle hand-off to the
-- tactical match and exactly-once result commits. Talks to clients over the Campaign remote.
--
-- Client → server: { requestId, action, data }  actions: open | new | command | battle | skip | return
-- Server → client: { kind = "view", view, sessionOnly, battleId? } | { kind = "error", requestId, reason }

local Players = game:GetService("Players")
local RunService = game:GetService("RunService")
local DataStoreService = game:GetService("DataStoreService")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Shared = ReplicatedStorage:WaitForChild("EoE")
local Scenarios = require(Shared.Scenarios)
local Types = require(Shared.Types)

local Campaign = require(script.Parent.Campaign)
local ProfileStore = require(script.Parent.Persist.ProfileStore)

type State = Campaign.State

type Session = {
	userId: number,
	sessionId: string,
	state: State?,
	activeBattleId: string?,
	activeScenario: Scenarios.Scenario?,
	committed: { [string]: boolean },
	renewAt: number,
}

export type Hooks = {
	isCommander: (Player) -> boolean,
	startBattle: (scenario: Scenarios.Scenario, battleId: string) -> (),
}

local CampaignService = {}

local remote: RemoteEvent
local hooks: Hooks
local store: ProfileStore.Store
local session: Session? = nil

local function send(player: Player, payload: any)
	remote:FireClient(player, payload)
end

local function sendError(player: Player, requestId: string, reason: string)
	send(player, { kind = "error", requestId = requestId, reason = reason })
end

local function sendView(player: Player, s: Session)
	if s.state then
		send(player, { kind = "view", view = Campaign.view(s.state), sessionOnly = store.sessionOnly, battleId = s.activeBattleId })
	end
end

local function newSessionId(): string
	return string.format("%s-%d-%d", game.JobId ~= "" and game.JobId or "studio", os.time(), math.random(1, 1e6))
end

-- Load or create the commander's session. Returns nil + reason on failure (never defaults
-- over a profile that could not be read).
local function ensureSession(player: Player): (Session?, string?)
	local s = session
	if s and s.userId == player.UserId then
		return s, nil
	end
	local sessionId = newSessionId()
	local okClaim, whyClaim = store:claimSession(player.UserId, sessionId, os.time())
	if not okClaim then
		return nil, if whyClaim == "locked" then "Your campaign is open in another server; try again in a minute" else "Could not claim your campaign: " .. tostring(whyClaim)
	end
	local profile, status = store:load(player.UserId)
	if status == "error" then
		store:releaseSession(player.UserId, sessionId)
		return nil, "Could not load your campaign. Nothing was changed; try again"
	end
	local state: State? = nil
	if profile then
		state = Campaign.deserialize(profile)
	end
	if not state then
		state = Campaign.new(os.time())
		if profile and type(profile.revision) == "number" then
			state.revision = profile.revision
		end
	end
	local created: Session = { userId = player.UserId, sessionId = sessionId, state = state, activeBattleId = nil, activeScenario = nil, committed = {}, renewAt = os.clock() + 60 }
	session = created
	return created, nil
end

local function checkpoint(player: Player, s: Session, requestId: string): boolean
	local ok, reason = Campaign.checkpoint(store, s.userId, s.sessionId, s.state :: State)
	if not ok then
		sendError(player, requestId, "Could not save the campaign (" .. tostring(reason) .. ")" .. (if store.sessionOnly then "" else "; progress since the last save may be lost"))
	end
	return ok
end

local function onRemote(player: Player, msg: any)
	if type(msg) ~= "table" or type(msg.requestId) ~= "string" or #msg.requestId > 48 or type(msg.action) ~= "string" then
		return
	end
	local requestId: string = msg.requestId
	if not hooks.isCommander(player) then
		sendError(player, requestId, "Only the commander may run the campaign")
		return
	end
	local s, why = ensureSession(player)
	if not s then
		sendError(player, requestId, why or "Campaign unavailable")
		return
	end
	local state = s.state :: State
	local action = msg.action
	local data = if type(msg.data) == "table" then msg.data else {}
	if action == "open" or action == "return" then
		sendView(player, s)
	elseif action == "new" then
		local fresh = Campaign.new(os.time())
		fresh.revision = state.revision
		s.state = fresh
		s.activeBattleId = nil
		s.activeScenario = nil
		s.committed = {}
		checkpoint(player, s, requestId)
		sendView(player, s)
	elseif action == "command" then
		if s.activeBattleId then
			sendError(player, requestId, "Finish the pending battle first")
			return
		end
		local cmd: Campaign.Command = { kind = tostring(data.kind), armyId = if type(data.armyId) == "number" then data.armyId else nil, regionId = if type(data.regionId) == "string" then data.regionId else nil, unitType = if type(data.unitType) == "string" then data.unitType else nil }
		local ok, reason = Campaign.command(state, cmd)
		if not ok then
			sendError(player, requestId, reason or "Not allowed")
		elseif cmd.kind == "endTurn" or cmd.kind == "restart" then
			checkpoint(player, s, requestId)
		end
		sendView(player, s)
	elseif action == "battle" then
		local pending = state.pendingBattles[1]
		if not pending then
			sendError(player, requestId, "No battle is pending")
			return
		end
		local scenario = Campaign.battleScenario(state, pending.battleId)
		if not scenario then
			sendError(player, requestId, "Could not build the battle")
			return
		end
		if not checkpoint(player, s, requestId) and not store.sessionOnly then
			return
		end
		s.activeBattleId = pending.battleId
		s.activeScenario = scenario
		hooks.startBattle(scenario, pending.battleId)
		sendView(player, s)
	elseif action == "skip" then
		local pending = state.pendingBattles[1]
		if not pending then
			sendError(player, requestId, "No battle is pending")
			return
		end
		local ok, reason = Campaign.autoResolve(state, pending.battleId)
		if not ok then
			sendError(player, requestId, reason or "Could not resolve the battle")
		else
			checkpoint(player, s, requestId)
		end
		sendView(player, s)
	else
		sendError(player, requestId, "Unknown campaign action")
	end
end

-- Called by the match layer once, when a campaign battle reaches results.
function CampaignService.onBattleEnded(battleId: string, scenario: Scenarios.Scenario, results: Types.Results, formations: { [number]: any }): (boolean, string?)
	local s = session
	if not s or s.activeBattleId ~= battleId or not s.state then
		return false, "no active campaign battle"
	end
	if s.committed[battleId] then
		return true, "alreadyApplied"
	end
	local survivors: { [string]: Campaign.Survivor } = {}
	for i, def in scenario.units do
		local f = formations[i]
		if def.key and f then
			survivors[def.key] = { strength = f.strength :: number, experience = f.experience :: number, destroyed = f.state == "destroyed" or f.state == "exited" }
		end
	end
	local ok, newState, reason = Campaign.commitBattle(store, s.userId, s.sessionId, s.state :: State, battleId, results, survivors)
	if ok and newState then
		s.state = newState
		s.committed[battleId] = true
		s.activeBattleId = nil
		s.activeScenario = nil
	elseif reason == "stale" or reason == "notOwner" or reason == "campaignMismatch" then
		-- Resume from the stored checkpoint; the battle stays pending there.
		local profile, status = store:load(s.userId)
		if status == "ok" and profile then
			s.state = Campaign.deserialize(profile) or s.state
		end
		s.activeBattleId = nil
		s.activeScenario = nil
	end
	local player = Players:GetPlayerByUserId(s.userId)
	if player then
		if not ok then
			sendError(player, "battle-end", "Battle result not saved (" .. tostring(reason) .. ")")
		end
		sendView(player, s)
	end
	return ok, reason
end

function CampaignService.isBattleCommitted(battleId: string): boolean
	local s = session
	return s ~= nil and s.committed[battleId] == true
end

function CampaignService.activeBattle(): (string?, Scenarios.Scenario?)
	local s = session
	if s then
		return s.activeBattleId, s.activeScenario
	end
	return nil, nil
end

local function onPlayerRemoving(player: Player)
	local s = session
	if s and s.userId == player.UserId then
		store:releaseSession(s.userId, s.sessionId)
		session = nil
	end
end

function CampaignService.start(campaignRemote: RemoteEvent, h: Hooks)
	remote = campaignRemote
	hooks = h
	store = ProfileStore.new({ name = "EoE", scope = if RunService:IsStudio() then "dev" else "live", dataStoreService = DataStoreService })
	remote.OnServerEvent:Connect(onRemote)
	Players.PlayerRemoving:Connect(onPlayerRemoving)
	RunService.Heartbeat:Connect(function()
		local s = session
		if s and os.clock() >= s.renewAt then
			s.renewAt = os.clock() + 60
			store:claimSession(s.userId, s.sessionId, os.time())
		end
	end)
end

function CampaignService.sessionOnly(): boolean
	return store ~= nil and store.sessionOnly
end

return CampaignService
]]></ProtectedString></Properties></Item><Item class="Script" referent="RBX00000015"><Properties><bool name="Disabled">false</bool><string name="Name">Main</string><token name="RunContext">0</token><ProtectedString name="Source"><![CDATA[--!strict
-- Server entry point.
require(script.Parent.MatchService).start()
]]></ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX00000016"><Properties><bool name="Disabled">false</bool><string name="Name">MatchService</string><ProtectedString name="Source"><![CDATA[--!strict
-- Match lifecycle, commander ownership, request handling, the server loop and replication.
-- One match per server. Everything the sim decides stays in Sim; this file only adapts it to
-- Roblox services and players.

local Players = game:GetService("Players")
local RunService = game:GetService("RunService")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Shared = ReplicatedStorage:WaitForChild("EoE")
local Config = require(Shared.Config)
local Protocol = require(Shared.Protocol)
local MapGen = require(Shared.MapGen)
local Scenarios = require(Shared.Scenarios)

local Sim = require(script.Parent.Sim)
local AI = require(script.Parent.AI)
local Remotes = require(script.Parent.Net.Remotes)
local CommandGate = require(script.Parent.Net.CommandGate)
local MatchClock = require(script.Parent.Net.MatchClock)
local CampaignService = require(script.Parent.CampaignService)

type Sim = Sim.Sim

export type MatchState = "menu" | "loading" | "deployment" | "running" | "paused" | "results"

type Match = {
	id: string,
	sim: Sim,
	ai: any,
	clock: MatchClock.Clock,
	scenario: Scenarios.Scenario,
	state: MatchState,
	difficulty: string,
	ticksSincePublish: number,
	ticksSinceKeyframe: number,
	pausedPublishTimer: number,
	devTimer: number,
	leftAt: number?, -- os.clock() when the commander left
	campaignBattleId: string?,
}

local MatchService = {}

local remotes: { [string]: RemoteEvent }
local gate = CommandGate.new()
local match: Match? = nil
local commanderUserId: number? = nil
local difficulty = "normal"
local mapCache: { [string]: MapGen.MapData } = {}
local matchCounter = 0
local heartbeat: RBXScriptConnection? = nil
local devView = RunService:IsStudio()

local function mapFor(id: string): MapGen.MapData
	local m = mapCache[id]
	if not m then
		m = MapGen.generate(id)
		mapCache[id] = m
	end
	return m
end

local function playerFaction(m: Match?): string
	return if m then m.scenario.factions.player else "france"
end

local function isCommander(player: Player): boolean
	return commanderUserId == player.UserId
end

local function matchStatePayload(player: Player)
	local m = match
	return {
		matchId = if m then m.id else "",
		state = if m then m.state else "menu",
		scenario = if m
			then {
				id = m.scenario.id,
				name = m.scenario.name,
				briefing = m.scenario.briefing,
				map = m.scenario.map,
				factions = m.scenario.factions,
				factionNames = m.scenario.factionNames,
				timeLimit = m.sim.timeLimit,
				date = (m.scenario :: any).date,
				summary = (m.scenario :: any).summary,
				weather = m.sim.weather,
				difficultyNote = (m.scenario :: any).difficultyNote,
			}
			else nil,
		viewerFaction = playerFaction(m),
		isCommander = isCommander(player),
		difficulty = if m then m.difficulty else difficulty,
		speed = if m then m.clock.speed else 1,
		results = if m then m.sim.result else nil,
		reason = if m and m.sim.result then m.sim.result.reason else nil,
		campaignAvailable = true,
		campaignSessionOnly = CampaignService.sessionOnly(),
		campaignBattle = if m and m.campaignBattleId then { battleId = m.campaignBattleId, name = m.scenario.name } else nil,
	}
end

local function broadcastState()
	for _, p in Players:GetPlayers() do
		remotes.MatchState:FireClient(p, matchStatePayload(p))
	end
end

local function sendSnapshot(player: Player, full: boolean)
	local m = match
	if not m then
		return
	end
	local snap = m.sim:snapshot(playerFaction(m), full)
	snap.speed = m.clock.speed
	snap.simLag = m.clock.simLag
	snap.state = m.state
	remotes.Snapshot:FireClient(player, snap)
end

local function publish(full: boolean)
	local m = match
	if not m then
		return
	end
	-- Delta tracking in Sim is per viewer faction, so publish once per faction then fan out.
	local players = Players:GetPlayers()
	if #players == 0 then
		m.sim:clearEvents()
		return
	end
	local snap = m.sim:snapshot(playerFaction(m), full)
	snap.speed = m.clock.speed
	snap.simLag = m.clock.simLag
	snap.state = m.state
	for _, p in players do
		remotes.Snapshot:FireClient(p, snap)
	end
	m.sim:clearEvents()
end

local function destroyMatch()
	local m = match
	if m then
		m.sim.aiStep = nil
	end
	match = nil
end

local function createMatchFrom(scenario: Scenarios.Scenario, campaignBattleId: string?)
	local map = mapFor(scenario.map)
	matchCounter += 1
	local id = string.format("m%d-%d", os.time() % 100000, matchCounter)
	local sim = Sim.new({ matchId = id, scenario = scenario, map = map, seed = os.time() + matchCounter * 7919, difficulty = difficulty })
	local ai = AI.new(sim, scenario.factions.enemy, difficulty)
	sim.aiStep = function(_s)
		AI.step(ai)
	end
	match = {
		id = id,
		sim = sim,
		ai = ai,
		clock = MatchClock.new(),
		scenario = scenario,
		state = "deployment",
		difficulty = difficulty,
		ticksSincePublish = 0,
		ticksSinceKeyframe = 0,
		pausedPublishTimer = 0,
		devTimer = 0,
		leftAt = nil,
		campaignBattleId = campaignBattleId,
	}
end

local function createMatch(scenarioId: string)
	createMatchFrom(Scenarios.get(scenarioId) or Scenarios.jena, nil)
end

local function result(player: Player, requestId: string, accepted: boolean, reason: string?, effectiveTick: number?)
	remotes.CommandResult:FireClient(player, { requestId = requestId, accepted = accepted, reason = reason, effectiveTick = effectiveTick })
end

local function onControl(player: Player, msg: any)
	local m = match
	local ok, reason = Protocol.validateControl(msg, { matchId = if m then m.id else "" })
	if not ok then
		if type(msg) == "table" and type(msg.requestId) == "string" then
			result(player, msg.requestId, false, reason)
		end
		return
	end
	local gok, greason = CommandGate.check(gate, player.UserId, "ctl:" .. msg.requestId, os.clock())
	if not gok then
		result(player, msg.requestId, false, greason)
		return
	end
	local action = msg.action
	print(string.format("[EoE server] control %s from %s (commander=%s)", tostring(action), player.Name, tostring(isCommander(player))))
	if action == "spectate" then
		remotes.MatchState:FireClient(player, matchStatePayload(player))
		if m then
			sendSnapshot(player, true)
		end
		result(player, msg.requestId, true)
		return
	end
	-- Claim command: the first player to start a match becomes commander for the server.
	if commanderUserId == nil or Players:GetPlayerByUserId(commanderUserId) == nil then
		commanderUserId = player.UserId
	end
	if not isCommander(player) then
		result(player, msg.requestId, false, Protocol.Reasons.notCommander)
		return
	end
	if action == "difficulty" then
		difficulty = msg.value
		if m and m.state == "deployment" then
			m.difficulty = difficulty
			m.sim.difficulty = difficulty
			m.ai = AI.new(m.sim, m.scenario.factions.enemy, difficulty)
			local ai = m.ai
			m.sim.aiStep = function(_s)
				AI.step(ai)
			end
		end
		result(player, msg.requestId, true)
		broadcastState()
	elseif action == "start" or action == "restart" then
		if action == "restart" and m and m.campaignBattleId then
			-- A campaign battle can be refought only while its result has not been committed.
			if CampaignService.isBattleCommitted(m.campaignBattleId) then
				result(player, msg.requestId, false, Protocol.Reasons.badState)
				return
			end
			local scenario, battleId = m.scenario, m.campaignBattleId
			destroyMatch()
			createMatchFrom(scenario, battleId)
		else
			local scenarioId = if type(msg.value) == "string" then msg.value elseif m then m.scenario.id else "jena"
			destroyMatch()
			createMatch(scenarioId)
		end
		result(player, msg.requestId, true)
		broadcastState()
		publish(true)
	elseif action == "ready" then
		if m and m.state == "deployment" then
			m.sim:start()
			m.state = "running"
			m.clock.paused = false
			result(player, msg.requestId, true)
			broadcastState()
			publish(true)
		else
			result(player, msg.requestId, false, Protocol.Reasons.badState)
		end
	elseif action == "pause" or action == "resume" then
		if m and (m.state == "running" or m.state == "paused") then
			m.state = if action == "pause" then "paused" else "running"
			m.clock.paused = m.state == "paused"
			result(player, msg.requestId, true)
			broadcastState()
		else
			result(player, msg.requestId, false, Protocol.Reasons.badState)
		end
	elseif action == "speed" then
		if m and MatchClock.setSpeed(m.clock, msg.value) then
			result(player, msg.requestId, true)
			broadcastState()
		else
			result(player, msg.requestId, false, Protocol.Reasons.badRequest)
		end
	elseif action == "quit" then
		destroyMatch()
		result(player, msg.requestId, true)
		broadcastState()
	end
end

local function onCommand(player: Player, cmd: any)
	local m = match
	if not m then
		if type(cmd) == "table" and type(cmd.requestId) == "string" then
			result(player, cmd.requestId, false, Protocol.Reasons.badState)
		end
		return
	end
	local sim = m.sim
	local faction = playerFaction(m)
	local ctx: Protocol.ValidateContext = {
		matchId = m.id,
		state = m.state,
		mapWidth = sim.map.width,
		mapDepth = sim.map.depth,
		isOwned = function(id: number): boolean
			local f = sim.formations[id]
			return f ~= nil and f.faction == faction and isCommander(player)
		end,
		classOf = function(id: number): string?
			local f = sim.formations[id]
			return if f then f.class else nil
		end,
		legalShapes = function(id: number): { [string]: boolean }?
			local f = sim.formations[id]
			return if f then (Config.Units :: any)[f.class].legalShapes else nil
		end,
	}
	local ok, reason = Protocol.validateCommand(cmd, ctx)
	if not ok then
		if type(cmd) == "table" and type(cmd.requestId) == "string" then
			result(player, cmd.requestId, false, if not isCommander(player) then Protocol.Reasons.notCommander else reason)
		end
		return
	end
	local gok, greason = CommandGate.check(gate, player.UserId, cmd.requestId, os.clock())
	if not gok then
		result(player, cmd.requestId, false, greason)
		return
	end
	if cmd.kind == "Deploy" then
		local dok, dreason = sim:deploy(cmd.ids[1], cmd.data.pos, cmd.data.heading)
		result(player, cmd.requestId, dok, if dok then nil else (Protocol.Reasons :: any)[dreason or "badRequest"] or dreason)
		if dok then
			publish(false)
		end
		return
	end
	local pok, preason = sim:precheck(cmd)
	if not pok then
		result(player, cmd.requestId, false, (Protocol.Reasons :: any)[preason or "badRequest"] or preason)
		return
	end
	local _seq, effectiveTick = sim:queueCommand(cmd, faction)
	result(player, cmd.requestId, true, nil, effectiveTick)
end

local function onHeartbeat(realDt: number)
	local m = match
	if not m then
		return
	end
	if m.state == "running" then
		local ticks = MatchClock.advance(m.clock, realDt, function()
			m.sim:step()
		end)
		m.ticksSincePublish += ticks
		m.ticksSinceKeyframe += ticks
		if m.sim.state == "ended" then
			m.state = "results"
			m.clock.paused = true
			publish(true)
			if m.campaignBattleId and m.sim.result then
				-- Exactly-once commit happens inside CampaignService (idempotent by battle id).
				CampaignService.onBattleEnded(m.campaignBattleId, m.scenario, m.sim.result, m.sim.formations)
			end
			broadcastState()
			return
		end
		if m.ticksSincePublish >= Config.Sim.SnapshotEveryTicks then
			m.ticksSincePublish = 0
			local keyframe = m.ticksSinceKeyframe >= 100
			if keyframe then
				m.ticksSinceKeyframe = 0
			end
			publish(keyframe)
		end
	elseif m.state == "paused" or m.state == "deployment" then
		-- Orders accepted while paused change dest/shape ghosts: publish deltas at 2 Hz.
		m.pausedPublishTimer += realDt
		if m.pausedPublishTimer >= 0.5 then
			m.pausedPublishTimer = 0
			publish(false)
		end
	end
	if devView and m.ai then
		m.devTimer += realDt
		if m.devTimer >= 1 then
			m.devTimer = 0
			local commander = if commanderUserId then Players:GetPlayerByUserId(commanderUserId) else nil
			if commander then
				remotes.Debug:FireClient(commander, { aiGoals = AI.debugView(m.ai) })
			end
		end
	end
	-- Commander departure: pause, then reset after the grace period.
	if m.leftAt and os.clock() - m.leftAt > Config.Match.ReconnectGrace then
		destroyMatch()
		commanderUserId = nil
		broadcastState()
	end
end

local function onPlayerAdded(player: Player)
	-- The first player present is the commander; later joiners spectate until they leave.
	if commanderUserId == nil or Players:GetPlayerByUserId(commanderUserId) == nil then
		commanderUserId = player.UserId
	end
	if commanderUserId == player.UserId then
		local m = match
		if m then
			m.leftAt = nil
		end
	end
	print(string.format("[EoE server] player %s (%d) joined; commander=%s", player.Name, player.UserId, tostring(isCommander(player))))
	remotes.MatchState:FireClient(player, matchStatePayload(player))
	if match then
		sendSnapshot(player, true)
	end
end

local function onPlayerRemoving(player: Player)
	CommandGate.forget(gate, player.UserId)
	local m = match
	if m and isCommander(player) then
		if m.state == "running" then
			m.state = "paused"
			m.clock.paused = true
		end
		m.leftAt = os.clock()
		broadcastState()
	elseif not m and isCommander(player) then
		-- No match in progress: hand command to whoever is still here.
		commanderUserId = nil
		for _, p in Players:GetPlayers() do
			if p ~= player then
				commanderUserId = p.UserId
				break
			end
		end
		broadcastState()
	end
end

function MatchService.start()
	remotes = Remotes.create()
	Players.CharacterAutoLoads = false
	remotes.Control.OnServerEvent:Connect(onControl)
	remotes.Command.OnServerEvent:Connect(onCommand)
	Players.PlayerAdded:Connect(onPlayerAdded)
	Players.PlayerRemoving:Connect(onPlayerRemoving)
	for _, p in Players:GetPlayers() do
		onPlayerAdded(p)
	end
	if heartbeat then
		heartbeat:Disconnect()
	end
	heartbeat = RunService.Heartbeat:Connect(onHeartbeat)
	print("[EoE server] match service started")
	CampaignService.start(remotes.Campaign, {
		isCommander = function(player: Player): boolean
			if commanderUserId == nil or Players:GetPlayerByUserId(commanderUserId) == nil then
				commanderUserId = player.UserId
			end
			return isCommander(player)
		end,
		startBattle = function(scenario: Scenarios.Scenario, battleId: string)
			destroyMatch()
			createMatchFrom(scenario, battleId)
			broadcastState()
			publish(true)
		end,
	})
end

-- Exposed for tests / tooling.
MatchService._internal = { createMatch = createMatch, destroyMatch = destroyMatch, getMatch = function()
	return match
end }

return MatchService
]]></ProtectedString></Properties></Item><Item class="Folder" referent="RBX00000020"><Properties><string name="Name">Net</string></Properties><Item class="ModuleScript" referent="RBX00000017"><Properties><bool name="Disabled">false</bool><string name="Name">CommandGate</string><ProtectedString name="Source"><![CDATA[--!strict
-- Per-player request gate: rate limiting and request-id de-duplication. Pure Luau; the
-- caller injects real elapsed time (never the paused battle clock).

local Shared = game:GetService("ReplicatedStorage"):WaitForChild("EoE")
local Config = require(Shared.Config)
local Protocol = require(Shared.Protocol)

export type PlayerGate = {
	stamps: { number }, -- recent request times (ring)
	head: number,
	seen: { [string]: boolean },
	seenOrder: { string },
	seenHead: number,
}

export type Gate = { players: { [any]: PlayerGate } }

local CommandGate = {}

local WINDOW = Config.Net.RequestsPerSecond
local DEDUPE = Config.Net.DedupeWindow

function CommandGate.new(): Gate
	return { players = {} }
end

local function playerGate(gate: Gate, key: any): PlayerGate
	local pg = gate.players[key]
	if not pg then
		pg = { stamps = table.create(WINDOW, -math.huge), head = 1, seen = {}, seenOrder = table.create(DEDUPE, ""), seenHead = 1 }
		gate.players[key] = pg
	end
	return pg
end

-- Returns ok, reason. Records the request when accepted.
function CommandGate.check(gate: Gate, key: any, requestId: string, now: number): (boolean, string?)
	local pg = playerGate(gate, key)
	if pg.seen[requestId] then
		return false, Protocol.Reasons.duplicate
	end
	-- Sliding window: the oldest of the last WINDOW requests must be more than 1 s ago.
	local oldest = pg.stamps[pg.head]
	if now - oldest < 1 then
		return false, Protocol.Reasons.rateLimited
	end
	pg.stamps[pg.head] = now
	pg.head = pg.head % WINDOW + 1
	-- Remember the id (bounded).
	local evict = pg.seenOrder[pg.seenHead]
	if evict ~= "" then
		pg.seen[evict] = nil
	end
	pg.seenOrder[pg.seenHead] = requestId
	pg.seen[requestId] = true
	pg.seenHead = pg.seenHead % DEDUPE + 1
	return true, nil
end

function CommandGate.forget(gate: Gate, key: any)
	gate.players[key] = nil
end

return CommandGate
]]></ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX00000018"><Properties><bool name="Disabled">false</bool><string name="Name">MatchClock</string><ProtectedString name="Source"><![CDATA[--!strict
-- Real time → logical ticks. Speed scales the accumulator, never the step. Work per frame is
-- bounded; sustained overload shows up as simLag instead of a giant step.

local Shared = game:GetService("ReplicatedStorage"):WaitForChild("EoE")
local Config = require(Shared.Config)

export type Clock = {
	speed: number,
	paused: boolean,
	accumulator: number,
	simLag: number, -- seconds of simulation owed but not yet run
}

local MatchClock = {}

local DT = Config.Sim.DT
local MAX_TICKS = Config.Sim.MaxTicksPerFrame
local MAX_DEBT = 2.0 -- seconds; beyond this we drop time rather than spiral

function MatchClock.new(): Clock
	return { speed = 1, paused = false, accumulator = 0, simLag = 0 }
end

function MatchClock.setSpeed(clock: Clock, speed: number): boolean
	for _, s in Config.Sim.Speeds do
		if s == speed then
			clock.speed = speed
			return true
		end
	end
	return false
end

-- Advance by realDt seconds; calls step() for each logical tick run. Returns ticks run.
function MatchClock.advance(clock: Clock, realDt: number, step: () -> ()): number
	if clock.paused then
		clock.accumulator = 0
		return 0
	end
	clock.accumulator += math.max(0, realDt) * clock.speed
	if clock.accumulator > MAX_DEBT then
		clock.accumulator = MAX_DEBT
	end
	local ticks = math.floor(clock.accumulator / DT)
	if ticks > MAX_TICKS then
		ticks = MAX_TICKS
	end
	for _ = 1, ticks do
		step()
	end
	clock.accumulator -= ticks * DT
	clock.simLag = math.max(0, clock.accumulator - DT)
	return ticks
end

return MatchClock
]]></ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX00000019"><Properties><bool name="Disabled">false</bool><string name="Name">Remotes</string><ProtectedString name="Source"><![CDATA[--!strict
-- Creates the RemoteEvents under ReplicatedStorage/EoE/Remotes (server only).

local ReplicatedStorage = game:GetService("ReplicatedStorage")
local Shared = ReplicatedStorage:WaitForChild("EoE")
local Protocol = require(Shared.Protocol)

local Remotes = {}

function Remotes.create(): { [string]: RemoteEvent }
	local folder: Instance? = Shared:FindFirstChild("Remotes")
	if not folder then
		local f = Instance.new("Folder")
		f.Name = "Remotes"
		f.Parent = Shared
		folder = f
	end
	local parent = folder :: Instance
	local out: { [string]: RemoteEvent } = {}
	for _, name in pairs(Protocol.Remotes :: { [string]: string }) do
		local r: Instance? = parent:FindFirstChild(name)
		if not r then
			local e = Instance.new("RemoteEvent")
			e.Name = name
			e.Parent = parent
			r = e
		end
		out[name] = r :: RemoteEvent
	end
	return out
end

return Remotes
]]></ProtectedString></Properties></Item></Item><Item class="Folder" referent="RBX00000022"><Properties><string name="Name">Persist</string></Properties><Item class="ModuleScript" referent="RBX00000021"><Properties><bool name="Disabled">false</bool><string name="Name">ProfileStore</string><ProtectedString name="Source"><![CDATA[--!strict
-- Versioned profile store on top of DataStoreService.UpdateAsync. Pure Luau; the DataStore
-- service is injected so tests run in the CLI with the memory adapter.
--
-- Contract:
--   * `load` never returns a default on failure: status "error" means "do not touch this user".
--   * `update` runs a pure, retry-safe mutate inside UpdateAsync (the callback may run more than
--     once); it rejects when the stored revision differs from `expectedRevision` ("stale") and
--     bumps `revision` on every successful write.
--   * `claimSession`/`releaseSession` implement single-writer ownership with a timeout so a crashed
--     server never locks a profile forever. `now` is injected (no wall clock here).
--   * The memory adapter marks the store `sessionOnly = true`: data lives for this server only.
--     Callers must surface that, never claim durability.

export type Profile = { [string]: any }
export type Mutate = (Profile?) -> (Profile?, string?)

export type Store = {
	name: string,
	scope: string,
	sessionOnly: boolean,
	sleep: (number) -> (),
	maxRetries: number,
	backoff: number,
	sessionTimeout: number,
	ds: any,
	load: (Store, number) -> (Profile?, string),
	update: (Store, number, number?, Mutate) -> (boolean, Profile?, string?),
	claimSession: (Store, number, string, number) -> (boolean, string?),
	releaseSession: (Store, number, string) -> (boolean, string?),
}

local ProfileStore = {}
ProfileStore.__index = ProfileStore

-- Deep copy that only accepts what a DataStore can hold (plain tables, strings, finite numbers,
-- booleans). Used by the memory adapter so in-memory behaviour matches serialisation.
local function clone(v: any, depth: number?): any
	local t = type(v)
	if t == "table" then
		local d = (depth or 0) + 1
		if d > 32 or getmetatable(v) ~= nil then
			error("unserialisable value")
		end
		local out = {}
		for k, x in v do
			local kt = type(k)
			if kt ~= "string" and kt ~= "number" then
				error("unserialisable key")
			end
			out[k] = clone(x, d)
		end
		return out
	elseif t == "number" then
		if v ~= v or v == math.huge or v == -math.huge then
			error("non-finite number")
		end
		return v
	elseif t == "string" or t == "boolean" or t == "nil" then
		return v
	end
	error("unserialisable value of type " .. t)
end
ProfileStore.clone = clone

local function memoryAdapter()
	local data: { [string]: any } = {}
	return {
		GetAsync = function(_, key: string)
			return clone(data[key])
		end,
		UpdateAsync = function(_, key: string, fn: (any) -> any)
			local new = fn(clone(data[key]))
			if new ~= nil then
				data[key] = clone(new)
			end
			return clone(new)
		end,
	}
end

local function isProfile(v: any): boolean
	return type(v) == "table" and type(v.version) == "number" and type(v.revision) == "number"
end

function ProfileStore.new(opts: { name: string, scope: "live" | "dev", dataStoreService: any?, sleep: ((number) -> ())?, maxRetries: number?, backoff: number?, sessionTimeout: number? }): Store
	local self: any = setmetatable({}, ProfileStore)
	self.name = opts.name
	self.scope = opts.scope
	self.sleep = opts.sleep or task.wait
	self.maxRetries = opts.maxRetries or 3
	self.backoff = opts.backoff or 1
	self.sessionTimeout = opts.sessionTimeout or 300
	self.sessionOnly = false
	local svc = opts.dataStoreService
	local ok, ds = false, nil
	if svc ~= nil then
		ok, ds = pcall(function()
			return svc:GetDataStore(opts.name .. "/" .. opts.scope)
		end)
	end
	if ok and ds ~= nil then
		self.ds = ds
	else
		self.ds = memoryAdapter()
		self.sessionOnly = true
	end
	return self
end

local function key(userId: number): string
	return "u" .. tostring(userId)
end

-- Retries fn (which may throw) with exponential backoff. Returns (ok, result).
local function withRetry(self: Store, fn: () -> any): (boolean, any)
	local lastErr: any = nil
	for attempt = 0, self.maxRetries do
		if attempt > 0 then
			self.sleep(self.backoff * 2 ^ (attempt - 1))
		end
		local ok, res = pcall(fn)
		if ok then
			return true, res
		end
		lastErr = res
	end
	return false, lastErr
end

function ProfileStore.load(self: Store, userId: number): (Profile?, string)
	local ok, res = withRetry(self, function()
		return self.ds:GetAsync(key(userId))
	end)
	if not ok then
		return nil, "error"
	end
	if res == nil then
		return nil, "empty"
	end
	if not isProfile(res) then
		return nil, "error" -- corrupt: refuse rather than overwrite
	end
	return res, "ok"
end

function ProfileStore.update(self: Store, userId: number, expectedRevision: number?, mutate: Mutate): (boolean, Profile?, string?)
	local reason: string? = nil
	local seen: any = nil
	local ok, res = withRetry(self, function()
		reason = nil
		return self.ds:UpdateAsync(key(userId), function(old: any): any
			-- Pure section: no side effects, may run several times.
			if old ~= nil and not isProfile(old) then
				reason = "corrupt"
				return nil
			end
			seen = old
			local stored = if old then old.revision else 0
			if expectedRevision ~= nil and stored ~= expectedRevision then
				reason = "stale"
				return nil
			end
			local new, why = mutate(old)
			if new == nil then
				reason = why or "cancelled"
				return nil
			end
			new.version = new.version or 1
			new.revision = stored + 1
			return new
		end)
	end)
	if not ok then
		return false, nil, "error"
	end
	if res == nil then
		return false, seen, reason or "cancelled"
	end
	return true, res, nil
end

function ProfileStore.claimSession(self: Store, userId: number, sessionId: string, now: number): (boolean, string?)
	local ok, _, reason = ProfileStore.update(self, userId, nil, function(old: Profile?): (Profile?, string?)
		local p: Profile = old or { version = 1, revision = 0 }
		local s = p.session
		if type(s) == "table" and s.id ~= sessionId and type(s.expires) == "number" and s.expires > now then
			return nil, "locked"
		end
		p.session = { id = sessionId, expires = now + self.sessionTimeout }
		return p, nil
	end)
	return ok, reason
end

function ProfileStore.releaseSession(self: Store, userId: number, sessionId: string): (boolean, string?)
	local ok, _, reason = ProfileStore.update(self, userId, nil, function(old: Profile?): (Profile?, string?)
		if old == nil or type(old.session) ~= "table" or old.session.id ~= sessionId then
			return nil, "notOwner"
		end
		old.session = nil
		return old, nil
	end)
	return ok, reason
end

return ProfileStore
]]></ProtectedString></Properties></Item></Item><Item class="ModuleScript" referent="RBX00000030"><Properties><bool name="Disabled">false</bool><string name="Name">Sim</string><ProtectedString name="Source"><![CDATA[--!strict
-- The authoritative battle simulation. Pure Luau: no Roblox APIs, no wall-clock time.
-- Owns formations, commands, the fixed tick, visibility, objectives, victory and snapshots.
-- Tick order is documented in docs/architecture.md and implemented in Sim:step().

local Shared = game:GetService("ReplicatedStorage"):WaitForChild("EoE")
local Config = require(Shared.Config)
local Vec = require(Shared.Vec)
local RNG = require(Shared.RNG)
local Grid = require(Shared.Grid)
local MapGen = require(Shared.MapGen)
local Scenarios = require(Shared.Scenarios)
local Types = require(Shared.Types)

local Formation = require(script.Formation)
local Nav = require(script.Nav)
local Movement = require(script.Movement)
local Combat = require(script.Combat)
local Morale = require(script.Morale)
local Visibility = require(script.Visibility)
local Objectives = require(script.Objectives)

type Vec = Vec.Vec
type Formation = Formation.Formation

export type Options = {
	matchId: string,
	scenario: Scenarios.Scenario,
	map: MapGen.MapData,
	seed: number,
	difficulty: string?,
	timeLimit: number?,
}

export type QueuedCommand = {
	matchId: string,
	requestId: string,
	kind: string,
	ids: { number },
	data: { [string]: any }?,
	seq: number,
	effectiveTick: number,
	faction: string,
}

export type Sim = {
	matchId: string,
	scenario: Scenarios.Scenario,
	map: MapGen.MapData,
	grid: Grid.Grid,
	nav: Nav.NavGrid,
	rng: RNG.RNG,
	seed: number,
	tick: number,
	clock: number,
	timeLimit: number,
	state: "deployment" | "running" | "ended",
	formations: { [number]: Formation },
	order: { number },
	factions: { string },
	playerFaction: string,
	enemyFaction: string,
	views: { [string]: Visibility.FactionView },
	objectives: { Objectives.ObjectiveState },
	commands: { QueuedCommand },
	seqCounter: number,
	events: { Types.Event },
	logLines: { string },
	deployed: { [string]: number },
	stats: { [string]: any },
	result: Types.Results?,
	winner: string?,
	lastSent: { [string]: { [number]: string } },
	difficulty: string,
	-- hooks implemented below
	emit: (Sim, Types.Event) -> (),
	log: (Sim, string) -> (),
	homeEdge: (Sim, string) -> Vec,
	findFormation: (Sim, number) -> Formation?,
	isVisibleTo: (Sim, string, number) -> boolean,
	hqOf: (Sim, string) -> Formation?,
	simLag: number,
	weather: string, -- key into Config.Weather, may change once at weatherUntil
	aiStep: ((Sim) -> ())?, -- per-instance AI hook (preferred over the module-level Sim.aiStep)
	-- methods
	deploy: (Sim, number, Vec, number) -> (boolean, string?),
	start: (Sim) -> (),
	precheck: (Sim, Types.Command) -> (boolean, string?),
	queueCommand: (Sim, Types.Command, string) -> (number, number),
	step: (Sim) -> (),
	snapshot: (Sim, string, boolean) -> Types.Snapshot,
	clearEvents: (Sim) -> (),
	buildResults: (Sim, string, string) -> Types.Results,
}

local Sim = {}
Sim.__index = Sim

local DT = Config.Sim.DT

function Sim.new(opts: Options): Sim
	local self: any = setmetatable({}, Sim)
	self.matchId = opts.matchId
	self.scenario = opts.scenario
	self.map = opts.map
	self.grid = opts.map.grid
	self.nav = Nav.build(opts.map.grid)
	self.seed = opts.seed
	self.rng = RNG.new(opts.seed)
	self.tick = 0
	self.clock = 0
	self.timeLimit = opts.timeLimit or opts.scenario.timeLimit or Config.Victory.TimeLimitSeconds
	self.state = "deployment"
	self.formations = {}
	self.order = {}
	self.factions = { opts.scenario.factions.player, opts.scenario.factions.enemy }
	self.playerFaction = opts.scenario.factions.player
	self.enemyFaction = opts.scenario.factions.enemy
	self.views = {}
	for _, faction in self.factions do
		self.views[faction] = Visibility.newView()
	end
	self.objectives = Objectives.init(opts.map.objectives)
	self.commands = {}
	self.seqCounter = 0
	self.events = {}
	self.logLines = {}
	self.deployed = {}
	self.stats = {}
	self.result = nil
	self.winner = nil
	self.lastSent = {}
	self.difficulty = opts.difficulty or "normal"
	self.simLag = 0
	self.aiStep = nil
	self.weather = if (Config.Weather :: any)[(opts.scenario :: any).weather] then (opts.scenario :: any).weather else "clear"
	for i, def in opts.scenario.units do
		local f = Formation.fromDef(i, def)
		self.formations[i] = f
		self.order[#self.order + 1] = i
	end
	table.sort(self.order)
	return self
end

-- Hooks used by the submodules ---------------------------------------------------------------

function Sim.emit(self: Sim, ev: Types.Event)
	self.events[#self.events + 1] = ev
end

function Sim.log(self: Sim, text: string)
	local m = math.floor(self.clock / 60)
	local s = math.floor(self.clock % 60)
	self.logLines[#self.logLines + 1] = string.format("%02d:%02d %s", m, s, text)
end

function Sim.findFormation(self: Sim, id: number): Formation?
	return self.formations[id]
end

function Sim.isVisibleTo(self: Sim, viewer: string, id: number): boolean
	return Visibility.isVisibleTo(self :: any, viewer, id)
end

function Sim.hqOf(self: Sim, faction: string): Formation?
	for _, id in self.order do
		local f = self.formations[id]
		if f and f.faction == faction and f.class == "hq" and Formation.isActive(f) then
			return f
		end
	end
	return nil
end

-- A faction's home edge is the map edge nearest its deployment zone.
function Sim.homeEdge(self: Sim, faction: string): Vec
	local zone = self.map.deployZones[faction]
	local margin = Config.Morale.RoutExitMargin + 6
	if zone and (zone.z0 + zone.z1) / 2 > self.map.depth / 2 then
		return { x = (zone.x0 + zone.x1) / 2, z = self.map.depth + margin }
	end
	return { x = if zone then (zone.x0 + zone.x1) / 2 else self.map.width / 2, z = -margin }
end

-- Deployment --------------------------------------------------------------------------------

function Sim.deploy(self: Sim, id: number, pos: Vec, heading: number): (boolean, string?)
	if self.state ~= "deployment" then
		return false, "badState"
	end
	local f = self.formations[id]
	if not f then
		return false, "destroyed"
	end
	if f.state == "offmap" then
		return false, "badState"
	end
	if not MapGen.inZone(self.map, f.faction, pos) then
		return false, "deployZone"
	end
	if not Grid.terrainAt(self.grid, pos.x, pos.z).passable or not Grid.fits(self.grid, pos.x, pos.z, 8) then
		return false, "noSpace"
	end
	for _, oid in self.order do
		local o = self.formations[oid]
		if o and oid ~= id and o.faction == f.faction then
			local minD = o.halfRadius + f.halfRadius + Config.Match.DeploymentMinSpacing
			if Vec.dist2(o.pos, pos) < minD * minD then
				return false, "noSpace"
			end
		end
	end
	f.pos = { x = pos.x, z = pos.z }
	f.heading = Vec.wrapAngle(heading)
	return true, nil
end

function Sim.start(self: Sim)
	if self.state ~= "deployment" then
		return
	end
	self.state = "running"
	for _, faction in self.factions do
		self.deployed[faction] = 0
	end
	for _, id in self.order do
		local f = self.formations[id]
		if f then
			self.deployed[f.faction] += f.strength
			Formation.refreshFootprint(f)
		end
	end
	Visibility.update(self :: any)
	self:log("The battle begins")
end

-- Commands ----------------------------------------------------------------------------------

-- Synchronous legality that the network layer can report immediately.
function Sim.precheck(self: Sim, cmd: Types.Command): (boolean, string?)
	for _, id in cmd.ids do
		local f = self.formations[id]
		if not f then
			return false, "destroyed"
		end
		if cmd.kind ~= "Deploy" then
			local ok, reason = Formation.canTakeOrders(f)
			if not ok then
				return false, reason
			end
			if cmd.kind == "Rally" and f.timers.rallyCd > 0 then
				return false, "cooldown"
			end
		end
	end
	-- Engage/Charge on a target the faction cannot currently see leaks nothing: it is
	-- converted to an attack-move on the last-known position, or refused if there is none.
	if (cmd.kind == "Engage" or cmd.kind == "Charge") and cmd.data and type(cmd.data.targetId) == "number" then
		local f = self.formations[cmd.ids[1]]
		local target = self.formations[cmd.data.targetId]
		if not target or not Formation.isActive(target) then
			return false, "badTarget"
		end
		if f and not self:isVisibleTo(f.faction, target.id) then
			local lk = self.views[f.faction] and self.views[f.faction].lastKnown[target.id]
			if not lk then
				return false, "badTarget"
			end
			cmd.kind = "AttackMove"
			cmd.data = { pos = { x = lk.x, z = lk.z }, queue = cmd.data.queue }
			if f.class == "artillery" then
				return false, "badTarget"
			end
		end
	end
	return true, nil
end

function Sim.queueCommand(self: Sim, cmd: Types.Command, faction: string): (number, number)
	self.seqCounter += 1
	local q: any = table.clone(cmd)
	q.seq = self.seqCounter
	q.effectiveTick = self.tick + Config.Sim.CommandDelayTicks
	q.faction = faction
	self.commands[#self.commands + 1] = q
	return q.seq, q.effectiveTick
end

-- Group move: assign slots along a line perpendicular to the heading, ordered by each
-- formation's current lateral position so units do not cross over.
local function groupSlots(self: Sim, ids: { number }, pos: Vec, heading: number?, frontage: number?): { [number]: Vec }
	local out: { [number]: Vec } = {}
	if #ids == 1 then
		out[ids[1]] = pos
		return out
	end
	local centroid = { x = 0, z = 0 }
	local n = 0
	for _, id in ids do
		local f = self.formations[id]
		if f then
			centroid = Vec.add(centroid, f.pos)
			n += 1
		end
	end
	centroid = Vec.scale(centroid, 1 / math.max(1, n))
	local h = heading or Vec.heading(Vec.sub(pos, centroid))
	local right = Vec.right(Vec.fromHeading(h))
	local sorted = table.clone(ids)
	table.sort(sorted, function(a, b)
		local fa, fb = self.formations[a], self.formations[b]
		return Vec.dot(fa.pos, right) < Vec.dot(fb.pos, right)
	end)
	local total = 0
	for _, id in sorted do
		total += self.formations[id].width + 6
	end
	if frontage and frontage > total then
		total = frontage
	end
	local gap = (total - (function()
		local s = 0
		for _, id in sorted do
			s += self.formations[id].width
		end
		return s
	end)()) / #sorted
	local cursor = -total / 2
	for _, id in sorted do
		local w = self.formations[id].width
		local centre = cursor + gap / 2 + w / 2
		local p = Vec.add(pos, Vec.scale(right, centre))
		p = Vec.clamp(p, 4, 4, self.map.width - 4, self.map.depth - 4)
		out[id] = p
		cursor += w + gap
	end
	return out
end

local function applyOrder(self: Sim, f: Formation, order: Types.Order, queue: boolean)
	if queue and (f.order ~= nil) then
		if #f.queue < Config.Match.MaxQueue then
			f.queue[#f.queue + 1] = order
		end
		return
	end
	f.order = order
	f.queue = {}
	f.path = nil
	f.pathIndex = 1
	f.targetId = order.targetId
	f.timers.stuck = 0
	if f.state == "melee" then
		-- Disengaging: allowed but costs cohesion; combat continues until out of contact.
		f.cohesion = math.max(0.3, f.cohesion - 0.15)
	end
	if order.kind == "Charge" then
		f.state = "charging"
		f.runUp = 0
		f.chargeReady = f.timers.chargeRecover <= 0
	elseif order.kind == "Face" or order.kind == "Hold" then
		if f.state == "moving" or f.state == "charging" then
			f.state = "idle"
		end
	elseif order.kind == "Engage" and f.class == "artillery" then
		f.state = if f.state == "moving" then "idle" else f.state
	else
		if f.state ~= "reforming" then
			f.state = if order.kind == "Retreat" then "retreating" else "moving"
		end
	end
end

local function applyCommand(self: Sim, cmd: QueuedCommand)
	local kind = cmd.kind
	local data: any = cmd.data or {}
	local queue = data.queue == true
	if kind == "Move" or kind == "AttackMove" or kind == "Charge" and data.targetId == nil then
		local slots = groupSlots(self, cmd.ids, data.pos, data.heading, data.frontage)
		for _, id in cmd.ids do
			local f = self.formations[id]
			if f and Formation.canTakeOrders(f) then
				applyOrder(self, f, { kind = kind, pos = slots[id], heading = data.heading, issuedTick = self.tick, anchor = { x = f.pos.x, z = f.pos.z } }, queue)
			end
		end
		return
	end
	for _, id in cmd.ids do
		local f = self.formations[id]
		if f and Formation.canTakeOrders(f) then
			if kind == "Engage" or kind == "Charge" then
				local target = self.formations[data.targetId]
				if target and Formation.isActive(target) and target.faction ~= f.faction then
					applyOrder(self, f, { kind = kind, targetId = target.id, issuedTick = self.tick, anchor = { x = f.pos.x, z = f.pos.z } }, queue)
				else
					self:emit({ kind = "message", tick = self.tick, id = f.id, faction = f.faction, text = f.name .. ": target is gone" })
				end
			elseif kind == "Stop" then
				Formation.clearOrder(f)
			elseif kind == "Hold" then
				applyOrder(self, f, { kind = "Hold", issuedTick = self.tick }, false)
			elseif kind == "Face" then
				applyOrder(self, f, { kind = "Face", heading = Vec.wrapAngle(data.heading), issuedTick = self.tick }, queue)
			elseif kind == "Retreat" then
				local pos = data.pos
				if not pos then
					local home = self:homeEdge(f.faction)
					local dir = Vec.normalize(Vec.sub(home, f.pos))
					pos = Vec.clamp(Vec.add(f.pos, Vec.scale(dir, 200)), 8, 8, self.map.width - 8, self.map.depth - 8)
				end
				f.cohesion = math.max(0.3, f.cohesion - 0.2)
				applyOrder(self, f, { kind = "Retreat", pos = pos, issuedTick = self.tick }, false)
			elseif kind == "Shape" then
				if Formation.legalShapes(f)[data.shape] then
					f.prevShape = nil
					Formation.beginShape(f, data.shape, false)
				end
			elseif kind == "Stance" then
				f.fireAtWill = data.fireAtWill == true
			elseif kind == "Limber" then
				local wantLimbered = data.limbered == true
				if Formation.isLimbered(f) ~= wantLimbered and f.pendingLimber == nil then
					f.pendingLimber = wantLimbered
					f.timers.limber = if wantLimbered then Config.ReformTime.limbered else Config.ReformTime.deployed
					f.state = "reforming"
					f.path = nil
					if wantLimbered then
						f.targetId = nil
					end
				end
			elseif kind == "Ammo" then
				f.ammoMode = data.ammo
			elseif kind == "Rally" then
				Morale.hqRally(self :: any, f)
			end
		end
	end
end

local function applyQueuedCommands(self: Sim)
	if #self.commands == 0 then
		return
	end
	table.sort(self.commands, function(a: QueuedCommand, b: QueuedCommand)
		if a.effectiveTick ~= b.effectiveTick then
			return a.effectiveTick < b.effectiveTick
		end
		return a.seq < b.seq
	end)
	local remaining = {}
	for _, cmd in self.commands do
		if cmd.effectiveTick <= self.tick then
			applyCommand(self, cmd)
		else
			remaining[#remaining + 1] = cmd
		end
	end
	self.commands = remaining
end

-- Attack-move: engage visible enemies met on the way, then resume the march.
-- Infantry halts once a target is in musket range and fires; cavalry charges a target that is not
-- in square (or a battery / routing unit) within its charge reach.
local CAV_REACH = 180
local function autoEngage(self: Sim)
	for _, id in self.order do
		local f = self.formations[id]
		local o = f and f.order
		if f and o and o.kind == "AttackMove" and Formation.isActive(f) and (f.state == "moving" or f.state == "idle" or f.state == "firing") then
			local best: Formation? = nil
			local bestD = math.huge
			for _, eid in self.order do
				local e = self.formations[eid]
				if e and e.faction ~= f.faction and Formation.isActive(e) and self:isVisibleTo(f.faction, eid) then
					local d = Vec.dist(f.pos, e.pos)
					if d < bestD then
						best = e
						bestD = d
					end
				end
			end
			if f.class == "cavalry" then
				if best and bestD <= CAV_REACH and best.shape ~= "square" and f.timers.chargeRecover <= 0 and not f.inWoods then
					local resume = table.clone(o)
					f.order = { kind = "Charge", targetId = best.id, issuedTick = self.tick, anchor = { x = f.pos.x, z = f.pos.z } }
					f.queue = { resume }
					f.path = nil
					f.state = "charging"
					f.runUp = 0
					f.chargeReady = true
				end
			elseif f.class == "infantry" then
				local range = Formation.unitConfig(f).musket.range
				if best and bestD <= range * 0.95 then
					if f.state == "moving" then
						f.path = nil
						f.state = "idle"
						f.targetId = best.id
						-- face the target; the line wheels in place
						f.heading = f.heading + Vec.angleDiff(f.heading, Vec.heading(Vec.sub(best.pos, f.pos))) * 0.5
					end
				elseif f.state == "idle" or f.state == "firing" then
					f.state = "moving" -- nothing in range any more: resume the march
					f.targetId = nil
				end
			end
		end
	end
end

-- Tick ----------------------------------------------------------------------------------------

-- AI hook: assigned by the match layer; called on schedule with the sim.
Sim.aiStep = nil :: ((Sim) -> ())?

function Sim.step(self: Sim)
	if self.state ~= "running" then
		return
	end
	self.tick += 1
	self.clock = self.tick * DT
	local s: any = self
	-- 0. weather clearing, reinforcements entering the field
	local until_ = (self.scenario :: any).weatherUntil
	if self.weather ~= "clear" and type(until_) == "number" and self.clock >= until_ then
		self.weather = "clear"
		self:emit({ kind = "message", tick = self.tick, text = "The weather clears" })
		self:log("Weather cleared")
	end
	for _, id in self.order do
		local f = self.formations[id]
		if f and f.state == "offmap" and f.arrivalTick and f.arrivalTick <= self.tick then
			f.state = "idle"
			f.arrivalTick = nil
			self:emit({ kind = "message", tick = self.tick, id = f.id, faction = f.faction, x = f.pos.x, z = f.pos.z, text = f.name .. " arrives on the field" })
			self:log(f.name .. " arrived")
		end
	end
	-- 1. commands
	applyQueuedCommands(self)
	if self.tick % 5 == 0 then
		autoEngage(self)
	end
	-- 2. AI
	local ai: ((Sim) -> ())? = (self :: any).aiStep or (Sim :: any).aiStep
	if ai and self.tick % Config.AI.DecisionTicks == 0 then
		ai(self)
		applyQueuedCommands(self) -- AI commands stamped for this tick apply now
	end
	-- 3/4. timers, navigation, movement
	for _, id in self.order do
		local f = self.formations[id]
		if f and Formation.isActive(f) then
			Movement.updateTimers(s, f)
		end
	end
	for _, id in self.order do
		local f = self.formations[id]
		if f then
			Movement.update(s, f)
		end
	end
	-- 5. visibility
	if self.tick % Config.Sim.VisibilityEveryTicks == 0 then
		Visibility.update(s)
	end
	-- 6/7. combat
	local attacks = Combat.gather(s)
	Combat.apply(s, attacks)
	-- 8. morale
	for _, id in self.order do
		local f = self.formations[id]
		if f then
			Morale.update(s, f)
		end
	end
	-- 9. objectives
	Objectives.update(s)
	-- 10. victory
	local winner, reason = Objectives.evaluate(s)
	if winner then
		self.state = "ended"
		self.winner = winner
		self.result = (self :: any):buildResults(winner, reason or "")
		self:log("Battle over: " .. (reason or ""))
	end
end

-- Snapshots -----------------------------------------------------------------------------------

local function viewOf(f: Formation, own: boolean): Types.FormationView
	local v: Types.FormationView = {
		id = f.id,
		faction = f.faction,
		name = f.name,
		corps = f.corps,
		class = f.class,
		colour = f.colour,
		x = f.pos.x,
		z = f.pos.z,
		heading = f.heading,
		shape = f.shape,
		state = f.state,
		strength = if own then f.strength else math.floor(f.strength / 50 + 0.5) * 50,
		startStrength = f.startStrength,
		moraleBand = Formation.moraleBandOf(f),
		width = f.width,
		depth = f.depth,
		commander = f.commander,
		experience = f.experience,
	}
	if own then
		v.morale = f.morale
		v.fatigue = f.fatigue
		v.ammo = f.ammo
		v.reload = f.reload
		v.cohesion = f.cohesion
		v.orderKind = if f.order then f.order.kind else nil
		v.targetId = f.targetId
		v.fireAtWill = f.fireAtWill
		v.limbered = if f.class == "artillery" then Formation.isLimbered(f) else nil
		v.status = f.status
		if f.state == "reforming" then
			v.status = "Reforming"
		elseif f.state == "routing" then
			v.status = "Routing"
		elseif f.state == "rallying" then
			v.status = "Rallying"
		elseif f.fatigue > Config.Morale.FatigueThreshold then
			v.status = v.status or "Exhausted"
		elseif f.hitSide then
			v.status = "Flanked"
		end
		v.rallyCd = if f.class == "hq" then f.timers.rallyCd else nil
		if f.order and f.order.pos then
			v.dest = f.order.pos
			v.destHeading = f.order.heading
		end
		v.ammoMode = if f.class == "artillery" then f.ammoMode else nil
		if #f.queue > 0 then
			local q = {}
			for _, o in f.queue do
				if o.pos then
					q[#q + 1] = o.pos
				end
			end
			v.queue = q
		end
	end
	return v
end

local function viewKey(v: Types.FormationView): string
	return string.format("%.1f|%.1f|%.2f|%s|%s|%d|%s|%s|%s|%s|%s|%s|%d", v.x, v.z, v.heading, v.shape, v.state, v.strength, v.moraleBand, tostring(v.status), tostring(v.orderKind), tostring(v.fireAtWill), tostring(v.ammo), tostring(math.floor((v.morale or 0) / 2)), math.ceil(v.reload or 0)) -- reload in whole seconds so cards stay current
end

-- Build the snapshot for one viewer faction. Pass full=true for keyframes.
function Sim.snapshot(self: Sim, viewer: string, full: boolean): Types.Snapshot
	local view = self.views[viewer]
	local formations: { Types.FormationView } = {}
	local removed: { number } = {}
	local last = self.lastSent[viewer]
	if not last or full then
		last = {}
		full = true
	end
	local nowKeys: { [number]: string } = {}
	for _, id in self.order do
		local f = self.formations[id]
		if f then
			local own = f.faction == viewer
			local show = Formation.isActive(f) and (own or (view and view.visible[id]))
			if show then
				local v = viewOf(f, own)
				local key = viewKey(v)
				nowKeys[id] = key
				if full or last[id] ~= key then
					formations[#formations + 1] = v
				end
			elseif last[id] then
				removed[#removed + 1] = id
			end
		end
	end
	self.lastSent[viewer] = nowKeys
	local lastKnown: { Types.LastKnown } = {}
	if view then
		for _, lk in view.lastKnown do
			lastKnown[#lastKnown + 1] = lk
		end
		table.sort(lastKnown, function(a: Types.LastKnown, b: Types.LastKnown)
			return a.id < b.id
		end)
	end
	-- Own reinforcements still off the map.
	local reinforcements = {}
	for _, id in self.order do
		local f = self.formations[id]
		if f and f.faction == viewer and f.state == "offmap" and f.arrivalTick then
			reinforcements[#reinforcements + 1] = { id = f.id, name = f.name, corps = f.corps, eta = math.max(0, (f.arrivalTick - self.tick) * DT) }
		end
	end
	-- Events: hide positions of unseen enemy actors.
	local events: { Types.Event } = {}
	for _, ev in self.events do
		local copy: Types.Event = table.clone(ev)
		if ev.id and ev.faction and ev.faction ~= viewer and not self:isVisibleTo(viewer, ev.id) then
			if ev.targetId and self.formations[ev.targetId] and self.formations[ev.targetId].faction == viewer then
				copy.x = nil
				copy.z = nil
				copy.id = nil
			else
				continue
			end
		end
		events[#events + 1] = copy
	end
	return {
		matchId = self.matchId,
		tick = self.tick,
		seq = self.tick,
		kind = if full then "full" else "delta",
		state = self.state,
		formations = formations,
		lastKnown = lastKnown,
		events = events,
		objectives = Objectives.view(self :: any),
		clock = self.clock,
		timeLimit = self.timeLimit,
		speed = 1,
		simLag = self.simLag,
		viewer = viewer,
		removed = if #removed > 0 then removed else nil,
		reinforcements = if #reinforcements > 0 then reinforcements else nil,
		weather = self.weather,
	}
end

-- Call after all viewers have been served for this publish.
function Sim.clearEvents(self: Sim)
	self.events = {}
end

-- Results ------------------------------------------------------------------------------------

function Sim.buildResults(self: Sim, winner: string, reason: string): Types.Results
	local sides: { [string]: any } = {}
	for _, faction in self.factions do
		local s = { deployed = self.deployed[faction] or 0, casualties = 0, remaining = 0, surviving = 0, routed = 0, shattered = 0, destroyed = 0, exited = 0, formations = 0 }
		for _, id in self.order do
			local f = self.formations[id]
			if f and f.faction == faction then
				s.formations += 1
				if f.state == "offmap" then
					s.remaining += f.strength
					s.surviving += 1
				elseif f.state == "destroyed" then
					s.destroyed += 1
					s.casualties += f.startStrength
				elseif f.state == "exited" then
					s.exited += 1
					s.casualties += f.startStrength
				else
					s.remaining += f.strength
					s.casualties += f.startStrength - f.strength
					if f.shattered then
						s.shattered += 1
					elseif f.state == "routing" or f.state == "rallying" then
						s.routed += 1
					else
						s.surviving += 1
					end
				end
			end
		end
		sides[faction] = s
	end
	local outcome: "victory" | "defeat" | "draw" = if winner == "draw" then "draw" elseif winner == self.playerFaction then "victory" else "defeat"
	local feedback: { string } = {}
	local p = sides[self.playerFaction]
	if p.routed + p.shattered > p.formations / 3 then
		feedback[#feedback + 1] = "More than a third of your formations broke. Keep the general close to the line and rest shaken units behind it."
	end
	local charges, squares = 0, 0
	for _, line in self.logLines do
		if string.find(line, "square", 1, true) then
			squares += 1
		end
		if string.find(line, "charged", 1, true) then
			charges += 1
		end
	end
	if squares > 0 then
		feedback[#feedback + 1] = "Cavalry charged a formed square. Charge flanks, guns or broken troops instead."
	end
	if p.casualties > 0 and sides[self.enemyFaction].casualties > p.casualties * 1.5 then
		feedback[#feedback + 1] = "Your fire was far more effective than the enemy's: good use of ground and facing."
	end
	if #feedback == 0 then
		feedback[#feedback + 1] = "A balanced action. Concentrate fire on one formation at a time to break it faster."
	end
	return {
		outcome = outcome,
		reason = reason,
		clock = self.clock,
		objectives = Objectives.view(self :: any),
		sides = sides,
		feedback = feedback,
		log = self.logLines,
	}
end

return Sim
]]></ProtectedString></Properties><Item class="ModuleScript" referent="RBX00000023"><Properties><bool name="Disabled">false</bool><string name="Name">Combat</string><ProtectedString name="Source"><![CDATA[--!strict
-- Fire, artillery, melee and charge resolution. Step 6 gathers attacks from a frozen view of
-- the tick (positions/states as they are after movement); step 7 applies them. Both sides
-- resolve simultaneously; ordering is ascending formation id for determinism.

local Shared = game:GetService("ReplicatedStorage"):WaitForChild("EoE")
local Config = require(Shared.Config)
local Grid = require(Shared.Grid)
local Vec = require(Shared.Vec)
local Types = require(Shared.Types)

local Formation = require(script.Parent.Formation)

type Vec = Vec.Vec
type Formation = Formation.Formation

export type Attack = {
	attackerId: number,
	targetId: number,
	casualties: number,
	side: string, -- front | flank | rear
	moraleExtra: number,
	kind: "volley" | "cannon" | "melee" | "charge",
}

export type SimLike = {
	grid: Grid.Grid,
	tick: number,
	rng: any,
	weather: string?,
	formations: { [number]: Formation },
	order: { number },
	emit: (sim: any, ev: Types.Event) -> (),
	isVisibleTo: (sim: any, viewerFaction: string, id: number) -> boolean,
	findFormation: (sim: any, id: number) -> Formation?,
}

local Combat = {}

local DT = Config.Sim.DT
local C = Config.Combat

local function rollCasualties(sim: SimLike, expected: number): number
	local whole = math.floor(expected)
	local frac = expected - whole
	if sim.rng:chance(frac) then
		whole += 1
	end
	return whole
end

-- A friendly formation inside the lane between shooter and target blocks the volley.
local function laneBlocked(sim: SimLike, shooter: Formation, target: Formation): boolean
	if not C.FriendlyBlocksFire then
		return false
	end
	local a, b = shooter.pos, target.pos
	for _, id in sim.order do
		if id ~= shooter.id and id ~= target.id then
			local o = sim.formations[id]
			if o and o.faction == shooter.faction and Formation.isActive(o) then
				local d = Vec.distToSegment(o.pos, a, b)
				if d < C.FireLaneHalfWidth + o.halfRadius * 0.5 then
					-- only counts when strictly between (not behind the shooter)
					local t = Vec.dot(Vec.sub(o.pos, a), Vec.sub(b, a)) / math.max(1e-6, Vec.dist2(a, b))
					if t > 0.1 and t < 0.9 then
						return true
					end
				end
			end
		end
	end
	return false
end

local function inArc(shooter: Formation, target: Formation, halfAngle: number): boolean
	return math.abs(Vec.bearing(shooter.pos, shooter.heading, target.pos)) <= halfAngle
end

-- Why a formation cannot fire right now (nil = it can). Also used for the HUD status word.
function Combat.fireBlockReason(sim: SimLike, f: Formation, target: Formation?): string?
	local unit = Formation.unitConfig(f)
	if f.class == "artillery" then
		if f.shape ~= "deployed" then
			return "Limbered"
		end
	elseif not unit.musket then
		return "No firearms"
	end
	if f.ammo <= 0 then
		return "Out of ammunition"
	end
	if f.state == "reforming" then
		return "Reforming"
	end
	if f.state == "melee" or f.state == "charging" or f.state == "routing" or f.state == "rallying" then
		return "Engaged"
	end
	if f.class == "infantry" and f.shape == "travel" then
		return "In travel column"
	end
	if f.reload > 0 then
		return "Reloading"
	end
	if not target then
		return "No target"
	end
	local dist = Vec.dist(f.pos, target.pos)
	if f.class == "artillery" then
		local gun = unit.gun
		local mode = Combat.artilleryMode(f, dist)
		local ammo = (gun :: any)[mode]
		if dist > ammo.range or dist < ammo.minRange then
			return "Out of range"
		end
		if not inArc(f, target, gun.arcHalfAngle) then
			return "Outside firing arc"
		end
	else
		if dist > unit.musket.range then
			return "Out of range"
		end
		-- a square faces every way (its fire factor already counts one face's muskets)
		if f.shape ~= "square" and not inArc(f, target, math.rad(60)) then
			return "Target not to the front"
		end
	end
	if not sim.isVisibleTo(sim, f.faction, target.id) then
		return "Target not visible"
	end
	if not Grid.lineOfSight(sim.grid, f.pos, target.pos) then
		return "Line of fire blocked"
	end
	if laneBlocked(sim, f, target) then
		return "Friends in the line of fire"
	end
	return nil
end

function Combat.artilleryMode(f: Formation, dist: number): "roundShot" | "canister"
	if f.ammoMode == "canister" then
		return "canister"
	elseif f.ammoMode == "roundShot" then
		return "roundShot"
	end
	return if dist <= Config.Units.artillery.gun.canister.range then "canister" else "roundShot"
end

-- Best visible enemy for fire-at-will: nearest in arc and range with a clear lane.
function Combat.pickFireTarget(sim: SimLike, f: Formation): Formation?
	local best: Formation? = nil
	local bestD = math.huge
	local preferred = f.targetId and sim.findFormation(sim, f.targetId)
	if preferred and Formation.isActive(preferred) and Combat.fireBlockReason(sim, f, preferred) == nil then
		return preferred
	end
	if not f.fireAtWill and f.class ~= "artillery" then
		return nil
	end
	for _, id in sim.order do
		local o = sim.formations[id]
		if o and o.faction ~= f.faction and Formation.isActive(o) then
			local d = Vec.dist2(f.pos, o.pos)
			if d < bestD and Combat.fireBlockReason(sim, f, o) == nil then
				best = o
				bestD = d
			end
		end
	end
	return best
end

local function uphill(sim: SimLike, a: Vec, b: Vec): boolean
	return Grid.heightAt(sim.grid, a.x, a.z) > Grid.heightAt(sim.grid, b.x, b.z) + 3
end

local function volley(sim: SimLike, f: Formation, target: Formation, attacks: { Attack })
	local unit = Formation.unitConfig(f)
	local musket = unit.musket
	local shapeCfg = (Config.Shapes :: any)[f.shape]
	local readiness = math.max(musket.minReadiness, f.cohesion)
	if f.moraleBand == "shaken" then
		readiness *= C.ShakenFireFactor
	end
	local shooters = f.strength * shapeCfg.fire * readiness
	if shooters < C.VolleyMinStrength then
		return
	end
	local dist = Vec.dist(f.pos, target.pos)
	local rangeF = 1 - C.RangeFalloff * (dist / musket.range)
	local cover = Grid.terrainAt(sim.grid, target.pos.x, target.pos.z).cover
	local side = Vec.attackSide(target.pos, target.heading, f.pos)
	local sideF = if side == "front" then 1 elseif side == "flank" then C.FlankFireFactor else C.RearFireFactor
	local hit = musket.accuracy * rangeF * (1 - cover) * Formation.fatigueFactor(f, C.FatigueAccuracyPenalty) * (1 + C.ExperienceAccuracy * f.experience)
	hit *= (C.TargetShapeFactor :: any)[target.shape] or 1
	hit *= sideF
	if uphill(sim, f.pos, target.pos) then
		hit *= 1 + Config.Slope.UphillFireBonus
	end
	hit *= ((Config.Weather :: any)[sim.weather or "clear"] or Config.Weather.clear).accuracy
	hit = math.min(C.MaxHitChance, hit)
	local casualties = rollCasualties(sim, shooters * hit)
	f.reload = musket.reload
	f.ammo -= 1
	f.lastShotTick = sim.tick
	f.state = if f.state == "idle" then "firing" else f.state
	f.timers.halt = 1.5 -- infantry halts to deliver the volley
	attacks[#attacks + 1] = { attackerId = f.id, targetId = target.id, casualties = casualties, side = side, moraleExtra = 0, kind = "volley" }
	sim.emit(sim, { kind = "volley", tick = sim.tick, id = f.id, targetId = target.id, faction = f.faction, x = f.pos.x, z = f.pos.z, tx = target.pos.x, tz = target.pos.z, n = casualties })
end

local function cannonade(sim: SimLike, f: Formation, target: Formation, attacks: { Attack })
	local gun = Formation.unitConfig(f).gun
	local dist = Vec.dist(f.pos, target.pos)
	local mode = Combat.artilleryMode(f, dist)
	local ammo = (gun :: any)[mode]
	local guns = Formation.figures(f)
	local rangeF = 1 - C.RangeFalloff * (dist / ammo.range)
	local shapeF = (Config.Shapes :: any)[target.shape].artillery
	local cover = Grid.terrainAt(sim.grid, target.pos.x, target.pos.z).cover
	local weatherF = ((Config.Weather :: any)[sim.weather or "clear"] or Config.Weather.clear).cannon
	local expected = guns * ammo.hit * weatherF * rangeF * (1 - cover * 0.5) * ammo.casualtiesPerHit * shapeF * Formation.fatigueFactor(f, C.FatigueAccuracyPenalty) * (1 + C.ExperienceAccuracy * f.experience)
	local casualties = rollCasualties(sim, expected)
	f.reload = ammo.reload
	f.ammo -= 1
	f.lastShotTick = sim.tick
	f.state = if f.state == "idle" then "firing" else f.state
	local side = Vec.attackSide(target.pos, target.heading, f.pos)
	attacks[#attacks + 1] = { attackerId = f.id, targetId = target.id, casualties = casualties, side = side, moraleExtra = ammo.morale, kind = "cannon" }
	sim.emit(sim, { kind = "cannon", tick = sim.tick, id = f.id, targetId = target.id, faction = f.faction, x = f.pos.x, z = f.pos.z, tx = target.pos.x, tz = target.pos.z, n = casualties, text = mode })
end

-- Footprints touching: centres within the sum of half-radii plus contact distance.
function Combat.inContact(a: Formation, b: Formation): boolean
	local r = a.halfRadius + b.halfRadius + C.MeleeContactDistance
	return Vec.dist2(a.pos, b.pos) <= r * r
end

local function meleeDamage(sim: SimLike, att: Formation, def: Formation, attacks: { Attack })
	local unitA = Formation.unitConfig(att)
	local unitD = Formation.unitConfig(def)
	local shapeA = (Config.Shapes :: any)[att.shape]
	local side = Vec.attackSide(def.pos, def.heading, att.pos)
	local dirF = (C.MeleeDirFactor :: any)[side]
	if def.shape == "square" then
		dirF = 1 -- a square has no flank
	end
	local rate = att.strength * C.MeleeRatePerSecond * unitA.melee.attack * shapeA.melee * dirF
	rate *= Formation.fatigueFactor(att, C.FatigueMeleePenalty) * (1 + C.ExperienceMelee * att.experience)
	if att.timers.bayonet > 0 then
		rate *= C.BayonetBonus
	end
	if att.class == "cavalry" and def.shape == "square" then
		rate *= 0.3
	end
	if att.class == "cavalry" and att.inWoods then
		rate *= 0.5
	end
	if att.class == "cavalry" and att.timers.meleeSeconds > unitA.charge.maxMeleeSeconds then
		rate *= 0.5 -- blown horses: sustained melee is not cavalry's business
	end
	if att.moraleBand == "shaken" then
		rate *= C.ShakenMeleeFactor
	end
	rate /= unitD.melee.defense
	local casualties = rollCasualties(sim, rate * DT)
	local extra = 0
	if att.class == "cavalry" and def.class == "artillery" then
		extra = 2 * DT
	end
	attacks[#attacks + 1] = { attackerId = att.id, targetId = def.id, casualties = casualties, side = side, moraleExtra = extra, kind = "melee" }
end

local function chargeImpact(sim: SimLike, att: Formation, def: Formation, attacks: { Attack })
	local unit = Formation.unitConfig(att)
	if att.class == "cavalry" then
		local ch = unit.charge
		local runUpF = math.clamp(att.runUp / ch.runUp, C.MinRunUpFactor, 1)
		local side = Vec.attackSide(def.pos, def.heading, att.pos)
		local dirF = if side == "front" then ch.frontFactor elseif side == "flank" then ch.flankFactor else ch.rearFactor
		local shapeF = (C.ChargeShapeFactor :: any)[def.shape] or 1
		if def.state == "reforming" then
			shapeF *= 1.5
		end
		if def.shape == "square" then
			dirF = 1
		end
		if def.state == "routing" then
			shapeF *= C.ChargeRoutingFactor
		end
		local impact = att.strength * ch.base * runUpF * dirF * shapeF * Formation.fatigueFactor(att, C.FatigueMeleePenalty)
		if att.inWoods then
			impact *= 0.5
		end
		local casualties = rollCasualties(sim, impact)
		attacks[#attacks + 1] = { attackerId = att.id, targetId = def.id, casualties = casualties, side = side, moraleExtra = if def.shape == "square" then 0 else 8, kind = "charge" }
		att.timers.chargeRecover = ch.recovery
		att.fatigue = math.min(100, att.fatigue + 10)
		sim.emit(sim, { kind = "charge", tick = sim.tick, id = att.id, targetId = def.id, faction = att.faction, x = att.pos.x, z = att.pos.z, tx = def.pos.x, tz = def.pos.z, n = casualties, text = if def.shape == "square" then "square" else side })
	else
		-- bayonet assault
		local side = Vec.attackSide(def.pos, def.heading, att.pos)
		local shock = if side == "front" then C.BayonetMoraleShock.front else C.BayonetMoraleShock.flank
		att.timers.bayonet = C.BayonetBonusSeconds
		attacks[#attacks + 1] = { attackerId = att.id, targetId = def.id, casualties = 0, side = side, moraleExtra = shock, kind = "charge" }
		sim.emit(sim, { kind = "charge", tick = sim.tick, id = att.id, targetId = def.id, faction = att.faction, x = att.pos.x, z = att.pos.z, tx = def.pos.x, tz = def.pos.z, n = 0, text = "bayonet" })
	end
	att.chargeReady = false
	att.runUp = 0
end

-- Step 6: gather all attacks for this tick.
function Combat.gather(sim: SimLike): { Attack }
	local attacks: { Attack } = {}
	-- Contacts first (charges land before volleys in the same tick; both still resolve).
	for _, id in sim.order do
		local f = sim.formations[id]
		if f and Formation.isActive(f) and f.state ~= "routing" and f.state ~= "rallying" then
			-- Charging into a target
			if f.state == "charging" and f.order and f.order.targetId then
				local target = sim.findFormation(sim, f.order.targetId)
				if target and Formation.isActive(target) and Combat.inContact(f, target) then
					if f.chargeReady and f.timers.chargeRecover <= 0 then
						chargeImpact(sim, f, target, attacks)
					end
					f.state = "melee"
					f.meleeWith[target.id] = true
					target.meleeWith[f.id] = true
					if target.state ~= "melee" and target.state ~= "routing" then
						target.state = "melee"
						target.path = nil
					end
					f.path = nil
				elseif target and Formation.isActive(target) and f.class == "cavalry" and not f.chargeReady and f.timers.chargeRecover <= 0 then
					f.chargeReady = true
				end
			elseif f.state == "charging" and f.order and f.order.pos and not f.order.targetId then
				-- charge toward a position: hit whatever enemy we touch
				for _, oid in sim.order do
					local o = sim.formations[oid]
					if o and o.faction ~= f.faction and Formation.isActive(o) and Combat.inContact(f, o) then
						if f.chargeReady and f.timers.chargeRecover <= 0 then
							chargeImpact(sim, f, o, attacks)
						end
						f.state = "melee"
						f.meleeWith[o.id] = true
						o.meleeWith[f.id] = true
						if o.state ~= "melee" and o.state ~= "routing" then
							o.state = "melee"
							o.path = nil
						end
						f.path = nil
						break
					end
				end
			elseif f.order and f.order.kind == "Engage" and f.order.targetId and (f.state == "moving" or f.state == "idle") then
				local target = sim.findFormation(sim, f.order.targetId)
				if target and Formation.isActive(target) and Combat.inContact(f, target) and f.class ~= "artillery" then
					f.state = "melee"
					f.meleeWith[target.id] = true
					target.meleeWith[f.id] = true
					if target.state ~= "melee" and target.state ~= "routing" then
						target.state = "melee"
						target.path = nil
					end
					f.path = nil
				end
			end
		end
	end
	-- Contact without an attack order (attack-move, a move that ran into the enemy, an enemy that
	-- walked into us): touching footprints fight. Guns and staff never start a melee themselves.
	for _, id in sim.order do
		local f = sim.formations[id]
		if f and Formation.isActive(f) and f.class ~= "artillery" and f.class ~= "hq" and (f.state == "idle" or f.state == "moving" or f.state == "firing") then
			for _, oid in sim.order do
				local o = sim.formations[oid]
				if o and o.faction ~= f.faction and Formation.isActive(o) and o.state ~= "routing" and o.state ~= "rallying" and Combat.inContact(f, o) then
					f.state = "melee"
					f.path = nil
					f.meleeWith[o.id] = true
					o.meleeWith[f.id] = true
					if o.state ~= "melee" then
						o.state = "melee"
						o.path = nil
					end
					break
				end
			end
		end
	end
	-- Melee damage for every engaged pair (each side attacks the other).
	for _, id in sim.order do
		local f = sim.formations[id]
		if f and f.state == "melee" then
			local anyContact = false
			for oid in f.meleeWith do
				local o = sim.formations[oid]
				if o and Formation.isActive(o) and o.state ~= "routing" and Combat.inContact(f, o) then
					anyContact = true
					meleeDamage(sim, f, o, attacks)
				else
					f.meleeWith[oid] = nil
				end
			end
			f.timers.meleeSeconds += DT
			f.fatigue = math.min(100, f.fatigue + Formation.unitConfig(f).fatigueMelee * DT)
			if not anyContact then
				f.state = "idle"
				f.timers.meleeSeconds = 0
				if f.order and (f.order.kind == "Charge" or f.order.kind == "Engage") then
					local target = f.order.targetId and sim.findFormation(sim, f.order.targetId)
					if not target or not Formation.isActive(target) or target.state == "routing" then
						Formation.clearOrder(f)
					else
						f.state = "moving"
						f.path = nil
					end
				end
			end
		end
	end
	-- Fire.
	for _, id in sim.order do
		local f = sim.formations[id]
		if f and Formation.isActive(f) and (f.state == "idle" or f.state == "firing" or f.state == "moving") then
			local target = Combat.pickFireTarget(sim, f)
			if target then
				if f.class == "artillery" then
					cannonade(sim, f, target, attacks)
				elseif f.class == "infantry" then
					if f.state == "moving" and f.order and f.order.kind == "Move" then
						-- Moving infantry does not stop for fire-at-will unless attack-moving.
					else
						volley(sim, f, target, attacks)
					end
				end
			elseif f.state == "firing" then
				f.state = "idle"
			end
			f.status = if f.class ~= "cavalry" and f.class ~= "hq" then Combat.fireBlockReason(sim, f, target) else nil
		end
	end
	return attacks
end

-- Step 7: apply casualties and ammunition; morale consequences handled by Morale.
function Combat.apply(sim: SimLike, attacks: { Attack })
	for _, a in attacks do
		local t = sim.formations[a.targetId]
		if t and Formation.isActive(t) then
			local lost = math.min(t.strength, a.casualties)
			t.strength -= lost
			t.casualtiesThisTick += lost
			if lost > 0 then
				t.timers.noDamage = 0
			end
			if a.side ~= "front" and (lost > 0 or a.kind ~= "volley") then
				if a.kind == "melee" then
					-- sustained pressure: per-second penalty applied by Morale
					if t.meleeSide == nil or a.side == "rear" then
						t.meleeSide = a.side
					end
				elseif t.hitSide == nil or a.side == "rear" then
					-- one-shot shock from a flank/rear volley, cannonade or charge
					t.hitSide = a.side
				end
			end
			if a.moraleExtra > 0 then
				t.morale = math.max(0, t.morale - a.moraleExtra)
			end
			if t.state == "reforming" and a.kind == "charge" then
				-- a charge interrupts a half-formed square: resolve against the previous shape
				t.cohesion = math.max(0.3, t.cohesion - 0.2)
			end
			Formation.refreshFootprint(t)
		end
	end
end

return Combat
]]></ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX00000024"><Properties><bool name="Disabled">false</bool><string name="Name">Formation</string><ProtectedString name="Source"><![CDATA[--!strict
-- Formation records: creation from scenario definitions, footprint geometry, shape changes,
-- legality helpers. Pure Luau; no Roblox APIs.

local Shared = game:GetService("ReplicatedStorage"):WaitForChild("EoE")
local Config = require(Shared.Config)
local Vec = require(Shared.Vec)
local Scenarios = require(Shared.Scenarios)
local Types = require(Shared.Types)

type Vec = Vec.Vec
type UnitDef = Scenarios.UnitDef

export type Formation = {
	id: number,
	faction: string,
	name: string,
	corps: string,
	class: Types.UnitClass,
	colour: string?,
	commander: boolean,
	startStrength: number,
	strength: number,
	experience: number,
	pos: Vec,
	heading: number,
	shape: Types.Shape,
	prevShape: Types.Shape?, -- shape to restore after a forced travel column
	state: Types.State,
	morale: number,
	baseMorale: number,
	fatigue: number,
	ammo: number,
	ammoMode: string, -- artillery: auto | roundShot | canister
	reload: number,
	order: Types.Order?,
	queue: { Types.Order },
	path: { Vec }?,
	pathIndex: number,
	targetId: number?,
	timers: {
		reform: number,
		limber: number,
		chargeRecover: number,
		rallyCd: number,
		routing: number,
		rallying: number,
		bayonet: number,
		noDamage: number,
		friendRout: number,
		isolation: number,
		stuck: number,
		halt: number,
		meleeSeconds: number,
	},
	fireAtWill: boolean,
	cohesion: number,
	lastShotTick: number,
	meleeWith: { [number]: boolean },
	routCount: number,
	shattered: boolean,
	runUp: number, -- distance at charge speed this charge
	chargeReady: boolean, -- impact not yet applied for the current charge
	hitSide: string?, -- strongest one-shot attack side suffered this tick (volley/cannon/charge)
	meleeSide: string?, -- strongest melee attack side this tick (sustained)
	status: string?,
	lastProgressDist: number,
	moraleBand: Types.MoraleBand,
	width: number,
	depth: number,
	halfRadius: number,
	destroyedTick: number?,
	pendingShape: Types.Shape?,
	pendingLimber: boolean?,
	casualtiesThisTick: number,
	visibleTo: { [string]: boolean },
	inWoods: boolean,
	arrivalTick: number?, -- reinforcements: tick at which the formation enters the field
}

local Formation = {}

function Formation.unitConfig(f: Formation)
	return (Config.Units :: any)[f.class]
end

function Formation.figures(f: Formation): number
	if f.class == "artillery" then
		return math.max(1, math.ceil(f.strength / Config.Visual.CrewPerGun))
	end
	return math.max(1, math.ceil(f.strength / Config.Visual.SoldiersPerFigure))
end

-- Width (frontage) and depth of the footprint for the current shape.
function Formation.footprint(f: Formation): (number, number)
	local shapeCfg = (Config.Shapes :: any)[f.shape]
	local figures = Formation.figures(f)
	local spacing = shapeCfg.figureSpacing
	local rankSpacing = shapeCfg.rankSpacing
	if f.shape == "square" then
		local side = math.max(2, math.ceil(math.sqrt(figures)))
		return side * spacing, side * rankSpacing
	end
	local ranks = math.max(1, shapeCfg.ranks)
	local files = math.max(1, math.ceil(figures / ranks))
	return files * spacing, ranks * rankSpacing
end

function Formation.refreshFootprint(f: Formation)
	local w, d = Formation.footprint(f)
	f.width = w
	f.depth = d
	f.halfRadius = math.max(w, d) / 2
end

function Formation.fromDef(id: number, def: UnitDef): Formation
	local unit = (Config.Units :: any)[def.class]
	local baseMorale = unit.baseMorale + Config.Combat.ExperienceMorale * def.experience
	local f: Formation = {
		id = id,
		faction = def.faction,
		name = def.name,
		corps = def.corps,
		class = def.class,
		colour = def.colour,
		commander = def.commander == true,
		startStrength = def.strength,
		strength = def.strength,
		experience = def.experience,
		pos = { x = def.pos.x, z = def.pos.z },
		heading = def.heading,
		shape = unit.defaultShape,
		prevShape = nil,
		state = "idle",
		morale = baseMorale,
		baseMorale = baseMorale,
		fatigue = 0,
		ammo = def.class == "artillery" and unit.gun.ammo or (def.class == "infantry" and 60 or 0),
		ammoMode = "auto",
		reload = 0,
		order = nil,
		queue = {},
		path = nil,
		pathIndex = 1,
		targetId = nil,
		timers = {
			reform = 0,
			limber = 0,
			chargeRecover = 0,
			rallyCd = 0,
			routing = 0,
			rallying = 0,
			bayonet = 0,
			noDamage = 999,
			friendRout = 0,
			isolation = 0,
			stuck = 0,
			halt = 0,
			meleeSeconds = 0,
		},
		fireAtWill = true,
		cohesion = 1,
		lastShotTick = -1000,
		meleeWith = {},
		routCount = 0,
		shattered = false,
		runUp = 0,
		chargeReady = false,
		hitSide = nil,
		meleeSide = nil,
		status = nil,
		lastProgressDist = math.huge,
		moraleBand = "steady",
		width = 0,
		depth = 0,
		halfRadius = 0,
		destroyedTick = nil,
		pendingShape = nil,
		pendingLimber = nil,
		casualtiesThisTick = 0,
		visibleTo = {},
		inWoods = false,
		arrivalTick = nil,
	}
	-- Off-map reinforcements: `arrival = { seconds, pos }` on the unit definition.
	local arrival = (def :: any).arrival
	if type(arrival) == "table" and type(arrival.seconds) == "number" and arrival.seconds > 0 then
		f.state = "offmap"
		f.arrivalTick = math.floor(arrival.seconds / Config.Sim.DT)
		if type(arrival.pos) == "table" then
			f.pos = { x = arrival.pos.x, z = arrival.pos.z }
		end
	end
	Formation.refreshFootprint(f)
	return f
end

function Formation.isActive(f: Formation): boolean
	return f.state ~= "destroyed" and f.state ~= "exited" and f.state ~= "offmap"
end

function Formation.isBroken(f: Formation): boolean
	return f.state == "routing" or f.state == "rallying" or f.shattered or not Formation.isActive(f)
end

function Formation.canTakeOrders(f: Formation): (boolean, string?)
	if f.state == "offmap" then
		return false, "badState"
	end
	if not Formation.isActive(f) then
		return false, "destroyed"
	end
	if f.state == "routing" or f.state == "rallying" then
		return false, "routing"
	end
	return true, nil
end

function Formation.legalShapes(f: Formation): { [string]: boolean }
	return Formation.unitConfig(f).legalShapes
end

-- Begin a shape change; completes when timers.reform reaches 0 (Movement handles the timer).
function Formation.beginShape(f: Formation, shape: Types.Shape, forced: boolean?)
	if f.shape == shape and f.pendingShape == nil then
		return
	end
	local t = (Config.ReformTime :: any)[shape] or 8
	if shape == "square" and f.shape == "column" then
		t = Config.SquareFromColumnTime
	end
	if forced and f.shape ~= "travel" then
		f.prevShape = f.shape
	end
	f.pendingShape = shape
	f.timers.reform = t
	f.state = "reforming"
	f.cohesion = math.min(f.cohesion, 0.6)
end

function Formation.completeShape(f: Formation)
	if f.pendingShape then
		f.shape = f.pendingShape
		f.pendingShape = nil
		Formation.refreshFootprint(f)
	end
	if f.state == "reforming" then
		-- An order received during the reform still needs executing: Movement replans.
		f.state = if f.path or (f.order and (f.order.pos or f.order.targetId)) then "moving" else "idle"
	end
end

function Formation.isLimbered(f: Formation): boolean
	return f.class == "artillery" and f.shape == "limbered"
end

function Formation.speedBase(f: Formation, charging: boolean): number
	local unit = Formation.unitConfig(f)
	return if charging then unit.chargeSpeed else unit.speed
end

function Formation.fatigueFactor(f: Formation, penalty: number): number
	return 1 - penalty * f.fatigue / 100
end

function Formation.clearOrder(f: Formation)
	f.order = nil
	f.queue = {}
	f.path = nil
	f.pathIndex = 1
	f.targetId = nil
	f.chargeReady = false
	f.runUp = 0
	if f.state == "moving" or f.state == "charging" or f.state == "retreating" then
		f.state = "idle"
	end
end

function Formation.moraleBandOf(f: Formation): Types.MoraleBand
	if f.shattered then
		return "shattered"
	end
	if f.state == "routing" or f.state == "rallying" then
		return "routing"
	end
	return f.moraleBand
end

-- Corners of the footprint rectangle (for client ghosts and contact tests).
function Formation.frontCentre(f: Formation): Vec
	local fwd = Vec.fromHeading(f.heading)
	return Vec.add(f.pos, Vec.scale(fwd, f.depth / 2))
end

return Formation
]]></ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX00000025"><Properties><bool name="Disabled">false</bool><string name="Name">Morale</string><ProtectedString name="Source"><![CDATA[--!strict
-- Morale, fatigue effects, rout / rally / shatter transitions, destruction. Step 8.

local Shared = game:GetService("ReplicatedStorage"):WaitForChild("EoE")
local Config = require(Shared.Config)
local Vec = require(Shared.Vec)
local Types = require(Shared.Types)

local Formation = require(script.Parent.Formation)

type Formation = Formation.Formation

export type SimLike = {
	tick: number,
	formations: { [number]: Formation },
	order: { number },
	emit: (sim: any, ev: Types.Event) -> (),
	log: (sim: any, text: string) -> (),
	hqOf: (sim: any, faction: string) -> Formation?,
	stats: { [string]: any },
	homeEdge: ((sim: any, faction: string) -> { x: number, z: number })?,
	grid: { width: number, depth: number }?,
}

local Morale = {}

local DT = Config.Sim.DT
local M = Config.Morale

local function nearestFriendDist(sim: SimLike, f: Formation): number
	local best = math.huge
	for _, id in sim.order do
		if id ~= f.id then
			local o = sim.formations[id]
			if o and o.faction == f.faction and Formation.isActive(o) and o.state ~= "routing" then
				local d = Vec.dist(f.pos, o.pos)
				if d < best then
					best = d
				end
			end
		end
	end
	return best
end

local function routingFriendsNear(sim: SimLike, f: Formation): number
	local n = 0
	for _, id in sim.order do
		if id ~= f.id then
			local o = sim.formations[id]
			if o and o.faction == f.faction and o.state == "routing" and Vec.dist(f.pos, o.pos) < M.FriendRoutRadius then
				n += 1
			end
		end
	end
	return n
end

local function enemyNear(sim: SimLike, f: Formation, radius: number): boolean
	for _, id in sim.order do
		local o = sim.formations[id]
		if o and o.faction ~= f.faction and Formation.isActive(o) and o.state ~= "routing" and Vec.dist(f.pos, o.pos) < radius then
			return true
		end
	end
	return false
end

local function startRout(sim: SimLike, f: Formation, why: string)
	f.state = "routing"
	f.routCount += 1
	f.order = nil
	f.queue = {}
	f.path = nil
	f.pathIndex = 1
	f.targetId = nil
	f.meleeWith = {}
	f.timers.routing = 0
	f.chargeReady = false
	if f.class == "artillery" then
		-- Crews abandon the guns: the battery is lost.
		f.state = "destroyed"
		f.destroyedTick = sim.tick
		sim.emit(sim, { kind = "destroyed", tick = sim.tick, id = f.id, faction = f.faction, x = f.pos.x, z = f.pos.z, text = f.name .. ": guns abandoned" })
		sim.log(sim, string.format("%s abandoned its guns (%s)", f.name, why))
		for _, id in sim.order do
			local o = sim.formations[id]
			if o and o.faction == f.faction and Formation.isActive(o) then
				o.morale = math.max(0, o.morale - M.CapturedGunsMorale)
			end
		end
		return
	end
	if f.strength < f.startStrength * M.ShatterStrengthFraction or f.routCount > M.MaxRouts then
		f.shattered = true
	end
	sim.emit(sim, { kind = "rout", tick = sim.tick, id = f.id, faction = f.faction, x = f.pos.x, z = f.pos.z, text = f.name .. (if f.shattered then " is shattered" else " is routing") })
	sim.log(sim, string.format("%s broke (%s)%s", f.name, why, if f.shattered then ", shattered" else ""))
end

function Morale.rally(sim: SimLike, f: Formation, by: string)
	f.state = "rallying"
	f.timers.rallying = 5
	f.morale = math.max(f.morale, M.RallyMorale)
	f.moraleBand = "shaken"
	f.path = nil
	-- Rallied at the rear edge: walk back onto the field to a slot spread by id, so rallied
	-- formations do not pile on top of each other.
	local home = if sim.homeEdge then sim.homeEdge(sim, f.faction) else nil
	local grid = sim.grid
	if home and grid then
		local edgeZ = if home.z < 0 then 0 else grid.depth
		if math.abs(f.pos.z - edgeZ) < 80 then
			local inward = if home.z < 0 then 1 else -1
			local x = math.clamp(f.pos.x + ((f.id % 5) - 2) * 45, 30, grid.width - 30)
			local z = edgeZ + inward * (110 + (f.id % 3) * 30)
			f.order = { kind = "Move", pos = { x = x, z = z }, heading = if inward > 0 then math.pi / 2 else -math.pi / 2, issuedTick = sim.tick }
			f.queue = {}
		end
	end
	sim.emit(sim, { kind = "rally", tick = sim.tick, id = f.id, faction = f.faction, x = f.pos.x, z = f.pos.z, text = f.name .. " rallies" .. by })
end

local function destroy(sim: SimLike, f: Formation)
	f.state = "destroyed"
	f.destroyedTick = sim.tick
	f.order = nil
	f.path = nil
	f.meleeWith = {}
	sim.emit(sim, { kind = "destroyed", tick = sim.tick, id = f.id, faction = f.faction, x = f.pos.x, z = f.pos.z, text = f.name .. " is destroyed" })
	sim.log(sim, f.name .. " was destroyed")
	if f.class == "hq" then
		for _, id in sim.order do
			local o = sim.formations[id]
			if o and o.faction == f.faction and Formation.isActive(o) then
				o.morale = math.max(0, o.morale - Config.Units.hq.lossMoralePenalty)
			end
		end
		sim.log(sim, f.name .. " fell; the army wavers")
	end
	if f.class == "artillery" then
		for _, id in sim.order do
			local o = sim.formations[id]
			if o and o.faction == f.faction and Formation.isActive(o) then
				o.morale = math.max(0, o.morale - M.CapturedGunsMorale)
			end
		end
	end
end

-- Step 8 for one formation.
function Morale.update(sim: SimLike, f: Formation)
	if not Formation.isActive(f) then
		return
	end
	-- Destruction from casualties.
	if f.strength <= 0 or (f.class ~= "hq" and f.strength < Config.Visual.SoldiersPerFigure * 0.5) then
		destroy(sim, f)
		return
	end
	local t = f.timers
	-- Casualty shock.
	if f.casualtiesThisTick > 0 then
		local frac = f.casualtiesThisTick / math.max(1, f.strength + f.casualtiesThisTick)
		f.morale -= frac * 100 * M.CasualtyFactor
		f.casualtiesThisTick = 0
	end
	-- Flank / rear shock: one-shot per volley/cannonade/charge, sustained per second in melee.
	if f.hitSide == "flank" then
		f.morale -= M.FlankHitPenalty
	elseif f.hitSide == "rear" then
		f.morale -= M.RearHitPenalty
	end
	if f.meleeSide == "flank" then
		f.morale -= M.FlankMeleePerSecond * DT
	elseif f.meleeSide == "rear" then
		f.morale -= M.RearMeleePerSecond * DT
	end
	f.hitSide = nil
	f.meleeSide = nil
	-- Friends routing nearby (a formation that is itself routing is past caring).
	t.friendRout += DT
	if t.friendRout >= M.FriendRoutInterval then
		t.friendRout = 0
		if f.state ~= "routing" then
			local n = routingFriendsNear(sim, f)
			if n > 0 then
				f.morale -= math.min(M.FriendRoutMax, n * M.FriendRoutPenalty)
			end
		end
	end
	-- Isolation.
	t.isolation += DT
	if t.isolation >= M.IsolationInterval then
		t.isolation = 0
		if nearestFriendDist(sim, f) > M.IsolationRadius then
			f.morale -= M.IsolationPenalty
		end
	end
	-- Fatigue.
	if f.fatigue > M.FatigueThreshold then
		f.morale -= M.FatiguePenaltyPerSecond * DT
	end
	-- Recovery (HQ influence raises the cap and the rate).
	local hq = sim.hqOf(sim, f.faction)
	local cap = f.baseMorale
	local rate = 0
	if t.noDamage >= M.RecoveryDelay then
		-- Routing formations recover too: that is how they come back to rally.
		rate = M.RecoveryPerSecond
	end
	if hq and hq.id ~= f.id and Vec.dist(hq.pos, f.pos) <= Config.Units.hq.influence.radius then
		cap += Config.Units.hq.influence.moraleBonus
		rate += Config.Units.hq.influence.recoveryBonus
	end
	if f.morale < cap then
		f.morale = math.min(cap, f.morale + rate * DT)
	end
	f.morale = math.clamp(f.morale, 0, 100)

	-- Transitions.
	if f.state == "routing" then
		t.routing += DT
		if not f.shattered and t.routing >= M.MinRoutSeconds and f.morale >= M.RallyMorale and not enemyNear(sim, f, M.RallyNoEnemyRadius) then
			Morale.rally(sim, f, "")
		end
		return
	end
	if f.state == "rallying" then
		t.rallying -= DT
		if t.rallying <= 0 then
			f.state = if f.order and f.order.pos then "moving" else "idle"
		end
		return
	end
	if f.morale < M.RoutEnter then
		startRout(sim, f, "morale collapsed")
		return
	end
	if f.moraleBand == "steady" and f.morale < M.ShakenEnter then
		f.moraleBand = "shaken"
	elseif f.moraleBand == "shaken" and f.morale >= M.ShakenExit then
		f.moraleBand = "steady"
	end
end

-- HQ Rally order: restore routing friends within radius that have routed for a minimum time.
function Morale.hqRally(sim: SimLike, hq: Formation): (boolean, string?)
	if hq.timers.rallyCd > 0 then
		return false, "cooldown"
	end
	local cfg = Config.Units.hq.rally
	local any = false
	for _, id in sim.order do
		local o = sim.formations[id]
		if o and o.faction == hq.faction and o.state == "routing" and not o.shattered and o.timers.routing >= cfg.minRoutingSeconds and Vec.dist(o.pos, hq.pos) <= cfg.radius then
			o.morale = math.min(100, o.morale + cfg.moraleRestore)
			Morale.rally(sim, o, " to the colours")
			any = true
		end
	end
	hq.timers.rallyCd = cfg.cooldown
	if not any then
		sim.emit(sim, { kind = "message", tick = sim.tick, id = hq.id, faction = hq.faction, text = "No routing formation within reach of the general" })
	end
	return true, nil
end

return Morale
]]></ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX00000026"><Properties><bool name="Disabled">false</bool><string name="Name">Movement</string><ProtectedString name="Source"><![CDATA[--!strict
-- Timed transitions (shape/limber/rally/charge recovery), navigation, movement, facing,
-- choke-point travel columns, avoidance, stuck detection and routing flight.
-- Runs in tick steps 3 and 4. Formations are processed in ascending id order.

local Shared = game:GetService("ReplicatedStorage"):WaitForChild("EoE")
local Config = require(Shared.Config)
local Grid = require(Shared.Grid)
local Vec = require(Shared.Vec)
local Types = require(Shared.Types)

local Formation = require(script.Parent.Formation)
local Nav = require(script.Parent.Nav)

type Vec = Vec.Vec
type Formation = Formation.Formation

local Movement = {}

local DT = Config.Sim.DT

-- Sim surface used here (kept narrow so tests can build a fake).
export type SimLike = {
	grid: Grid.Grid,
	nav: Nav.NavGrid,
	map: any,
	tick: number,
	formations: { [number]: Formation },
	order: { number },
	events: { Types.Event },
	emit: (sim: any, ev: Types.Event) -> (),
	homeEdge: (sim: any, faction: string) -> Vec,
	findFormation: (sim: any, id: number) -> Formation?,
	weather: string?,
}

local function terrainSpeed(f: Formation, grid: Grid.Grid): number
	local t = Grid.terrainAt(grid, f.pos.x, f.pos.z)
	return if f.class == "cavalry" then t.cavalrySpeed else t.speed
end

function Movement.currentSpeed(sim: SimLike, f: Formation, dir: Vec): number
	local charging = f.state == "charging"
	local base = Formation.speedBase(f, charging)
	local shapeCfg = (Config.Shapes :: any)[f.shape]
	local shapeFactor = if charging then 1 else shapeCfg.speed
	if f.class == "artillery" and f.shape == "deployed" then
		return 0
	end
	local slope = Grid.slopeAlong(sim.grid, f.pos.x, f.pos.z, dir)
	local slopeFactor = math.max(0.25, 1 - Config.Slope.UphillPenalty * math.max(0, slope) + Config.Slope.DownhillBonus * math.max(0, -slope))
	local fatigue = Formation.fatigueFactor(f, Config.Combat.FatigueSpeedPenalty)
	local weatherF = ((Config.Weather :: any)[sim.weather or "clear"] or Config.Weather.clear).speed
	local speed = base * shapeFactor * terrainSpeed(f, sim.grid) * slopeFactor * fatigue * weatherF
	if f.state == "routing" then
		speed = base * terrainSpeed(f, sim.grid) * slopeFactor * Config.Morale.RoutSpeedFactor
	end
	return speed
end

local function turnToward(f: Formation, target: number, dt: number): boolean
	local rate = (Config.Shapes :: any)[f.shape].turnRate
	if f.state == "routing" then
		rate = 2.0
	end
	local diff = Vec.angleDiff(f.heading, target)
	local step = rate * dt
	if math.abs(diff) <= step then
		f.heading = target
		return true
	end
	f.heading = Vec.wrapAngle(f.heading + (if diff > 0 then step else -step))
	return false
end

-- Step 3: timers.
function Movement.updateTimers(sim: SimLike, f: Formation)
	local t = f.timers
	if t.reform > 0 then
		t.reform = math.max(0, t.reform - DT)
		if t.reform == 0 then
			Formation.completeShape(f)
		end
	end
	if t.limber > 0 then
		t.limber = math.max(0, t.limber - DT)
		if t.limber == 0 and f.pendingLimber ~= nil then
			f.shape = if f.pendingLimber then "limbered" else "deployed"
			f.pendingLimber = nil
			Formation.refreshFootprint(f)
			if f.state == "reforming" then
				f.state = if f.path then "moving" else "idle"
			end
		end
	end
	if t.chargeRecover > 0 then
		t.chargeRecover = math.max(0, t.chargeRecover - DT)
	end
	if t.rallyCd > 0 then
		t.rallyCd = math.max(0, t.rallyCd - DT)
	end
	if t.bayonet > 0 then
		t.bayonet = math.max(0, t.bayonet - DT)
	end
	if t.halt > 0 then
		t.halt = math.max(0, t.halt - DT)
	end
	if f.reload > 0 then
		f.reload = math.max(0, f.reload - DT)
	end
	t.noDamage += DT
	-- Cohesion recovers slowly when not reforming or in melee.
	if f.state ~= "reforming" and f.state ~= "melee" and f.state ~= "routing" then
		f.cohesion = math.min(1, f.cohesion + 0.03 * DT)
	end
end

-- Request a route for the formation's current order destination.
function Movement.plan(sim: SimLike, f: Formation, dest: Vec): boolean
	local path = Nav.findPath(sim.nav, f.pos, dest, f.halfRadius)
	if not path then
		f.path = nil
		return false
	end
	f.path = path
	f.pathIndex = 1
	f.lastProgressDist = math.huge
	f.timers.stuck = 0
	return true
end

local function orderDestination(sim: SimLike, f: Formation): Vec?
	local o = f.order
	if not o then
		return nil
	end
	if o.kind == "Move" or o.kind == "AttackMove" or o.kind == "Retreat" or (o.kind == "Charge" and o.targetId == nil) then
		return o.pos
	end
	if (o.kind == "Engage" or o.kind == "Charge") and o.targetId then
		local target = sim.findFormation(sim, o.targetId)
		if target and Formation.isActive(target) then
			return target.pos
		end
	end
	return nil
end

local function startNextQueued(sim: SimLike, f: Formation)
	local nextOrder = table.remove(f.queue, 1)
	f.order = nextOrder
	f.path = nil
	f.pathIndex = 1
	if nextOrder then
		local dest = orderDestination(sim, f)
		if dest and not Movement.plan(sim, f, dest) then
			sim.emit(sim, { kind = "message", tick = sim.tick, id = f.id, faction = f.faction, text = f.name .. ": no route to that position" })
			f.order = nil
		end
		if f.order then
			f.state = if nextOrder.kind == "Charge" then "charging" else "moving"
		end
	end
	if not f.order then
		f.state = "idle"
	end
end

-- Arrival: settle facing, then hold or take the next queued order.
local function arrive(sim: SimLike, f: Formation)
	f.path = nil
	local o = f.order
	local wantHeading = o and o.heading
	if wantHeading then
		if not turnToward(f, wantHeading, DT) then
			f.state = "moving"
			return
		end
	end
	if o and o.kind == "Retreat" then
		f.state = "idle"
		f.order = nil
		f.queue = {}
		return
	end
	if o and o.kind == "Engage" and o.targetId then
		-- Reached the target's vicinity: stop here; combat decides the rest.
		f.state = "idle"
		return
	end
	startNextQueued(sim, f)
end

-- Advance along the path by one tick.
local function followPath(sim: SimLike, f: Formation, speedScale: number)
	local path = f.path
	if not path then
		return
	end
	local wp = path[f.pathIndex]
	if not wp then
		arrive(sim, f)
		return
	end
	local toWp = Vec.sub(wp, f.pos)
	local dist = Vec.len(toWp)
	local dir = Vec.normalize(toWp)
	local wantHeading = Vec.heading(dir)
	-- Lines wheel before marching; columns and cavalry turn on the move.
	local aligned = turnToward(f, wantHeading, DT)
	if f.shape == "line" and not aligned and math.abs(Vec.angleDiff(f.heading, wantHeading)) > 0.6 then
		return
	end
	local speed = Movement.currentSpeed(sim, f, dir) * speedScale
	if f.timers.halt > 0 then
		speed = 0
	end
	local step = speed * DT
	if f.state == "charging" then
		f.runUp += step
	end
	if step >= dist then
		f.pos = { x = wp.x, z = wp.z }
		f.pathIndex += 1
		f.lastProgressDist = math.huge
		if f.pathIndex > #path then
			arrive(sim, f)
		end
	else
		f.pos = Vec.add(f.pos, Vec.scale(dir, step))
	end
	-- Fatigue from marching.
	local unit = Formation.unitConfig(f)
	local terrain = Grid.terrainAt(sim.grid, f.pos.x, f.pos.z)
	local rate = if f.state == "charging" then unit.fatigueCharge else unit.fatigueMove
	f.fatigue = math.min(100, f.fatigue + rate * terrain.fatigue * DT)
	f.cohesion = math.max(0.3, f.cohesion - terrain.cohesion * DT)
	-- Stuck detection.
	if dist < f.lastProgressDist - 0.01 then
		f.lastProgressDist = dist
		f.timers.stuck = 0
	else
		f.timers.stuck += DT
		if f.timers.stuck > Config.Match.StuckSeconds then
			local dest = orderDestination(sim, f)
			if not dest or not Movement.plan(sim, f, dest) then
				sim.emit(sim, { kind = "message", tick = sim.tick, id = f.id, faction = f.faction, text = f.name .. ": route blocked" })
				Formation.clearOrder(f)
			end
		end
	end
end

-- Choke points: adopt / restore the travel column based on clearance ahead.
local function updateTravelShape(sim: SimLike, f: Formation)
	if f.class ~= "infantry" and f.class ~= "cavalry" then
		return
	end
	local path = f.path
	if not path or not path[f.pathIndex] then
		return
	end
	local ahead = Nav.segmentMinClearance(sim.nav, f.pos, path[f.pathIndex])
	if f.shape ~= "travel" and f.pendingShape ~= "travel" and ahead < f.width / 2 then
		Formation.beginShape(f, "travel", true)
	elseif f.shape == "travel" and f.prevShape and f.pendingShape == nil then
		-- Restore only when the remaining path has room for the previous shape.
		local prev: Types.Shape = f.prevShape :: Types.Shape
		local tmpShape: Types.Shape = f.shape
		f.shape = prev
		local w = Formation.footprint(f)
		f.shape = tmpShape
		local minAhead = math.huge
		for i = f.pathIndex, #path do
			local a = if i == f.pathIndex then f.pos else path[i - 1]
			local c = Nav.segmentMinClearance(sim.nav, a, path[i])
			if c < minAhead then
				minAhead = c
			end
		end
		if minAhead >= w / 2 and Grid.clearanceAt(sim.grid, f.pos.x, f.pos.z) >= w / 2 then
			Formation.beginShape(f, prev, false)
			f.prevShape = nil
		end
	end
end

-- Separation between friendly footprints; the lower id has priority at choke points.
local function avoid(sim: SimLike, f: Formation): number
	local scale = 1
	for _, otherId in sim.order do
		if otherId ~= f.id then
			local o = sim.formations[otherId]
			if o and o.faction == f.faction and Formation.isActive(o) and o.state ~= "melee" and f.state ~= "melee" then
				local minDist = f.halfRadius + o.halfRadius
				local d2 = Vec.dist2(f.pos, o.pos)
				if d2 < minDist * minDist and d2 > 0.01 then
					local d = math.sqrt(d2)
					local push = (minDist - d) * 0.5
					local dir = Vec.normalize(Vec.sub(f.pos, o.pos))
					if f.state == "moving" or f.state == "charging" or f.state == "routing" then
						if o.state == "moving" and o.id < f.id and Grid.clearanceAt(sim.grid, f.pos.x, f.pos.z) < 24 then
							scale = 0.5 -- yield at the choke point
						end
						local np = Vec.add(f.pos, Vec.scale(dir, math.min(push, 2) * DT * 10))
						if Nav.isWalkable(sim.nav, np) then
							f.pos = np
						end
					end
				end
			end
		end
	end
	return scale
end

local function routeToHome(sim: SimLike, f: Formation)
	if not f.path or not f.path[f.pathIndex] then
		local home = sim.homeEdge(sim, f.faction)
		-- Aim at a walkable point just inside the home edge; the exit rule removes the unit there.
		local edgeZ = math.clamp(home.z, 6, sim.grid.depth - 6)
		local want = { x = math.clamp(f.pos.x + (home.x - f.pos.x) * 0.2, 8, sim.grid.width - 8), z = edgeZ }
		local target = Nav.nearestWalkable(sim.nav, want, 12) or want
		if not Movement.plan(sim, f, target) then
			-- No route at all: drift straight toward home; the stuck rule removes the unit.
			f.path = { target }
			f.pathIndex = 1
		end
	end
end

-- Step 4 for one formation.
function Movement.update(sim: SimLike, f: Formation)
	if not Formation.isActive(f) then
		return
	end
	f.inWoods = Grid.terrainAt(sim.grid, f.pos.x, f.pos.z).blocksSight
	if f.state == "routing" then
		local m = Config.Morale.RoutExitMargin
		local home = sim.homeEdge(sim, f.faction)
		local waiting = (if home.z < 0 then f.pos.z < m else f.pos.z > sim.grid.depth - m) and not f.shattered
		if not waiting then
			routeToHome(sim, f)
			followPath(sim, f, 1)
		end
		-- At the home edge a routing formation waits in the rear and may still rally; only a
		-- shattered formation (or one hopelessly stuck / off the map) leaves the field for good.
		local atEdge = if home.z < 0 then f.pos.z < m else f.pos.z > sim.grid.depth - m
		if atEdge and not f.shattered then
			f.path = nil
			f.status = "Fled to the rear"
			return
		end
		if atEdge or f.timers.stuck > Config.Match.StuckSeconds * 3 or f.pos.x < -m or f.pos.z < -m or f.pos.x > sim.grid.width + m or f.pos.z > sim.grid.depth + m then
			f.state = "exited"
			sim.emit(sim, { kind = "destroyed", tick = sim.tick, id = f.id, faction = f.faction, text = f.name .. " has fled the field" })
		end
		return
	end
	if f.state == "reforming" or f.state == "rallying" or f.state == "melee" then
		-- Resting cohesion/fatigue handled elsewhere; no movement.
		return
	end
	local o = f.order
	if f.state == "idle" then
		if o and (o.kind == "Face") and o.heading then
			if turnToward(f, o.heading, DT) then
				f.order = nil
			end
		elseif o and o.kind == "Hold" then
			-- holding: nothing
		elseif o == nil and #f.queue > 0 then
			startNextQueued(sim, f)
		end
		local unit = Formation.unitConfig(f)
		f.fatigue = math.max(0, f.fatigue - unit.rest * DT)
		return
	end
	if f.state == "moving" or f.state == "charging" or f.state == "retreating" then
		if not f.path then
			local dest = orderDestination(sim, f)
			if not dest or not Movement.plan(sim, f, dest) then
				Formation.clearOrder(f)
				return
			end
		end
		-- Engage/Charge targets move: re-aim the path tail at the target periodically.
		if o and (o.kind == "Engage" or o.kind == "Charge") and o.targetId and sim.tick % 20 == 0 then
			local target = sim.findFormation(sim, o.targetId)
			if target and Formation.isActive(target) then
				-- Leash: stop chasing once the pursuit has gone further than the player ordered.
				if o.kind == "Engage" and o.anchor and Vec.dist(f.pos, o.anchor) > Config.Match.LeashDistance then
					sim.emit(sim, { kind = "message", tick = sim.tick, id = f.id, faction = f.faction, text = f.name .. ": halted, pursuit limit reached" })
					Formation.clearOrder(f)
					return
				end
				local path = f.path
				if path then
					path[#path] = { x = target.pos.x, z = target.pos.z }
				end
			else
				Formation.clearOrder(f)
				return
			end
		end
		updateTravelShape(sim, f)
		local scale = avoid(sim, f)
		followPath(sim, f, scale)
	end
end

return Movement
]]></ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX00000027"><Properties><bool name="Disabled">false</bool><string name="Name">Nav</string><ProtectedString name="Source"><![CDATA[--!strict
-- Formation navigation on a coarse grid derived from the terrain grid.
-- Nodes are Config.Map.NavCellSize studs; a node is walkable when its clearance allows at
-- least a travel column (half-width 8). Cost = distance / infantry terrain speed.
-- A* with a binary heap, then string-pulling that keeps the path inside walkable, clear ground.

local Shared = game:GetService("ReplicatedStorage"):WaitForChild("EoE")
local Config = require(Shared.Config)
local Grid = require(Shared.Grid)
local Vec = require(Shared.Vec)

type Vec = Vec.Vec
type Grid = Grid.Grid

export type NavGrid = {
	cols: number,
	rows: number,
	size: number,
	walk: { boolean },
	cost: { number }, -- per-node traversal cost multiplier (1 / speed)
	clear: { number }, -- min clearance in the node (studs)
	grid: Grid,
	cache: { [string]: { Vec }? },
}

local Nav = {}

local TRAVEL_HALF = 8
local SQRT2 = math.sqrt(2)

function Nav.build(grid: Grid): NavGrid
	local size = Config.Map.NavCellSize
	local cols = grid.width // size
	local rows = grid.depth // size
	local n = cols * rows
	local walk = table.create(n, false)
	local cost = table.create(n, 1)
	local clear = table.create(n, 0)
	local sub = size // grid.cell
	for nz = 0, rows - 1 do
		for nx = 0, cols - 1 do
			local maxClear = 0
			local speedSum = 0
			local count = 0
			local passable = true
			for sz = 0, sub - 1 do
				for sx = 0, sub - 1 do
					local cx = nx * sub + sx
					local cz = nz * sub + sz
					local idx = cz * grid.cols + cx + 1
					local t = Config.Terrain[grid.class[idx]]
					if not t.passable then
						passable = false
					end
					speedSum += t.speed
					count += 1
					if grid.clearance[idx] > maxClear then
						maxClear = grid.clearance[idx]
					end
				end
			end
			local i = nz * cols + nx + 1
			-- Some cell in the node must leave room for a travel column (bridges, defiles).
			walk[i] = passable or maxClear >= TRAVEL_HALF
			clear[i] = maxClear
			local avg = speedSum / count
			cost[i] = if avg > 0.05 then 1 / avg else 20
		end
	end
	return { cols = cols, rows = rows, size = size, walk = walk, cost = cost, clear = clear, grid = grid, cache = {} }
end

local function nodeOf(nav: NavGrid, p: Vec): (number, number)
	return math.clamp(math.floor(p.x / nav.size), 0, nav.cols - 1), math.clamp(math.floor(p.z / nav.size), 0, nav.rows - 1)
end

local function centre(nav: NavGrid, nx: number, nz: number): Vec
	return { x = (nx + 0.5) * nav.size, z = (nz + 0.5) * nav.size }
end

-- Binary heap keyed on f-score.
local function heapPush(heap: { number }, keys: { number }, node: number)
	heap[#heap + 1] = node
	local i = #heap
	while i > 1 do
		local parent = i // 2
		if keys[heap[parent]] <= keys[heap[i]] then
			break
		end
		heap[parent], heap[i] = heap[i], heap[parent]
		i = parent
	end
end

local function heapPop(heap: { number }, keys: { number }): number
	local top = heap[1]
	local last = table.remove(heap)
	if #heap > 0 and last then
		heap[1] = last
		local i = 1
		local n = #heap
		while true do
			local l, r = i * 2, i * 2 + 1
			local m = i
			if l <= n and keys[heap[l]] < keys[heap[m]] then
				m = l
			end
			if r <= n and keys[heap[r]] < keys[heap[m]] then
				m = r
			end
			if m == i then
				break
			end
			heap[m], heap[i] = heap[i], heap[m]
			i = m
		end
	end
	return top
end

-- Nearest walkable node to p (spiral search), or nil.
function Nav.nearestWalkable(nav: NavGrid, p: Vec, maxRadius: number?): Vec?
	local nx, nz = nodeOf(nav, p)
	local r = 0
	local limit = maxRadius or 6
	while r <= limit do
		for dz = -r, r do
			for dx = -r, r do
				if math.abs(dx) == r or math.abs(dz) == r then
					local x, z = nx + dx, nz + dz
					if x >= 0 and z >= 0 and x < nav.cols and z < nav.rows and nav.walk[z * nav.cols + x + 1] then
						return centre(nav, x, z)
					end
				end
			end
		end
		r += 1
	end
	return nil
end

function Nav.isWalkable(nav: NavGrid, p: Vec): boolean
	if not Grid.inBounds(nav.grid, p.x, p.z) then
		return false
	end
	local nx, nz = nodeOf(nav, p)
	return nav.walk[nz * nav.cols + nx + 1]
end

-- Straight segment stays on walkable nodes with clearance >= halfWidth (sampled every 4 studs).
local function segmentClear(nav: NavGrid, a: Vec, b: Vec, halfWidth: number): boolean
	local d = Vec.dist(a, b)
	local steps = math.max(1, math.ceil(d / 4))
	for i = 0, steps do
		local t = i / steps
		local x = a.x + (b.x - a.x) * t
		local z = a.z + (b.z - a.z) * t
		if not Grid.inBounds(nav.grid, x, z) then
			return false
		end
		local nx, nz = nodeOf(nav, { x = x, z = z })
		local idx = nz * nav.cols + nx + 1
		if not nav.walk[idx] then
			return false
		end
		if Grid.clearanceAt(nav.grid, x, z) < halfWidth then
			return false
		end
	end
	return true
end

-- A* from a to b. Returns a list of waypoints (excluding a, ending at b or the nearest
-- reachable point), or nil when no route exists. halfWidth only affects smoothing.
function Nav.findPath(nav: NavGrid, a: Vec, b: Vec, halfWidth: number): { Vec }?
	local cols, rows = nav.cols, nav.rows
	local sx, sz = nodeOf(nav, a)
	local gx, gz = nodeOf(nav, b)
	local start = sz * cols + sx + 1
	local goal = gz * cols + gx + 1
	if not nav.walk[goal] then
		local alt = Nav.nearestWalkable(nav, b, 4)
		if not alt then
			return nil
		end
		gx, gz = nodeOf(nav, alt)
		goal = gz * cols + gx + 1
		b = alt
	end
	if not nav.walk[start] then
		local alt = Nav.nearestWalkable(nav, a, 4)
		if not alt then
			return nil
		end
		sx, sz = nodeOf(nav, alt)
		start = sz * cols + sx + 1
	end
	local key = start .. ":" .. goal
	local cached = nav.cache[key]
	if cached ~= nil then
		return Nav.smooth(nav, a, cached, halfWidth)
	end

	local gScore: { [number]: number } = { [start] = 0 }
	local fScore: { number } = {}
	local came: { [number]: number } = {}
	local closed: { [number]: boolean } = {}
	local heap: { number } = {}
	local function h(i: number): number
		local x = (i - 1) % cols
		local z = (i - 1) // cols
		local dx, dz = math.abs(x - gx), math.abs(z - gz)
		return (math.max(dx, dz) + (SQRT2 - 1) * math.min(dx, dz)) * 0.7 -- admissible (min cost 1/1.3)
	end
	fScore[start] = h(start)
	heapPush(heap, fScore, start)
	local found = false
	local expanded = 0
	while #heap > 0 do
		local cur = heapPop(heap, fScore)
		if cur == goal then
			found = true
			break
		end
		if not closed[cur] then
			closed[cur] = true
			expanded += 1
			if expanded > 20000 then
				break
			end
			local cx = (cur - 1) % cols
			local cz = (cur - 1) // cols
			for dz = -1, 1 do
				for dx = -1, 1 do
					if dx ~= 0 or dz ~= 0 then
						local nx, nz = cx + dx, cz + dz
						if nx >= 0 and nz >= 0 and nx < cols and nz < rows then
							local ni = nz * cols + nx + 1
							if nav.walk[ni] and not closed[ni] then
								-- no corner cutting past blocked nodes
								local okDiag = true
								if dx ~= 0 and dz ~= 0 then
									okDiag = nav.walk[cz * cols + nx + 1] and nav.walk[nz * cols + cx + 1]
								end
								if okDiag then
									local stepCost = (if dx ~= 0 and dz ~= 0 then SQRT2 else 1) * (nav.cost[cur] + nav.cost[ni]) * 0.5
									local tentative = gScore[cur] + stepCost
									if gScore[ni] == nil or tentative < gScore[ni] then
										gScore[ni] = tentative
										came[ni] = cur
										fScore[ni] = tentative + h(ni)
										heapPush(heap, fScore, ni)
									end
								end
							end
						end
					end
				end
			end
		end
	end
	if not found then
		nav.cache[key] = nil
		return nil
	end
	local nodes: { Vec } = {}
	local cur = goal
	while cur ~= start do
		local x = (cur - 1) % cols
		local z = (cur - 1) // cols
		table.insert(nodes, 1, centre(nav, x, z))
		cur = came[cur]
	end
	nodes[#nodes] = b -- end exactly at the requested point
	nav.cache[key] = nodes
	return Nav.smooth(nav, a, nodes, halfWidth)
end

-- String pulling: from the current point, jump to the farthest waypoint reachable in a
-- straight clear line. Falls back to a column-width check so narrow passages are kept.
function Nav.smooth(nav: NavGrid, from: Vec, nodes: { Vec }, halfWidth: number): { Vec }
	local out: { Vec } = {}
	local cur = from
	local i = 1
	local n = #nodes
	while i <= n do
		local best = i
		for j = n, i + 1, -1 do
			if segmentClear(nav, cur, nodes[j], halfWidth) or segmentClear(nav, cur, nodes[j], TRAVEL_HALF) and j - i <= 2 then
				best = j
				break
			end
		end
		out[#out + 1] = nodes[best]
		cur = nodes[best]
		i = best + 1
	end
	return out
end

-- Minimum clearance along the next segment of a path from p (sampled), used to decide
-- whether the formation must adopt a travel column.
function Nav.segmentMinClearance(nav: NavGrid, a: Vec, b: Vec): number
	local d = Vec.dist(a, b)
	local steps = math.max(1, math.ceil(d / 8))
	local minC = math.huge
	for i = 0, steps do
		local t = i / steps
		local c = Grid.clearanceAt(nav.grid, a.x + (b.x - a.x) * t, a.z + (b.z - a.z) * t)
		if c < minC then
			minC = c
		end
	end
	return minC
end

return Nav
]]></ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX00000028"><Properties><bool name="Disabled">false</bool><string name="Name">Objectives</string><ProtectedString name="Source"><![CDATA[--!strict
-- Objective capture (step 9) and the single victory evaluator (step 10).

local Shared = game:GetService("ReplicatedStorage"):WaitForChild("EoE")
local Config = require(Shared.Config)
local Vec = require(Shared.Vec)
local Types = require(Shared.Types)
local MapGen = require(Shared.MapGen)

local Formation = require(script.Parent.Formation)

type Formation = Formation.Formation

export type ObjectiveState = {
	def: MapGen.Objective,
	owner: string?,
	capturing: string?,
	progress: number, -- 0..1
	contested: boolean,
	heldSince: number?, -- tick when current owner took it
	takenFromEnemy: boolean, -- captured from the other side at least once this battle
}

export type SimLike = {
	tick: number,
	formations: { [number]: Formation },
	order: { number },
	factions: { string },
	objectives: { ObjectiveState },
	emit: (sim: any, ev: Types.Event) -> (),
	log: (sim: any, text: string) -> (),
	playerFaction: string,
	enemyFaction: string,
	deployed: { [string]: number },
	timeLimit: number,
	clock: number,
}

local Objectives = {}

local DT = Config.Sim.DT
local O = Config.Objectives

function Objectives.init(defs: { MapGen.Objective }): { ObjectiveState }
	local out = {}
	for _, d in defs do
		out[#out + 1] = { def = d, owner = nil, capturing = nil, progress = 0, contested = false, heldSince = nil, takenFromEnemy = false }
	end
	return out
end

local function eligible(f: Formation): boolean
	if not (O.EligibleClasses :: any)[f.class] then
		return false
	end
	if not Formation.isActive(f) or f.state == "routing" or f.state == "rallying" or f.shattered then
		return false
	end
	if f.state == "reforming" and f.pendingShape == "square" then
		return false
	end
	return true
end

function Objectives.update(sim: SimLike)
	for _, obj in sim.objectives do
		local present: { [string]: number } = {}
		local r2 = obj.def.radius * obj.def.radius
		for _, id in sim.order do
			local f = sim.formations[id]
			if f and eligible(f) and Vec.dist2(f.pos, obj.def.pos) <= r2 then
				present[f.faction] = (present[f.faction] or 0) + 1
			end
		end
		local factionsPresent = 0
		local only: string? = nil
		for faction in present do
			factionsPresent += 1
			only = faction
		end
		obj.contested = factionsPresent > 1
		if factionsPresent == 1 and only and only ~= obj.owner then
			if obj.capturing ~= only then
				obj.capturing = only
				obj.progress = 0
			end
			obj.progress = math.min(1, obj.progress + DT / O.CaptureSeconds)
			if obj.progress >= 1 then
				local prev = obj.owner
				obj.owner = only
				obj.heldSince = sim.tick
				if prev ~= nil and prev ~= only then
					obj.takenFromEnemy = true
				end
				obj.capturing = nil
				obj.progress = 0
				sim.emit(sim, { kind = "capture", tick = sim.tick, faction = only, x = obj.def.pos.x, z = obj.def.pos.z, text = obj.def.name .. " taken" })
				sim.log(sim, string.format("%s captured %s%s", only, obj.def.name, if prev then " from " .. prev else ""))
			end
		elseif factionsPresent == 0 then
			-- Progress decays when nobody is present.
			if obj.capturing then
				obj.progress = math.max(0, obj.progress - DT / O.CaptureSeconds)
				if obj.progress == 0 then
					obj.capturing = nil
				end
			end
		end
		-- contested: progress frozen (no change)
	end
end

function Objectives.view(sim: SimLike): { Types.ObjectiveView }
	local out = {}
	for _, obj in sim.objectives do
		out[#out + 1] = {
			id = obj.def.id,
			name = obj.def.name,
			x = obj.def.pos.x,
			z = obj.def.pos.z,
			radius = obj.def.radius,
			owner = obj.owner,
			contested = obj.contested,
			progress = obj.progress,
			capturing = obj.capturing,
		}
	end
	return out
end

local function sideStats(sim: SimLike, faction: string)
	local total, broken, strength = 0, 0, 0
	for _, id in sim.order do
		local f = sim.formations[id]
		if f and f.faction == faction and f.state ~= "offmap" then
			total += 1
			if f.state == "routing" or f.state == "rallying" or f.shattered or not Formation.isActive(f) then
				broken += 1
			end
			if Formation.isActive(f) then
				strength += f.strength
			end
		end
	end
	return total, broken, strength
end

function Objectives.collapsed(sim: SimLike, faction: string): boolean
	local total, broken, strength = sideStats(sim, faction)
	if total == 0 then
		return true
	end
	if broken / total >= Config.Victory.CollapseFraction then
		return true
	end
	local deployed = sim.deployed[faction] or 1
	return strength < deployed * Config.Victory.CollapseStrengthFraction
end

function Objectives.heldAll(sim: SimLike, faction: string): boolean
	if #sim.objectives == 0 or sim.clock < O.HoldAllEarliest then
		return false
	end
	-- Holding what you started with is not a victory; at least one objective must have been
	-- taken from the enemy. The timeout rule still rewards the side holding more.
	local tookOne = false
	for _, obj in sim.objectives do
		if obj.owner == faction and obj.takenFromEnemy then
			tookOne = true
		end
	end
	if not tookOne then
		return false
	end
	for _, obj in sim.objectives do
		if obj.owner ~= faction or not obj.heldSince or (sim.tick - obj.heldSince) * DT < O.HoldAllSeconds then
			return false
		end
	end
	return true
end

function Objectives.countOwned(sim: SimLike, faction: string): number
	local n = 0
	for _, obj in sim.objectives do
		if obj.owner == faction then
			n += 1
		end
	end
	return n
end

-- Returns winner faction (or "draw") and reason, or nil while the battle continues.
-- Precedence: player collapse, enemy collapse, objectives held, timeout.
function Objectives.evaluate(sim: SimLike): (string?, string?)
	local player, enemy = sim.playerFaction, sim.enemyFaction
	if Objectives.collapsed(sim, player) then
		return enemy, "Your army has collapsed"
	end
	if Objectives.collapsed(sim, enemy) then
		return player, "The enemy army has collapsed"
	end
	if Objectives.heldAll(sim, player) then
		return player, "All objectives held"
	end
	if Objectives.heldAll(sim, enemy) then
		return enemy, "The enemy holds every objective"
	end
	if sim.clock >= sim.timeLimit then
		local p, e = Objectives.countOwned(sim, player), Objectives.countOwned(sim, enemy)
		if p > e then
			return player, "Time expired holding more objectives"
		elseif e > p then
			return enemy, "Time expired; the enemy holds more objectives"
		end
		return "draw", "Time expired with the field divided"
	end
	return nil, nil
end

return Objectives
]]></ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX00000029"><Properties><bool name="Disabled">false</bool><string name="Name">Visibility</string><ProtectedString name="Source"><![CDATA[--!strict
-- Per-faction visibility: which enemy formations are currently seen, and last-known memory.
-- Recomputed every Config.Sim.VisibilityEveryTicks ticks (step 5). The AI and the snapshot
-- filter both read this; nothing else decides what a faction knows.

local Shared = game:GetService("ReplicatedStorage"):WaitForChild("EoE")
local Config = require(Shared.Config)
local Grid = require(Shared.Grid)
local Vec = require(Shared.Vec)
local Types = require(Shared.Types)

local Formation = require(script.Parent.Formation)

type Formation = Formation.Formation

export type FactionView = {
	visible: { [number]: boolean },
	lastKnown: { [number]: Types.LastKnown },
	lastSeenTick: { [number]: number },
	lastSeenPos: { [number]: { x: number, z: number, heading: number, shape: Types.Shape, width: number, depth: number } },
}

export type SimLike = {
	grid: Grid.Grid,
	tick: number,
	formations: { [number]: Formation },
	order: { number },
	factions: { string },
	views: { [string]: FactionView },
	weather: string?,
}

local Visibility = {}

function Visibility.newView(): FactionView
	return { visible = {}, lastKnown = {}, lastSeenTick = {}, lastSeenPos = {} }
end

local function canSee(sim: SimLike, observer: Formation, target: Formation): boolean
	local spot = Formation.unitConfig(observer).spot * ((Config.Weather :: any)[sim.weather or "clear"] or Config.Weather.clear).spot
	local d = Vec.dist(observer.pos, target.pos)
	if target.inWoods then
		spot = math.min(spot, Config.Vision.WoodsReveal)
	end
	if d > spot then
		return false
	end
	if d <= Config.Vision.WoodsReveal then
		return true
	end
	return Grid.lineOfSight(sim.grid, observer.pos, target.pos)
end

function Visibility.update(sim: SimLike)
	local dt = Config.Sim.DT
	for _, faction in sim.factions do
		local view = sim.views[faction]
		local newVisible: { [number]: boolean } = {}
		for _, tid in sim.order do
			local target = sim.formations[tid]
			if target and target.faction ~= faction and Formation.isActive(target) then
				local seen = false
				for _, oid in sim.order do
					local obs = sim.formations[oid]
					if obs and obs.faction == faction and Formation.isActive(obs) and obs.state ~= "routing" then
						if canSee(sim, obs, target) then
							seen = true
							break
						end
					end
				end
				if seen then
					newVisible[tid] = true
					view.lastSeenTick[tid] = sim.tick
					view.lastSeenPos[tid] = { x = target.pos.x, z = target.pos.z, heading = target.heading, shape = target.shape, width = target.width, depth = target.depth }
					view.lastKnown[tid] = nil
				elseif view.visible[tid] then
					-- Just lost sight: freeze what was last actually seen (not the current state).
					local seenAt = view.lastSeenPos[tid]
					if seenAt then
						view.lastKnown[tid] = {
							id = tid,
							faction = target.faction,
							class = target.class,
							x = seenAt.x,
							z = seenAt.z,
							heading = seenAt.heading,
							shape = seenAt.shape,
							ageSeconds = 0,
							name = target.name,
							colour = target.colour,
							width = seenAt.width,
							depth = seenAt.depth,
						}
					end
				end
			elseif target and not Formation.isActive(target) then
				view.lastKnown[tid] = nil
			end
		end
		view.visible = newVisible
		for id, lk in view.lastKnown do
			lk.ageSeconds = (sim.tick - (view.lastSeenTick[id] or sim.tick)) * dt
			if lk.ageSeconds > Config.Vision.LastKnownForgetSeconds then
				view.lastKnown[id] = nil
			end
		end
	end
	-- Mirror onto formations for cheap checks.
	for _, id in sim.order do
		local f = sim.formations[id]
		if f then
			for _, faction in sim.factions do
				f.visibleTo[faction] = faction == f.faction or sim.views[faction].visible[id] == true
			end
		end
	end
end

function Visibility.isVisibleTo(sim: SimLike, viewer: string, id: number): boolean
	local f = sim.formations[id]
	if not f then
		return false
	end
	if f.faction == viewer then
		return true
	end
	local view = sim.views[viewer]
	return view ~= nil and view.visible[id] == true
end

return Visibility
]]></ProtectedString></Properties></Item></Item></Item></Item><Item class="StarterPlayer" referent="RBX00000066"><Properties><string name="Name">StarterPlayer</string><bool name="EnableMouseLockOption">false</bool><float name="CameraMaxZoomDistance">2000</float></Properties><Item class="StarterPlayerScripts" referent="RBX00000065"><Properties><string name="Name">StarterPlayerScripts</string></Properties><Item class="Folder" referent="RBX00000064"><Properties><string name="Name">EoEClient</string></Properties><Item class="ModuleScript" referent="RBX00000033"><Properties><bool name="Disabled">false</bool><string name="Name">Audio</string><ProtectedString name="Source"><![CDATA[--!strict
-- Sound registry + pooled Sound instances. Asset ids are intentionally empty: nothing is
-- invented. With an empty id a play() is a silent no-op and Audio.isSilent() reports it.

local SoundService = game:GetService("SoundService") :: SoundService
local Settings = require(script.Parent.Settings)
local Signal = require(script.Parent.Signal)

type Entry = { id: string, category: "sfx" | "music", volume: number, pool: number }

local REGISTRY: { [string]: Entry } = {
	volley = { id = "", category = "sfx", volume = 0.7, pool = 6 },
	cannon = { id = "", category = "sfx", volume = 0.9, pool = 4 },
	melee = { id = "", category = "sfx", volume = 0.6, pool = 3 },
	charge = { id = "", category = "sfx", volume = 0.7, pool = 2 },
	rout = { id = "", category = "sfx", volume = 0.5, pool = 2 },
	rally = { id = "", category = "sfx", volume = 0.5, pool = 2 },
	capture = { id = "", category = "sfx", volume = 0.6, pool = 2 },
	click = { id = "", category = "sfx", volume = 0.4, pool = 2 },
	battleMusic = { id = "", category = "music", volume = 0.5, pool = 1 },
}

local Audio = {}

local group: SoundGroup? = nil
local pools: { [string]: { Sound } } = {}
local cursor: { [string]: number } = {}
local settingsConn: Signal.Connection? = nil

local function applyVolume(name: string, s: Sound)
	local e = REGISTRY[name]
	local v = Settings.get()
	local cat = if e.category == "music" then v.music else v.sfx
	s.Volume = e.volume * cat * v.master
end

function Audio.init()
	if group then
		return
	end
	local g = Instance.new("SoundGroup") :: SoundGroup
	g.Name = "EoEAudio"
	g.Parent = SoundService
	group = g
	for name, e in REGISTRY do
		local list: { Sound } = {}
		if e.id ~= "" then
			for i = 1, e.pool do
				local s = Instance.new("Sound") :: Sound
				s.Name = name .. i
				s.SoundId = e.id
				s.Looped = e.category == "music"
				s.SoundGroup = g
				s.Parent = g
				applyVolume(name, s)
				list[i] = s
			end
		end
		pools[name] = list
		cursor[name] = 0
	end
	settingsConn = Settings.changed:Connect(function()
		for name, list in pools do
			for _, s in list do
				applyVolume(name, s)
			end
		end
	end)
end

-- True when no registered asset id is installed (the settings panel says so).
function Audio.isSilent(): boolean
	for _, e in REGISTRY do
		if e.id ~= "" then
			return false
		end
	end
	return true
end

function Audio.play(name: string)
	local list = pools[name]
	if not list or #list == 0 then
		return -- silent fallback
	end
	local i = cursor[name] % #list + 1
	cursor[name] = i
	local s = list[i]
	if s.IsPlaying and not s.Looped then
		s:Stop()
	end
	if not s.IsPlaying then
		s:Play()
	end
end

function Audio.stop(name: string)
	local list = pools[name]
	if list then
		for _, s in list do
			s:Stop()
		end
	end
end

function Audio.destroy()
	if settingsConn then
		settingsConn:Disconnect()
		settingsConn = nil
	end
	if group then
		group:Destroy()
		group = nil
	end
	table.clear(pools)
end

return Audio
]]></ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX00000034"><Properties><bool name="Disabled">false</bool><string name="Name">BattleState</string><ProtectedString name="Source"><![CDATA[--!strict
-- Client-side mirror of the match: merged snapshot data, pending orders, match metadata.
-- Every other client module reads from here; nothing reads cosmetic parts for gameplay.

local Signal = require(script.Parent.Signal)

export type Vec = { x: number, z: number }

export type Formation = {
	id: number,
	faction: string,
	name: string?,
	corps: string?,
	class: string,
	colour: string?,
	x: number,
	z: number,
	heading: number,
	shape: string,
	state: string,
	strength: number,
	startStrength: number,
	morale: number?,
	moraleBand: string,
	fatigue: number?,
	ammo: number?,
	reload: number?,
	cohesion: number?,
	width: number,
	depth: number,
	orderKind: string?,
	targetId: number?,
	fireAtWill: boolean?,
	limbered: boolean?,
	status: string?,
	rallyCd: number?,
	commander: boolean?,
	dest: Vec?,
	destHeading: number?,
	experience: number?,
	ammoMode: string?,
	queue: { Vec }?,
}

export type LastKnown = {
	id: number,
	faction: string,
	class: string,
	x: number,
	z: number,
	heading: number,
	shape: string,
	ageSeconds: number,
	name: string?,
	colour: string?,
	width: number,
	depth: number,
}

export type Objective = {
	id: string,
	name: string,
	x: number,
	z: number,
	radius: number,
	owner: string?,
	contested: boolean,
	progress: number,
	capturing: string?,
}

export type Event = {
	kind: string,
	x: number?,
	z: number?,
	id: number?,
	targetId: number?,
	faction: string?,
	text: string?,
	tick: number,
	tx: number?,
	tz: number?,
	n: number?,
}

export type Pending = {
	requestId: string,
	kind: string,
	ids: { number },
	pos: Vec?,
	heading: number?,
	frontage: number?,
	issuedAt: number,
}

local BattleState = {}

BattleState.matchId = ""
BattleState.state = "menu"
BattleState.viewerFaction = ""
BattleState.enemyFaction = ""
BattleState.isCommander = false
BattleState.difficulty = "normal"
BattleState.speed = 1
BattleState.scenario = nil :: any
BattleState.campaignBattle = nil :: any -- {battleId, name} when the match belongs to the campaign
BattleState.map = nil :: any -- MapGen.MapData once built
BattleState.clock = 0
BattleState.timeLimit = 0
BattleState.simLag = 0
BattleState.tick = 0
BattleState.lastSnapshotAt = 0

BattleState.formations = {} :: { [number]: Formation }
BattleState.lastKnown = {} :: { [number]: LastKnown }
BattleState.objectives = {} :: { Objective }
BattleState.reinforcements = {} :: { { id: number, name: string, corps: string, eta: number } } -- own side, off-map
BattleState.pending = {} :: { [string]: Pending }

BattleState.updated = Signal.new() -- (snapshot) after merge
BattleState.event = Signal.new() -- (event) one per snapshot event
BattleState.pendingChanged = Signal.new()
BattleState.orderRejected = Signal.new() -- (reason)

function BattleState.reset()
	table.clear(BattleState.formations)
	table.clear(BattleState.lastKnown)
	BattleState.objectives = {}
	BattleState.reinforcements = {}
	table.clear(BattleState.pending)
	BattleState.clock = 0
	BattleState.tick = 0
	BattleState.simLag = 0
	BattleState.lastSnapshotAt = 0
end

function BattleState.applyMatchState(msg: any)
	BattleState.matchId = msg.matchId or ""
	BattleState.state = msg.state or "menu"
	BattleState.viewerFaction = msg.viewerFaction or ""
	BattleState.isCommander = msg.isCommander == true
	BattleState.difficulty = msg.difficulty or "normal"
	BattleState.speed = msg.speed or 1
	BattleState.scenario = msg.scenario
	BattleState.campaignBattle = msg.campaignBattle
	if msg.scenario and msg.scenario.factions then
		local f = msg.scenario.factions
		BattleState.enemyFaction = if f.player == BattleState.viewerFaction then f.enemy else f.player
	end
end

function BattleState.applySnapshot(snap: any)
	if snap.matchId ~= BattleState.matchId then
		return
	end
	BattleState.tick = snap.tick
	BattleState.clock = snap.clock or 0
	BattleState.timeLimit = snap.timeLimit or 0
	BattleState.speed = snap.speed or BattleState.speed
	BattleState.simLag = snap.simLag or 0
	BattleState.lastSnapshotAt = os.clock()
	if snap.state then
		BattleState.state = snap.state
	end
	local forms = BattleState.formations
	if snap.kind == "full" then
		table.clear(forms)
	elseif snap.removed then
		for _, id in snap.removed do
			forms[id] = nil
		end
	end
	for _, f in snap.formations do
		forms[f.id] = f
	end
	-- lastKnown is sent whole each snapshot
	table.clear(BattleState.lastKnown)
	for _, lk in snap.lastKnown or {} do
		if forms[lk.id] == nil then
			BattleState.lastKnown[lk.id] = lk
		end
	end
	if snap.objectives then
		BattleState.objectives = snap.objectives
	end
	if snap.reinforcements then
		BattleState.reinforcements = snap.reinforcements
	elseif snap.kind == "full" then
		BattleState.reinforcements = {}
	end
	BattleState.updated:Fire(snap)
	for _, ev in snap.events or {} do
		BattleState.event:Fire(ev)
	end
end

function BattleState.addPending(p: Pending)
	BattleState.pending[p.requestId] = p
	BattleState.pendingChanged:Fire()
end

function BattleState.applyResult(res: any)
	local p = BattleState.pending[res.requestId]
	if not p then
		return
	end
	BattleState.pending[res.requestId] = nil
	if not res.accepted then
		BattleState.orderRejected:Fire(res.reason or "Order refused")
	end
	BattleState.pendingChanged:Fire()
end

-- Drop pending ghosts that never got an answer (lost packet, server restart).
function BattleState.expirePending(maxAge: number)
	local now = os.clock()
	local changed = false
	for id, p in BattleState.pending do
		if now - p.issuedAt > maxAge then
			BattleState.pending[id] = nil
			changed = true
		end
	end
	if changed then
		BattleState.pendingChanged:Fire()
	end
end

function BattleState.isOwn(f: { faction: string }): boolean
	return f.faction == BattleState.viewerFaction
end

function BattleState.ownFormations(): { Formation }
	local out = {}
	for _, f in BattleState.formations do
		if f.faction == BattleState.viewerFaction then
			table.insert(out, f)
		end
	end
	table.sort(out, function(a: Formation, b: Formation)
		return a.id < b.id
	end)
	return out
end

-- Centre of the viewer's army (or the map centre when nothing is fielded).
function BattleState.armyCentre(): Vec
	local sx, sz, n = 0, 0, 0
	for _, f in BattleState.formations do
		if f.faction == BattleState.viewerFaction then
			sx += f.x
			sz += f.z
			n += 1
		end
	end
	if n == 0 then
		local m = BattleState.map
		return { x = if m then m.width / 2 else 800, z = if m then m.depth / 2 else 600 }
	end
	return { x = sx / n, z = sz / n }
end

-- Validation context for Protocol.validateCommand.
function BattleState.validateContext(): any
	return {
		matchId = BattleState.matchId,
		state = BattleState.state,
		mapWidth = if BattleState.map then BattleState.map.width else 1600,
		mapDepth = if BattleState.map then BattleState.map.depth else 1200,
		isOwned = function(id: number): boolean
			local f = BattleState.formations[id]
			return f ~= nil and f.faction == BattleState.viewerFaction
		end,
		classOf = function(id: number): string?
			local f = BattleState.formations[id]
			return if f then f.class else nil
		end,
		legalShapes = function(id: number): { [string]: boolean }?
			local f = BattleState.formations[id]
			if not f then
				return nil
			end
			if f.class == "infantry" then
				return { line = true, column = true, square = true }
			elseif f.class == "cavalry" then
				return { wedge = true, line = true }
			end
			return nil
		end,
	}
end

return BattleState
]]></ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX00000035"><Properties><bool name="Disabled">false</bool><string name="Name">Camera</string><ProtectedString name="Source"><![CDATA[--!strict
-- Scriptable RTS camera: bounded pan, rotate, zoom, pitch; never clips into hills.
-- Height is measured above the terrain under the focus point.

local RunService = game:GetService("RunService") :: RunService
local UserInputService = game:GetService("UserInputService") :: UserInputService
local Shared = game:GetService("ReplicatedStorage"):WaitForChild("EoE")
local Grid = require(Shared.Grid)
local Settings = require(script.Parent.Settings)

local Camera = {}

local MIN_HEIGHT, MAX_HEIGHT = 120, 900
local MIN_PITCH, MAX_PITCH = math.rad(35), math.rad(65)
local DEFAULT_PITCH = math.rad(52)
-- NTW-style: the view tilts toward the horizon as it nears the ground (full tilt at MIN_HEIGHT,
-- none above TILT_FROM).
local TILT_MAX = math.rad(18)
local TILT_FROM = 520
local INTRO_SECONDS = 11
local DEFAULT_HEIGHT = 420
local DEFAULT_YAW = math.pi / 2 -- look toward +z (north)
local PAN_SPEED = 1.1 -- studs per second per stud of height
local ROTATE_SPEED = 1.6
local ZOOM_STEP = 1.15
local DAMP = 10

-- target values (inputs move these) and smoothed values (what is rendered)
local target = { x = 800, z = 600, yaw = DEFAULT_YAW, pitch = DEFAULT_PITCH, height = DEFAULT_HEIGHT }
local cur = { x = 800, z = 600, yaw = DEFAULT_YAW, pitch = DEFAULT_PITCH, height = DEFAULT_HEIGHT }
local map: any = nil
local bounds = { x0 = 0, z0 = 0, x1 = 1600, z1 = 1200 }
local shakeAmount = 0
local connections: { RBXScriptConnection } = {}
local bound = false
local enabled = true
-- cinematic intro: sweeps from `from` to `to` over INTRO_SECONDS; any input skips it
type View = { x: number, z: number, yaw: number, pitch: number, height: number }
local intro: { t0: number, from: View, to: View }? = nil
local lastFrameHeight = DEFAULT_HEIGHT

local function groundY(x: number, z: number): number
	if map then
		return Grid.heightAt(map.grid, x, z)
	end
	return 0
end

local function textBoxFocused(): boolean
	return (UserInputService:GetFocusedTextBox() :: TextBox?) ~= nil
end

-- The focus keeps a margin from the map edge that grows with height, so the frustum stays
-- over the terrain instead of showing sky past the edge.
local function clampTarget()
	target.height = math.clamp(target.height, MIN_HEIGHT, MAX_HEIGHT)
	target.pitch = math.clamp(target.pitch, MIN_PITCH, MAX_PITCH)
	local w, d = bounds.x1 - bounds.x0, bounds.z1 - bounds.z0
	local margin = math.clamp(target.height * 0.45, 40, math.min(w, d) * 0.3)
	target.x = math.clamp(target.x, bounds.x0 + margin, bounds.x1 - margin)
	target.z = math.clamp(target.z, bounds.z0 + margin, bounds.z1 - margin)
end

local function readKeys(dt: number)
	if not enabled or textBoxFocused() then
		return
	end
	local isDown = function(k: EnumKeyCode): boolean
		return UserInputService:IsKeyDown(k)
	end
	local fwd = 0
	local side = 0
	if isDown(Enum.KeyCode.W) or isDown(Enum.KeyCode.Up) then
		fwd += 1
	end
	if isDown(Enum.KeyCode.S) or isDown(Enum.KeyCode.Down) then
		fwd -= 1
	end
	if isDown(Enum.KeyCode.D) or isDown(Enum.KeyCode.Right) then
		side += 1
	end
	if isDown(Enum.KeyCode.A) or isDown(Enum.KeyCode.Left) then
		side -= 1
	end
	if fwd ~= 0 or side ~= 0 then
		local speed = PAN_SPEED * cur.height * dt
		-- forward on screen = look direction projected on the ground; right = +90° in sim space
		-- is the screen-left in Roblox (Y-up, right-handed), so screen-right is yaw - 90°.
		local fx, fz = math.cos(cur.yaw), math.sin(cur.yaw)
		local rx, rz = math.cos(cur.yaw - math.pi / 2), math.sin(cur.yaw - math.pi / 2)
		target.x += (fx * fwd + rx * side) * speed
		target.z += (fz * fwd + rz * side) * speed
	end
	if isDown(Enum.KeyCode.Q) then
		target.yaw += ROTATE_SPEED * dt
	end
	if isDown(Enum.KeyCode.E) then
		target.yaw -= ROTATE_SPEED * dt
	end
	if isDown(Enum.KeyCode.PageUp) then
		target.pitch += 0.8 * dt
	end
	if isDown(Enum.KeyCode.PageDown) then
		target.pitch -= 0.8 * dt
	end
	clampTarget()
end

local function smoothstep(t: number): number
	t = math.clamp(t, 0, 1)
	return t * t * (3 - 2 * t)
end

local function finishIntro()
	local i = intro
	if not i then
		return
	end
	intro = nil
	target.x, target.z, target.yaw, target.pitch, target.height = i.to.x, i.to.z, i.to.yaw, i.to.pitch, i.to.height
	cur.x, cur.z, cur.yaw, cur.pitch, cur.height = i.to.x, i.to.z, i.to.yaw, i.to.pitch, i.to.height
end

local function stepIntro(): boolean
	local i = intro
	if not i then
		return false
	end
	local t = (os.clock() - i.t0) / INTRO_SECONDS
	if t >= 1 then
		finishIntro()
		return false
	end
	local e = smoothstep(t)
	local a, b = i.from, i.to
	cur.x = a.x + (b.x - a.x) * e
	cur.z = a.z + (b.z - a.z) * e
	cur.yaw = a.yaw + (b.yaw - a.yaw) * e
	cur.pitch = a.pitch + (b.pitch - a.pitch) * e
	-- rise a little mid-sweep, then settle onto the default view
	cur.height = a.height + (b.height - a.height) * e + math.sin(e * math.pi) * 120
	return true
end

local function step(dt: number)
	if not stepIntro() then
		readKeys(dt)
		local k = 1 - math.exp(-DAMP * dt)
		cur.x += (target.x - cur.x) * k
		cur.z += (target.z - cur.z) * k
		cur.height += (target.height - cur.height) * k
		cur.pitch += (target.pitch - cur.pitch) * k
		-- shortest-way yaw blend
		local dy = (target.yaw - cur.yaw + math.pi) % (2 * math.pi) - math.pi
		cur.yaw += dy * k
	end

	local focusY = groundY(cur.x, cur.z)
	local tilt = TILT_MAX * math.clamp((TILT_FROM - cur.height) / (TILT_FROM - MIN_HEIGHT), 0, 1)
	local pitch = cur.pitch - tilt
	local dist = cur.height / math.tan(pitch)
	local camX = cur.x - math.cos(cur.yaw) * dist
	local camZ = cur.z - math.sin(cur.yaw) * dist
	local camY = focusY + cur.height
	-- never clip into hills: the camera and the line to the focus stay above the terrain
	camY = math.max(camY, groundY(camX, camZ) + 14)
	for i = 1, 4 do
		local t = i / 5
		local sx, sz = camX + (cur.x - camX) * t, camZ + (cur.z - camZ) * t
		local lineY = camY + (focusY - camY) * t
		local need = groundY(sx, sz) + 8
		if lineY < need then
			camY += (need - lineY) / (1 - t)
		end
	end
	lastFrameHeight = camY - focusY
	local pos = Vector3.new(camX, camY, camZ)
	if shakeAmount > 0.01 then
		local s = if Settings.get().reducedShake then shakeAmount * 0.3 else shakeAmount
		pos += Vector3.new((math.random() - 0.5) * s, (math.random() - 0.5) * s, (math.random() - 0.5) * s)
		shakeAmount *= math.exp(-6 * dt)
	end
	local cam = workspace.CurrentCamera
	if cam then
		cam.CameraType = Enum.CameraType.Scriptable
		cam.CFrame = CFrame.lookAt(pos, Vector3.new(cur.x, focusY, cur.z))
	end
end

function Camera.init()
	if bound then
		return
	end
	bound = true
	local cam = workspace.CurrentCamera
	if cam then
		cam.CameraType = Enum.CameraType.Scriptable
		cam.FieldOfView = 55
	end
	RunService:BindToRenderStep("EoECamera", Enum.RenderPriority.Camera.Value, step)
	table.insert(connections, UserInputService.InputBegan:Connect(function(input: InputObject)
		local t = input.UserInputType
		if intro and (t == Enum.UserInputType.Keyboard or t == Enum.UserInputType.MouseButton1 or t == Enum.UserInputType.MouseButton2 or t == Enum.UserInputType.Touch or t == Enum.UserInputType.Gamepad1) then
			finishIntro()
		end
	end))
	table.insert(connections, UserInputService.InputChanged:Connect(function(input: InputObject, gp: boolean)
		if input.UserInputType == Enum.UserInputType.MouseWheel and intro then
			finishIntro()
			return
		end
		if gp or not enabled or input.UserInputType ~= Enum.UserInputType.MouseWheel then
			return
		end
		if input.Position.Z > 0 then
			target.height /= ZOOM_STEP
		elseif input.Position.Z < 0 then
			target.height *= ZOOM_STEP
		end
		clampTarget()
	end))
end

function Camera.setMap(m: any)
	map = m
	if m then
		bounds = { x0 = 0, z0 = 0, x1 = m.width, z1 = m.depth }
	end
	clampTarget()
end

function Camera.setEnabled(on: boolean)
	enabled = on
end

function Camera.focusOn(x: number, z: number, snap: boolean?)
	target.x, target.z = x, z
	clampTarget()
	if snap then
		cur.x, cur.z = target.x, target.z
	end
end

-- Default angle: high oblique, look north from the south at 52°, 420 studs up.
function Camera.reset(x: number, z: number)
	intro = nil
	target.yaw = DEFAULT_YAW
	target.pitch = DEFAULT_PITCH
	target.height = DEFAULT_HEIGHT
	Camera.focusOn(x, z, true)
	cur.yaw, cur.pitch, cur.height = target.yaw, target.pitch, target.height
end

-- Sweeps in from high over the far side of the field, turning onto the current default view
-- (call after Camera.reset). Skipped by any key, click or wheel.
function Camera.playIntro()
	if not map then
		return
	end
	local to: View = { x = target.x, z = target.z, yaw = target.yaw, pitch = target.pitch, height = target.height }
	local cx, cz = map.width / 2, map.depth / 2
	-- start across the map centre from the destination, looking back toward it
	local fx = math.clamp(cx + (cx - to.x) * 0.6, map.width * 0.2, map.width * 0.8)
	local fz = math.clamp(cz + (cz - to.z) * 0.6, map.depth * 0.2, map.depth * 0.8)
	local from: View = { x = fx, z = fz, yaw = to.yaw - 2.4, pitch = math.rad(40), height = 700 }
	intro = { t0 = os.clock(), from = from, to = to }
	cur.x, cur.z, cur.yaw, cur.pitch, cur.height = from.x, from.z, from.yaw, from.pitch, from.height
end

function Camera.introPlaying(): boolean
	return intro ~= nil
end

function Camera.getFocus(): (number, number)
	return cur.x, cur.z
end

function Camera.getYaw(): number
	return cur.yaw
end

function Camera.height(): number
	return lastFrameHeight
end

function Camera.groundHeight(x: number, z: number): number
	return groundY(x, z)
end

function Camera.shake(amount: number)
	shakeAmount = math.max(shakeAmount, amount)
end

function Camera.destroy()
	if not bound then
		return
	end
	bound = false
	RunService:UnbindFromRenderStep("EoECamera")
	intro = nil
	for _, c in connections do
		c:Disconnect()
	end
	table.clear(connections)
end

return Camera
]]></ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX00000036"><Properties><bool name="Disabled">false</bool><string name="Name">Effects</string><ProtectedString name="Source"><![CDATA[--!strict
-- Pooled one-shot visual effects driven by snapshot events only: lingering volley smoke banks,
-- muzzle flashes, cannon plumes and shot strikes, charge dust, routing markers.

local Shared = game:GetService("ReplicatedStorage"):WaitForChild("EoE")
local Grid = require(Shared.Grid)
local Settings = require(script.Parent.Settings)
local BattleState = require(script.Parent.BattleState)
local Camera = require(script.Parent.Camera)

local Effects = {}

type Active = {
	part: Part,
	t0: number,
	life: number,
	size0: number,
	size1: number,
	rise: number,
	x: number,
	y: number,
	z: number,
	vx: number,
	vz: number,
	alpha0: number,
}

-- Lingering smoke needs a deep pool; reduced effects halves it (and the puffs per event).
local BASE_POOL = { [1] = 120, [2] = 260, [3] = 420 }
local WIND_X, WIND_Z = 0.9, 0.35 -- studs/s drift, light breeze from the south-west

local folder: Folder? = nil
local free: { Part } = {}
local active: { Active } = {}
local capacity = 0
local density = 1
local rng = Random.new(1806)

local SMOKE = Color3.fromRGB(236, 234, 228)
local SMOKE_GREY = Color3.fromRGB(200, 198, 192)
local DUST = Color3.fromRGB(184, 166, 124)
local EARTH = Color3.fromRGB(110, 92, 64)
local FLASH = Color3.fromRGB(255, 214, 120)
local ROUT = Color3.fromRGB(150, 60, 50)

local function groundY(x: number, z: number): number
	local m = BattleState.map
	return if m then Grid.heightAt(m.grid, x, z) else 0
end

local function makePart(): Part
	local p = Instance.new("Part") :: Part
	p.Shape = Enum.PartType.Ball
	p.Anchored = true
	p.CanCollide = false
	p.CanTouch = false
	p.CanQuery = false
	p.CastShadow = false
	p.Material = Enum.Material.SmoothPlastic
	p.Size = Vector3.new(1, 1, 1)
	p.Transparency = 1
	return p
end

function Effects.init()
	if folder then
		return
	end
	local f = Instance.new("Folder") :: Folder
	f.Name = "EoEEffects"
	f.Parent = workspace
	folder = f
	Effects.applySettings()
end

function Effects.applySettings()
	local s = Settings.get()
	capacity = BASE_POOL[math.clamp(s.quality, 1, 3)]
	density = 1
	if s.reducedEffects then
		capacity = capacity // 2
		density = 0.5
	end
end

local function count(n: number): number
	return math.max(1, math.round(n * density))
end

local function spawn(x: number, y: number, z: number, color: Color3, size0: number, size1: number, life: number, rise: number, alpha0: number, vx: number?, vz: number?)
	if not folder or #active >= capacity then
		return
	end
	local p = table.remove(free) or makePart()
	p.Color = color
	p.Size = Vector3.new(size0, size0, size0)
	p.Transparency = alpha0
	p.CFrame = CFrame.new(x, y, z)
	p.Parent = folder
	table.insert(active, { part = p, t0 = os.clock(), life = life, size0 = size0, size1 = size1, rise = rise, x = x, y = y, z = z, vx = vx or 0, vz = vz or 0, alpha0 = alpha0 })
end

local function puffs(x: number, z: number, n: number, spread: number, color: Color3, size: number, life: number, rise: number)
	local y = groundY(x, z) + 1.5
	for _ = 1, count(n) do
		local ox = (rng:NextNumber() - 0.5) * spread
		local oz = (rng:NextNumber() - 0.5) * spread
		spawn(x + ox, y + rng:NextNumber() * 1.5, z + oz, color, size * 0.6, size * (1.4 + rng:NextNumber() * 0.6), life, rise, 0.3, ox * 0.4, oz * 0.4)
	end
end

-- A bank of overlapping smoke along the firing front: flashes first, then smoke that swells,
-- drifts with the breeze and fades over ~6 s.
local function volley(ev: any)
	local f = BattleState.formations[ev.id or -1]
	if not f then
		if ev.x then
			puffs(ev.x, ev.z, 5, 14, SMOKE, 4, 5, 2)
		end
		return
	end
	local fx, fz = math.cos(f.heading), math.sin(f.heading)
	local rx, rz = -fz, fx
	local frontX = f.x + fx * (f.depth / 2 + 1.5)
	local frontZ = f.z + fz * (f.depth / 2 + 1.5)
	local n = count(math.clamp(math.floor(f.width / 3.5), 4, 22))
	for i = 1, n do
		local t = (i - 0.5) / n - 0.5 + (rng:NextNumber() - 0.5) / n
		local px = frontX + rx * f.width * t
		local pz = frontZ + rz * f.width * t
		local y = groundY(px, pz) + 1.9
		spawn(px, y, pz, FLASH, 0.9, 0.3, 0.1, 0, 0.05)
		-- muzzle puff thrown forward, then the bank behind it
		spawn(px + fx * 1.5, y + 0.3, pz + fz * 1.5, SMOKE, 1.6, 5 + rng:NextNumber() * 2, 6 + rng:NextNumber() * 1.5, 3, 0.25, fx * 1.2 + WIND_X, fz * 1.2 + WIND_Z)
		if rng:NextNumber() < 0.6 then
			spawn(px + fx * 3, y + 1.2, pz + fz * 3, SMOKE_GREY, 2.5, 6.5, 5.5, 4, 0.45, fx * 0.6 + WIND_X, fz * 0.6 + WIND_Z)
		end
	end
	Camera.shake(0.2)
end

local function cannon(ev: any)
	if not ev.x then
		return
	end
	local y = groundY(ev.x, ev.z) + 1.6
	local dx, dz = 0, 0
	if ev.tx then
		local l = math.sqrt((ev.tx - ev.x) ^ 2 + (ev.tz - ev.z) ^ 2)
		if l > 1 then
			dx, dz = (ev.tx - ev.x) / l, (ev.tz - ev.z) / l
		end
	end
	spawn(ev.x + dx * 3.5, y, ev.z + dz * 3.5, FLASH, 2.5, 0.6, 0.14, 0, 0.05)
	-- a thick plume rolling out of the muzzle
	for i = 1, count(6) do
		local d = 3 + i * 2.2
		spawn(ev.x + dx * d, y + 0.5 + i * 0.3, ev.z + dz * d, if i % 2 == 0 then SMOKE_GREY else SMOKE, 2.5 + i * 0.6, 8 + i * 1.2, 6.5, 4, 0.2, dx * 1.5 + WIND_X, dz * 1.5 + WIND_Z)
	end
	if ev.tx then
		-- round shot strikes: a spray of earth and a dust puff
		local ty = groundY(ev.tx, ev.tz)
		for _ = 1, count(4) do
			spawn(ev.tx + (rng:NextNumber() - 0.5) * 3, ty + 0.5, ev.tz + (rng:NextNumber() - 0.5) * 3, EARTH, 1.2, 2.5, 0.9, 4, 0.1, dx * 3, dz * 3)
		end
		puffs(ev.tx, ev.tz, 3, 6, DUST, 3, 2.2, 1.5)
	end
	Camera.shake(1.2)
end

-- Dust thrown up behind a charging formation.
local function charge(ev: any)
	local f = BattleState.formations[ev.id or -1]
	if f then
		local fx, fz = math.cos(f.heading), math.sin(f.heading)
		local rx, rz = -fz, fx
		local n = count(10)
		for i = 1, n do
			local t = (i - 0.5) / n - 0.5
			local px = f.x - fx * f.depth / 2 + rx * f.width * t
			local pz = f.z - fz * f.depth / 2 + rz * f.width * t
			spawn(px, groundY(px, pz) + 1, pz, DUST, 2, 6, 3, 2, 0.35, -fx * 2 + WIND_X, -fz * 2 + WIND_Z)
		end
	elseif ev.x then
		puffs(ev.x, ev.z, 8, 26, DUST, 3.5, 2.5, 2)
	end
end

function Effects.onEvent(ev: any)
	if not folder then
		return
	end
	local kind = ev.kind
	if kind == "volley" then
		volley(ev)
	elseif kind == "cannon" then
		cannon(ev)
	elseif kind == "melee" then
		if ev.x then
			puffs(ev.x, ev.z, 5, 18, DUST, 3, 1.6, 1.5)
		end
	elseif kind == "charge" then
		charge(ev)
	elseif kind == "rout" then
		if ev.x then
			puffs(ev.x, ev.z, 3, 14, DUST, 2.5, 1.4, 1)
			spawn(ev.x, groundY(ev.x, ev.z) + 6, ev.z, ROUT, 3, 1, 2.5, 6, 0.3)
		end
	end
end

function Effects.update(_dt: number)
	local now = os.clock()
	local i = 1
	while i <= #active do
		local a = active[i]
		local age = now - a.t0
		local t = age / a.life
		if t >= 1 then
			a.part.Parent = nil
			table.insert(free, a.part)
			active[i] = active[#active]
			active[#active] = nil
		else
			local s = a.size0 + (a.size1 - a.size0) * math.sqrt(t)
			a.part.Size = Vector3.new(s, s * 0.85, s)
			-- hold density for the first third, then thin out
			local fade = math.clamp((t - 0.3) / 0.7, 0, 1)
			a.part.Transparency = a.alpha0 + (1 - a.alpha0) * fade * fade
			a.part.CFrame = CFrame.new(a.x + a.vx * age, a.y + a.rise * t, a.z + a.vz * age)
			i += 1
		end
	end
end

function Effects.clear()
	for _, a in active do
		a.part:Destroy()
	end
	table.clear(active)
	for _, p in free do
		p:Destroy()
	end
	table.clear(free)
	if folder then
		folder:Destroy()
		folder = nil
	end
end

return Effects
]]></ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX00000037"><Properties><bool name="Disabled">false</bool><string name="Name">Factions</string><ProtectedString name="Source"><![CDATA[--!strict
-- Faction look-ups shared by the HUD, figures, props and minimap: colours (palette key from a
-- unit `colour` override, else the faction), display names and marker-flag designs.

local Shared = game:GetService("ReplicatedStorage"):WaitForChild("EoE")
local Config = require(Shared.Config)

local Factions = {}

local P = Config.Visual.Palette :: { [string]: { number } }

-- Fallbacks for palette keys the shared Config may not define yet.
local DEFAULTS: { [string]: { number } } = {
	France = { 44, 79, 166 },
	Prussia = { 58, 61, 66 },
	Saxony = { 108, 113, 128 },
	Russia = { 46, 98, 60 },
	Austria = { 232, 228, 220 },
	Britain = { 170, 40, 44 },
	Bavaria = { 92, 150, 200 },
	Netherlands = { 214, 120, 40 },
}

local NAMES: { [string]: string } = {
	france = "France",
	prussia = "Prussia",
	russia = "Russia",
	austria = "Austria",
	britain = "Britain",
	saxony = "Saxony",
	bavaria = "Bavaria",
	netherlands = "Netherlands",
}

local function rgb(t: { number }): Color3
	return Color3.fromRGB(t[1], t[2], t[3])
end

local function keyFor(faction: string?): string
	local f = faction or ""
	return string.upper(string.sub(f, 1, 1)) .. string.sub(f, 2)
end

-- Palette colour for a palette key ("Saxony") or a faction id ("prussia").
function Factions.colour(faction: string?, override: string?): Color3
	local key = override or keyFor(faction)
	local t = P[key] or DEFAULTS[key]
	if t then
		return rgb(t)
	end
	return Color3.fromRGB(120, 108, 96)
end

function Factions.name(faction: string?): string
	return NAMES[faction or ""] or tostring(faction or "—")
end

export type Flag = {
	bands: { Color3 }?, -- vertical bands, left to right
	field: Color3?, -- plain field when there are no bands
	mark: string?, -- "diamond" | "x" | "plus" | "double" | "diagonal"
	markColour: Color3,
}

local WHITE = Color3.fromRGB(242, 240, 232)
local BLACK = Color3.fromRGB(28, 26, 24)
local GOLD = Color3.fromRGB(205, 168, 62)

local FLAGS: { [string]: Flag } = {
	france = { bands = { Color3.fromRGB(30, 62, 150), Color3.fromRGB(240, 238, 230), Color3.fromRGB(190, 42, 50) }, mark = "diamond", markColour = GOLD },
	prussia = { field = WHITE, mark = "x", markColour = BLACK },
	russia = { field = Color3.fromRGB(40, 96, 56), mark = "diamond", markColour = GOLD },
	austria = { field = WHITE, mark = "double", markColour = BLACK },
	britain = { field = Color3.fromRGB(178, 36, 42), mark = "plus", markColour = WHITE },
}

function Factions.flag(faction: string?): Flag
	local f = FLAGS[faction or ""]
	if f then
		return f
	end
	return { field = Factions.colour(faction), mark = "diagonal", markColour = WHITE }
end

-- How much the far-LOD slab is darkened (Prussian blocks read near-black in the reference).
function Factions.slabDarken(faction: string?): number
	return if faction == "prussia" then 0.45 else 0.12
end

return Factions
]]></ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX00000038"><Properties><bool name="Disabled">false</bool><string name="Name">Figures</string><ProtectedString name="Source"><![CDATA[--!strict
-- Formation visuals: procedural figures (near LOD) or rank blocks (far LOD), nameplate
-- markers, selection rings, destination ghosts and route lines. Purely cosmetic: nothing here
-- is read for gameplay. Parts are anchored and moved with workspace:BulkMoveTo.

local Shared = game:GetService("ReplicatedStorage"):WaitForChild("EoE")
local Config = require(Shared.Config)
local Grid = require(Shared.Grid)
local Vec = require(Shared.Vec)
local BattleState = require(script.Parent.BattleState)
local Selection = require(script.Parent.Selection)
local Settings = require(script.Parent.Settings)
local Factions = require(script.Parent.Factions)
local Soldiers = require(script.Parent.World.Soldiers)

local Figures = {}

local P = Config.Visual.Palette
local function rgb(t: { number }): Color3
	return Color3.fromRGB(t[1], t[2], t[3])
end
local CREAM = rgb(P.Cream)
local INK = rgb(P.Ink)
local SELECT = rgb(P.Select)
local HOSTILE = rgb(P.Hostile)

local SNAP_DT = 0.1
local MAX_EXTRAP = 0.15
local LABEL_INTERVAL = 0.15

type Slot = { x: number, z: number, sx: number, sz: number, phase: number } -- local offset + scatter (routing spread)
type Marker = {
	parts: { BasePart },
	locals: { CFrame },
	plate: Part,
	gui: SurfaceGui,
	nameLabel: TextLabel,
	statusLabel: TextLabel,
	bar: Frame,
	barFill: Frame,
	height: number,
	priority: number,
}
type Group = {
	id: number,
	faction: string,
	class: string,
	colour: Color3,
	ghost: boolean,
	lod: string, -- "near" | "far"
	parts: { BasePart },
	locals: { CFrame },
	slots: { Slot },
	partSlot: { number }, -- part index -> slot index (0 = formation-relative, no bob)
	anim: { number }, -- part index -> Soldiers anim code
	pivot: { number }, -- part index -> swing pivot height
	layoutKey: string,
	p0x: number,
	p0z: number,
	p0h: number,
	p1x: number,
	p1z: number,
	p1h: number,
	t1: number,
	rx: number,
	rz: number,
	rh: number,
	dirty: boolean,
	phase: number,
	marker: Marker,
	ring: { BasePart }?,
	ringColour: Color3?,
	dest: { BasePart },
	route: { BasePart },
	destKey: string,
}

local folder: Folder? = nil
local groups: { [number]: Group } = {}
local previews: { BasePart } = {}
local thinK = 1
local labelClock = 0
local pendingKey = ""
local prevSelected: { [number]: boolean } = {}

-- ------------------------------------------------------------------ part helpers

local function mk(className: string, size: Vector3, color: Color3): BasePart
	local p = Instance.new(className) :: BasePart
	p.Size = size
	p.Color = color
	p.Material = Enum.Material.SmoothPlastic
	p.Anchored = true
	p.CanCollide = false
	p.CanTouch = false
	p.CanQuery = false
	p.CastShadow = true
	p.TopSurface = Enum.SurfaceType.Smooth
	p.BottomSurface = Enum.SurfaceType.Smooth
	return p
end

local function cylinder(length: number, radius: number, color: Color3): BasePart
	local p = mk("Part", Vector3.new(length, radius * 2, radius * 2), color) :: Part
	p.Shape = Enum.PartType.Cylinder
	return p
end

local function groundY(x: number, z: number): number
	local m = BattleState.map
	return if m then Grid.heightAt(m.grid, x, z) else 0
end

-- Yaw so local +X points along a sim heading and local +Z is the formation's right.
local function frame(x: number, y: number, z: number, heading: number): CFrame
	return CFrame.new(x, y, z) * CFrame.Angles(0, -heading, 0)
end

local function factionColour(faction: string, colourKey: string?): Color3
	return Factions.colour(faction, colourKey)
end

local function desaturate(c: Color3): Color3
	local g = (c.R + c.G + c.B) / 3
	return Color3.new(g, g, g):Lerp(c, 0.25):Lerp(Color3.new(0.75, 0.72, 0.68), 0.3)
end

local function figureCount(class: string, strength: number?): number
	strength = strength or 0
	if class == "hq" then
		return 2
	elseif class == "artillery" then
		return math.max(1, math.ceil(strength / Config.Visual.CrewPerGun))
	end
	return math.max(1, math.ceil(strength / Config.Visual.SoldiersPerFigure))
end

-- ------------------------------------------------------------------ layout

-- Returns local (x forward, z right) offsets for n figures in the formation footprint.
local function layoutSlots(class: string, shape: string, n: number, width: number, depth: number, k: number, seed: number): { Slot }
	local cells: { { number } } = {} -- {file, rank, files, ranks}
	local shapeDef = (Config.Shapes :: any)[shape]
	local ranks = if shapeDef then shapeDef.ranks else 3
	if class == "hq" then
		cells = { { 0, 0, 2, 1 }, { 1, 0, 2, 1 } }
	elseif shape == "square" then
		local side = math.max(2, math.ceil(math.sqrt(n)))
		local list: { { number } } = {}
		for i = 0, side - 1 do
			for j = 0, side - 1 do
				table.insert(list, { i, j, side, side, math.min(i, j, side - 1 - i, side - 1 - j) })
			end
		end
		table.sort(list, function(a: { number }, b: { number })
			if a[5] ~= b[5] then
				return a[5] < b[5]
			end
			return a[1] * side + a[2] < b[1] * side + b[2]
		end)
		for i = 1, math.min(n, #list) do
			cells[i] = list[i]
		end
	elseif shape == "wedge" then
		local placed, r, rows = 0, 0, {}
		while placed < n do
			local w = math.min(2 * r + 1, n - placed)
			table.insert(rows, w)
			placed += w
			r += 1
		end
		local maxW = rows[#rows]
		for ri, w in rows do
			for f = 0, w - 1 do
				table.insert(cells, { f + (maxW - w) / 2, ri - 1, maxW, #rows })
			end
		end
	else
		if ranks <= 0 then
			ranks = 3
		end
		ranks = math.min(ranks, n)
		local files = math.ceil(n / ranks)
		for i = 0, n - 1 do
			local rank = i // files
			local file = i % files
			table.insert(cells, { file, rank, files, ranks })
		end
	end
	local slots: { Slot } = {}
	local rng = Random.new(seed)
	for i, c in cells do
		local file, rank, files, rks = c[1], c[2], c[3], c[4]
		-- thinning keeps the outline (first/last file and rank) and every k-th interior figure
		local edge = file == 0 or file >= files - 1 or rank == 0 or rank >= rks - 1
		if k <= 1 or edge or i % k == 0 then
			local fileSp = width / files
			local rankSp = depth / rks
			table.insert(slots, {
				x = depth / 2 - (rank + 0.5) * rankSp,
				z = (file + 0.5) * fileSp - width / 2,
				sx = (rng:NextNumber() - 0.5) * 6,
				sz = (rng:NextNumber() - 0.5) * 6,
				phase = rng:NextNumber() * math.pi * 2,
			})
		end
	end
	return slots
end

-- ------------------------------------------------------------------ builders
-- Each builder appends parts + local CFrames (relative to the figure origin at ground level).

local function addPart(g: Group, p: BasePart, cf: CFrame, slot: number, anim: number?, pivot: number?)
	table.insert(g.parts, p)
	table.insert(g.locals, cf)
	table.insert(g.partSlot, slot)
	table.insert(g.anim, anim or 0)
	table.insert(g.pivot, pivot or 0)
	p.Parent = folder
end

-- Battalion extras: a mounted officer in front, colour-bearer and drummer at the front centre
-- (inside a square they stand in the middle). Never thinned.
local function specialSlots(f: any): { { x: number, z: number, role: string } }
	if f.shape == "square" then
		return { { x = 0, z = 0, role = "officer" }, { x = 0.6, z = -1.4, role = "colour" }, { x = 0.6, z = 1.4, role = "drummer" } }
	end
	local front = f.depth / 2
	return { { x = front + 3.6, z = 0, role = "officer" }, { x = front + 1.3, z = -0.6, role = "colour" }, { x = front + 1.3, z = 1.4, role = "drummer" } }
end

local function buildNear(g: Group, f: any)
	local n = figureCount(g.class, f.strength)
	g.slots = layoutSlots(g.class, f.shape, n, f.width, f.depth, thinK, g.id * 7919)
	local detail = Settings.get().quality >= 2
	local slotIndex = 0
	local function adder(): Soldiers.Add
		local si = slotIndex
		return function(p: BasePart, cf: CFrame, anim: number, pivot: number)
			addPart(g, p, cf, si, anim, pivot)
		end
	end
	local base = #g.slots
	for i = 1, base do
		slotIndex = i
		local add = adder()
		if g.class == "infantry" then
			Soldiers.infantry(add, g.faction, g.colour, detail, "line")
		elseif g.class == "cavalry" then
			Soldiers.rider(add, g.faction, g.colour, Soldiers.riderKind(f.name), detail, g.id + i)
		elseif g.class == "hq" then
			Soldiers.rider(add, g.faction, g.colour, "officer", detail, g.id + i)
		elseif g.class == "artillery" then
			Soldiers.gun(add, g.faction, g.colour, f.shape == "limbered" or f.limbered == true, detail, g.id + i)
		end
	end
	if g.class == "infantry" then
		for _, s in specialSlots(f) do
			table.insert(g.slots, { x = s.x, z = s.z, sx = 0, sz = 0, phase = #g.slots * 1.7 })
			slotIndex = #g.slots
			local add = adder()
			if s.role == "officer" then
				Soldiers.rider(add, g.faction, g.colour, "officer", detail, g.id)
			else
				Soldiers.infantry(add, g.faction, g.colour, detail, if s.role == "colour" then "colour" else "drummer")
			end
		end
	end
end

local BLACK = Color3.new(0, 0, 0)
local WHITE = Color3.fromRGB(242, 240, 232)
local GUN = Color3.fromRGB(30, 28, 26)
local SLAB_H = 1.2

-- Reference look: French deep cobalt, Prussian near-black charcoal; ghosts desaturated.
local function slabColour(g: Group): Color3
	local c = g.colour:Lerp(BLACK, Factions.slabDarken(g.faction))
	return if g.ghost then desaturate(c) else c
end

-- Flat slab: thin dark edge, body colour, slightly lighter top face.
local function slab(g: Group, cx: number, cz: number, sx: number, sz: number)
	local c = slabColour(g)
	local edge = mk("Part", Vector3.new(sx + 0.5, SLAB_H, sz + 0.5), c:Lerp(BLACK, 0.6))
	local body = mk("Part", Vector3.new(sx, SLAB_H + 0.1, sz), c)
	local top = mk("Part", Vector3.new(math.max(sx - 0.4, 0.5), 0.16, math.max(sz - 0.4, 0.5)), c:Lerp(Color3.new(1, 1, 1), 0.28))
	top.CastShadow = false
	for _, part in { edge, body, top } do
		if g.ghost then
			part.Transparency = 0.4
		end
	end
	addPart(g, edge, CFrame.new(cx, SLAB_H / 2, cz), 0)
	addPart(g, body, CFrame.new(cx, SLAB_H / 2 + 0.05, cz), 0)
	addPart(g, top, CFrame.new(cx, SLAB_H + 0.2, cz), 0)
end

-- White diagonal stripes on a slab top: French two parallel bands, Prussian a cross.
local function stripes(g: Group, sx: number, sz: number)
	local len = math.min(sx, sz) * 1.2
	local y = SLAB_H + 0.3
	local function stripe(ox: number, angle: number)
		local s = mk("Part", Vector3.new(len, 0.16, math.max(0.5, math.min(sx, sz) * 0.14)), WHITE)
		s.CastShadow = false
		if g.ghost then
			s.Transparency = 0.4
		end
		addPart(g, s, CFrame.new(ox, y, 0) * CFrame.Angles(0, angle, 0), 0)
	end
	if g.faction == "france" then
		stripe(-sx * 0.2, math.rad(45))
		stripe(sx * 0.2, math.rad(45))
	else
		stripe(0, math.rad(45))
		stripe(0, math.rad(-45))
	end
end

local function buildFar(g: Group, f: any)
	if g.class == "cavalry" then
		slab(g, 0, 0, f.depth, f.width)
		stripes(g, f.depth, f.width)
	elseif g.class == "artillery" then
		-- small dark gun silhouettes, no block
		local n = figureCount("artillery", f.strength)
		for i = 1, n do
			local z = (i - 0.5) / n * f.width - f.width / 2
			addPart(g, cylinder(5, 0.45, GUN), CFrame.new(0.5, 1.6, z), 0)
			for side = -1, 1, 2 do
				addPart(g, cylinder(0.5, 1.5, GUN), CFrame.new(-0.5, 1.5, z + side * 1.5) * CFrame.Angles(math.pi / 2, 0, 0) * CFrame.Angles(0, 0, math.pi / 2), 0)
			end
		end
	elseif g.class == "hq" then
		-- the marker alone stands for a headquarters
		return
	elseif f.shape == "square" then
		local tk = math.max(f.depth * 0.22, 2.5)
		slab(g, f.depth / 2 - tk / 2, 0, tk, f.width)
		slab(g, -f.depth / 2 + tk / 2, 0, tk, f.width)
		slab(g, 0, f.width / 2 - tk / 2, f.depth - 2 * tk, tk)
		slab(g, 0, -f.width / 2 + tk / 2, f.depth - 2 * tk, tk)
	else
		-- a cluster of 2–4 parallel slabs across the footprint depth
		local shapeDef = (Config.Shapes :: any)[f.shape]
		local ranks = math.clamp(if shapeDef and shapeDef.ranks > 0 then shapeDef.ranks else 3, 2, 4)
		ranks = math.max(1, math.min(ranks, figureCount(g.class, f.strength)))
		local rankSp = f.depth / ranks
		for r = 0, ranks - 1 do
			slab(g, f.depth / 2 - (r + 0.5) * rankSp, 0, rankSp * 0.6, f.width)
		end
	end
end

local POLE = Color3.fromRGB(150, 150, 150)
local IVORY = Color3.fromRGB(246, 241, 226)
local GOLD = Color3.fromRGB(205, 168, 62)

-- Marker: pole (formation space), then camera-facing parts whose locals are offsets from the
-- plate centre: frame, plate, square flag. parts[1] is always the pole.
local function buildMarker(g: Group, f: any): Marker
	local hq = g.class == "hq"
	local scale = if hq then 1.5 else 1
	local poleH = 13 * scale
	local plateW = if hq then 12 else 8
	local plateH = if hq then 4.2 else 2.8
	local parts: { BasePart } = {}
	local locals: { CFrame } = {}
	local function face(p: BasePart, cf: CFrame)
		p.CastShadow = false
		table.insert(parts, p)
		table.insert(locals, cf)
	end
	local pole = cylinder(poleH, 0.1, POLE)
	pole.CastShadow = false
	table.insert(parts, pole)
	table.insert(locals, CFrame.new(0, poleH / 2, 0) * CFrame.Angles(0, 0, math.pi / 2))
	local framePart = mk("Part", Vector3.new(plateW + 0.4, plateH + 0.4, 0.2), if hq then GOLD else INK)
	face(framePart, CFrame.new(0, 0, 0.12))
	local plate = mk("Part", Vector3.new(plateW, plateH, 0.3), IVORY) :: Part
	face(plate, CFrame.new())
	-- square flag below the plate, beside the pole; design per faction
	local s = 2.4 * scale
	local fx = s / 2 + 0.2
	local fy = -(plateH / 2 + s / 2 + 0.3)
	local flag = Factions.flag(g.faction)
	if flag.bands then
		local n = #flag.bands
		for i, c in flag.bands do
			face(mk("Part", Vector3.new(s / n, s, 0.12), c), CFrame.new(fx + (i - (n + 1) / 2) * s / n, fy, 0))
		end
	else
		face(mk("Part", Vector3.new(s, s, 0.12), flag.field or g.colour), CFrame.new(fx, fy, 0))
	end
	local mc = flag.markColour
	local markCf = CFrame.new(fx, fy, -0.08)
	if flag.mark == "diamond" then
		face(mk("Part", Vector3.new(0.55 * scale, 0.55 * scale, 0.14), mc), markCf * CFrame.Angles(0, 0, math.rad(45)))
	elseif flag.mark == "x" then
		for _, a in { 45, -45 } do
			face(mk("Part", Vector3.new(s * 1.3, 0.22, 0.14), mc), markCf * CFrame.Angles(0, 0, math.rad(a)))
		end
	elseif flag.mark == "plus" then
		face(mk("Part", Vector3.new(s, 0.3, 0.14), mc), markCf)
		face(mk("Part", Vector3.new(0.3, s, 0.14), mc), markCf)
	elseif flag.mark == "double" then
		face(mk("Part", Vector3.new(s, 0.24, 0.14), mc), markCf * CFrame.new(0, s * 0.18, 0))
		face(mk("Part", Vector3.new(s, 0.24, 0.14), mc), markCf * CFrame.new(0, -s * 0.18, 0))
	elseif flag.mark == "diagonal" then
		face(mk("Part", Vector3.new(s * 1.3, 0.22, 0.14), mc), markCf * CFrame.Angles(0, 0, math.rad(45)))
	end
	for _, p in parts do
		if g.ghost then
			p.Transparency = 0.35
		end
		p.Parent = folder
	end

	local gui = Instance.new("SurfaceGui") :: SurfaceGui
	gui.Face = Enum.NormalId.Front
	gui.CanvasSize = Vector2.new(plateW * 60, plateH * 60)
	gui.LightInfluence = 0
	gui.Parent = plate
	local function line(sizeY: number, posY: number, text: string, font: EnumFont): TextLabel
		local l = Instance.new("TextLabel") :: TextLabel
		l.BackgroundTransparency = 1
		l.Size = UDim2.new(1, -16, sizeY, 0)
		l.Position = UDim2.new(0, 8, posY, 0)
		l.Font = font
		l.TextScaled = true
		l.TextColor3 = INK
		l.Text = text
		l.Parent = gui
		return l
	end
	local nameText = string.upper(tostring(f.name or ("#" .. g.id)))
	local corpsText = string.upper(tostring(f.corps or ""))
	if hq then
		-- "Napoléon — Imperial HQ" -> NAPOLÉON / IMPERIAL HQ
		local a, b = string.match(nameText, "^(.-)%s+[—%-]+%s+(.+)$")
		if a and b then
			nameText, corpsText = a, b
		end
	end
	local nameLabel = line(if hq then 0.5 else 0.46, 0.04, nameText, Enum.Font.Garamond)
	line(if hq then 0.22 else 0.26, if hq then 0.54 else 0.48, corpsText, Enum.Font.Garamond)
	local statusLabel = line(0.22, if hq then 0.76 else 0.74, "", Enum.Font.Gotham)
	local bar = Instance.new("Frame") :: Frame
	bar.Size = UDim2.new(1, -16, 0, 6)
	bar.Position = UDim2.new(0, 8, 1, -8)
	bar.BackgroundColor3 = INK
	bar.BorderSizePixel = 0
	bar.Visible = false
	bar.Parent = gui
	local fill = Instance.new("Frame") :: Frame
	fill.Size = UDim2.fromScale(1, 1)
	fill.BackgroundColor3 = g.colour
	fill.BorderSizePixel = 0
	fill.Parent = bar
	return {
		parts = parts,
		locals = locals,
		plate = plate,
		gui = gui,
		nameLabel = nameLabel,
		statusLabel = statusLabel,
		bar = bar,
		barFill = fill,
		height = poleH + plateH / 2,
		priority = if hq then 4 else 1,
	}
end

local function destroyParts(list: { BasePart })
	for _, p in list do
		p:Destroy()
	end
	table.clear(list)
end

local function rebuildBody(g: Group, f: any)
	destroyParts(g.parts)
	table.clear(g.locals)
	table.clear(g.partSlot)
	table.clear(g.anim)
	table.clear(g.pivot)
	table.clear(g.slots)
	if g.lod == "near" and not g.ghost then
		buildNear(g, f)
	else
		buildFar(g, f)
	end
	g.dirty = true
end

local function layoutKeyOf(g: Group, f: any): string
	return string.format("%s|%d|%d|%d|%d|%d|%d", f.shape, math.round(f.width), math.round(f.depth), figureCount(g.class, f.strength), thinK, if g.lod == "near" then 1 else 0, Settings.get().quality)
end

local function newGroup(id: number, f: any, ghost: boolean): Group
	local colour = factionColour(f.faction, f.colour)
	local g: Group = {
		id = id,
		faction = f.faction,
		class = f.class,
		colour = colour,
		ghost = ghost,
		lod = "far",
		parts = {},
		locals = {},
		slots = {},
		partSlot = {},
		anim = {},
		pivot = {},
		layoutKey = "",
		p0x = f.x,
		p0z = f.z,
		p0h = f.heading,
		p1x = f.x,
		p1z = f.z,
		p1h = f.heading,
		t1 = os.clock(),
		rx = f.x,
		rz = f.z,
		rh = f.heading,
		dirty = true,
		phase = 0,
		marker = nil :: any,
		ring = nil,
		ringColour = nil,
		dest = {},
		route = {},
		destKey = "",
	}
	g.marker = buildMarker(g, f)
	return g
end

local function destroyGroup(g: Group)
	destroyParts(g.parts)
	destroyParts(g.marker.parts)
	if g.ring then
		destroyParts(g.ring)
	end
	destroyParts(g.dest)
	destroyParts(g.route)
end

-- ------------------------------------------------------------------ snapshot intake

local function budget(): number
	return if Settings.get().quality >= 3 then Config.Visual.MaxFiguresHigh elseif Settings.get().quality == 2 then (Config.Visual.MaxFiguresHigh + Config.Visual.MaxFiguresLow) // 2 else Config.Visual.MaxFiguresLow
end

local function onSnapshot()
	if not folder then
		return
	end
	local now = os.clock()
	local seen: { [number]: boolean } = {}
	local total = 0
	for id, f in BattleState.formations do
		seen[id] = true
		total += figureCount(f.class, f.strength)
		local existing: Group? = groups[id]
		if existing and existing.ghost then
			destroyGroup(existing)
			groups[id] = nil
			existing = nil
		end
		local g: Group
		if existing then
			g = existing
			if f.x ~= g.p1x or f.z ~= g.p1z or f.heading ~= g.p1h then
				g.p0x, g.p0z, g.p0h = g.rx, g.rz, g.rh
				g.p1x, g.p1z, g.p1h = f.x, f.z, f.heading
				g.t1 = now + SNAP_DT
			else
				-- unchanged this snapshot: it has stopped, so settle on p1 (no extrapolation)
				g.p0x, g.p0z, g.p0h = g.p1x, g.p1z, g.p1h
				g.t1 = now
			end
		else
			g = newGroup(id, f, false)
			groups[id] = g
		end
		if f.state == "destroyed" or f.state == "exited" then
			destroyGroup(g)
			groups[id] = nil
			seen[id] = nil
		end
	end
	for id, lk in BattleState.lastKnown do
		seen[id] = true
		local existing: Group? = groups[id]
		if existing and not existing.ghost then
			destroyGroup(existing)
			groups[id] = nil
			existing = nil
		end
		local g: Group
		if existing then
			g = existing
		else
			g = newGroup(id, lk, true)
			groups[id] = g
		end
		g.rx, g.rz, g.rh = lk.x, lk.z, lk.heading
		g.p1x, g.p1z, g.p1h = lk.x, lk.z, lk.heading
		g.marker.statusLabel.Text = string.format("last seen %ds ago", math.floor(lk.ageSeconds))
	end
	for id, g in groups do
		if not seen[id] then
			destroyGroup(g)
			groups[id] = nil
		end
	end
	local newK = math.max(1, math.ceil(total / budget()))
	if newK ~= thinK then
		thinK = newK
	end
end

-- ------------------------------------------------------------------ overlays

local function ringParts(g: Group, colour: Color3, alpha: number): { BasePart }
	local list: { BasePart } = {}
	for _ = 1, 4 do
		local p = mk("Part", Vector3.new(1, 0.25, 1), colour)
		p.CastShadow = false
		p.Transparency = alpha
		p.Parent = folder
		table.insert(list, p)
	end
	g.ringColour = colour
	return list
end

local function placeRing(list: { BasePart }, cfs: { CFrame }, ring: { BasePart }, cf: CFrame, w: number, d: number)
	local pad = 2
	local hw, hd = w / 2 + pad, d / 2 + pad
	ring[1].Size = Vector3.new(0.4, 0.25, hw * 2)
	ring[2].Size = Vector3.new(0.4, 0.25, hw * 2)
	ring[3].Size = Vector3.new(hd * 2, 0.25, 0.4)
	ring[4].Size = Vector3.new(hd * 2, 0.25, 0.4)
	local offs = { CFrame.new(hd, 0.3, 0), CFrame.new(-hd, 0.3, 0), CFrame.new(0, 0.3, hw), CFrame.new(0, 0.3, -hw) }
	for i = 1, 4 do
		table.insert(list, ring[i])
		table.insert(cfs, cf * offs[i])
	end
end

-- Translucent footprint + facing chevron at a destination. Returns parts (3).
local function ghostParts(colour: Color3, alpha: number): { BasePart }
	local rect = mk("Part", Vector3.new(1, 0.3, 1), colour)
	rect.Transparency = alpha
	rect.CastShadow = false
	local a = mk("Part", Vector3.new(3, 0.3, 0.4), colour)
	local b = mk("Part", Vector3.new(3, 0.3, 0.4), colour)
	a.Transparency = alpha * 0.6
	b.Transparency = alpha * 0.6
	a.CastShadow = false
	b.CastShadow = false
	rect.Parent = folder
	a.Parent = folder
	b.Parent = folder
	return { rect, a, b }
end

local function placeGhost(parts: { BasePart }, x: number, z: number, heading: number, w: number, d: number)
	local cf = frame(x, groundY(x, z) + 0.4, z, heading)
	parts[1].Size = Vector3.new(d, 0.3, w)
	parts[1].CFrame = cf
	parts[2].CFrame = cf * CFrame.new(d / 2 + 1.2, 0, 1.0) * CFrame.Angles(0, math.rad(40), 0)
	parts[3].CFrame = cf * CFrame.new(d / 2 + 1.2, 0, -1.0) * CFrame.Angles(0, math.rad(-40), 0)
end

local function routeSegment(parent: Instance, colour: Color3, a: { x: number, z: number }, b: { x: number, z: number }): BasePart
	local p = mk("Part", Vector3.new(1, 0.2, 0.6), colour)
	p.CastShadow = false
	p.Transparency = 0.35
	local len = Vec.dist(a, b)
	local mx, mz = (a.x + b.x) / 2, (a.z + b.z) / 2
	p.Size = Vector3.new(math.max(len, 0.5), 0.2, 0.6)
	p.CFrame = frame(mx, (groundY(a.x, a.z) + groundY(b.x, b.z)) / 2 + 0.5, mz, math.atan2(b.z - a.z, b.x - a.x))
	p.Parent = parent
	return p
end

-- Destination ghosts + route lines for a selected own formation (server dest + queue, plus
-- pending orders not yet acknowledged). Rebuilt only when the key changes.
local function updateOrders(g: Group, f: any, selected: boolean)
	local key = ""
	if selected and not g.ghost and f.faction == BattleState.viewerFaction then
		if f.dest then
			key = string.format("d%.0f,%.0f,%.2f", f.dest.x, f.dest.z, f.destHeading or f.heading)
		end
		if f.queue then
			for _, q in f.queue do
				key ..= string.format("q%.0f,%.0f", q.x, q.z)
			end
		end
		key ..= pendingKey
	end
	if key == g.destKey then
		return
	end
	g.destKey = key
	destroyParts(g.dest)
	destroyParts(g.route)
	if key == "" or not folder then
		return
	end
	local fl = folder :: Folder
	local last = { x = g.rx, z = g.rz }
	if f.dest then
		local parts = ghostParts(g.colour, 0.6)
		placeGhost(parts, f.dest.x, f.dest.z, f.destHeading or f.heading, f.width, f.depth)
		for _, p in parts do
			table.insert(g.dest, p)
		end
		table.insert(g.route, routeSegment(fl, g.colour, last, f.dest))
		last = f.dest
	end
	if f.queue then
		for _, q in f.queue do
			table.insert(g.route, routeSegment(fl, g.colour, last, q))
			last = q
		end
	end
	for _, pend in BattleState.pending do
		if pend.pos and table.find(pend.ids, g.id) then
			local parts = ghostParts(SELECT, 0.7)
			placeGhost(parts, pend.pos.x, pend.pos.z, pend.heading or f.heading, pend.frontage or f.width, f.depth)
			for _, p in parts do
				table.insert(g.dest, p)
			end
			table.insert(g.route, routeSegment(fl, SELECT, last, pend.pos))
		end
	end
end

-- ------------------------------------------------------------------ labels

local function deconflictLabels(cam: Camera)
	local vp = cam.ViewportSize
	local list: { { g: Group, x: number, y: number, w: number, h: number, pri: number } } = {}
	local hovered = Selection.hovered()
	local fov = math.rad(cam.FieldOfView)
	for id, g in groups do
		local m = g.marker
		local pri = m.priority
		if Selection.isSelected(id) then
			pri = math.max(pri, 3)
		elseif id == hovered then
			pri = math.max(pri, 2)
		end
		local world = Vector3.new(g.rx, groundY(g.rx, g.rz) + m.height, g.rz)
		local sp, onScreen = cam:WorldToViewportPoint(world)
		if onScreen and sp.Z > 0 then
			local scale = vp.Y / (2 * sp.Z * math.tan(fov / 2))
			local w = m.plate.Size.X * scale
			local h = m.plate.Size.Y * scale
			table.insert(list, { g = g, x = sp.X, y = sp.Y, w = w, h = h, pri = pri })
		else
			m.gui.Enabled = false
		end
	end
	table.sort(list, function(a: { g: Group, x: number, y: number, w: number, h: number, pri: number }, b: { g: Group, x: number, y: number, w: number, h: number, pri: number })
		if a.pri ~= b.pri then
			return a.pri > b.pri
		end
		return a.g.id < b.g.id
	end)
	local accepted: { { x: number, y: number, w: number, h: number } } = {}
	for _, e in list do
		local ok = true
		for _, a in accepted do
			if math.abs(a.x - e.x) < (a.w + e.w) / 2 and math.abs(a.y - e.y) < (a.h + e.h) / 2 then
				ok = false
				break
			end
		end
		e.g.marker.gui.Enabled = ok
		if ok then
			table.insert(accepted, { x = e.x, y = e.y, w = e.w, h = e.h })
		end
	end
end

local STATUS_WORD: { [string]: string } = {
	idle = "Holding",
	moving = "Marching",
	reforming = "Reforming",
	firing = "Firing",
	charging = "Charging",
	melee = "In melee",
	retreating = "Retreating",
	routing = "Routing",
	rallying = "Rallying",
	destroyed = "Destroyed",
	exited = "Left the field",
}

local function statusText(f: any): string
	local s = STATUS_WORD[f.state] or f.state
	if f.moraleBand == "shaken" then
		s ..= " · Shaken"
	elseif f.moraleBand == "shattered" then
		s = "Shattered"
	end
	if f.status and f.status ~= "" then
		s ..= " · " .. f.status
	end
	return s
end

-- ------------------------------------------------------------------ public

function Figures.init()
	if folder then
		return
	end
	local f = Instance.new("Folder") :: Folder
	f.Name = "EoEFigures"
	f.Parent = workspace
	folder = f
	thinK = 1
end

function Figures.onSnapshot()
	onSnapshot()
end

function Figures.onPendingChanged()
	local parts = {}
	for id, p in BattleState.pending do
		table.insert(parts, id)
	end
	table.sort(parts)
	pendingKey = table.concat(parts, ",")
end

-- Drag preview ghosts: list of {x, z, heading, width, depth}.
function Figures.setPreview(list: { { x: number, z: number, heading: number, width: number, depth: number } }?)
	destroyParts(previews)
	if not list or not folder then
		return
	end
	for _, e in list do
		local parts = ghostParts(SELECT, 0.55)
		placeGhost(parts, e.x, e.z, e.heading, e.width, e.depth)
		for _, p in parts do
			table.insert(previews, p)
		end
	end
end

function Figures.update(dt: number)
	if not folder then
		return
	end
	local cam = workspace.CurrentCamera
	if not cam then
		return
	end
	local camPos = cam.CFrame.Position
	local now = os.clock()
	local moveParts: { BasePart } = {}
	local moveCfs: { CFrame } = {}
	local hovered = Selection.hovered()
	local farD = Config.Visual.FarLodDistance

	for id, g in groups do
		local f: any = if g.ghost then BattleState.lastKnown[id] else BattleState.formations[id]
		if f then
			-- interpolate ≈ one snapshot behind, extrapolate at most MAX_EXTRAP
			if not g.ghost then
				local t = (now - (g.t1 - SNAP_DT)) / SNAP_DT
				if t > 1 + MAX_EXTRAP / SNAP_DT then
					t = 1 + MAX_EXTRAP / SNAP_DT
				end
				t = math.max(t, 0)
				local nx = g.p0x + (g.p1x - g.p0x) * t
				local nz = g.p0z + (g.p1z - g.p0z) * t
				local nh = g.p0h + Vec.angleDiff(g.p0h, g.p1h) * math.min(t, 1)
				if nx ~= g.rx or nz ~= g.rz or nh ~= g.rh then
					g.rx, g.rz, g.rh = nx, nz, nh
					g.dirty = true
				end
			end
			-- LOD with hysteresis
			local dist = (camPos - Vector3.new(g.rx, groundY(g.rx, g.rz), g.rz)).Magnitude
			local wantLod = if g.ghost then "far" elseif g.lod == "near" then (if dist > farD * 1.1 then "far" else "near") else (if dist < farD then "near" else "far")
			if wantLod ~= g.lod then
				g.lod = wantLod
			end
			local key = layoutKeyOf(g, f)
			if key ~= g.layoutKey then
				g.layoutKey = key
				rebuildBody(g, f)
			end

			local state = f.state
			local animating = not g.ghost and g.lod == "near" and (state == "moving" or state == "charging" or state == "routing" or state == "retreating" or state == "melee")
			if animating then
				g.phase += dt * (if state == "charging" or state == "routing" then 9 else 5.5)
				g.dirty = true
			end
			if g.dirty then
				g.dirty = false
				local baseY = groundY(g.rx, g.rz)
				local cf = frame(g.rx, baseY, g.rz, g.rh)
				local routing = state == "routing"
				local charging = state == "charging"
				-- muskets come down for volleys and bayonet charges
				local armed = state == "firing" or (charging and g.class == "infantry")
				local amp = if routing or charging then 0.75 else 0.45
				local slotCf: { CFrame } = {}
				local swing: { number } = {}
				for si, s in g.slots do
					local sx, sz = s.x, s.z
					if routing then
						-- running back with a ragged spread
						sx += s.sx * 2.5
						sz += s.sz * 2.5
					end
					local wp = cf * Vector3.new(sx, 0, sz)
					local y = groundY(wp.X, wp.Z)
					local sw = 0
					if animating then
						local ph = g.phase + s.phase
						sw = math.sin(ph) * amp
						y += math.abs(math.cos(ph)) * 0.12
					end
					swing[si] = sw
					local h = g.rh
					if routing then
						h += math.pi + (s.phase - math.pi) * 0.35
					end
					local scf = frame(wp.X, y, wp.Z, h)
					if charging then
						scf *= CFrame.Angles(0, 0, if g.class == "cavalry" then -0.1 else -0.22) -- lean into the charge
					end
					slotCf[si] = scf
				end
				local anims, pivots, slots = g.anim, g.pivot, g.partSlot
				for i, p in g.parts do
					local slot = slots[i]
					local lc = g.locals[i]
					local base = cf
					if slot > 0 then
						base = slotCf[slot]
						local a = anims[i]
						if a ~= 0 then
							lc = Soldiers.partCFrame(a, lc, pivots[i], swing[slot], armed and not routing)
						end
					end
					table.insert(moveParts, p)
					table.insert(moveCfs, base * lc)
				end
				-- marker: pole in formation space, plate and flag turned to the camera
				local m = g.marker
				local markerBase = CFrame.new(g.rx, baseY, g.rz)
				local plateY = baseY + m.height
				local face = CFrame.lookAt(Vector3.new(g.rx, plateY, g.rz), Vector3.new(camPos.X, plateY, camPos.Z))
				for i, p in m.parts do
					table.insert(moveParts, p)
					table.insert(moveCfs, if i == 1 then markerBase * m.locals[1] else face * m.locals[i])
				end
				-- selection / hover ring
				local selected = Selection.isSelected(id)
				local wantRing: Color3? = if selected then SELECT elseif id == hovered then (if g.faction == BattleState.viewerFaction then CREAM else HOSTILE) else nil
				local needNew = g.ring == nil or g.ringColour ~= wantRing
				if wantRing ~= nil and needNew then
					if g.ring then
						destroyParts(g.ring)
					end
					g.ring = ringParts(g, wantRing, if selected then 0.1 else 0.5)
				elseif not wantRing and g.ring then
					destroyParts(g.ring)
					g.ring = nil
				end
				if g.ring then
					placeRing(moveParts, moveCfs, g.ring, cf, f.width, f.depth)
				end
			else
				-- the plate still has to follow the camera; cheap enough per frame
				local m = g.marker
				local plateY = groundY(g.rx, g.rz) + m.height
				local face = CFrame.lookAt(Vector3.new(g.rx, plateY, g.rz), Vector3.new(camPos.X, plateY, camPos.Z))
				for i = 2, #m.parts do
					table.insert(moveParts, m.parts[i])
					table.insert(moveCfs, face * m.locals[i])
				end
			end
			-- ring/dest refresh on selection or hover change
			local selected = Selection.isSelected(id)
			local wasSelected = prevSelected[id] == true
			if wasSelected ~= selected then
				prevSelected[id] = selected
				g.dirty = true
			end
			local showStatus = selected or id == hovered
			local m = g.marker
			if not g.ghost then
				m.statusLabel.Text = if showStatus then statusText(f) else ""
				m.bar.Visible = showStatus
				if showStatus then
					m.barFill.Size = UDim2.fromScale(math.clamp(f.strength / math.max(f.startStrength, 1), 0, 1), 1)
				end
			end
			updateOrders(g, f, selected)
		end
	end
	if #moveParts > 0 then
		workspace:BulkMoveTo(moveParts, moveCfs, Enum.BulkMoveMode.FireCFrameChanged)
	end
	labelClock += dt
	if labelClock >= LABEL_INTERVAL then
		labelClock = 0
		deconflictLabels(cam)
	end
end

-- Forces every group to re-place its parts (after hover changes etc).
function Figures.markDirty()
	for _, g in groups do
		g.dirty = true
	end
end

function Figures.clear()
	for _, g in groups do
		destroyGroup(g)
	end
	table.clear(groups)
	destroyParts(previews)
	table.clear(prevSelected)
	pendingKey = ""
	if folder then
		folder:Destroy()
		folder = nil
	end
end

return Figures
]]></ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX00000039"><Properties><bool name="Disabled">false</bool><string name="Name">Input</string><ProtectedString name="Source"><![CDATA[--!strict
-- Mouse and keyboard for the battlefield. Picking is done against formation footprints from
-- BattleState (never against cosmetic parts); the ground point comes from a terrain raycast.

local UserInputService = game:GetService("UserInputService") :: UserInputService
local Players = game:GetService("Players") :: Players
local Shared = game:GetService("ReplicatedStorage"):WaitForChild("EoE")
local Config = require(Shared.Config)
local Vec = require(Shared.Vec)
local MapGen = require(Shared.MapGen)
local BattleState = require(script.Parent.BattleState)
local Selection = require(script.Parent.Selection)
local Camera = require(script.Parent.Camera)
local Net = require(script.Parent.Net)
local Figures = require(script.Parent.Figures)
local Signal = require(script.Parent.Signal)
local Terrain = require(script.Parent.World.Terrain)

local Input = {}

Input.action = Signal.new() -- (name: string) for escape, dev, help
Input.orderSent = Signal.new() -- (kind) so the HUD can flash

type Vec = { x: number, z: number }

local DRAG_PX = 6
local PICK_PAD = 4

local mode = "off" -- off | battle | deploy
local connections: { RBXScriptConnection } = {}
local gui: ScreenGui? = nil
local box: Frame? = nil

local left: { down: boolean, sx: number, sy: number, ground: Vec?, dragging: boolean, formation: number? } = { down = false, sx = 0, sy = 0, ground = nil, dragging = false, formation = nil }
local right: { down: boolean, sx: number, sy: number, ground: Vec?, dragging: boolean, formation: number? } = { down = false, sx = 0, sy = 0, ground = nil, dragging = false, formation = nil }
local deployHeading: { [number]: number } = {}
local armed: string? = nil -- "Charge": the next right-click charges instead of moving

-- ------------------------------------------------------------------ picking

local function mousePos(): Vector2
	return UserInputService:GetMouseLocation()
end

local function groundUnderMouse(): Vec?
	local cam = workspace.CurrentCamera
	if not cam then
		return nil
	end
	local m = mousePos()
	local ray = cam:ScreenPointToRay(m.X, m.Y)
	local params = RaycastParams.new()
	params.FilterType = Enum.RaycastFilterType.Include
	local list: { Instance } = { workspace.Terrain }
	local plane = Terrain.pickPlane()
	if plane then
		table.insert(list, plane)
	end
	params.FilterDescendantsInstances = list
	params.IgnoreWater = false
	local hit = workspace:Raycast(ray.Origin, ray.Direction * 8000, params)
	if hit then
		return { x = hit.Position.X, z = hit.Position.Z }
	end
	return nil
end

-- Nearest formation whose footprint (padded) contains the ground point. Own first, then
-- visible enemies, then last-known ghosts.
local function pickAt(p: Vec): (number?, string?)
	local bestId: number? = nil
	local bestKind: string? = nil
	local bestScore = math.huge
	local function test(f: any, kind: string)
		local fx, fz = math.cos(f.heading), math.sin(f.heading)
		local dx, dz = p.x - f.x, p.z - f.z
		local along = dx * fx + dz * fz
		local across = -dx * fz + dz * fx
		local hd, hw = f.depth / 2 + PICK_PAD, f.width / 2 + PICK_PAD
		if math.abs(along) <= hd and math.abs(across) <= hw then
			local score = (along / hd) ^ 2 + (across / hw) ^ 2
			if score < bestScore then
				bestScore = score
				bestId = f.id
				bestKind = kind
			end
		end
	end
	for _, f in BattleState.formations do
		test(f, if f.faction == BattleState.viewerFaction then "own" else "enemy")
	end
	if bestId == nil then
		for _, lk in BattleState.lastKnown do
			test(lk, "ghost")
		end
	end
	return bestId, bestKind
end

local function textBoxFocused(): boolean
	return (UserInputService:GetFocusedTextBox() :: TextBox?) ~= nil
end

local function clampToMap(p: Vec): Vec
	local m = BattleState.map
	local w = if m then m.width else Config.Map.Width
	local d = if m then m.depth else Config.Map.Depth
	return { x = math.clamp(p.x, 1, w - 1), z = math.clamp(p.z, 1, d - 1) }
end

local function selectedFormations(): { any }
	local out = {}
	for _, id in Selection.ids() do
		local f = BattleState.formations[id]
		if f then
			table.insert(out, f)
		end
	end
	return out
end

-- ------------------------------------------------------------------ orders

local function sendOrder(kind: string, ids: { number }, data: { [string]: any }): boolean
	if kind == "Charge" then
		armed = nil
		Input.action:Fire("disarm")
	end
	local requestId, reason = Net.send(kind, ids, data)
	if requestId then
		BattleState.addPending({
			requestId = requestId,
			kind = kind,
			ids = ids,
			pos = data.pos,
			heading = data.heading,
			frontage = data.frontage,
			issuedAt = os.clock(),
		})
		Input.orderSent:Fire(kind)
		return true
	end
	BattleState.orderRejected:Fire(reason or "Order refused")
	return false
end

-- Line placement along a right-drag: formations spread along the drag, facing its left side.
local function linePlacement(a: Vec, b: Vec): { { f: any, x: number, z: number, heading: number, frontage: number } }
	local forms = selectedFormations()
	if #forms == 0 then
		return {}
	end
	local d = Vec.sub(b, a)
	local len = Vec.len(d)
	local dir = Vec.normalize(d)
	local heading = Vec.heading({ x = dir.z, z = -dir.x }) -- right(f) == dir
	-- keep current left-to-right ordering along the drag so lines do not cross
	table.sort(forms, function(p, q)
		return Vec.dot({ x = p.x, z = p.z }, dir) < Vec.dot({ x = q.x, z = q.z }, dir)
	end)
	local out = {}
	local n = #forms
	for i, f in forms do
		local c = Vec.add(a, Vec.scale(dir, len * (i - 0.5) / n))
		table.insert(out, { f = f, x = c.x, z = c.z, heading = heading, frontage = len / n })
	end
	return out
end

local function previewLine(a: Vec, b: Vec)
	local list = {}
	for _, e in linePlacement(a, b) do
		table.insert(list, { x = e.x, z = e.z, heading = e.heading, width = math.max(e.frontage, 4), depth = e.f.depth })
	end
	Figures.setPreview(list)
end

local function issueLineMove(a: Vec, b: Vec, queue: boolean)
	for _, e in linePlacement(a, b) do
		local pos = clampToMap({ x = e.x, z = e.z })
		sendOrder("Move", { e.f.id }, { pos = pos, heading = e.heading, frontage = e.frontage, queue = queue })
	end
end

-- Plain move keeps each formation's offset from the selection centroid.
local function issueMove(target: Vec, queue: boolean)
	local forms = selectedFormations()
	if #forms == 0 then
		return
	end
	local cx, cz = 0, 0
	for _, f in forms do
		cx += f.x
		cz += f.z
	end
	cx /= #forms
	cz /= #forms
	for _, f in forms do
		local pos = clampToMap({ x = target.x + (f.x - cx), z = target.z + (f.z - cz) })
		sendOrder("Move", { f.id }, { pos = pos, queue = queue })
	end
end

local function issueEngage(targetId: number, queue: boolean)
	local ids = {}
	for _, f in selectedFormations() do
		if f.class ~= "hq" then
			table.insert(ids, f.id)
		end
	end
	if #ids > 0 then
		sendOrder("Engage", ids, { targetId = targetId, queue = queue })
	end
end

-- ------------------------------------------------------------------ deployment drags

local function deployPos(id: number, p: Vec): Vec
	local m = BattleState.map
	if m then
		local zone = m.deployZones[BattleState.viewerFaction]
		if zone then
			return { x = math.clamp(p.x, zone.x0 + 2, zone.x1 - 2), z = math.clamp(p.z, zone.z0 + 2, zone.z1 - 2) }
		end
	end
	return clampToMap(p)
end

local function deployPreview(id: number, p: Vec?, heading: number?)
	local f = BattleState.formations[id]
	if not f then
		Figures.setPreview(nil)
		return
	end
	local pos = if p then deployPos(id, p) else { x = f.x, z = f.z }
	Figures.setPreview({ { x = pos.x, z = pos.z, heading = heading or deployHeading[id] or f.heading, width = f.width, depth = f.depth } })
end

local function sendDeploy(id: number, p: Vec, heading: number)
	local f = BattleState.formations[id]
	if not f then
		return
	end
	local pos = deployPos(id, p)
	local m = BattleState.map
	if m and not MapGen.inZone(m, BattleState.viewerFaction, pos) then
		BattleState.orderRejected:Fire("Outside your deployment zone")
		return
	end
	sendOrder("Deploy", { id }, { pos = pos, heading = heading })
end

-- ------------------------------------------------------------------ box select

local function ensureGui()
	if gui then
		return
	end
	local player = Players.LocalPlayer :: Player
	local sg = Instance.new("ScreenGui") :: ScreenGui
	sg.Name = "EoEInput"
	sg.ResetOnSpawn = false
	sg.IgnoreGuiInset = true -- box coordinates come from GetMouseLocation (inset included)
	sg.DisplayOrder = 5
	sg.Parent = player:WaitForChild("PlayerGui")
	local b = Instance.new("Frame") :: Frame
	b.BackgroundColor3 = Color3.fromRGB(240, 226, 180)
	b.BackgroundTransparency = 0.8
	b.BorderSizePixel = 1
	b.BorderColor3 = Color3.fromRGB(240, 226, 180)
	b.Visible = false
	b.Parent = sg
	gui = sg
	box = b
end

local function showBox(x0: number, y0: number, x1: number, y1: number)
	if box then
		box.Visible = true
		box.Position = UDim2.fromOffset(math.min(x0, x1), math.min(y0, y1))
		box.Size = UDim2.fromOffset(math.abs(x1 - x0), math.abs(y1 - y0))
	end
end

local function hideBox()
	if box then
		box.Visible = false
	end
end

local function boxSelect(x0: number, y0: number, x1: number, y1: number, additive: boolean)
	local cam = workspace.CurrentCamera
	if not cam then
		return
	end
	local minX, maxX = math.min(x0, x1), math.max(x0, x1)
	local minY, maxY = math.min(y0, y1), math.max(y0, y1)
	local ids = {}
	for id, f in BattleState.formations do
		if f.faction == BattleState.viewerFaction then
			local sp, on = cam:WorldToScreenPoint(Vector3.new(f.x, Camera.groundHeight(f.x, f.z), f.z))
			if on and sp.X >= minX and sp.X <= maxX and sp.Y >= minY and sp.Y <= maxY then
				table.insert(ids, id)
			end
		end
	end
	if additive then
		Selection.add(ids)
	else
		Selection.set(ids)
	end
end

-- ------------------------------------------------------------------ handlers

local function shift(): boolean
	return UserInputService:IsKeyDown(Enum.KeyCode.LeftShift) or UserInputService:IsKeyDown(Enum.KeyCode.RightShift)
end

local function ctrl(): boolean
	return UserInputService:IsKeyDown(Enum.KeyCode.LeftControl) or UserInputService:IsKeyDown(Enum.KeyCode.RightControl)
end

local function cancelDrags()
	left.down = false
	left.dragging = false
	left.formation = nil
	right.down = false
	right.dragging = false
	right.formation = nil
	hideBox()
	Figures.setPreview(nil)
end

local function onLeftDown()
	local m = mousePos()
	left.down = true
	left.dragging = false
	left.sx, left.sy = m.X, m.Y
	left.ground = groundUnderMouse()
	left.formation = nil
	if mode == "deploy" and left.ground then
		local id, kind = pickAt(left.ground)
		if id and kind == "own" then
			left.formation = id
			Selection.set({ id })
		end
	end
end

local function onLeftUp()
	if not left.down then
		return
	end
	left.down = false
	local m = mousePos()
	if left.dragging then
		left.dragging = false
		if left.formation then
			local g = groundUnderMouse()
			local f = BattleState.formations[left.formation]
			if g and f then
				sendDeploy(left.formation, g, deployHeading[left.formation] or f.heading)
			end
			Figures.setPreview(nil)
		else
			hideBox()
			boxSelect(left.sx, left.sy, m.X, m.Y, shift())
		end
		left.formation = nil
		return
	end
	left.formation = nil
	local g = groundUnderMouse()
	if not g then
		return
	end
	local id, kind = pickAt(g)
	if id and kind == "own" then
		if shift() then
			Selection.toggle(id)
		else
			Selection.set({ id })
		end
	elseif not shift() then
		Selection.clear()
	end
end

local function onRightDown()
	local m = mousePos()
	right.down = true
	right.dragging = false
	right.sx, right.sy = m.X, m.Y
	right.ground = groundUnderMouse()
	right.formation = nil
	if mode == "deploy" and right.ground then
		local id, kind = pickAt(right.ground)
		if id and kind == "own" then
			right.formation = id
		end
	end
end

local function onRightUp()
	if not right.down then
		return
	end
	right.down = false
	local g = groundUnderMouse()
	if right.dragging then
		right.dragging = false
		Figures.setPreview(nil)
		if mode == "deploy" then
			if right.formation and g and right.ground then
				local f = BattleState.formations[right.formation]
				if f then
					local h = Vec.heading(Vec.sub(g, right.ground))
					deployHeading[right.formation] = h
					sendDeploy(right.formation, { x = f.x, z = f.z }, h)
				end
			end
		elseif right.ground and g then
			issueLineMove(right.ground, g, shift())
		end
		right.formation = nil
		return
	end
	right.formation = nil
	if mode ~= "battle" or not g then
		return
	end
	if Selection.count() == 0 then
		return
	end
	local id, kind = pickAt(g)
	if armed == "Charge" then
		local ids = {}
		for _, f in selectedFormations() do
			if f.class == "infantry" or f.class == "cavalry" then
				table.insert(ids, f.id)
			end
		end
		if #ids > 0 then
			if id and (kind == "enemy" or kind == "ghost") then
				sendOrder("Charge", ids, { targetId = id, queue = shift() })
			else
				sendOrder("Charge", ids, { pos = clampToMap(g), queue = shift() })
			end
		end
		armed = nil
		Input.action:Fire("disarm")
	elseif id and (kind == "enemy" or kind == "ghost") then
		issueEngage(id, shift())
	elseif kind == "own" and id and Selection.count() == 1 and Selection.isSelected(id) then
		-- right-clicking the only selected formation: no-op
		return
	else
		issueMove(g, shift())
	end
end

local function onMouseMove()
	local m = mousePos()
	if left.down and not left.dragging then
		if math.abs(m.X - left.sx) > DRAG_PX or math.abs(m.Y - left.sy) > DRAG_PX then
			left.dragging = true
		end
	end
	if left.dragging then
		if left.formation then
			deployPreview(left.formation, groundUnderMouse(), nil)
		else
			showBox(left.sx, left.sy, m.X, m.Y)
		end
	end
	if right.down and not right.dragging then
		if math.abs(m.X - right.sx) > DRAG_PX or math.abs(m.Y - right.sy) > DRAG_PX then
			right.dragging = true
		end
	end
	if right.dragging and right.ground then
		local g = groundUnderMouse()
		if g then
			if mode == "deploy" then
				if right.formation then
					deployPreview(right.formation, nil, Vec.heading(Vec.sub(g, right.ground)))
				end
			elseif Vec.dist(g, right.ground) > 8 then
				previewLine(right.ground, g)
			end
		end
	end
	-- hover
	if not left.dragging and not right.dragging then
		local g = groundUnderMouse()
		local id = if g then (pickAt(g)) else nil
		Selection.setHovered(id)
	end
end

local function focusSelection()
	local forms = selectedFormations()
	if #forms == 0 then
		return
	end
	local cx, cz = 0, 0
	for _, f in forms do
		cx += f.x
		cz += f.z
	end
	Camera.focusOn(cx / #forms, cz / #forms)
end

local function onKey(input: InputObject)
	local k = input.KeyCode
	local state = BattleState.state
	if k == Enum.KeyCode.Escape then
		if armed then
			armed = nil
			Input.action:Fire("disarm")
		else
			Selection.clear()
		end
		Input.action:Fire("escape")
	elseif k == Enum.KeyCode.F9 then
		Input.action:Fire("dev")
	elseif k == Enum.KeyCode.F1 then
		Input.action:Fire("help")
	elseif k == Enum.KeyCode.Space then
		if state == "running" then
			Net.control("pause")
		elseif state == "paused" then
			Net.control("resume")
		end
	elseif k == Enum.KeyCode.One then
		Net.control("speed", 1)
	elseif k == Enum.KeyCode.Two then
		Net.control("speed", 2)
	elseif k == Enum.KeyCode.Three then
		Net.control("speed", 4)
	elseif k == Enum.KeyCode.F then
		focusSelection()
	elseif k == Enum.KeyCode.Home then
		local c = BattleState.armyCentre()
		Camera.focusOn(c.x, c.z)
	else
		local groupKeys = { Enum.KeyCode.Four, Enum.KeyCode.Five, Enum.KeyCode.Six, Enum.KeyCode.Seven, Enum.KeyCode.Eight, Enum.KeyCode.Nine }
		for i, code in groupKeys do
			if k == code then
				if ctrl() then
					Selection.assignGroup(i + 3)
				else
					Selection.recallGroup(i + 3)
				end
			end
		end
	end
end

-- ------------------------------------------------------------------ public

function Input.init()
	if #connections > 0 then
		return
	end
	ensureGui()
	table.insert(connections, UserInputService.InputBegan:Connect(function(input: InputObject, gp: boolean)
		if mode == "off" then
			return
		end
		if input.UserInputType == Enum.UserInputType.Keyboard then
			if gp or textBoxFocused() then
				return
			end
			onKey(input)
			return
		end
		if gp then
			return -- the GUI consumed it: never a battlefield order
		end
		if input.UserInputType == Enum.UserInputType.MouseButton1 then
			onLeftDown()
		elseif input.UserInputType == Enum.UserInputType.MouseButton2 then
			onRightDown()
		end
	end))
	table.insert(connections, UserInputService.InputEnded:Connect(function(input: InputObject, _gp: boolean)
		if mode == "off" then
			return
		end
		-- releases are handled even when over the GUI so drags always finish
		if input.UserInputType == Enum.UserInputType.MouseButton1 then
			onLeftUp()
		elseif input.UserInputType == Enum.UserInputType.MouseButton2 then
			onRightUp()
		end
	end))
	table.insert(connections, UserInputService.InputChanged:Connect(function(input: InputObject, _gp: boolean)
		if mode ~= "off" and input.UserInputType == Enum.UserInputType.MouseMovement then
			onMouseMove()
		end
	end))
	table.insert(connections, UserInputService.WindowFocusReleased:Connect(cancelDrags))
end

-- "off" | "battle" | "deploy"
function Input.setMode(m: string)
	if m == mode then
		return
	end
	cancelDrags()
	mode = m
	Camera.setEnabled(m ~= "off")
	if m == "off" then
		Selection.setHovered(nil)
	end
	if m ~= "deploy" then
		table.clear(deployHeading)
	end
end

function Input.mode(): string
	return mode
end

-- Arms a two-step order (Charge): the next right-click supplies the target or position.
function Input.arm(kind: string?)
	armed = kind
end

function Input.armed(): string?
	return armed
end

function Input.sendOrder(kind: string, ids: { number }, data: { [string]: any }): boolean
	return sendOrder(kind, ids, data)
end

function Input.destroy()
	cancelDrags()
	mode = "off"
	armed = nil
	for _, c in connections do
		c:Disconnect()
	end
	table.clear(connections)
	if gui then
		gui:Destroy()
		gui = nil
		box = nil
	end
	table.clear(deployHeading)
end

return Input
]]></ProtectedString></Properties></Item><Item class="LocalScript" referent="RBX00000040"><Properties><bool name="Disabled">false</bool><string name="Name">Main</string><ProtectedString name="Source"><![CDATA[--!strict
-- Client bootstrap: waits for shared modules and remotes, builds the world per map, wires the
-- modules together and drives the match lifecycle from MatchState messages.

local RunService = game:GetService("RunService") :: RunService
local Shared = game:GetService("ReplicatedStorage"):WaitForChild("EoE")
local MapGen = require(Shared.MapGen)

local Signal = require(script.Parent.Signal)
local Settings = require(script.Parent.Settings)
local Net = require(script.Parent.Net)
local BattleState = require(script.Parent.BattleState)
local Audio = require(script.Parent.Audio)
local Camera = require(script.Parent.Camera)
local Selection = require(script.Parent.Selection)
local Input = require(script.Parent.Input)
local Figures = require(script.Parent.Figures)
local Effects = require(script.Parent.Effects)
local Terrain = require(script.Parent.World.Terrain)
local Props = require(script.Parent.World.Props)
local WorldLighting = require(script.Parent.World.Lighting)
local Menu = require(script.Parent.UI.Menu)
local HUD = require(script.Parent.UI.HUD)
local Deployment = require(script.Parent.UI.Deployment)
local Results = require(script.Parent.UI.Results)
local SettingsPanel = require(script.Parent.UI.SettingsPanel)
local Help = require(script.Parent.UI.Help)
local Loading = require(script.Parent.UI.Loading)
local DevPanel = require(script.Parent.UI.DevPanel)
local CampaignScreen = require(script.Parent.UI.CampaignScreen)
local BattleSelect = require(script.Parent.UI.BattleSelect)

local DEFAULT_MAP = "jena"

local mapCache: { [string]: any } = {}
local builtMapId: string? = nil
local buildToken = 0
local needCameraReset = false
local pendingClock = 0
local lastMatchId = ""
local lastMenuArgs = { isCommander = false, campaignAvailable = false }
local campaignWanted = false -- a campaign view should take the screen when it arrives
local conns: { Signal.Connection } = {}

-- ------------------------------------------------------------------ world

-- Generates (cached) and builds terrain + props for a map. Yields. False if superseded.
local function ensureWorld(mapId: string): boolean
	if builtMapId == mapId then
		return true
	end
	buildToken += 1
	local token = buildToken
	Loading.show("Surveying the ground…")
	local map = mapCache[mapId]
	if not map then
		map = MapGen.generate(mapId)
		mapCache[mapId] = map
	end
	BattleState.map = map
	Camera.setMap(map)
	builtMapId = nil
	Terrain.clear()
	Props.clear()
	local ok = Terrain.build(map, function(p: number)
		Loading.setProgress(p * 0.7, "Raising the hills…")
	end)
	if not ok or token ~= buildToken then
		return false
	end
	ok = Props.build(map, Settings.get().quality, function(p: number)
		Loading.setProgress(0.7 + p * 0.3, "Planting woods and villages…")
	end)
	if not ok or token ~= buildToken then
		return false
	end
	builtMapId = mapId
	Loading.hide()
	return true
end

-- ------------------------------------------------------------------ panels

local function closePanels()
	Help.hide()
	SettingsPanel.hide()
	BattleSelect.hide()
end

local function openHelp()
	SettingsPanel.hide()
	Help.show()
end

local function openSettings()
	Help.hide()
	SettingsPanel.show()
end

local menuCallbacks: any
menuCallbacks = {
	play = function()
		Menu.hide()
		BattleSelect.show({
			fight = function(id: string)
				BattleSelect.hide()
				Net.control("start", id)
			end,
			difficulty = function(v: string)
				Net.control("difficulty", v)
			end,
			back = function()
				BattleSelect.hide()
				Menu.show(menuCallbacks, lastMenuArgs.isCommander, lastMenuArgs.campaignAvailable)
			end,
		}, BattleState.isCommander)
	end,
	campaign = function()
		campaignWanted = true
		Net.campaign("open")
	end,
	help = openHelp,
	settings = openSettings,
}

local campaignCallbacks = {
	send = function(action: string, data: { [string]: any }?)
		Net.campaign(action, data)
	end,
	menu = function()
		campaignWanted = false
		CampaignScreen.hide()
		if BattleState.state == "menu" then
			Menu.show(menuCallbacks, lastMenuArgs.isCommander, lastMenuArgs.campaignAvailable)
		else
			Net.control("quit")
		end
	end,
}

local function onCampaign(msg: any)
	if type(msg) ~= "table" then
		return
	end
	if msg.kind == "error" then
		if CampaignScreen.isOpen() then
			CampaignScreen.showError(tostring(msg.reason))
		elseif campaignWanted then
			HUD.toast(tostring(msg.reason))
			Menu.show(menuCallbacks, lastMenuArgs.isCommander, lastMenuArgs.campaignAvailable)
			campaignWanted = false
		end
		return
	end
	if msg.kind ~= "view" or type(msg.view) ~= "table" then
		return
	end
	if not campaignWanted then
		return -- e.g. a view echoed while a campaign battle is being fought
	end
	-- the campaign takes the screen over the menu or the results panel
	Menu.hide()
	Results.destroy()
	if CampaignScreen.isOpen() then
		CampaignScreen.setView(msg.view, msg.sessionOnly == true)
	else
		CampaignScreen.show(msg.view, msg.sessionOnly == true, campaignCallbacks)
	end
end

local hudCallbacks = {
	settings = openSettings,
	help = openHelp,
	menu = function()
		Net.control("quit")
	end,
}

-- ------------------------------------------------------------------ lifecycle

-- Removes everything a previous state created. Safe to call repeatedly.
local function teardown()
	Input.setMode("off")
	Figures.clear()
	Effects.clear()
	HUD.destroy()
	Deployment.destroy()
	Results.destroy()
	Menu.hide()
	Props.setDeployZone(nil, nil)
	Selection.reset()
	Figures.setPreview(nil)
	closePanels()
	CampaignScreen.hide()
end

local gotServerState = false

-- Diagnostic beacon (bottom-left, F10 toggles; shown by default only in Studio).
local beacon: TextLabel? = nil
local beaconGui: ScreenGui? = nil
local function diag(text: string)
	print("[EoE client] " .. text)
	if not beacon then
		local sg = Instance.new("ScreenGui") :: ScreenGui
		sg.Name = "EoEDiag"
		sg.DisplayOrder = 100
		sg.ResetOnSpawn = false
		sg.Enabled = RunService:IsStudio()
		sg.Parent = (game:GetService("Players") :: Players).LocalPlayer:WaitForChild("PlayerGui")
		beaconGui = sg
		local l = Instance.new("TextLabel") :: TextLabel
		l.AnchorPoint = Vector2.new(1, 0)
		l.Position = UDim2.new(1, -8, 0, 90)
		l.Size = UDim2.fromOffset(0, 18)
		l.AutomaticSize = Enum.AutomaticSize.X
		l.AnchorPoint = Vector2.new(0, 0)
		l.BackgroundTransparency = 0.4
		l.BackgroundColor3 = Color3.new(0, 0, 0)
		l.TextColor3 = Color3.new(1, 1, 1)
		l.TextXAlignment = Enum.TextXAlignment.Left
		l.Font = Enum.Font.Code
		l.TextSize = 12
		l.Parent = sg
		beacon = l
	end
	if beacon then
		beacon.Text = "EoE build 5 | " .. text
	end
end

local function onMatchState(msg: any)
	if type(msg) ~= "table" then
		return
	end
	diag(string.format("state=%s match=%s commander=%s", tostring(msg.state), tostring(msg.matchId), tostring(msg.isCommander)))
	local prevState = BattleState.state
	local sameMatch = msg.matchId == lastMatchId and msg.matchId ~= ""
	local pauseToggle = sameMatch and ((prevState == "running" and msg.state == "paused") or (prevState == "paused" and msg.state == "running"))
	BattleState.applyMatchState(msg)
	Net.setMatch(BattleState.matchId, BattleState.validateContext)
	if pauseToggle then
		-- keep figures, selection and HUD; just reflect the new state
		BattleState.updated:Fire(nil)
		return
	end
	if not sameMatch then
		BattleState.reset()
		lastMatchId = msg.matchId or ""
		needCameraReset = true
	end
	teardown()
	local state = msg.state
	local scenario = msg.scenario
	local mapId = if scenario and scenario.map then scenario.map else DEFAULT_MAP

	if state == "menu" then
		lastMenuArgs = { isCommander = BattleState.isCommander, campaignAvailable = msg.campaignAvailable == true }
		if campaignWanted and BattleState.isCommander then
			Net.campaign("return") -- back from a campaign battle: show the map again
		else
			campaignWanted = false
			Menu.show(menuCallbacks, lastMenuArgs.isCommander, lastMenuArgs.campaignAvailable)
		end
		Camera.setEnabled(true)
		local built = ensureWorld(DEFAULT_MAP)
		diag(string.format("menu shown (commander=%s), world built=%s", tostring(BattleState.isCommander), tostring(built)))
		if built then
			local m = BattleState.map
			Camera.reset(m.width / 2, m.depth * 0.45)
		end
	elseif state == "loading" then
		Loading.show("The army is forming…")
		ensureWorld(mapId)
		Loading.show("Waiting for the server…")
	elseif state == "deployment" then
		campaignWanted = msg.campaignBattle ~= nil
		if not ensureWorld(mapId) then
			return
		end
		Figures.init()
		Effects.init()
		local zone = BattleState.map.deployZones[BattleState.viewerFaction]
		Props.setDeployZone(zone, BattleState.viewerFaction)
		Deployment.show({
			ready = function()
				Net.control("ready")
				Deployment.setWaiting("Forming up…")
			end,
			settings = openSettings,
		})
		Input.setMode(if BattleState.isCommander then "deploy" else "off")
		Camera.setEnabled(true)
		if zone then
			Camera.reset((zone.x0 + zone.x1) / 2, (zone.z0 + zone.z1) / 2)
			Camera.playIntro() -- sweep over the field while the briefing is read
			needCameraReset = false
		end
	elseif state == "running" or state == "paused" then
		if not ensureWorld(mapId) then
			return
		end
		Figures.init()
		Effects.init()
		HUD.show(hudCallbacks)
		Input.setMode(if BattleState.isCommander then "battle" else "off")
		Camera.setEnabled(true)
		if msg.reason then
			HUD.message(tostring(msg.reason))
		end
	elseif state == "results" then
		if not ensureWorld(mapId) then
			return
		end
		Figures.init() -- the field stays visible, frozen, behind the panel
		local inCampaign = BattleState.campaignBattle ~= nil
		Results.show(msg.results or {}, {
			restart = function()
				Net.control("restart")
			end,
			menu = function()
				campaignWanted = false
				Net.control("quit")
			end,
			campaign = if inCampaign then function()
				campaignWanted = true
				Net.campaign("return")
			end else nil,
		})
		Camera.setEnabled(true)
	end
	-- a snapshot may already be in BattleState: render it now
	if next(BattleState.formations) ~= nil then
		Figures.onSnapshot()
	end
end

local function onSnapshot(snap: any)
	if type(snap) ~= "table" then
		return
	end
	BattleState.applySnapshot(snap)
end

-- ------------------------------------------------------------------ wiring

local function wire()
	table.insert(conns, Net.onMatchState:Connect(function(msg: any)
		gotServerState = true
		task.spawn(onMatchState, msg)
	end))
	table.insert(conns, Net.onSnapshot:Connect(onSnapshot))
	table.insert(conns, Net.onCampaign:Connect(onCampaign))
	table.insert(conns, Net.onResult:Connect(function(res: any)
		if type(res) == "table" then
			BattleState.applyResult(res)
		end
	end))
	table.insert(conns, Net.onDebug:Connect(function(msg: any)
		if type(msg) == "table" and type(msg.aiGoals) == "table" then
			DevPanel.setGoals(msg.aiGoals)
		end
	end))
	table.insert(conns, BattleState.updated:Connect(function()
		Selection.prune()
		Figures.onSnapshot()
		Props.updateObjectives(BattleState.objectives)
		if needCameraReset and next(BattleState.formations) ~= nil then
			needCameraReset = false
			local c = BattleState.armyCentre()
			Camera.reset(c.x, c.z)
		end
	end))
	table.insert(conns, BattleState.event:Connect(function(ev: any)
		Effects.onEvent(ev)
		HUD.onEvent(ev)
		if ev.kind == "volley" or ev.kind == "cannon" or ev.kind == "melee" or ev.kind == "charge" or ev.kind == "rout" or ev.kind == "rally" or ev.kind == "capture" then
			Audio.play(ev.kind)
		end
	end))
	table.insert(conns, BattleState.pendingChanged:Connect(Figures.onPendingChanged))
	table.insert(conns, Selection.hoverChanged:Connect(Figures.markDirty))
	table.insert(conns, Selection.changed:Connect(Figures.markDirty))
	table.insert(conns, Input.action:Connect(function(name: string)
		if name == "escape" then
			closePanels()
		elseif name == "dev" then
			DevPanel.toggle()
		elseif name == "help" then
			if Help.isOpen() then
				Help.hide()
			else
				openHelp()
			end
		end
	end))
	table.insert(conns, Settings.changed:Connect(function(key: string)
		if key == "quality" then
			Effects.applySettings()
			WorldLighting.apply(Settings.get().quality)
			local id = builtMapId
			if id then
				task.spawn(function()
					Props.build(mapCache[id], Settings.get().quality, nil)
				end)
			end
		elseif key == "reducedEffects" then
			Effects.applySettings()
		end
	end))
end

-- ------------------------------------------------------------------ boot

-- Morning light, haze and post effects (World/Lighting); re-applied when quality changes.
WorldLighting.apply(Settings.get().quality)

Audio.init()
Camera.init()
Input.init()
diag("starting; waiting for remotes")
Net.init()
diag("remotes hooked; requesting state")
-- The server announced the match state when we joined, possibly before we were listening:
-- ask for it again now that the remotes are hooked.
Net.control("spectate")
wire()

local UserInputService = game:GetService("UserInputService") :: UserInputService
UserInputService.InputBegan:Connect(function(input: InputObject, gp: boolean)
	if not gp and input.KeyCode == Enum.KeyCode.F10 and beaconGui then
		beaconGui.Enabled = not beaconGui.Enabled
	end
end)

RunService.RenderStepped:Connect(function(dt: number)
	Figures.update(dt)
	Effects.update(dt)
	HUD.update(dt)
	Props.updateLabels(Camera.height())
	pendingClock += dt
	if pendingClock > 1 then
		pendingClock = 0
		BattleState.expirePending(6)
	end
end)

-- Until the server speaks, show the menu over the default battlefield.
task.spawn(function()
	task.wait(1)
	if not gotServerState then
		Net.control("spectate")
	end
	task.wait(1.5)
	if not gotServerState then
		diag("no reply from server after 2.5 s; showing offline menu")
		onMatchState({ matchId = "", state = "menu", viewerFaction = "", isCommander = false, difficulty = "normal", speed = 1 })
	end
end)
]]></ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX00000041"><Properties><bool name="Disabled">false</bool><string name="Name">Net</string><ProtectedString name="Source"><![CDATA[--!strict
-- Remote wrapper. Owns requestId generation, client-side validation and a send queue
-- throttled under the server rate limit. Everything else talks to Net, never to remotes.

local Players = game:GetService("Players") :: Players
local RunService = game:GetService("RunService") :: RunService

local Shared = game:GetService("ReplicatedStorage"):WaitForChild("EoE")
local Config = require(Shared.Config)
local Protocol = require(Shared.Protocol)
local Signal = require(script.Parent.Signal)

local Net = {}

Net.onSnapshot = Signal.new()
Net.onMatchState = Signal.new()
Net.onResult = Signal.new()
Net.onDebug = Signal.new()
Net.onCampaign = Signal.new() -- ({kind="view"|"error", ...})

local remotes: { [string]: RemoteEvent } = {}
local connections: { RBXScriptConnection } = {}
local counter = 0
local matchId: string = ""
local ctxFn: (() -> any)? = nil -- builds a Protocol.ValidateContext at send time
local queue: { { remote: RemoteEvent, payload: any } } = {}
local sentThisSecond = 0
local secondStart = 0
local initialised = false

local playerId: string = tostring((Players.LocalPlayer :: Player).UserId)

local function nextRequestId(): string
	counter += 1
	return playerId .. ":" .. counter
end

local function drain()
	local now = os.clock()
	if now - secondStart >= 1 then
		secondStart = now
		sentThisSecond = 0
	end
	-- leave headroom under Config.Net.RequestsPerSecond for control messages
	while #queue > 0 and sentThisSecond < Config.Net.RequestsPerSecond - 4 do
		local item = table.remove(queue, 1) :: any
		item.remote:FireServer(item.payload)
		sentThisSecond += 1
	end
end

function Net.init()
	if initialised then
		return
	end
	initialised = true
	local folder = Shared:WaitForChild("Remotes")
	for _, name in { "Command", "Control", "CommandResult", "Snapshot", "MatchState", "Campaign", "Debug" } do
		local r = folder:WaitForChild(name, 30)
		if r then
			remotes[name] = r :: RemoteEvent
		else
			warn("[EoE] remote missing: " .. name)
		end
	end
	local function hook(name: string, sig: Signal.Signal)
		local r = remotes[name]
		if r then
			table.insert(connections, r.OnClientEvent:Connect(function(payload: any)
				sig:Fire(payload)
			end))
		end
	end
	hook(Protocol.Remotes.Snapshot, Net.onSnapshot)
	hook(Protocol.Remotes.MatchState, Net.onMatchState)
	hook(Protocol.Remotes.CommandResult, Net.onResult)
	hook(Protocol.Remotes.Debug, Net.onDebug)
	hook(Protocol.Remotes.Campaign, Net.onCampaign)
	table.insert(connections, RunService.Heartbeat:Connect(drain))
end

function Net.setMatch(id: string, validateCtx: (() -> any)?)
	matchId = id
	ctxFn = validateCtx
end

function Net.matchId(): string
	return matchId
end

-- Returns requestId on success, or nil plus the validation reason.
function Net.send(kind: string, ids: { number }, data: { [string]: any }?): (string?, string?)
	local cmd = { matchId = matchId, requestId = nextRequestId(), kind = kind, ids = ids, data = data or {} }
	if ctxFn then
		local ok, reason = Protocol.validateCommand(cmd, ctxFn())
		if not ok then
			return nil, reason
		end
	end
	local r = remotes[Protocol.Remotes.Command]
	if not r then
		return nil, "No connection"
	end
	table.insert(queue, { remote = r, payload = cmd })
	return cmd.requestId, nil
end

function Net.control(action: string, value: any): string?
	local r = remotes[Protocol.Remotes.Control]
	if not r then
		return nil
	end
	local msg = { matchId = matchId, requestId = nextRequestId(), action = action, value = value }
	local ok, reason = Protocol.validateControl(msg, { matchId = matchId })
	if not ok then
		warn("[EoE] control rejected locally: " .. tostring(reason))
		return nil
	end
	r:FireServer(msg)
	return msg.requestId
end

-- Campaign remote: open | new | command | battle | skip | return. Returns the requestId.
function Net.campaign(action: string, data: { [string]: any }?): string?
	local r = remotes[Protocol.Remotes.Campaign]
	if not r then
		return nil
	end
	local msg = { requestId = nextRequestId(), action = action, data = data or {} }
	r:FireServer(msg)
	return msg.requestId
end

return Net
]]></ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX00000042"><Properties><bool name="Disabled">false</bool><string name="Name">Selection</string><ProtectedString name="Source"><![CDATA[--!strict
-- Selected formation ids, control groups and the hovered formation. Pure state + signal.

local Signal = require(script.Parent.Signal)
local BattleState = require(script.Parent.BattleState)

local Selection = {}

local selected: { [number]: boolean } = {}
local groups: { [number]: { number } } = {}
local hovered: number? = nil

Selection.changed = Signal.new() -- fired after any selection change
Selection.hoverChanged = Signal.new()

local function fire()
	Selection.changed:Fire()
end

function Selection.ids(): { number }
	local out = {}
	for id in selected do
		table.insert(out, id)
	end
	table.sort(out)
	return out
end

function Selection.count(): number
	local n = 0
	for _ in selected do
		n += 1
	end
	return n
end

function Selection.isSelected(id: number): boolean
	return selected[id] == true
end

function Selection.set(ids: { number })
	table.clear(selected)
	for _, id in ids do
		selected[id] = true
	end
	fire()
end

function Selection.toggle(id: number)
	if selected[id] then
		selected[id] = nil
	else
		selected[id] = true
	end
	fire()
end

function Selection.add(ids: { number })
	for _, id in ids do
		selected[id] = true
	end
	fire()
end

function Selection.clear()
	if next(selected) == nil then
		return
	end
	table.clear(selected)
	fire()
end

-- Drops ids that no longer exist on our side (destroyed, exited, new match).
function Selection.prune()
	local changed = false
	for id in selected do
		local f = BattleState.formations[id]
		if not f or f.faction ~= BattleState.viewerFaction then
			selected[id] = nil
			changed = true
		end
	end
	if changed then
		fire()
	end
end

function Selection.first(): number?
	local ids = Selection.ids()
	return ids[1]
end

function Selection.assignGroup(n: number)
	groups[n] = Selection.ids()
end

function Selection.recallGroup(n: number)
	local g = groups[n]
	if g and #g > 0 then
		Selection.set(g)
	end
end

function Selection.setHovered(id: number?)
	if hovered ~= id then
		hovered = id
		Selection.hoverChanged:Fire(id)
	end
end

function Selection.hovered(): number?
	return hovered
end

function Selection.reset()
	table.clear(selected)
	table.clear(groups)
	hovered = nil
	fire()
end

return Selection
]]></ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX00000043"><Properties><bool name="Disabled">false</bool><string name="Name">Settings</string><ProtectedString name="Source"><![CDATA[--!strict
-- Viewer settings store. Lives for the session; `changed` fires (key, value) on every set.

local Signal = require(script.Parent.Signal)

export type Values = {
	quality: number, -- 1..3
	master: number, -- 0..1
	sfx: number,
	music: number,
	reducedShake: boolean,
	reducedEffects: boolean,
}

local Settings = {}

local values: Values = {
	quality = 2,
	master = 0.8,
	sfx = 1.0,
	music = 0.6,
	reducedShake = false,
	reducedEffects = false,
}

Settings.changed = Signal.new()

function Settings.get(): Values
	return values
end

function Settings.set(key: string, value: any)
	local v = values :: any
	if v[key] == value then
		return
	end
	if key == "quality" then
		value = math.clamp(math.round(value), 1, 3)
	elseif key == "master" or key == "sfx" or key == "music" then
		value = math.clamp(value, 0, 1)
	end
	v[key] = value
	Settings.changed:Fire(key, value)
end

return Settings
]]></ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX00000044"><Properties><bool name="Disabled">false</bool><string name="Name">Signal</string><ProtectedString name="Source"><![CDATA[--!strict
-- Minimal synchronous signal. Handlers run in order; a handler error is reported, not fatal.

export type Connection = { Disconnect: (self: Connection) -> () }
export type Handler = (...any) -> ()

local Signal = {}
Signal.__index = Signal

export type Signal = typeof(setmetatable({} :: { _handlers: { Handler } }, Signal))

function Signal.new(): Signal
	return setmetatable({ _handlers = {} :: { Handler } }, Signal)
end

-- `fn` is loosely typed on purpose: handlers declare only the arguments they use.
function Signal.Connect(self: Signal, fn: any): Connection
	local handlers = self._handlers
	table.insert(handlers, fn :: Handler)
	return {
		Disconnect = function(_self: Connection)
			local i = table.find(handlers, fn)
			if i then
				table.remove(handlers, i)
			end
		end,
	}
end

function Signal.Fire(self: Signal, ...: any)
	-- copy so handlers may disconnect while firing
	for _, fn in table.clone(self._handlers) do
		local ok, err = (pcall :: any)(fn, ...)
		if not ok then
			warn("[EoE] signal handler error: " .. tostring(err))
		end
	end
end

function Signal.DisconnectAll(self: Signal)
	table.clear(self._handlers)
end

return Signal
]]></ProtectedString></Properties></Item><Item class="Folder" referent="RBX00000058"><Properties><string name="Name">UI</string></Properties><Item class="ModuleScript" referent="RBX00000045"><Properties><bool name="Disabled">false</bool><string name="Name">BattleSelect</string><ProtectedString name="Source"><![CDATA[--!strict
-- Battle select: the scenarios from Scenarios.list() (fallback: Scenarios.jena alone), each with
-- name, date, sides, summary, difficulty note and a Fight button; a difficulty selector on top.

local Shared = game:GetService("ReplicatedStorage"):WaitForChild("EoE")
local Scenarios = require(Shared.Scenarios)
local Kit = require(script.Parent.Kit)
local BattleState = require(script.Parent.Parent.BattleState)

local BattleSelect = {}

export type Callbacks = {
	fight: (id: string) -> (),
	difficulty: (value: string) -> (),
	back: () -> (),
}

type Entry = { id: string, name: string, date: string?, map: string?, factionNames: { [string]: string }?, summary: string?, difficultyNote: string? }

local gui: ScreenGui? = nil
local difficultyButtons: { [string]: TextButton } = {}

local function entries(): { Entry }
	local list = (Scenarios :: any).list
	if type(list) == "function" then
		local ok, result = pcall(list)
		if ok and type(result) == "table" and #result > 0 then
			return result
		end
	end
	local j = (Scenarios :: any).jena
	if j then
		return { { id = j.id, name = j.name, date = "14 October 1806", map = j.map, factionNames = j.factionNames, summary = j.briefing, difficultyNote = "The opening battle: even numbers, the French hold the high ground." } }
	end
	return {}
end

local function sides(e: Entry): string
	local names = {}
	for _, n in e.factionNames or {} do
		table.insert(names, tostring(n))
	end
	table.sort(names)
	return table.concat(names, "  vs  ")
end

local function refreshDifficulty()
	for key, b in difficultyButtons do
		Kit.setActiveLook(b, BattleState.difficulty == key)
	end
end

local function card(parent: Instance, e: Entry, order: number, cb: Callbacks, isCommander: boolean)
	local f = Kit.panel(parent, { size = UDim2.new(1, -8, 0, 150), position = UDim2.new(), dark = true, padding = 12 })
	f.LayoutOrder = order
	f.AutomaticSize = Enum.AutomaticSize.Y
	Kit.title(f, e.name, { size = UDim2.new(1, -130, 0, 28), textSize = 24 })
	Kit.label(f, string.format("%s   ·   %s", tostring(e.date or ""), sides(e)), { size = UDim2.new(1, -130, 0, 18), position = UDim2.new(0, 0, 0, 30), textSize = 12, colour = Kit.MUTED })
	-- summary and note stacked, so a long summary pushes the note down instead of overlapping it
	local body = Instance.new("Frame") :: Frame
	body.Size = UDim2.new(1, -130, 0, 0)
	body.Position = UDim2.new(0, 0, 0, 52)
	body.AutomaticSize = Enum.AutomaticSize.Y
	body.BackgroundTransparency = 1
	body.Parent = f
	Kit.list(body, 6)
	local summary = Kit.label(body, tostring(e.summary or ""), { size = UDim2.new(1, 0, 0, 0), textSize = 13, wrap = true })
	summary.AutomaticSize = Enum.AutomaticSize.Y
	summary.TextYAlignment = Enum.TextYAlignment.Top
	summary.LayoutOrder = 1
	local note = Kit.label(body, if e.difficultyNote then "Difficulty: " .. tostring(e.difficultyNote) else "", { size = UDim2.new(1, 0, 0, 0), textSize = 12, colour = Kit.MUTED, wrap = true })
	note.AutomaticSize = Enum.AutomaticSize.Y
	note.LayoutOrder = 2
	local b = Kit.button(f, "Fight", function()
		cb.fight(e.id)
	end, { size = UDim2.fromOffset(110, 40), position = UDim2.new(1, 0, 0, 0), anchor = Vector2.new(1, 0), primary = true, textSize = 16 })
	Kit.setEnabled(b, isCommander, "Only the commander starts a battle")
end

function BattleSelect.show(cb: Callbacks, isCommander: boolean)
	BattleSelect.destroy()
	local sg = Kit.screen("EoEBattleSelect", 31)
	local panel = Kit.panel(sg, { size = UDim2.fromOffset(720, 640), position = UDim2.fromScale(0.5, 0.5), anchor = Vector2.new(0.5, 0.5), padding = 20 })
	Kit.title(panel, "Choose a battle", { size = UDim2.new(1, 0, 0, 36), textSize = 30 })
	Kit.button(panel, "Back (Esc)", cb.back, { size = UDim2.fromOffset(110, 28), position = UDim2.new(1, 0, 0, 0), anchor = Vector2.new(1, 0) })
	Kit.label(panel, "Enemy difficulty", { size = UDim2.new(0, 160, 0, 30), position = UDim2.new(0, 0, 0, 44), textSize = 13, colour = Kit.MUTED })
	local dRow = Instance.new("Frame") :: Frame
	dRow.Size = UDim2.new(0, 300, 0, 30)
	dRow.Position = UDim2.new(0, 150, 0, 44)
	dRow.BackgroundTransparency = 1
	dRow.Parent = panel
	Kit.list(dRow, 6, true)
	table.clear(difficultyButtons)
	for i, key in { "easy", "normal", "hard" } do
		local b = Kit.button(dRow, string.upper(string.sub(key, 1, 1)) .. string.sub(key, 2), function()
			cb.difficulty(key)
			BattleState.difficulty = key
			refreshDifficulty()
		end, { size = UDim2.fromOffset(94, 30), order = i, tooltip = if key == "hard" then "The enemy gets +5 morale" else nil })
		Kit.setEnabled(b, isCommander, "Only the commander sets the difficulty")
		difficultyButtons[key] = b
	end
	refreshDifficulty()
	local scroll = Instance.new("ScrollingFrame") :: ScrollingFrame
	scroll.Size = UDim2.new(1, 0, 1, -86)
	scroll.Position = UDim2.new(0, 0, 0, 82)
	scroll.BackgroundTransparency = 1
	scroll.BorderSizePixel = 0
	scroll.ScrollBarThickness = 6
	scroll.AutomaticCanvasSize = Enum.AutomaticSize.Y
	scroll.CanvasSize = UDim2.new()
	scroll.Active = true
	scroll.Parent = panel
	Kit.list(scroll, 10)
	local list = entries()
	for i, e in list do
		card(scroll, e, i, cb, isCommander)
	end
	if #list == 0 then
		Kit.label(scroll, "No scenarios are installed.", { size = UDim2.new(1, 0, 0, 24), colour = Kit.MUTED })
	end
	gui = sg
end

function BattleSelect.isOpen(): boolean
	return gui ~= nil
end

function BattleSelect.hide()
	BattleSelect.destroy()
end

function BattleSelect.destroy()
	if gui then
		gui:Destroy()
		gui = nil
	end
	table.clear(difficultyButtons)
end

return BattleSelect
]]></ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX00000046"><Properties><bool name="Disabled">false</bool><string name="Name">CampaignScreen</string><ProtectedString name="Source"><![CDATA[--!strict
-- Campaign screen: stylised region map (nodes, roads, owner fills, army stacks), side panel
-- (resources, selected army, recruitment, objectives, log), End Turn, pending-battle dialog.
-- The server view is the only state; every action goes back through `callbacks.send`.

local Kit = require(script.Parent.Kit)
local Factions = require(script.Parent.Parent.Factions)

local CampaignScreen = {}

export type Callbacks = {
	send: (action: string, data: { [string]: any }?) -> (),
	menu: () -> (),
}

local PLAYER = "france"
local OLIVE = Color3.fromRGB(128, 118, 70)
local OLIVE_DARK = Color3.fromRGB(96, 88, 52)
local ROAD = Color3.fromRGB(214, 200, 160)
local REASONS: { [string]: string } = {
	notYourArmy = "That army is not yours",
	alreadyMoved = "That army has already marched this turn",
	notAdjacent = "No road leads there",
	unknownUnit = "Unknown unit type",
	notYourRegion = "You do not hold that region",
	queueFull = "The recruitment queue is full",
	insufficientFunds = "Not enough treasury",
	wrongPhase = "Not during this phase",
	nothingToReplenish = "Nothing to replenish",
	badArgs = "Malformed order",
	unknownCommand = "Unknown order",
}

local gui: ScreenGui? = nil
local cb: Callbacks? = nil
local view: any = nil
local sessionOnly = false
local selectedArmy: number? = nil
local selectedRegion: string? = nil
local confirmNew = false

local mapFrame: Frame? = nil
local roadLayer: Frame? = nil
local nodeLayer: Frame? = nil
local side: ScrollingFrame? = nil
local toast: TextLabel? = nil
local dialog: Frame? = nil
local sizeConn: RBXScriptConnection? = nil

-- ------------------------------------------------------------------ helpers

local function regionById(id: string?): any
	if not view or not id then
		return nil
	end
	for _, r in view.regions do
		if r.id == id then
			return r
		end
	end
	return nil
end

local function armyById(id: number?): any
	if not view or not id then
		return nil
	end
	for _, a in view.armies do
		if a.id == id then
			return a
		end
	end
	return nil
end

local function armyStrength(a: any): number
	local s = 0
	for _, u in a.units do
		s += u.strength
	end
	return s
end

local function shortName(name: string): string
	local tail = string.match(name, "·%s*(.+)$")
	return tail or name
end

local function factionName(f: string?): string
	return Factions.name(f)
end

local function plural(n: number): string
	return if n == 1 then "" else "s"
end

local function isAdjacent(a: any, regionId: string): boolean
	return table.find(a.adjacent, regionId) ~= nil
end

local function nodePos(r: any): UDim2
	return UDim2.fromScale(0.08 + 0.84 * r.pos.x / 1000, 0.08 + 0.84 * r.pos.z / 1000)
end

local function playerPhase(): boolean
	return view ~= nil and view.phase == "player" and view.victory == nil and view.pendingBattle == nil
end

local function queueCount(): number
	local n = 0
	for _, q in view.recruitment do
		if q.faction == PLAYER then
			n += 1
		end
	end
	return n
end

local function send(action: string, data: { [string]: any }?)
	if cb then
		cb.send(action, data)
	end
end

-- ------------------------------------------------------------------ map

local function drawRoads()
	local layer = roadLayer
	local mf = mapFrame
	if not layer or not mf or not view then
		return
	end
	layer:ClearAllChildren()
	local size = mf.AbsoluteSize
	local done: { [string]: boolean } = {}
	for _, r in view.regions do
		for _, otherId in r.adjacent do
			local key = if r.id < otherId then r.id .. "|" .. otherId else otherId .. "|" .. r.id
			local o = regionById(otherId)
			if o and not done[key] then
				done[key] = true
				local ax, ay = (0.08 + 0.84 * r.pos.x / 1000) * size.X, (0.08 + 0.84 * r.pos.z / 1000) * size.Y
				local bx, by = (0.08 + 0.84 * o.pos.x / 1000) * size.X, (0.08 + 0.84 * o.pos.z / 1000) * size.Y
				local line = Instance.new("Frame") :: Frame
				line.AnchorPoint = Vector2.new(0.5, 0.5)
				line.BackgroundColor3 = ROAD
				line.BackgroundTransparency = 0.25
				line.BorderSizePixel = 0
				line.Position = UDim2.fromOffset((ax + bx) / 2, (ay + by) / 2)
				line.Size = UDim2.fromOffset(math.sqrt((bx - ax) ^ 2 + (by - ay) ^ 2), 3)
				line.Rotation = math.deg(math.atan2(by - ay, bx - ax))
				line.Parent = layer
			end
		end
	end
end

local function onRegionClick(r: any)
	local a = armyById(selectedArmy)
	if a and a.faction == PLAYER and playerPhase() and a.regionId ~= r.id and isAdjacent(regionById(a.regionId), r.id) and a.movesLeft > 0 then
		send("command", { kind = "move", armyId = a.id, regionId = r.id })
		return
	end
	selectedRegion = r.id
	selectedArmy = nil
	for _, id in r.armies do
		local army = armyById(id)
		if army and army.faction == PLAYER then
			selectedArmy = id
			break
		end
	end
	CampaignScreen.render()
end

local function armyStack(parent: Instance, a: any, order: number)
	local own = a.faction == PLAYER
	local b = Instance.new("TextButton") :: TextButton
	b.Size = UDim2.fromOffset(92, 18)
	b.BackgroundColor3 = if own then Kit.FRANCE else Color3.fromRGB(36, 37, 40)
	b.BorderSizePixel = 0
	b.AutoButtonColor = true
	b.Font = Enum.Font.Gotham
	b.TextSize = 10
	b.TextColor3 = Color3.fromRGB(240, 236, 224)
	b.Text = string.format("%s  %d", shortName(a.name), armyStrength(a))
	b.LayoutOrder = order
	b.ZIndex = 6
	b.Active = true
	b.Parent = parent
	local stroke = Instance.new("UIStroke") :: UIStroke
	stroke.Color = if selectedArmy == a.id then Kit.SELECT else Color3.fromRGB(20, 20, 20)
	stroke.Thickness = if selectedArmy == a.id then 2 else 1
	stroke.Parent = b
	local top = Instance.new("Frame") :: Frame
	top.Size = UDim2.new(1, 0, 0, 2)
	top.BackgroundColor3 = b.BackgroundColor3:Lerp(Color3.new(1, 1, 1), 0.3)
	top.BorderSizePixel = 0
	top.ZIndex = 7
	top.Parent = b
	if a.movesLeft <= 0 and own then
		b.TextTransparency = 0.35
	end
	b.Activated:Connect(function()
		selectedArmy = a.id
		selectedRegion = a.regionId
		CampaignScreen.render()
	end)
end

local function drawNodes()
	local layer = nodeLayer
	if not layer or not view then
		return
	end
	layer:ClearAllChildren()
	local sel = armyById(selectedArmy)
	local canMove = sel ~= nil and sel.faction == PLAYER and sel.movesLeft > 0 and playerPhase()
	local from = if sel then regionById(sel.regionId) else nil
	for _, r in view.regions do
		local legal = canMove and from ~= nil and r.id ~= from.id and isAdjacent(from, r.id)
		local d = if r.isCity then 30 else 22
		local node = Instance.new("TextButton") :: TextButton
		node.Size = UDim2.fromOffset(d, d)
		node.AnchorPoint = Vector2.new(0.5, 0.5)
		node.Position = nodePos(r)
		node.BackgroundColor3 = Kit.factionColour(r.owner)
		node.Text = ""
		node.AutoButtonColor = true
		node.BorderSizePixel = 0
		node.ZIndex = 5
		node.Active = true
		node.Parent = layer
		local c = Instance.new("UICorner") :: UICorner
		c.CornerRadius = UDim.new(1, 0)
		c.Parent = node
		local s = Instance.new("UIStroke") :: UIStroke
		s.Thickness = if legal or selectedRegion == r.id then 3 else 1.5
		s.Color = if legal then Kit.SELECT elseif selectedRegion == r.id then Kit.CREAM else Color3.fromRGB(30, 28, 24)
		s.Parent = node
		if r.isCity then
			local inner = Instance.new("Frame") :: Frame
			inner.Size = UDim2.fromScale(0.45, 0.45)
			inner.AnchorPoint = Vector2.new(0.5, 0.5)
			inner.Position = UDim2.fromScale(0.5, 0.5)
			inner.BackgroundColor3 = Kit.CREAM
			inner.BorderSizePixel = 0
			inner.ZIndex = 6
			inner.Parent = node
			local ic = Instance.new("UICorner") :: UICorner
			ic.CornerRadius = UDim.new(1, 0)
			ic.Parent = inner
		end
		node.Activated:Connect(function()
			onRegionClick(r)
		end)
		local objective = false
		for _, o in view.objectives.regions do
			if o.id == r.id then
				objective = true
			end
		end
		local label = Kit.label(layer, r.name .. (if objective then " ✦" else ""), { size = UDim2.fromOffset(140, 20), position = nodePos(r) + UDim2.fromOffset(0, d / 2 + 2), anchor = Vector2.new(0.5, 0), font = Enum.Font.Garamond, textSize = if r.isCity then 20 else 17, colour = Kit.CREAM, align = Enum.TextXAlignment.Center })
		label.TextStrokeTransparency = 0.5
		label.TextStrokeColor3 = Color3.fromRGB(30, 28, 20)
		label.ZIndex = 5
		if #r.armies > 0 then
			local stack = Instance.new("Frame") :: Frame
			stack.Size = UDim2.fromOffset(92, 20 * #r.armies)
			stack.Position = nodePos(r) + UDim2.fromOffset(d / 2 + 6, -10)
			stack.BackgroundTransparency = 1
			stack.ZIndex = 6
			stack.Parent = layer
			Kit.list(stack, 2)
			for i, id in r.armies do
				local a = armyById(id)
				if a then
					armyStack(stack, a, i)
				end
			end
		end
		-- recruitment in progress at this region
		local queued = 0
		for _, q in view.recruitment do
			if q.regionId == r.id then
				queued += 1
			end
		end
		if queued > 0 then
			local q = Kit.label(layer, string.format("+%d raising", queued), { size = UDim2.fromOffset(90, 14), position = nodePos(r) + UDim2.fromOffset(-d / 2 - 6, -7), anchor = Vector2.new(1, 0), textSize = 10, colour = Kit.CREAM, align = Enum.TextXAlignment.Right })
			q.ZIndex = 5
		end
	end
end

-- ------------------------------------------------------------------ side panel

local function section(parent: Instance, title: string, order: number): Frame
	local f = Instance.new("Frame") :: Frame
	f.Size = UDim2.new(1, 0, 0, 20)
	f.AutomaticSize = Enum.AutomaticSize.Y
	f.BackgroundTransparency = 1
	f.LayoutOrder = order
	f.Parent = parent
	Kit.list(f, 4)
	local t = Kit.title(f, title, { size = UDim2.new(1, 0, 0, 24), textSize = 20 })
	t.LayoutOrder = 0
	return f
end

local function row(parent: Instance, text: string, order: number, props: Kit.TextProps?): TextLabel
	local p: Kit.TextProps = props or {}
	p.size = p.size or UDim2.new(1, 0, 0, 18)
	p.textSize = p.textSize or 13
	p.wrap = if p.wrap == nil then true else p.wrap
	local l = Kit.label(parent, text, p)
	l.AutomaticSize = Enum.AutomaticSize.Y
	l.LayoutOrder = order
	return l
end

local function unitRow(parent: Instance, u: any, order: number)
	local f = Instance.new("Frame") :: Frame
	f.Size = UDim2.new(1, 0, 0, 30)
	f.BackgroundTransparency = 1
	f.LayoutOrder = order
	f.Parent = parent
	local name = Kit.label(f, u.name, { size = UDim2.new(1, -40, 0, 16), textSize = 12 })
	name.TextTruncate = Enum.TextTruncate.AtEnd
	Kit.label(f, string.rep("›", math.clamp(u.experience or 0, 0, 3)), { size = UDim2.fromOffset(36, 16), position = UDim2.new(1, -36, 0, 0), textSize = 14, colour = Kit.MUTED, align = Enum.TextXAlignment.Right })
	local track = Instance.new("Frame") :: Frame
	track.Size = UDim2.new(1, -60, 0, 5)
	track.Position = UDim2.new(0, 0, 0, 20)
	track.BackgroundColor3 = Kit.INK
	track.BackgroundTransparency = 0.7
	track.BorderSizePixel = 0
	track.Parent = f
	local fill = Instance.new("Frame") :: Frame
	fill.Size = UDim2.fromScale(math.clamp(u.strength / math.max(u.maxStrength, 1), 0, 1), 1)
	fill.BackgroundColor3 = Kit.FRANCE
	fill.BorderSizePixel = 0
	fill.Parent = track
	Kit.label(f, string.format("%d/%d", u.strength, u.maxStrength), { size = UDim2.fromOffset(56, 12), position = UDim2.new(1, -56, 0, 17), textSize = 10, colour = Kit.MUTED, align = Enum.TextXAlignment.Right })
end

local function armySection(parent: Instance, order: number)
	local a = armyById(selectedArmy)
	if not a then
		return
	end
	local s = section(parent, a.name, order)
	local r = regionById(a.regionId)
	local where: string = if r then tostring(r.name) else tostring(a.regionId)
	local supplyWord: string = if a.supplied then "supplied" else "out of supply"
	row(s, string.format("%s · %s · %d men · %s", factionName(a.faction), where, armyStrength(a), supplyWord), 1, { colour = if a.supplied then Kit.MUTED else Kit.HOSTILE })
	for i, u in a.units do
		unitRow(s, u, 10 + i)
	end
	if a.faction == PLAYER then
		local need = 0
		for _, u in a.units do
			need += math.max(u.maxStrength - u.strength, 0)
		end
		local cost = math.ceil(need * 0.5)
		local b = Kit.button(s, string.format("Replenish  (%d men · %d treasury)", need, cost), function()
			send("command", { kind = "replenish", armyId = a.id })
		end, { size = UDim2.new(1, 0, 0, 30), order = 100, textSize = 12 })
		local ok, why = true, nil
		if not playerPhase() then
			ok, why = false, REASONS.wrongPhase
		elseif need == 0 then
			ok, why = false, REASONS.nothingToReplenish
		elseif not r or r.owner ~= PLAYER then
			ok, why = false, "Replacements only arrive in a region you hold"
		elseif view.treasury < 1 or view.manpower < 1 then
			ok, why = false, "No treasury or manpower for replacements"
		end
		Kit.setEnabled(b, ok, why)
		local moveText = if a.movesLeft > 0 then "Can march this turn: click a highlighted region." else "Has marched this turn."
		row(s, moveText, 101, { colour = Kit.MUTED, textSize = 12 })
	end
end

local function regionSection(parent: Instance, order: number)
	local r = regionById(selectedRegion)
	if not r then
		return
	end
	local s = section(parent, r.name .. (if r.isCity then " (city)" else ""), order)
	local owner: string = factionName(r.owner)
	local income: number, men: number, ground: string = r.income, r.manpower, tostring(r.terrain)
	row(s, string.format("Held by %s · +%d treasury, +%d manpower per turn · %s ground", owner, income, men, ground), 1, { colour = Kit.MUTED, textSize = 12 })
	for _, q in view.recruitment do
		if q.regionId == r.id then
			local qName: string, left: number = tostring(q.name), q.turnsLeft
			row(s, string.format("Raising %s — %d turn%s left", qName, left, plural(left)), 2, { textSize = 12 })
		end
	end
	local sub = row(s, "Recruit here", 3, { font = Enum.Font.GothamBold, textSize = 12 })
	sub.LayoutOrder = 3
	local keys = {}
	for key, t in view.unitTypes do
		if t.recruitable then
			table.insert(keys, key)
		end
	end
	table.sort(keys, function(x: string, y: string)
		return view.unitTypes[x].cost < view.unitTypes[y].cost
	end)
	for i, key in keys do
		local t = view.unitTypes[key]
		local tName: string, cost: number, turns: number, size: number = tostring(t.name), t.cost, t.turns, t.strength
		local b = Kit.button(s, string.format("%s · %d treasury · %d turn%s · %d men", tName, cost, turns, plural(turns), size), function()
			send("command", { kind = "recruit", regionId = r.id, unitType = key })
		end, { size = UDim2.new(1, 0, 0, 28), order = 10 + i, textSize = 11 })
		b.TextXAlignment = Enum.TextXAlignment.Left
		local ok, why = true, nil
		if not playerPhase() then
			ok, why = false, REASONS.wrongPhase
		elseif r.owner ~= PLAYER then
			ok, why = false, REASONS.notYourRegion
		elseif queueCount() >= 6 then
			ok, why = false, REASONS.queueFull
		elseif view.treasury < t.cost then
			ok, why = false, string.format("Not enough treasury (%d needed)", t.cost)
		end
		Kit.setEnabled(b, ok, why)
	end
end

local function buildSide()
	local s = side
	if not s or not view then
		return
	end
	s:ClearAllChildren()
	Kit.list(s, 10)
	local order = 0
	local function next(): number
		order += 1
		return order
	end
	-- header
	local head = section(s, string.format("Turn %d of %d", view.turn, view.turnLimit), next())
	local phaseText = if view.victory then (if view.victory.outcome == "victory" then "Campaign won" else "Campaign lost") elseif view.pendingBattle then "A battle awaits" elseif view.phase == "player" then "Your orders" else "The enemy moves"
	row(head, phaseText, 1, { colour = Kit.MUTED })
	row(head, string.format("Treasury %d   ·   Manpower %d   ·   Supply %d%%", view.treasury, view.manpower, view.supply), 2, { font = Enum.Font.GothamBold })
	if view.supply <= 25 then
		row(head, "Supply is low: unpaid upkeep bleeds strength each turn.", 3, { colour = Kit.HOSTILE, textSize = 12 })
	end
	if sessionOnly then
		row(head, "Saving unavailable: progress lasts this session only.", 4, { colour = Kit.HOSTILE, textSize = 12 })
	end
	local endTurn = Kit.button(head, "End Turn", function()
		send("command", { kind = "endTurn" })
	end, { size = UDim2.new(1, 0, 0, 36), primary = true, order = 5, textSize = 15 })
	Kit.setEnabled(endTurn, playerPhase(), if view.pendingBattle then "Resolve the pending battle first" elseif view.victory then "The campaign is over" else REASONS.wrongPhase)

	if view.victory then
		local v = section(s, if view.victory.outcome == "victory" then "Victory" else "Defeat", next())
		row(v, tostring(view.victory.reason), 1)
		Kit.button(v, "Start again", function()
			send("command", { kind = "restart" })
		end, { size = UDim2.new(1, 0, 0, 30), order = 2 })
	end

	armySection(s, next())
	regionSection(s, next())

	local obj = section(s, "Objectives", next())
	for i, o in view.objectives.regions do
		row(obj, (if o.held then "■  " else "□  ") .. o.name, i, { colour = if o.held then Kit.INK else Kit.MUTED })
	end
	local ok = view.objectives.armyStrength >= view.objectives.minArmyStrength
	row(obj, string.format("Army strength %d / %d required", view.objectives.armyStrength, view.objectives.minArmyStrength), 20, { colour = if ok then Kit.INK else Kit.MUTED })

	local lg = section(s, "Dispatches", next())
	local lines = view.log or {}
	for i = #lines, math.max(1, #lines - 9), -1 do
		row(lg, "· " .. tostring(lines[i]), 100 - i, { textSize = 12, colour = Kit.MUTED })
	end

	local tools = section(s, "", next())
	Kit.button(tools, if confirmNew then "Confirm: abandon and start new" else "New Campaign", function()
		if confirmNew then
			confirmNew = false
			send("new")
		else
			confirmNew = true
			CampaignScreen.render()
		end
	end, { size = UDim2.new(1, 0, 0, 30), order = 1, primary = confirmNew })
	if confirmNew then
		Kit.button(tools, "Cancel", function()
			confirmNew = false
			CampaignScreen.render()
		end, { size = UDim2.new(1, 0, 0, 28), order = 2 })
	end
	Kit.button(tools, "Main Menu", function()
		if cb then
			cb.menu()
		end
	end, { size = UDim2.new(1, 0, 0, 30), order = 3 })
end

-- ------------------------------------------------------------------ battle dialog

local function buildDialog(sg: ScreenGui)
	if dialog then
		dialog:Destroy()
		dialog = nil
	end
	local pb = view and view.pendingBattle
	if not pb then
		return
	end
	local r = regionById(pb.regionId)
	local d = Kit.panel(sg, { size = UDim2.fromOffset(420, 200), position = UDim2.fromScale(0.5, 0.5), anchor = Vector2.new(0.5, 0.5), padding = 18 })
	d.ZIndex = 20
	Kit.title(d, "Battle at " .. (if r then r.name else pb.regionId), { size = UDim2.new(1, 0, 0, 32), textSize = 26 })
	local ground: string = if r then tostring(r.terrain) else "open"
	Kit.label(d, string.format("%s attacks %s. Fight it on the %s ground, or let the staff resolve it.", factionName(pb.attacker), factionName(pb.defender), ground), { size = UDim2.new(1, 0, 0, 60), position = UDim2.new(0, 0, 0, 40), wrap = true, textSize = 13 })
	local rowF = Instance.new("Frame") :: Frame
	rowF.Size = UDim2.new(1, 0, 0, 38)
	rowF.Position = UDim2.new(0, 0, 1, -38)
	rowF.BackgroundTransparency = 1
	rowF.Parent = d
	Kit.list(rowF, 8, true)
	Kit.button(rowF, "Fight", function()
		send("battle")
	end, { size = UDim2.new(0.5, -4, 1, 0), primary = true, order = 1, textSize = 15 })
	Kit.button(rowF, "Auto-resolve", function()
		send("skip")
	end, { size = UDim2.new(0.5, -4, 1, 0), order = 2, textSize = 15, tooltip = "The staff decides the outcome from strength and ground" })
	dialog = d
end

-- ------------------------------------------------------------------ public

local function build()
	if gui then
		return
	end
	local sg = Kit.screen("EoECampaign", 32)
	local back = Instance.new("Frame") :: Frame
	back.Size = UDim2.fromScale(1, 1)
	back.BackgroundColor3 = Color3.fromRGB(28, 26, 22)
	back.BackgroundTransparency = 0.35
	back.BorderSizePixel = 0
	back.Active = true
	back.Parent = sg
	local mapPanel = Kit.panel(sg, { size = UDim2.new(1, -420, 1, -32), position = UDim2.new(0, 16, 0, 16), transparency = 0 })
	mapPanel.BackgroundColor3 = OLIVE
	local grad = Instance.new("UIGradient") :: UIGradient
	grad.Color = ColorSequence.new(OLIVE, OLIVE_DARK)
	grad.Rotation = 60
	grad.Parent = mapPanel
	local mf = Instance.new("Frame") :: Frame
	mf.Size = UDim2.fromScale(1, 1)
	mf.AnchorPoint = Vector2.new(0.5, 0.5)
	mf.Position = UDim2.fromScale(0.5, 0.5)
	mf.BackgroundTransparency = 1
	mf.Parent = mapPanel
	local aspect = Instance.new("UIAspectRatioConstraint") :: UIAspectRatioConstraint
	aspect.AspectRatio = 1.15
	aspect.Parent = mf
	local rl = Instance.new("Frame") :: Frame
	rl.Size = UDim2.fromScale(1, 1)
	rl.BackgroundTransparency = 1
	rl.Parent = mf
	local nl = Instance.new("Frame") :: Frame
	nl.Size = UDim2.fromScale(1, 1)
	nl.BackgroundTransparency = 1
	nl.ZIndex = 5
	nl.Parent = mf
	local t = Kit.title(mapPanel, "Thuringia, October 1806", { size = UDim2.new(1, -20, 0, 30), position = UDim2.new(0, 12, 0, 6), textSize = 24, colour = Kit.CREAM })
	t.ZIndex = 8
	local compass = Kit.label(mapPanel, "N ▲", { size = UDim2.fromOffset(60, 20), position = UDim2.new(1, -12, 0, 10), anchor = Vector2.new(1, 0), textSize = 12, colour = Kit.CREAM, align = Enum.TextXAlignment.Right })
	compass.ZIndex = 8
	local sidePanel = Kit.panel(sg, { size = UDim2.new(0, 380, 1, -32), position = UDim2.new(1, -16, 0, 16), anchor = Vector2.new(1, 0), padding = 14 })
	local sc = Instance.new("ScrollingFrame") :: ScrollingFrame
	sc.Size = UDim2.fromScale(1, 1)
	sc.BackgroundTransparency = 1
	sc.BorderSizePixel = 0
	sc.ScrollBarThickness = 6
	sc.AutomaticCanvasSize = Enum.AutomaticSize.Y
	sc.CanvasSize = UDim2.new()
	sc.Active = true
	sc.Parent = sidePanel
	toast = Kit.label(sg, "", { size = UDim2.new(1, -420, 0, 24), position = UDim2.new(0, 16, 1, -40), textSize = 13, align = Enum.TextXAlignment.Center, colour = Kit.CREAM })
	toast.TextStrokeTransparency = 0.3
	toast.TextStrokeColor3 = Kit.INK
	toast.ZIndex = 9
	toast.Visible = false
	gui = sg
	mapFrame = mf
	roadLayer = rl
	nodeLayer = nl
	side = sc
	sizeConn = mf:GetPropertyChangedSignal("AbsoluteSize"):Connect(drawRoads)
end

function CampaignScreen.render()
	if not gui or not view then
		return
	end
	-- keep the selection valid against the new view
	if selectedArmy and not armyById(selectedArmy) then
		selectedArmy = nil
	end
	if selectedRegion and not regionById(selectedRegion) then
		selectedRegion = nil
	end
	drawRoads()
	drawNodes()
	buildSide()
	buildDialog(gui :: ScreenGui)
end

function CampaignScreen.show(v: any, isSessionOnly: boolean, callbacks: Callbacks)
	build()
	cb = callbacks
	view = v
	sessionOnly = isSessionOnly
	if gui then
		gui.Enabled = true
	end
	CampaignScreen.render()
end

function CampaignScreen.setView(v: any, isSessionOnly: boolean)
	view = v
	sessionOnly = isSessionOnly
	confirmNew = false
	CampaignScreen.render()
end

function CampaignScreen.showError(reason: string)
	local text = REASONS[reason] or reason
	if toast then
		toast.Text = text
		toast.Visible = true
		task.delay(4, function()
			if toast and toast.Text == text then
				toast.Visible = false
			end
		end)
	end
end

function CampaignScreen.isOpen(): boolean
	return gui ~= nil and (gui :: ScreenGui).Enabled
end

function CampaignScreen.hide()
	if gui then
		gui.Enabled = false
	end
end

function CampaignScreen.destroy()
	if sizeConn then
		sizeConn:Disconnect()
		sizeConn = nil
	end
	if gui then
		gui:Destroy()
		gui = nil
	end
	mapFrame = nil
	roadLayer = nil
	nodeLayer = nil
	side = nil
	toast = nil
	dialog = nil
	view = nil
	cb = nil
	selectedArmy = nil
	selectedRegion = nil
	confirmNew = false
end

return CampaignScreen
]]></ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX00000047"><Properties><bool name="Disabled">false</bool><string name="Name">CardBar</string><ProtectedString name="Source"><![CDATA[--!strict
-- Unit card bar (bottom centre): one card per own formation in roster order, grouped by corps,
-- then greyed cards for reinforcements still on the road. Click selects, shift-click toggles,
-- double-click focuses the camera. Routing cards flash; destroyed or exited formations grey
-- out and collapse. Scrolls horizontally when the army is wider than the bar.

local TweenService = game:GetService("TweenService") :: TweenService
local UserInputService = game:GetService("UserInputService") :: UserInputService
local Shared = game:GetService("ReplicatedStorage"):WaitForChild("EoE")
local Config = require(Shared.Config)
local Kit = require(script.Parent.Kit)
local BattleState = require(script.Parent.Parent.BattleState)
local Selection = require(script.Parent.Parent.Selection)
local Input = require(script.Parent.Parent.Input)
local Camera = require(script.Parent.Parent.Camera)
local Factions = require(script.Parent.Parent.Factions)

local CardBar = {}

local CARD_W, CARD_H = 58, 80
local GAP = 3
CardBar.HEIGHT = 96
CardBar.SIDE_MARGIN = 276 -- clear of the command panel (left) and the minimap (right)

local AMBER = Color3.fromRGB(196, 140, 40)
local MORALE_DEFAULT: { [string]: number } = { steady = 100, shaken = 45, routing = 15, shattered = 0 }
local STATE_WORD: { [string]: string } = { idle = "Holding", moving = "Marching", reforming = "Reforming", firing = "Firing", charging = "Charging", melee = "In melee", retreating = "Retreating", routing = "Routing", rallying = "Rallying" }

type Card = {
	root: TextButton,
	stroke: UIStroke,
	name: TextLabel,
	count: TextLabel,
	strength: Frame,
	morale: Frame,
	icons: { [string]: Frame },
	reloadFill: Frame,
	view: any, -- last FormationView table seen (identity changes when the server resends it)
	seenAt: number,
	lastClick: number,
	routing: boolean,
	shattered: boolean,
}

local panel: Frame? = nil
local scroll: ScrollingFrame? = nil
local cards: { [number]: Card } = {}
local extras: { Instance } = {} -- corps spacers and arriving cards, rebuilt on roster change
local arriving: { [number]: TextLabel } = {}
local rosterKey = ""
local conns: { RBXScriptConnection } = {}

-- ------------------------------------------------------------------ drawing helpers

local function rect(parent: Instance, w: number, h: number, x: number, y: number, rot: number, colour: Color3): Frame
	local f = Instance.new("Frame") :: Frame
	f.Size = UDim2.fromOffset(w, h)
	f.AnchorPoint = Vector2.new(0.5, 0.5)
	f.Position = UDim2.fromOffset(x, y)
	f.Rotation = rot
	f.BackgroundColor3 = colour
	f.BorderSizePixel = 0
	f.Parent = parent
	return f
end

local function ring(parent: Instance, d: number, x: number, y: number, colour: Color3, thickness: number): Frame
	local f = rect(parent, d, d, x, y, 0, colour)
	f.BackgroundTransparency = 1
	local c = Instance.new("UICorner") :: UICorner
	c.CornerRadius = UDim.new(1, 0)
	c.Parent = f
	local s = Instance.new("UIStroke") :: UIStroke
	s.Color = colour
	s.Thickness = thickness
	s.Parent = f
	return f
end

local function box(parent: Instance, d: number, x: number, y: number, colour: Color3): Frame
	local f = rect(parent, d, d, x, y, 0, colour)
	f.BackgroundTransparency = 1
	local s = Instance.new("UIStroke") :: UIStroke
	s.Color = colour
	s.Thickness = 1
	s.Parent = f
	return f
end

-- Class glyph centred in a CARD_W x 26 area.
local function glyph(parent: Frame, class: string)
	local cx, cy = CARD_W / 2, 13
	local ink = Kit.INK
	if class == "infantry" then -- crossed muskets
		rect(parent, 2, 26, cx, cy, 35, ink)
		rect(parent, 2, 26, cx, cy, -35, ink)
		rect(parent, 4, 7, cx - 6.5, cy + 9.5, 35, ink) -- butts
		rect(parent, 4, 7, cx + 6.5, cy + 9.5, -35, ink)
	elseif class == "cavalry" then -- sabre with crossguard
		local r = math.rad(30)
		rect(parent, 2, 24, cx, cy, 30, ink)
		rect(parent, 11, 2, cx - math.sin(r) * 7, cy + math.cos(r) * 7, 30, ink)
		rect(parent, 3, 5, cx - math.sin(r) * 10, cy + math.cos(r) * 10, 30, ink)
	elseif class == "artillery" then -- barrel on a wheel
		rect(parent, 24, 5, cx + 3, cy - 2, -15, ink)
		ring(parent, 12, cx - 3, cy + 5, ink, 2)
	elseif class == "hq" then -- eight-point star
		rect(parent, 14, 14, cx, cy, 0, Kit.GOLD)
		rect(parent, 14, 14, cx, cy, 45, Kit.GOLD)
		ring(parent, 5, cx, cy, ink, 1.5)
	end
end

local function iconSlot(parent: Instance, name: string, order: number): Frame
	local f = Instance.new("Frame") :: Frame
	f.Name = name
	f.Size = UDim2.fromOffset(10, 10)
	f.BackgroundTransparency = 1
	f.LayoutOrder = order
	f.Visible = false
	f.Parent = parent
	return f
end

-- Short form of a formation name for a 58 px card (the tooltip carries the full name).
local ABBREV = {
	{ " — .*$", "" },
	{ " à cheval", "" },
	{ " de ", " " },
	{ "Batterie", "Bty" },
	{ "Battery", "Bty" },
	{ "Battalion", "Bn" },
	{ "Bataillon", "Bn" },
	{ "Regiment", "Rgt" },
	{ "Chasseurs", "Chass." },
	{ "Grenadiers?", "Gren." },
	{ "Cuirassiers", "Cuir." },
	{ "Dragoons", "Drag." },
	{ "Dragoner", "Drag." },
	{ "Husaren", "Huss." },
	{ "Hussars", "Huss." },
	{ "Infanterie", "Inf." },
}
local function abbreviate(name: string): string
	local s = name
	for _, a in ABBREV do
		s = string.gsub(s, a[1], a[2])
	end
	return s
end

local function tipFor(id: number): string
	local f = BattleState.formations[id]
	if not f then
		return ""
	end
	local lines = {
		tostring(f.name or ("#" .. id)),
		tostring(f.corps or ""),
		string.format("%d / %d men · %s", f.strength, f.startStrength, string.upper(string.sub(f.moraleBand, 1, 1)) .. string.sub(f.moraleBand, 2)),
		STATE_WORD[f.state] or f.state,
	}
	if f.status and f.status ~= "" then
		lines[4] ..= " · " .. f.status
	end
	return table.concat(lines, "\n")
end

-- ------------------------------------------------------------------ cards

local function newCard(f: any): Card
	local s = scroll :: ScrollingFrame
	local id = f.id
	local b = Instance.new("TextButton") :: TextButton
	b.Name = "Card" .. id
	b.Size = UDim2.fromOffset(CARD_W, CARD_H)
	b.BackgroundColor3 = Kit.CREAM
	b.BorderSizePixel = 0
	b.AutoButtonColor = false
	b.Text = ""
	b.ClipsDescendants = true
	b.Active = true
	b.Parent = s
	local stroke = Instance.new("UIStroke") :: UIStroke
	stroke.Color = Kit.INK
	stroke.Thickness = 1
	stroke.ApplyStrokeMode = Enum.ApplyStrokeMode.Border
	stroke.Parent = b
	local header = Instance.new("Frame") :: Frame
	header.Size = UDim2.new(1, 0, 0, 5)
	header.BackgroundColor3 = Factions.colour(f.faction, f.colour)
	header.BorderSizePixel = 0
	header.Parent = b
	local g = Instance.new("Frame") :: Frame
	g.Size = UDim2.fromOffset(CARD_W, 26)
	g.Position = UDim2.fromOffset(0, 7)
	g.BackgroundTransparency = 1
	g.Parent = b
	glyph(g, f.class)
	local name = Kit.label(b, abbreviate(tostring(f.name or id)), { size = UDim2.new(1, -6, 0, 12), position = UDim2.fromOffset(3, 34), textSize = 10, align = Enum.TextXAlignment.Center })
	name.TextTruncate = Enum.TextTruncate.AtEnd
	local count = Kit.label(b, "", { size = UDim2.new(0.6, 0, 0, 10), position = UDim2.fromOffset(4, 47), textSize = 9, font = Enum.Font.GothamBold })
	Kit.label(b, string.rep("›", math.clamp(f.experience or 0, 0, 3)), { size = UDim2.new(0.4, -4, 0, 10), position = UDim2.new(0.6, 0, 0, 47), textSize = 10, font = Enum.Font.GothamBold, colour = Kit.GOLD, align = Enum.TextXAlignment.Right })
	local strength = Kit.bar(b, UDim2.new(1, -8, 0, 4), UDim2.fromOffset(4, 58), Factions.colour(f.faction, f.colour))
	local morale = Kit.bar(b, UDim2.new(1, -8, 0, 4), UDim2.fromOffset(4, 64), Kit.MORALE.steady)

	-- status icons, left to right; hidden ones take no room
	local row = Instance.new("Frame") :: Frame
	row.Size = UDim2.new(1, -8, 0, 10)
	row.Position = UDim2.fromOffset(4, 69)
	row.BackgroundTransparency = 1
	row.Parent = b
	Kit.list(row, 2, true)
	local icons: { [string]: Frame } = {}
	local reload = iconSlot(row, "reload", 1) -- cartridge box filling as the volley reloads
	box(reload, 8, 5, 5, Kit.INK)
	local reloadFill = Instance.new("Frame") :: Frame
	reloadFill.AnchorPoint = Vector2.new(0, 1)
	reloadFill.Position = UDim2.fromOffset(2, 8)
	reloadFill.Size = UDim2.fromOffset(6, 0)
	reloadFill.BackgroundColor3 = AMBER
	reloadFill.BorderSizePixel = 0
	reloadFill.Parent = reload
	icons.reload = reload
	local noAmmo = iconSlot(row, "noAmmo", 2) -- struck-through box
	box(noAmmo, 8, 5, 5, Kit.HOSTILE)
	rect(noAmmo, 2, 11, 5, 5, 45, Kit.HOSTILE)
	icons.noAmmo = noAmmo
	local square = iconSlot(row, "square", 3) -- hollow square
	box(square, 8, 5, 5, Kit.INK)
	box(square, 4, 5, 5, Kit.INK)
	icons.square = square
	local limbered = iconSlot(row, "limbered", 4) -- wheel and trail
	ring(limbered, 7, 4, 5, Kit.INK, 1.5)
	rect(limbered, 5, 2, 8, 6, 20, Kit.INK)
	icons.limbered = limbered
	local holdFire = iconSlot(row, "holdFire", 5) -- red cross
	rect(holdFire, 2, 11, 5, 5, 45, Kit.HOSTILE)
	rect(holdFire, 2, 11, 5, 5, -45, Kit.HOSTILE)
	icons.holdFire = holdFire

	local card: Card = {
		root = b,
		stroke = stroke,
		name = name,
		count = count,
		strength = strength,
		morale = morale,
		icons = icons,
		reloadFill = reloadFill,
		view = nil,
		seenAt = 0,
		lastClick = 0,
		routing = false,
		shattered = false,
	}
	b.Activated:Connect(function()
		local now = os.clock()
		if now - card.lastClick < 0.35 then
			local cur = BattleState.formations[id]
			if cur then
				Camera.focusOn(cur.x, cur.z)
			end
		elseif Input.mode() ~= "off" then
			if UserInputService:IsKeyDown(Enum.KeyCode.LeftShift) or UserInputService:IsKeyDown(Enum.KeyCode.RightShift) then
				Selection.toggle(id)
			else
				Selection.set({ id })
			end
		end
		card.lastClick = now
	end)
	Kit.hoverTip(b, function(): string
		return tipFor(id)
	end)
	return card
end

-- Seconds of reload left, run forward locally: the server only resends a formation when
-- something else about it changes.
local function reloadLeft(c: Card, f: any): number
	if c.view ~= f then
		c.view = f
		c.seenAt = os.clock()
	end
	local r = f.reload or 0
	if r <= 0 then
		return 0
	end
	local elapsed = if BattleState.state == "running" then (os.clock() - c.seenAt) * BattleState.speed else 0
	return r - elapsed
end

local function reloadTime(f: any): number
	if f.class == "artillery" then
		local gun = Config.Units.artillery.gun
		return if f.ammoMode == "canister" then gun.canister.reload else gun.roundShot.reload
	end
	local m = Config.Units.infantry.musket
	return if m then m.reload else 15
end

local function paint(c: Card, f: any)
	Kit.setBar(c.strength, f.strength / math.max(f.startStrength, 1))
	c.count.Text = tostring(math.floor(f.strength))
	Kit.setBar(c.morale, (f.morale or MORALE_DEFAULT[f.moraleBand] or 50) / 100)
	c.morale.BackgroundColor3 = (Kit.MORALE :: { [string]: Color3 })[f.moraleBand] or Kit.MUTED
	local left = reloadLeft(c, f)
	local shoots = f.class == "infantry" or f.class == "artillery"
	c.icons.reload.Visible = shoots and left > 0
	c.reloadFill.Size = UDim2.fromOffset(6, math.floor(6 * math.clamp(1 - left / reloadTime(f), 0, 1)))
	c.icons.noAmmo.Visible = shoots and f.ammo ~= nil and f.ammo <= 0
	c.icons.square.Visible = f.shape == "square"
	c.icons.limbered.Visible = f.class == "artillery" and (f.limbered == true or f.shape == "limbered")
	c.icons.holdFire.Visible = shoots and f.fireAtWill == false
	c.routing = f.state == "routing" or f.moraleBand == "routing"
	c.shattered = f.moraleBand == "shattered"
	local sel = Selection.isSelected(f.id)
	c.stroke.Color = if sel then Kit.GOLD else Kit.INK
	c.stroke.Thickness = if sel then 2 else 1
	c.stroke.Transparency = if sel then 0 else 0.4
	if not c.routing then
		c.root.BackgroundColor3 = if c.shattered then Kit.MUTED elseif sel then Kit.SELECT else Kit.CREAM
	end
end

-- Grey the card out, then fold it away.
local function retire(c: Card)
	local cover = Instance.new("Frame") :: Frame
	cover.Size = UDim2.fromScale(1, 1)
	cover.BackgroundColor3 = Kit.MUTED
	cover.BackgroundTransparency = 0.25
	cover.BorderSizePixel = 0
	cover.ZIndex = 5
	cover.Parent = c.root
	c.root.Active = false
	local tw = TweenService:Create(c.root, TweenInfo.new(0.5, Enum.EasingStyle.Quad, Enum.EasingDirection.In, 0, false, 1.5), { Size = UDim2.fromOffset(0, CARD_H) })
	tw.Completed:Connect(function()
		c.root:Destroy()
	end)
	tw:Play()
end

local function spacer(order: number)
	local s = Instance.new("Frame") :: Frame
	s.Size = UDim2.fromOffset(5, CARD_H)
	s.BackgroundTransparency = 1
	s.LayoutOrder = order
	s.Parent = scroll
	local rule = Instance.new("Frame") :: Frame
	rule.Size = UDim2.new(0, 1, 0.7, 0)
	rule.Position = UDim2.fromScale(0.5, 0.15)
	rule.BackgroundColor3 = Kit.GOLD
	rule.BorderSizePixel = 0
	rule.Parent = s
	table.insert(extras, s)
end

local function arrivingCard(r: any, order: number)
	local f = Instance.new("Frame") :: Frame
	f.Size = UDim2.fromOffset(CARD_W, CARD_H)
	f.BackgroundColor3 = Kit.PANEL_DARK
	f.BackgroundTransparency = 0.3
	f.BorderSizePixel = 0
	f.Active = true
	f.LayoutOrder = order
	f.Parent = scroll
	local s = Instance.new("UIStroke") :: UIStroke
	s.Color = Kit.MUTED
	s.Thickness = 1
	s.Parent = f
	local header = Instance.new("Frame") :: Frame
	header.Size = UDim2.new(1, 0, 0, 5)
	header.BackgroundColor3 = Kit.MUTED
	header.BorderSizePixel = 0
	header.Parent = f
	Kit.label(f, "on the road", { size = UDim2.new(1, 0, 0, 12), position = UDim2.fromOffset(0, 10), textSize = 9, colour = Kit.MUTED, align = Enum.TextXAlignment.Center })
	local eta = Kit.label(f, "", { size = UDim2.new(1, 0, 0, 14), position = UDim2.fromOffset(0, 22), textSize = 12, font = Enum.Font.GothamBold, colour = Kit.MUTED, align = Enum.TextXAlignment.Center })
	local n = Kit.label(f, abbreviate(tostring(r.name)), { size = UDim2.new(1, -6, 0, 24), position = UDim2.fromOffset(3, 40), textSize = 10, wrap = true, colour = Kit.MUTED, align = Enum.TextXAlignment.Center })
	n.TextTruncate = Enum.TextTruncate.AtEnd
	local rname, rcorps = tostring(r.name), tostring(r.corps or "")
	Kit.hoverTip(f, function(): string
		return rname .. "\n" .. rcorps .. "\nReinforcement, not yet on the field"
	end)
	arriving[r.id] = eta
	table.insert(extras, f)
end

local function relayout(forms: { any })
	for _, e in extras do
		e:Destroy()
	end
	table.clear(extras)
	table.clear(arriving)
	-- corps in order of their first formation, formations by id inside a corps
	local corpsRank: { [string]: number } = {}
	for _, f in forms do -- forms is id-sorted
		local k = tostring(f.corps)
		if corpsRank[k] == nil then
			local n = 0
			for _ in corpsRank do
				n += 1
			end
			corpsRank[k] = n
		end
	end
	local present: { [number]: boolean } = {}
	local spaced: { [number]: boolean } = {}
	for _, f in forms do
		present[f.id] = true
		local rank = corpsRank[tostring(f.corps)]
		local c = cards[f.id]
		if not c then
			c = newCard(f)
			cards[f.id] = c
		end
		c.root.LayoutOrder = rank * 100000 + f.id * 2
		if rank > 0 and not spaced[rank] then
			spaced[rank] = true
			spacer(rank * 100000)
		end
	end
	for id, c in cards do
		if not present[id] then
			cards[id] = nil
			retire(c)
		end
	end
	local base = 1000000000
	if #BattleState.reinforcements > 0 and #forms > 0 then
		spacer(base)
	end
	for i, r in BattleState.reinforcements do
		arrivingCard(r, base + i)
	end
end

local function fitWidth()
	local p, s = panel, scroll
	if not p or not s then
		return
	end
	local layout = s:FindFirstChildOfClass("UIListLayout") :: UIListLayout?
	local sg = p.Parent :: ScreenGui
	local content = if layout then layout.AbsoluteContentSize.X else 0
	local avail = math.max(sg.AbsoluteSize.X - 2 * CardBar.SIDE_MARGIN, CARD_W + 12)
	p.Size = UDim2.fromOffset(math.min(content + 12, avail), CardBar.HEIGHT)
	p.Visible = content > 0
end

-- ------------------------------------------------------------------ API

function CardBar.create(sg: ScreenGui)
	CardBar.destroy()
	local p = Kit.panel(sg, { size = UDim2.fromOffset(200, CardBar.HEIGHT), position = UDim2.new(0.5, 0, 1, -8), anchor = Vector2.new(0.5, 1), padding = 6, transparency = 0.12 })
	p.Name = "CardBar"
	local s = Instance.new("ScrollingFrame") :: ScrollingFrame
	s.Size = UDim2.fromScale(1, 1)
	s.BackgroundTransparency = 1
	s.BorderSizePixel = 0
	s.ScrollingDirection = Enum.ScrollingDirection.X
	s.AutomaticCanvasSize = Enum.AutomaticSize.X
	s.CanvasSize = UDim2.new()
	s.ScrollBarThickness = 4
	s.ScrollBarImageColor3 = Kit.INK
	s.Active = true
	s.Parent = p
	local layout = Kit.list(s, GAP, true)
	panel = p
	scroll = s
	table.insert(conns, layout:GetPropertyChangedSignal("AbsoluteContentSize"):Connect(fitWidth))
	table.insert(conns, sg:GetPropertyChangedSignal("AbsoluteSize"):Connect(fitWidth))
	-- the wheel scrolls the cards sideways instead of zooming the camera
	table.insert(conns, s.InputChanged:Connect(function(input: InputObject)
		if input.UserInputType == Enum.UserInputType.MouseWheel then
			s.CanvasPosition = Vector2.new(math.max(0, s.CanvasPosition.X - input.Position.Z * 80), 0)
		end
	end))
	rosterKey = ""
	fitWidth()
end

function CardBar.update()
	if not scroll then
		return
	end
	local forms = BattleState.ownFormations()
	local ids = {}
	for _, f in forms do
		table.insert(ids, f.id)
	end
	for _, r in BattleState.reinforcements do
		table.insert(ids, -r.id)
	end
	local key = table.concat(ids, ",")
	if key ~= rosterKey then
		rosterKey = key
		relayout(forms)
	end
	for _, f in forms do
		local c = cards[f.id]
		if c then
			paint(c, f)
		end
	end
	for _, r in BattleState.reinforcements do
		local l = arriving[r.id]
		if l then
			l.Text = Kit.formatClock(r.eta or 0)
		end
	end
end

-- Per frame: routing cards pulse red, reload boxes keep filling between snapshots.
function CardBar.animate()
	local pulse = (math.sin(os.clock() * 8) + 1) / 2
	for id, c in cards do
		if c.routing then
			c.root.BackgroundColor3 = Kit.CREAM:Lerp(Kit.MORALE.routing, 0.25 + 0.6 * pulse)
		end
		if c.icons.reload.Visible then
			local f = BattleState.formations[id]
			if f then
				local left = reloadLeft(c, f)
				c.reloadFill.Size = UDim2.fromOffset(6, math.floor(6 * math.clamp(1 - left / reloadTime(f), 0, 1)))
				if left <= 0 then
					c.icons.reload.Visible = false
				end
			end
		end
	end
end

function CardBar.destroy()
	for _, c in conns do
		c:Disconnect()
	end
	table.clear(conns)
	if panel then
		panel:Destroy()
	end
	panel = nil
	scroll = nil
	table.clear(cards)
	table.clear(extras)
	table.clear(arriving)
	rosterKey = ""
end

return CardBar
]]></ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX00000048"><Properties><bool name="Disabled">false</bool><string name="Name">Deployment</string><ProtectedString name="Source"><![CDATA[--!strict
-- Deployment phase: the pre-battle briefing (date, weather, orders, difficulty, history),
-- placement hints and a prominent Start Battle. Dragging formations is handled by Input in
-- "deploy" mode; this panel only explains and sends `ready`.

local Shared = game:GetService("ReplicatedStorage"):WaitForChild("EoE")
local Config = require(Shared.Config)
local Kit = require(script.Parent.Kit)
local BattleState = require(script.Parent.Parent.BattleState)

local Deployment = {}

export type Callbacks = { ready: () -> (), settings: () -> () }

local gui: ScreenGui? = nil
local startBtn: TextButton? = nil

local HINTS = "· Left-drag a formation to re-place it inside your zone.\n· Right-drag from a formation to set its facing.\n· Objectives are marked with flags; north is up on the minimap."

local function section(parent: Instance, heading: string, body: string, order: number, colour: Color3?)
	local h = Kit.title(parent, heading, { size = UDim2.new(1, 0, 0, 22), textSize = 19 })
	h.LayoutOrder = order
	local b = Kit.label(parent, body, { size = UDim2.new(1, -6, 0, 0), wrap = true, textSize = 13, colour = colour })
	b.AutomaticSize = Enum.AutomaticSize.Y
	b.TextYAlignment = Enum.TextYAlignment.Top
	b.LayoutOrder = order + 1
end

function Deployment.show(cb: Callbacks)
	Deployment.destroy()
	local sg = Kit.screen("EoEDeploy", 20)
	local sc = BattleState.scenario or {}
	local panel = Kit.panel(sg, { size = UDim2.new(0, 420, 1, -96), position = UDim2.new(0, 24, 0.5, 0), anchor = Vector2.new(0, 0.5), padding = 18 })
	local cap = Instance.new("UISizeConstraint") :: UISizeConstraint
	cap.MaxSize = Vector2.new(420, 660)
	cap.Parent = panel

	local title = Kit.title(panel, sc.name or "Deployment", { size = UDim2.new(1, 0, 0, 34), textSize = 28 })
	title.TextTruncate = Enum.TextTruncate.AtEnd
	local facts = {}
	if sc.date then
		table.insert(facts, sc.date)
	end
	local w = (Config.Weather :: any)[sc.weather or ""]
	if w then
		table.insert(facts, w.label)
	end
	if sc.timeLimit and sc.timeLimit > 0 then
		table.insert(facts, string.format("%d minutes", math.floor(sc.timeLimit / 60)))
	end
	Kit.title(panel, table.concat(facts, "  ·  "), { size = UDim2.new(1, 0, 0, 20), position = UDim2.fromOffset(0, 36), textSize = 17, colour = Kit.MUTED })
	local rule = Instance.new("Frame") :: Frame
	rule.Size = UDim2.new(1, 0, 0, 1)
	rule.Position = UDim2.fromOffset(0, 62)
	rule.BackgroundColor3 = Kit.GOLD
	rule.BorderSizePixel = 0
	rule.Parent = panel

	local body = Instance.new("ScrollingFrame") :: ScrollingFrame
	body.Size = UDim2.new(1, 0, 1, -72 - 62)
	body.Position = UDim2.fromOffset(0, 70)
	body.BackgroundTransparency = 1
	body.BorderSizePixel = 0
	body.ScrollBarThickness = 4
	body.ScrollBarImageColor3 = Kit.INK
	body.AutomaticCanvasSize = Enum.AutomaticSize.Y
	body.CanvasSize = UDim2.new()
	body.Parent = panel
	Kit.list(body, 4)
	if sc.difficultyNote then
		local note = Kit.label(body, sc.difficultyNote, { size = UDim2.new(1, -6, 0, 0), wrap = true, textSize = 13, font = Enum.Font.GothamBold, colour = Kit.HOSTILE })
		note.AutomaticSize = Enum.AutomaticSize.Y
		note.LayoutOrder = 1
	end
	section(body, "Orders", sc.briefing or "", 10)
	section(body, "Deployment", HINTS, 20, Kit.MUTED)
	if sc.summary then
		section(body, "What happened", sc.summary, 30, Kit.MUTED)
	end

	local row = Instance.new("Frame") :: Frame
	row.Size = UDim2.new(1, 0, 0, 52)
	row.Position = UDim2.new(0, 0, 1, -52)
	row.BackgroundTransparency = 1
	row.Parent = panel
	Kit.list(row, 8, true)
	local b = Kit.button(row, "Start Battle", cb.ready, { size = UDim2.new(1, -98, 1, 0), primary = true, order = 1, textSize = 24, font = Enum.Font.Garamond })
	local bs = b:FindFirstChildOfClass("UIStroke") :: UIStroke?
	if bs then
		bs.Color = Kit.GOLD
		bs.Thickness = 2
		bs.Transparency = 0
	end
	Kit.button(row, "Settings", cb.settings, { size = UDim2.new(0, 90, 1, 0), order = 2 })
	if not BattleState.isCommander then
		Kit.setEnabled(b, false, "Waiting for the commander to start the battle")
	end
	startBtn = b
	gui = sg
end

function Deployment.setWaiting(text: string)
	if startBtn then
		startBtn.Text = text
		Kit.setEnabled(startBtn, false, "The battle is starting")
	end
end

function Deployment.destroy()
	if gui then
		gui:Destroy()
		gui = nil
		startBtn = nil
	end
end

return Deployment
]]></ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX00000049"><Properties><bool name="Disabled">false</bool><string name="Name">DevPanel</string><ProtectedString name="Source"><![CDATA[--!strict
-- F9 developer panel: AI goals from the server's Debug remote. Collapsible, hidden by default.

local Kit = require(script.Parent.Kit)

local DevPanel = {}

local gui: ScreenGui? = nil
local body: TextLabel? = nil
local bodyFrame: Frame? = nil
local collapsed = false
local lastGoals: { any } = {}

local function build()
	if gui then
		return
	end
	local sg = Kit.screen("EoEDev", 45)
	sg.Enabled = false
	local panel = Kit.panel(sg, { size = UDim2.fromOffset(420, 320), position = UDim2.new(1, -260, 0, 48), anchor = Vector2.new(1, 0), dark = true })
	local header = Kit.button(panel, "AI goals (F9)  ▾", function()
		collapsed = not collapsed
		if bodyFrame then
			bodyFrame.Visible = not collapsed
		end
		panel.Size = if collapsed then UDim2.fromOffset(420, 32) else UDim2.fromOffset(420, 320)
	end, { size = UDim2.new(1, 0, 0, 30), textSize = 13 })
	header.TextXAlignment = Enum.TextXAlignment.Left
	local bf = Instance.new("Frame") :: Frame
	bf.Size = UDim2.new(1, -8, 1, -38)
	bf.Position = UDim2.new(0, 4, 0, 34)
	bf.BackgroundTransparency = 1
	bf.Parent = panel
	local scroll = Instance.new("ScrollingFrame") :: ScrollingFrame
	scroll.Size = UDim2.fromScale(1, 1)
	scroll.BackgroundTransparency = 1
	scroll.BorderSizePixel = 0
	scroll.ScrollBarThickness = 4
	scroll.AutomaticCanvasSize = Enum.AutomaticSize.Y
	scroll.CanvasSize = UDim2.new()
	scroll.Parent = bf
	local b = Kit.label(scroll, "(no debug data; the server dev view is off)", { size = UDim2.new(1, -8, 0, 20), textSize = 12, wrap = true })
	b.AutomaticSize = Enum.AutomaticSize.Y
	b.TextYAlignment = Enum.TextYAlignment.Top
	gui = sg
	body = b
	bodyFrame = bf
end

function DevPanel.toggle()
	build()
	if gui then
		gui.Enabled = not gui.Enabled
	end
end

function DevPanel.setGoals(goals: { any })
	lastGoals = goals
	if not body then
		return
	end
	local lines = {}
	for _, g in goals do
		table.insert(lines, string.format("#%s  %s — %s", tostring(g.id), tostring(g.goal), tostring(g.reason)))
	end
	body.Text = if #lines > 0 then table.concat(lines, "\n") else "(no AI goals reported)"
end

function DevPanel.hide()
	if gui then
		gui.Enabled = false
	end
end

function DevPanel.destroy()
	if gui then
		gui:Destroy()
		gui = nil
		body = nil
		bodyFrame = nil
	end
	table.clear(lastGoals)
end

return DevPanel
]]></ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX00000050"><Properties><bool name="Disabled">false</bool><string name="Name">HUD</string><ProtectedString name="Source"><![CDATA[--!strict
-- Battle HUD, laid out after Napoleon: Total War. Top bar (name, clock / limit, pause and
-- speeds, weather), balance of power and objective banners under it, message ticker top-left,
-- selection inspector and command panel bottom-left, unit cards bottom-centre, framed minimap
-- bottom-right. Everything hugs the screen edges; the centre of the field stays clear.

local Shared = game:GetService("ReplicatedStorage"):WaitForChild("EoE")
local Config = require(Shared.Config)
local Kit = require(script.Parent.Kit)
local Minimap = require(script.Parent.Minimap)
local CardBar = require(script.Parent.CardBar)
local BattleState = require(script.Parent.Parent.BattleState)
local Selection = require(script.Parent.Parent.Selection)
local Net = require(script.Parent.Parent.Net)
local Input = require(script.Parent.Parent.Input)
local Signal = require(script.Parent.Parent.Signal)

local HUD = {}

export type Callbacks = { settings: () -> (), help: () -> (), menu: () -> () }

local EDGE = 8
local CMD_W = 256
local BOTTOM_H = CardBar.HEIGHT

local gui: ScreenGui? = nil
local cb: Callbacks? = nil
local conns: { Signal.Connection } = {}
local weather: string? = nil

-- top bar
local clockLabel: TextLabel? = nil
local lagLabel: TextLabel? = nil
local weatherLabel: TextLabel? = nil
local speedButtons: { [number]: TextButton } = {}
local pauseButton: TextButton? = nil
local balanceOwn: Frame? = nil
local balanceText = ""
local objectiveStrip: Frame? = nil
local objectiveChips: { [string]: { frame: Frame, pennant: Frame, label: TextLabel, bar: Frame } } = {}

-- ticker
local tickerLines: { { label: TextLabel, t0: number } } = {}
local tickerFrame: Frame? = nil
local tickerOrder = 0
local TICKER_LIFE = 9

-- inspector
local inspector: Frame? = nil
local inspectorFields: { [string]: TextLabel } = {}
local inspectorBarFill: Frame? = nil

-- command panel
local commandButtons: { [string]: TextButton } = {}
local rallyBar: Frame? = nil
local toast: TextLabel? = nil
local toastT0 = 0

local MORALE_WORD: { [string]: string } = { steady = "Steady", shaken = "Shaken", routing = "Routing", shattered = "Shattered" }
local STATE_WORD: { [string]: string } = { idle = "Holding", moving = "Marching", reforming = "Reforming", firing = "Firing", charging = "Charging", melee = "Melee", retreating = "Retreating", routing = "Routing", rallying = "Rallying", destroyed = "Destroyed", exited = "Exited" }

local GARAMOND_BOLD = Font.new(Font.fromEnum(Enum.Font.Garamond).Family, Enum.FontWeight.Bold)
local GARAMOND = Font.fromEnum(Enum.Font.Garamond)

local function selectedFormations(): { any }
	local out = {}
	for _, id in Selection.ids() do
		local f = BattleState.formations[id]
		if f then
			table.insert(out, f)
		end
	end
	return out
end

local function idsOfClass(forms: { any }, classes: { [string]: boolean }): { number }
	local ids = {}
	for _, f in forms do
		if classes[f.class] and f.state ~= "routing" then
			table.insert(ids, f.id)
		end
	end
	return ids
end

-- ------------------------------------------------------------------ top bar

local function buildTopBar(sg: ScreenGui)
	local bar = Kit.panel(sg, { size = UDim2.new(1, 0, 0, 36), position = UDim2.new(0, 0, 0, 0), transparency = 0.08 })
	local sc = BattleState.scenario
	local name = Kit.title(bar, if sc then sc.name else "", { size = UDim2.new(0.5, -230, 1, 0), position = UDim2.new(0, 12, 0, 0), textSize = 20 })
	name.TextTruncate = Enum.TextTruncate.AtEnd

	-- centre: clock / limit, pause, speeds, weather
	local mid = Instance.new("Frame") :: Frame
	mid.Size = UDim2.fromOffset(0, 26)
	mid.AutomaticSize = Enum.AutomaticSize.X
	mid.Position = UDim2.new(0.5, 0, 0, 5)
	mid.AnchorPoint = Vector2.new(0.5, 0)
	mid.BackgroundTransparency = 1
	mid.Parent = bar
	local ml = Kit.list(mid, 6, true)
	ml.VerticalAlignment = Enum.VerticalAlignment.Center
	clockLabel = Kit.label(mid, "00:00", { size = UDim2.fromOffset(118, 26), textSize = 16, font = Enum.Font.GothamBold, align = Enum.TextXAlignment.Right })
	;(clockLabel :: TextLabel).LayoutOrder = 1
	local pb = Kit.button(mid, "II", function()
		if BattleState.state == "paused" then
			Net.control("resume")
		else
			Net.control("pause")
		end
	end, { size = UDim2.fromOffset(34, 26), order = 2, font = Enum.Font.GothamBlack, tooltip = "Pause / resume (Space)" })
	pauseButton = pb
	for i, s in { 1, 2, 4 } do
		local b = Kit.button(mid, "×" .. s, function()
			if BattleState.state == "paused" then
				Net.control("resume")
			end
			Net.control("speed", s)
		end, { size = UDim2.fromOffset(34, 26), order = 2 + i, tooltip = "Speed ×" .. s .. " (key " .. i .. ")" })
		speedButtons[s] = b
	end
	weatherLabel = Kit.title(mid, "", { size = UDim2.fromOffset(118, 26), textSize = 18 })
	;(weatherLabel :: TextLabel).LayoutOrder = 6
	lagLabel = Kit.label(mid, "", { size = UDim2.fromOffset(0, 26), textSize = 11, colour = Kit.HOSTILE })
	;(lagLabel :: TextLabel).AutomaticSize = Enum.AutomaticSize.X
	;(lagLabel :: TextLabel).LayoutOrder = 7

	local right = Instance.new("Frame") :: Frame
	right.Size = UDim2.fromOffset(220, 26)
	right.Position = UDim2.new(1, -EDGE, 0, 5)
	right.AnchorPoint = Vector2.new(1, 0)
	right.BackgroundTransparency = 1
	right.Parent = bar
	local l = Kit.list(right, 6, true)
	l.HorizontalAlignment = Enum.HorizontalAlignment.Right
	Kit.button(right, "Help", function()
		if cb then
			cb.help()
		end
	end, { size = UDim2.fromOffset(60, 26), order = 1 })
	Kit.button(right, "Settings", function()
		if cb then
			cb.settings()
		end
	end, { size = UDim2.fromOffset(80, 26), order = 2 })
	Kit.button(right, "Menu", function()
		if cb then
			cb.menu()
		end
	end, { size = UDim2.fromOffset(60, 26), order = 3, tooltip = "Leave the battle" })

	-- balance of power: own strength against the enemy strength we can see
	local bal = Kit.panel(sg, { size = UDim2.fromOffset(320, 12), position = UDim2.new(0.5, 0, 0, 42), anchor = Vector2.new(0.5, 0), transparency = 0, plain = true })
	bal.BackgroundColor3 = Kit.factionColour(BattleState.enemyFaction)
	local own = Instance.new("Frame") :: Frame
	own.Size = UDim2.fromScale(0.5, 1)
	own.BackgroundColor3 = Kit.factionColour(BattleState.viewerFaction)
	own.BorderSizePixel = 0
	own.Parent = bal
	local tick = Instance.new("Frame") :: Frame
	tick.Size = UDim2.new(0, 2, 1, 4)
	tick.Position = UDim2.fromScale(0.5, 0.5)
	tick.AnchorPoint = Vector2.new(0.5, 0.5)
	tick.BackgroundColor3 = Kit.GOLD
	tick.BorderSizePixel = 0
	tick.Parent = bal
	Kit.hoverTip(bal, function(): string
		return balanceText
	end)
	balanceOwn = own

	local strip = Instance.new("Frame") :: Frame
	strip.Size = UDim2.new(0, 640, 0, 24)
	strip.Position = UDim2.new(0.5, 0, 0, 60)
	strip.AnchorPoint = Vector2.new(0.5, 0)
	strip.BackgroundTransparency = 1
	strip.Parent = sg
	local sl = Kit.list(strip, 6, true)
	sl.HorizontalAlignment = Enum.HorizontalAlignment.Center
	objectiveStrip = strip
end

local function updateBalance()
	local own, enemy = 0, 0
	for _, f in BattleState.formations do
		if f.state ~= "destroyed" and f.state ~= "exited" then
			if f.faction == BattleState.viewerFaction then
				own += f.strength
			else
				enemy += f.strength
			end
		end
	end
	if balanceOwn then
		balanceOwn.Size = UDim2.fromScale(if own + enemy > 0 then own / (own + enemy) else 0.5, 1)
	end
	balanceText = string.format("Balance of power\nYour army: %d men\nKnown enemy strength: %d men\n(only the enemy formations you can see)", own, enemy)
end

local function objectiveTip(id: string): string
	for _, o in BattleState.objectives do
		if o.id == id then
			local owner = if o.owner then Kit.factionName(o.owner) else "Unclaimed"
			local t = string.format("%s\nHeld by: %s", o.name, owner)
			if o.contested then
				t ..= "\nContested"
			elseif o.capturing and (o.progress or 0) > 0 then
				t ..= string.format("\n%s capturing: %d%%", Kit.factionName(o.capturing), math.floor((o.progress or 0) * 100))
			end
			return t
		end
	end
	return ""
end

local function updateObjectives()
	local strip = objectiveStrip
	if not strip then
		return
	end
	for i, o in BattleState.objectives do
		local chip = objectiveChips[o.id]
		if not chip then
			local f = Kit.panel(strip, { size = UDim2.fromOffset(124, 24), position = UDim2.new(), transparency = 0.12, plain = true })
			f.LayoutOrder = i
			local pennant = Instance.new("Frame") :: Frame
			pennant.Size = UDim2.new(0, 7, 1, 0)
			pennant.BorderSizePixel = 0
			pennant.Parent = f
			local lbl = Kit.title(f, o.name, { size = UDim2.new(1, -14, 1, -3), position = UDim2.new(0, 11, 0, 0), textSize = 15, align = Enum.TextXAlignment.Center })
			lbl.TextTruncate = Enum.TextTruncate.AtEnd
			local bar = Instance.new("Frame") :: Frame
			bar.Size = UDim2.new(0, 0, 0, 3)
			bar.Position = UDim2.new(0, 7, 1, -3)
			bar.BorderSizePixel = 0
			bar.Parent = f
			local oid = o.id
			Kit.hoverTip(f, function(): string
				return objectiveTip(oid)
			end)
			chip = { frame = f, pennant = pennant, label = lbl, bar = bar }
			objectiveChips[o.id] = chip
		end
		chip.pennant.BackgroundColor3 = if o.owner then Kit.factionColour(o.owner) else Kit.PANEL_DARK
		chip.label.TextColor3 = if o.contested then Kit.HOSTILE else Kit.INK
		chip.bar.BackgroundColor3 = Kit.factionColour(o.capturing or o.owner)
		chip.bar.Size = UDim2.new(math.clamp(o.progress or 0, 0, 1), -7, 0, 3)
	end
end

local function updateTopBar()
	if clockLabel then
		local limit = BattleState.timeLimit
		if limit <= 0 then
			local sc = BattleState.scenario
			limit = if sc and sc.timeLimit then sc.timeLimit else Config.Victory.TimeLimitSeconds
		end
		clockLabel.Text = Kit.formatClock(BattleState.clock) .. " / " .. Kit.formatClock(limit)
	end
	if weatherLabel then
		local w = (Config.Weather :: any)[weather or "clear"]
		weatherLabel.Text = if w then w.label else ""
	end
	if lagLabel then
		lagLabel.Text = if BattleState.simLag > 0.5 then string.format("lag %.1fs", BattleState.simLag) else ""
	end
	local paused = BattleState.state == "paused"
	for s, b in speedButtons do
		Kit.setActiveLook(b, not paused and BattleState.speed == s)
		Kit.setEnabled(b, BattleState.isCommander, "Only the commander sets the speed")
	end
	if pauseButton then
		pauseButton.Text = if paused then ">" else "II"
		Kit.setActiveLook(pauseButton, paused)
		Kit.setEnabled(pauseButton, BattleState.isCommander, "Only the commander may pause")
	end
	updateBalance()
end

-- ------------------------------------------------------------------ ticker

local function buildTicker(sg: ScreenGui)
	local f = Instance.new("Frame") :: Frame
	f.Size = UDim2.fromOffset(440, 96)
	f.Position = UDim2.new(0, 12, 0, 44)
	f.BackgroundTransparency = 1
	f.Parent = sg
	Kit.list(f, 3)
	tickerFrame = f
end

local function escape(s: string): string
	return (string.gsub(string.gsub(string.gsub(s, "&", "&amp;"), "<", "&lt;"), ">", "&gt;"))
end

-- Up to four lines, newest at the bottom, fading out. `bold` for routs and captures.
function HUD.message(text: string, colour: Color3?, bold: boolean?)
	local f = tickerFrame
	if not f then
		return
	end
	if #tickerLines >= 4 then
		local old = table.remove(tickerLines, 1)
		if old then
			old.label:Destroy()
		end
	end
	local l = Kit.label(f, escape(text), { size = UDim2.fromOffset(0, 20), textSize = 17, colour = colour or Kit.CREAM, rich = true })
	l.FontFace = if bold then GARAMOND_BOLD else GARAMOND
	l.AutomaticSize = Enum.AutomaticSize.X
	l.BackgroundColor3 = Kit.INK
	l.BackgroundTransparency = 0.5
	l.TextStrokeTransparency = 0.5
	l.TextStrokeColor3 = Kit.INK
	local pad = Instance.new("UIPadding") :: UIPadding
	pad.PaddingLeft = UDim.new(0, 8)
	pad.PaddingRight = UDim.new(0, 8)
	pad.Parent = l
	if bold then
		local edge = Instance.new("Frame") :: Frame
		edge.Size = UDim2.new(0, 2, 1, 0)
		edge.Position = UDim2.fromOffset(-8, 0)
		edge.BackgroundColor3 = Kit.GOLD
		edge.BorderSizePixel = 0
		edge.Parent = l
	end
	tickerOrder += 1
	l.LayoutOrder = tickerOrder
	table.insert(tickerLines, { label = l, t0 = os.clock() })
end

local function updateTicker()
	local now = os.clock()
	local i = 1
	while i <= #tickerLines do
		local e = tickerLines[i]
		local age = now - e.t0
		if age > TICKER_LIFE then
			e.label:Destroy()
			table.remove(tickerLines, i)
		else
			local fade = math.clamp((age - TICKER_LIFE + 3) / 3, 0, 1)
			e.label.TextTransparency = fade
			e.label.TextStrokeTransparency = 0.5 + 0.5 * fade
			e.label.BackgroundTransparency = 0.5 + 0.5 * fade
			i += 1
		end
	end
	if toast and now - toastT0 > 3 then
		toast.Visible = false
	end
end

-- ------------------------------------------------------------------ inspector

local INSPECTOR_FIELDS = { "corps", "class", "strength", "morale", "fatigue", "ammo", "shape", "status" }

local function buildInspector(sg: ScreenGui)
	local p = Kit.panel(sg, { size = UDim2.fromOffset(CMD_W, 190), position = UDim2.new(0, EDGE, 1, -EDGE - BOTTOM_H - 6), anchor = Vector2.new(0, 1), transparency = 0.1, padding = 10 })
	inspectorFields.name = Kit.title(p, "", { size = UDim2.new(1, -40, 0, 26), textSize = 21 })
	inspectorFields.name.TextTruncate = Enum.TextTruncate.AtEnd
	inspectorFields.exp = Kit.label(p, "", { size = UDim2.new(0, 40, 0, 26), position = UDim2.new(1, 0, 0, 0), anchor = Vector2.new(1, 0), textSize = 16, font = Enum.Font.GothamBold, align = Enum.TextXAlignment.Right, colour = Kit.GOLD })
	inspectorBarFill = Kit.bar(p, UDim2.new(1, 0, 0, 6), UDim2.new(0, 0, 0, 30), Kit.FRANCE)
	local y = 40
	local names = { corps = "Corps", class = "Class", strength = "Strength", morale = "Morale", fatigue = "Fatigue", ammo = "Ammunition", shape = "Shape", status = "Status" }
	for i, key in INSPECTOR_FIELDS do
		local col = (i - 1) % 2
		local rowY = y + ((i - 1) // 2) * 32
		local k = Kit.label(p, names[key], { size = UDim2.new(0.5, -4, 0, 12), position = UDim2.new(col * 0.5, 0, 0, rowY), textSize = 10, colour = Kit.MUTED })
		k.Name = key .. "Key"
		inspectorFields[key] = Kit.label(p, "—", { size = UDim2.new(0.5, -4, 0, 18), position = UDim2.new(col * 0.5, 0, 0, rowY + 12), textSize = 12, font = Enum.Font.GothamBold })
		inspectorFields[key].TextTruncate = Enum.TextTruncate.AtEnd
	end
	p.Visible = false
	inspector = p
end

local function updateInspector()
	local p = inspector
	if not p then
		return
	end
	local forms = selectedFormations()
	if #forms == 0 then
		p.Visible = false
		return
	end
	p.Visible = true
	local f = forms[1]
	local F = inspectorFields
	F.name.Text = if #forms > 1 then string.format("%s  (+%d)", tostring(f.name or f.id), #forms - 1) else tostring(f.name or f.id)
	F.exp.Text = string.rep("›", math.clamp(f.experience or 0, 0, 3))
	F.corps.Text = tostring(f.corps or "—")
	F.class.Text = string.upper(string.sub(f.class, 1, 1)) .. string.sub(f.class, 2)
	F.strength.Text = string.format("%d / %d", f.strength, f.startStrength)
	if inspectorBarFill then
		Kit.setBar(inspectorBarFill, f.strength / math.max(f.startStrength, 1))
		inspectorBarFill.BackgroundColor3 = Kit.factionColour(f.faction)
	end
	F.morale.Text = string.format("%s%s", MORALE_WORD[f.moraleBand] or f.moraleBand, if f.morale then string.format(" (%d)", math.floor(f.morale)) else "")
	F.morale.TextColor3 = if f.moraleBand == "steady" then Kit.INK else Kit.HOSTILE
	F.fatigue.Text = if f.fatigue then (if f.fatigue < 30 then "Fresh" elseif f.fatigue < 70 then "Tired" else "Exhausted") .. string.format(" (%d)", math.floor(f.fatigue)) else "—"
	if f.class == "artillery" then
		F.ammo.Text = string.format("%s rounds · %s", if f.ammo then tostring(math.floor(f.ammo)) else "?", tostring(f.ammoMode or "auto"))
	elseif f.class == "infantry" then
		F.ammo.Text = if f.ammo then tostring(math.floor(f.ammo)) else "—"
	else
		F.ammo.Text = "—"
	end
	F.shape.Text = string.upper(string.sub(f.shape, 1, 1)) .. string.sub(f.shape, 2) .. (if f.fireAtWill == false then " · hold fire" else "")
	local status = STATE_WORD[f.state] or f.state
	if f.status and f.status ~= "" then
		status ..= " · " .. f.status
	elseif f.reload and f.reload > 0 then
		status ..= " · reloading"
	end
	F.status.Text = status
end

-- ------------------------------------------------------------------ command panel

type CommandDef = { key: string, text: string, tip: string }
-- Grid order, four to a row: formations, then stance and orders, then guns and the staff.
local COMMANDS: { CommandDef } = {
	{ key = "line", text = "Line", tip = "Three ranks: full fire, slow (infantry/cavalry)" },
	{ key = "column", text = "Column", tip = "Deep column: fast, strong in the charge, weak to fire" },
	{ key = "square", text = "Square", tip = "Hollow box against cavalry; artillery loves it" },
	{ key = "wedge", text = "Wedge", tip = "Cavalry charge formation" },
	{ key = "fire", text = "Fire at will", tip = "Toggle: fire at any target in range" },
	{ key = "charge", text = "Charge", tip = "Then right-click a target or a point" },
	{ key = "hold", text = "Hold", tip = "Stand and hold position" },
	{ key = "stop", text = "Halt", tip = "Cancel orders and halt" },
	{ key = "retreat", text = "Retreat", tip = "Fall back toward your edge" },
	{ key = "limber", text = "Limber", tip = "Guns: limber to move, unlimber to fire" },
	{ key = "ammo", text = "Auto ammo", tip = "Cycle: round shot (long) / canister (short) / auto" },
	{ key = "rally", text = "Rally", tip = "HQ: rally routing formations within 100 studs" },
}

local AMMO_CYCLE = { auto = "roundShot", roundShot = "canister", canister = "auto" }

local function runCommand(key: string)
	local forms = selectedFormations()
	if key == "line" or key == "column" or key == "square" then
		local ids = idsOfClass(forms, { infantry = true, cavalry = key == "line" })
		if #ids > 0 then
			Input.sendOrder("Shape", ids, { shape = key })
		end
	elseif key == "wedge" then
		local ids = idsOfClass(forms, { cavalry = true })
		if #ids > 0 then
			Input.sendOrder("Shape", ids, { shape = "wedge" })
		end
	elseif key == "fire" then
		local ids = idsOfClass(forms, { infantry = true, artillery = true })
		if #ids > 0 then
			local first = BattleState.formations[ids[1]]
			Input.sendOrder("Stance", ids, { fireAtWill = not (first and first.fireAtWill ~= false) })
		end
	elseif key == "charge" then
		Input.arm(if Input.armed() == "Charge" then nil else "Charge")
		HUD.refreshCommands()
	elseif key == "hold" or key == "stop" or key == "retreat" then
		local ids = idsOfClass(forms, { infantry = true, cavalry = true, artillery = true, hq = true })
		if #ids > 0 then
			Input.sendOrder(if key == "hold" then "Hold" elseif key == "stop" then "Stop" else "Retreat", ids, {})
		end
	elseif key == "limber" then
		local ids = idsOfClass(forms, { artillery = true })
		if #ids > 0 then
			local first = BattleState.formations[ids[1]]
			Input.sendOrder("Limber", ids, { limbered = not (first and first.limbered == true) })
		end
	elseif key == "ammo" then
		local ids = idsOfClass(forms, { artillery = true })
		if #ids > 0 then
			local first = BattleState.formations[ids[1]]
			local cur = if first and first.ammoMode then first.ammoMode else "auto"
			Input.sendOrder("Ammo", ids, { ammo = AMMO_CYCLE[cur] or "auto" })
		end
	elseif key == "rally" then
		local ids = idsOfClass(forms, { hq = true })
		if #ids > 0 then
			Input.sendOrder("Rally", ids, {})
		end
	end
end

local function buildCommandPanel(sg: ScreenGui)
	local p = Kit.panel(sg, { size = UDim2.fromOffset(CMD_W, BOTTOM_H), position = UDim2.new(0, EDGE, 1, -EDGE), anchor = Vector2.new(0, 1), transparency = 0.1, padding = 9 })
	local grid = Instance.new("Frame") :: Frame
	grid.Size = UDim2.fromScale(1, 1)
	grid.BackgroundTransparency = 1
	grid.Parent = p
	local g = Instance.new("UIGridLayout") :: UIGridLayout
	g.CellSize = UDim2.fromOffset(math.floor((CMD_W - 18 - 9) / 4), 24)
	g.CellPadding = UDim2.fromOffset(3, 3)
	g.FillDirectionMaxCells = 4
	g.SortOrder = Enum.SortOrder.LayoutOrder
	g.Parent = grid
	for i, c in COMMANDS do
		local key = c.key
		local b = Kit.button(grid, c.text, function()
			runCommand(key)
		end, { order = i, textSize = 11, tooltip = c.tip })
		b.TextScaled = true
		local tc = Instance.new("UITextSizeConstraint") :: UITextSizeConstraint
		tc.MaxTextSize = 11
		tc.Parent = b
		local pad = Instance.new("UIPadding") :: UIPadding
		pad.PaddingLeft = UDim.new(0, 2)
		pad.PaddingRight = UDim.new(0, 2)
		pad.Parent = b
		commandButtons[c.key] = b
	end
	-- rally cooldown: a gold bar along the bottom of the button that shrinks to nothing
	local rb = commandButtons.rally
	local bar = Instance.new("Frame") :: Frame
	bar.AnchorPoint = Vector2.new(0, 1)
	bar.Position = UDim2.new(0, -2, 1, 0)
	bar.Size = UDim2.new(0, 0, 0, 3)
	bar.BackgroundColor3 = Kit.GOLD
	bar.BorderSizePixel = 0
	bar.Parent = rb
	rallyBar = bar

	toast = Kit.label(sg, "", { size = UDim2.fromOffset(500, 24), position = UDim2.new(0.5, 0, 1, -EDGE - BOTTOM_H - 10), anchor = Vector2.new(0.5, 1), textSize = 13, align = Enum.TextXAlignment.Center, colour = Kit.CREAM })
	toast.TextStrokeTransparency = 0.3
	toast.TextStrokeColor3 = Kit.INK
	toast.Visible = false
end

-- Which classes each command needs (any one of them, not routing).
local COMMAND_CLASSES: { [string]: { string } } = {
	line = { "infantry", "cavalry" },
	column = { "infantry" },
	square = { "infantry" },
	wedge = { "cavalry" },
	fire = { "infantry", "artillery" },
	charge = { "infantry", "cavalry" },
	limber = { "artillery" },
	ammo = { "artillery" },
	rally = { "hq" },
}
local ANY_CLASS = { "infantry", "cavalry", "artillery", "hq" }

local function firstOfClass(forms: { any }, class: string): any
	for _, f in forms do
		if f.class == class then
			return f
		end
	end
	return nil
end

-- Button text / active look that depends on the selection; may veto with a reason.
local function decorateCommand(key: string, b: TextButton, forms: { any }): string?
	if key == "fire" then
		local f: any = forms[1]
		b.Text = if f and f.fireAtWill == false then "Hold fire" else "Fire at will"
		Kit.setActiveLook(b, f ~= nil and f.fireAtWill ~= false)
	elseif key == "charge" then
		local armed = Input.armed() == "Charge"
		Kit.setActiveLook(b, armed)
		b.Text = if armed then "Charge…" else "Charge"
	elseif key == "limber" then
		local art = firstOfClass(forms, "artillery")
		b.Text = if art and art.limbered == true then "Unlimber" else "Limber"
	elseif key == "ammo" then
		local art = firstOfClass(forms, "artillery")
		local mode = if art and art.ammoMode then art.ammoMode else "auto"
		b.Text = if mode == "roundShot" then "Round shot" elseif mode == "canister" then "Canister" else "Auto ammo"
	elseif key == "rally" then
		local cd = 0
		for _, f in forms do
			if f.class == "hq" and f.rallyCd and f.rallyCd > cd then
				cd = f.rallyCd
			end
		end
		if rallyBar then
			local frac = math.clamp(cd / Config.Units.hq.rally.cooldown, 0, 1)
			rallyBar.Size = UDim2.new(frac, math.round(4 * frac), 0, 3)
		end
		if cd > 0 then
			return string.format("Recharging (%ds)", math.ceil(cd))
		end
	end
	return nil
end

function HUD.refreshCommands()
	local forms = selectedFormations()
	local commander = BattleState.isCommander and (BattleState.state == "running" or BattleState.state == "paused")
	local has: { [string]: boolean } = {}
	local allRouting = #forms > 0
	for _, f in forms do
		if f.state ~= "routing" and f.moraleBand ~= "shattered" then
			has[f.class] = true
			allRouting = false
		end
	end
	local function why(classes: { string }): (boolean, string?)
		if not commander then
			return false, if BattleState.isCommander then "Not during this phase" else "Spectators cannot give orders"
		end
		if #forms == 0 then
			return false, "Select a formation"
		end
		if allRouting then
			return false, "Routing formations take no orders"
		end
		for _, c in classes do
			if has[c] then
				return true, nil
			end
		end
		return false, "Needs " .. table.concat(classes, " or ")
	end
	for key, b in commandButtons do
		local ok, reason = why(COMMAND_CLASSES[key] or ANY_CLASS)
		local veto = decorateCommand(key, b, forms)
		if ok and veto then
			ok, reason = false, veto
		end
		Kit.setEnabled(b, ok, reason)
	end
end

function HUD.toast(text: string)
	if toast then
		toast.Text = text
		toast.Visible = true
		toastT0 = os.clock()
	end
end

-- ------------------------------------------------------------------ lifecycle

local function buildMinimap(sg: ScreenGui)
	local m = BattleState.map
	local w = 200
	local h = if m then math.round(w * m.depth / m.width) else 150
	local frame = Kit.panel(sg, { size = UDim2.fromOffset(w + 12, h + 12), position = UDim2.new(1, -EDGE, 1, -EDGE), anchor = Vector2.new(1, 1), transparency = 0.05, padding = 6 })
	frame.Name = "MinimapFrame"
	Minimap.create(frame, UDim2.fromScale(1, 1), UDim2.new(), Vector2.new(0, 0))
	local n = Kit.title(frame, "N", { size = UDim2.fromOffset(14, 14), position = UDim2.new(0.5, 0, 0, -6), anchor = Vector2.new(0.5, 0.5), textSize = 14, align = Enum.TextXAlignment.Center })
	n.BackgroundTransparency = 0
	n.BackgroundColor3 = Kit.CREAM
	n.ZIndex = 10
	if m then
		task.spawn(Minimap.paint, m)
	end
end

local function refreshAll()
	updateTopBar()
	updateObjectives()
	CardBar.update()
	updateInspector()
	HUD.refreshCommands()
end

function HUD.show(callbacks: Callbacks)
	HUD.destroy()
	cb = callbacks
	weather = if BattleState.scenario then BattleState.scenario.weather else nil
	local sg = Kit.screen("EoEHUD", 10)
	buildTopBar(sg)
	buildTicker(sg)
	buildInspector(sg)
	buildCommandPanel(sg)
	CardBar.create(sg)
	buildMinimap(sg)
	gui = sg
	table.insert(conns, BattleState.updated:Connect(function(snap: any)
		if type(snap) == "table" and type(snap.weather) == "string" then
			weather = snap.weather
		end
		refreshAll()
	end))
	table.insert(conns, Selection.changed:Connect(function()
		CardBar.update()
		updateInspector()
		HUD.refreshCommands()
	end))
	table.insert(conns, BattleState.orderRejected:Connect(function(reason: string)
		HUD.toast(reason)
	end))
	table.insert(conns, Input.action:Connect(function(name: string)
		if name == "disarm" then
			HUD.refreshCommands()
		end
	end))
	refreshAll()
end

function HUD.onEvent(ev: any)
	local f = if ev.id then BattleState.formations[ev.id] else nil
	local name = if f and f.name then f.name else (if ev.id then "#" .. tostring(ev.id) else nil)
	local ours = ev.faction == BattleState.viewerFaction
	local kind = ev.kind
	if kind == "message" and ev.text then
		HUD.message(ev.text)
	elseif kind == "rout" and name then
		HUD.message(name .. " is routing!", if ours then Kit.HOSTILE else Kit.SELECT, true)
	elseif kind == "rally" and name then
		HUD.message(name .. " has rallied.")
	elseif kind == "capture" then
		local names = if BattleState.scenario and BattleState.scenario.factionNames then BattleState.scenario.factionNames else {}
		local who = if ev.faction then (names[ev.faction] or Kit.factionName(ev.faction)) else "Someone"
		HUD.message(string.format("%s captured %s", who, ev.text or "an objective"), if ours then Kit.SELECT else Kit.HOSTILE, true)
	elseif kind == "destroyed" and name then
		HUD.message(name .. " is destroyed.", Kit.HOSTILE)
	elseif kind == "charge" and name then
		HUD.message(name .. " charges!")
	end
end

function HUD.update(_dt: number)
	if not gui then
		return
	end
	updateTicker()
	CardBar.animate()
	Minimap.update()
end

function HUD.destroy()
	for _, c in conns do
		c:Disconnect()
	end
	table.clear(conns)
	Minimap.destroy()
	CardBar.destroy()
	if gui then
		gui:Destroy()
		gui = nil
	end
	cb = nil
	clockLabel = nil
	lagLabel = nil
	weatherLabel = nil
	pauseButton = nil
	balanceOwn = nil
	objectiveStrip = nil
	tickerFrame = nil
	inspector = nil
	inspectorBarFill = nil
	rallyBar = nil
	toast = nil
	table.clear(speedButtons)
	table.clear(objectiveChips)
	table.clear(tickerLines)
	table.clear(inspectorFields)
	table.clear(commandButtons)
end

return HUD
]]></ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX00000051"><Properties><bool name="Disabled">false</bool><string name="Name">Help</string><ProtectedString name="Source"><![CDATA[--!strict
-- "How to Command": controls table and one-line formation explanations (docs/architecture.md,
-- docs/rules.md). Static text; shown as a centred panel.

local Kit = require(script.Parent.Kit)

local Help = {}

local gui: ScreenGui? = nil

local CONTROLS = {
	{ "Left click", "Select a formation · drag to box-select · Shift adds or removes" },
	{ "Right click", "Move there (keeps the selection's spacing) · on an enemy: Engage" },
	{ "Right drag", "Draw the line: formations spread along it and face its open side" },
	{ "Shift + order", "Queue the order after the current one (up to 4)" },
	{ "WASD / arrows", "Pan the camera · Q / E rotate · wheel zoom · PgUp / PgDn pitch" },
	{ "F / Home", "Focus the selection / return to the army" },
	{ "Space · 1 2 3", "Pause or resume · speed ×1 ×2 ×4" },
	{ "Ctrl + 4…9 / 4…9", "Assign a control group / recall it" },
	{ "Esc", "Clear the selection, close panels" },
	{ "F1 · F9", "This help · developer panel (when the server allows it)" },
}

local FORMATIONS = {
	{ "Line", "Three ranks: full musketry, slow, vulnerable to cavalry on the flanks." },
	{ "Column", "Twelve ranks: fast on roads, strong in the bayonet charge, weak to fire and round shot." },
	{ "Square", "Hollow box: nearly immune to cavalry, half the fire, a gift to artillery. Slow to form." },
	{ "Travel column", "Adopted automatically at choke points; cannot fire. Reforms when clearance allows." },
	{ "Cavalry wedge", "Charge formation: impact grows with the run-up. Never charge a formed square." },
	{ "Limbered / deployed", "Guns move only when limbered and fire only when deployed (20–25 s to change)." },
	{ "Status words", "Shaken: morale under 40 — rally with the HQ nearby. Routing: no orders accepted until it rallies." },
	{ "Objectives", "Infantry or cavalry inside the ring for 30 s capture it; both sides inside = contested." },
}

local function row(parent: Instance, key: string, text: string, order: number)
	local f = Instance.new("Frame") :: Frame
	f.Size = UDim2.new(1, 0, 0, 22)
	f.BackgroundTransparency = 1
	f.LayoutOrder = order
	f.AutomaticSize = Enum.AutomaticSize.Y
	f.Parent = parent
	Kit.label(f, key, { size = UDim2.new(0, 150, 0, 22), font = Enum.Font.GothamBold, textSize = 13 })
	local t = Kit.label(f, text, { size = UDim2.new(1, -160, 0, 22), position = UDim2.new(0, 160, 0, 0), textSize = 13, wrap = true })
	t.AutomaticSize = Enum.AutomaticSize.Y
end

function Help.show()
	if not gui then
		local sg = Kit.screen("EoEHelp", 35)
		local panel = Kit.panel(sg, { size = UDim2.fromOffset(720, 620), position = UDim2.fromScale(0.5, 0.5), anchor = Vector2.new(0.5, 0.5), padding = 20 })
		Kit.title(panel, "How to Command", { size = UDim2.new(1, 0, 0, 36), textSize = 30 })
		Kit.button(panel, "Close (Esc)", Help.hide, { size = UDim2.fromOffset(110, 28), position = UDim2.new(1, 0, 0, 0), anchor = Vector2.new(1, 0) })
		local scroll = Instance.new("ScrollingFrame") :: ScrollingFrame
		scroll.Size = UDim2.new(1, 0, 1, -48)
		scroll.Position = UDim2.new(0, 0, 0, 44)
		scroll.BackgroundTransparency = 1
		scroll.BorderSizePixel = 0
		scroll.ScrollBarThickness = 6
		scroll.AutomaticCanvasSize = Enum.AutomaticSize.Y
		scroll.CanvasSize = UDim2.new()
		scroll.Parent = panel
		Kit.list(scroll, 4)
		local order = 0
		local function heading(text: string)
			order += 1
			local h = Kit.title(scroll, text, { size = UDim2.new(1, 0, 0, 30), textSize = 22 })
			h.LayoutOrder = order
		end
		heading("Controls")
		for _, c in CONTROLS do
			order += 1
			row(scroll, c[1], c[2], order)
		end
		heading("Formations and words on the field")
		for _, c in FORMATIONS do
			order += 1
			row(scroll, c[1], c[2], order)
		end
		gui = sg
	end
	if gui then
		gui.Enabled = true
	end
end

function Help.hide()
	if gui then
		gui.Enabled = false
	end
end

function Help.isOpen(): boolean
	return gui ~= nil and (gui :: ScreenGui).Enabled
end

function Help.destroy()
	if gui then
		gui:Destroy()
		gui = nil
	end
end

return Help
]]></ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX00000052"><Properties><bool name="Disabled">false</bool><string name="Name">Kit</string><ProtectedString name="Source"><![CDATA[--!strict
-- Tiny native-GUI toolkit: cream panels, ink text, serif titles, Gotham data, buttons with
-- disabled-reason tooltips, sliders. Every panel is Active so clicks never reach the field.

local Players = game:GetService("Players") :: Players
local UserInputService = game:GetService("UserInputService") :: UserInputService
local Shared = game:GetService("ReplicatedStorage"):WaitForChild("EoE")
local Config = require(Shared.Config)
local Factions = require(script.Parent.Parent.Factions)

local Kit = {}

local P = Config.Visual.Palette
local function rgb(t: { number }): Color3
	return Color3.fromRGB(t[1], t[2], t[3])
end

Kit.CREAM = rgb(P.Cream)
Kit.INK = rgb(P.Ink)
Kit.SELECT = rgb(P.Select)
Kit.HOSTILE = rgb(P.Hostile)
Kit.FRANCE = rgb(P.France)
Kit.PRUSSIA = rgb(P.Prussia)
Kit.MUTED = Color3.fromRGB(120, 108, 96)
Kit.PANEL_DARK = Color3.fromRGB(224, 214, 190)
Kit.GOLD = Color3.fromRGB(184, 148, 62)
Kit.MORALE = {
	steady = Color3.fromRGB(88, 128, 64),
	shaken = Color3.fromRGB(206, 160, 52),
	routing = Color3.fromRGB(178, 58, 44),
	shattered = Color3.fromRGB(70, 60, 54),
}

function Kit.factionColour(faction: string?): Color3
	if faction == nil or faction == "" then
		return Kit.MUTED
	end
	return Factions.colour(faction)
end

function Kit.factionName(faction: string?): string
	return Factions.name(faction)
end

function Kit.screen(name: string, order: number, ignoreInset: boolean?): ScreenGui
	local sg = Instance.new("ScreenGui") :: ScreenGui
	sg.Name = name
	sg.ResetOnSpawn = false
	sg.IgnoreGuiInset = ignoreInset == true
	sg.DisplayOrder = order
	sg.ZIndexBehavior = Enum.ZIndexBehavior.Sibling
	sg.Parent = (Players.LocalPlayer :: Player):WaitForChild("PlayerGui")
	return sg
end

export type PanelProps = {
	size: UDim2,
	position: UDim2,
	anchor: Vector2?,
	transparency: number?,
	padding: number?,
	dark: boolean?,
	plain: boolean?, -- no inner border or gold corners (small chips, cards)
}

-- Period trim: an inner hairline border 3 px inside the outer stroke and gold corner studs.
-- Added first so content drawn later sits on top; never Active, never in a layout (panels hold
-- layouts only in child frames).
local function trim(f: Frame, pad: number)
	local inner = Instance.new("Frame") :: Frame
	inner.Name = "Trim"
	inner.BackgroundTransparency = 1
	inner.Position = UDim2.fromOffset(3 - pad, 3 - pad)
	inner.Size = UDim2.new(1, 2 * pad - 6, 1, 2 * pad - 6)
	inner.Parent = f
	local s = Instance.new("UIStroke") :: UIStroke
	s.Color = Kit.GOLD
	s.Thickness = 1
	s.Transparency = 0.35
	s.Parent = inner
	for _, c in { Vector2.new(0, 0), Vector2.new(1, 0), Vector2.new(0, 1), Vector2.new(1, 1) } do
		local d = Instance.new("Frame") :: Frame
		d.Name = "Stud"
		d.Size = UDim2.fromOffset(6, 6)
		d.AnchorPoint = Vector2.new(0.5, 0.5)
		d.Position = UDim2.fromScale(c.X, c.Y)
		d.Rotation = 45
		d.BackgroundColor3 = Kit.GOLD
		d.BorderSizePixel = 0
		d.Parent = inner
	end
end

function Kit.panel(parent: Instance, props: PanelProps): Frame
	local f = Instance.new("Frame") :: Frame
	f.Size = props.size
	f.Position = props.position
	f.AnchorPoint = props.anchor or Vector2.new(0, 0)
	f.BackgroundColor3 = if props.dark then Kit.PANEL_DARK else Kit.CREAM
	f.BackgroundTransparency = props.transparency or 0.06
	f.BorderSizePixel = 0
	f.Active = true
	f.Parent = parent
	local stroke = Instance.new("UIStroke") :: UIStroke
	stroke.Color = Kit.INK
	stroke.Thickness = 1
	stroke.Transparency = if props.plain then 0.5 else 0.2
	stroke.Parent = f
	if not props.plain then
		trim(f, props.padding or 0)
	end
	if props.padding then
		local pad = Instance.new("UIPadding") :: UIPadding
		pad.PaddingTop = UDim.new(0, props.padding)
		pad.PaddingBottom = UDim.new(0, props.padding)
		pad.PaddingLeft = UDim.new(0, props.padding)
		pad.PaddingRight = UDim.new(0, props.padding)
		pad.Parent = f
	end
	return f
end

export type TextProps = {
	size: UDim2?,
	position: UDim2?,
	anchor: Vector2?,
	textSize: number?,
	font: EnumFont?,
	colour: Color3?,
	align: EnumTextXAlignment?,
	wrap: boolean?,
	rich: boolean?,
}

function Kit.label(parent: Instance, text: string, props: TextProps?): TextLabel
	local p: TextProps = props or {}
	local l = Instance.new("TextLabel") :: TextLabel
	l.Size = p.size or UDim2.new(1, 0, 0, 20)
	l.Position = p.position or UDim2.new(0, 0, 0, 0)
	l.AnchorPoint = p.anchor or Vector2.new(0, 0)
	l.BackgroundTransparency = 1
	l.Font = p.font or Enum.Font.Gotham
	l.TextSize = p.textSize or 14
	l.TextColor3 = p.colour or Kit.INK
	l.TextXAlignment = p.align or Enum.TextXAlignment.Left
	l.TextWrapped = p.wrap == true
	l.RichText = p.rich == true
	l.Text = text
	l.Parent = parent
	return l
end

function Kit.title(parent: Instance, text: string, props: TextProps?): TextLabel
	local p: TextProps = props or {}
	p.font = Enum.Font.Garamond
	p.textSize = p.textSize or 26
	return Kit.label(parent, text, p)
end

-- Vertical list container. Children lay out top to bottom.
function Kit.list(parent: Instance, gap: number, horizontal: boolean?): UIListLayout
	local l = Instance.new("UIListLayout") :: UIListLayout
	l.Padding = UDim.new(0, gap)
	l.SortOrder = Enum.SortOrder.LayoutOrder
	l.FillDirection = if horizontal then Enum.FillDirection.Horizontal else Enum.FillDirection.Vertical
	l.Parent = parent
	return l
end

-- ------------------------------------------------------------------ tooltip (one per screen)

local tooltip: TextLabel? = nil

local function ensureTooltip()
	if tooltip and tooltip.Parent then
		return
	end
	local sg = Kit.screen("EoETooltip", 50, true)
	local t = Kit.label(sg, "", { size = UDim2.fromOffset(240, 36), textSize = 13, wrap = true, align = Enum.TextXAlignment.Center })
	t.BackgroundTransparency = 0.05
	t.BackgroundColor3 = Kit.INK
	t.TextColor3 = Kit.CREAM
	t.Visible = false
	t.ZIndex = 100
	t.AutomaticSize = Enum.AutomaticSize.Y
	local c = Instance.new("UICorner") :: UICorner
	c.CornerRadius = UDim.new(0, 3)
	c.Parent = t
	tooltip = t
end

local function showTooltip(text: string)
	ensureTooltip()
	local t = tooltip :: TextLabel
	t.Text = text
	local m = UserInputService:GetMouseLocation()
	local cam = workspace.CurrentCamera
	local maxX = if cam then cam.ViewportSize.X - 248 else m.X + 14
	-- grows upward from just above the cursor and stays on screen at the right edge
	t.AnchorPoint = Vector2.new(0, 1)
	t.Position = UDim2.fromOffset(math.min(m.X + 14, maxX), math.max(m.Y - 10, 40))
	t.Visible = true
end

local function hideTooltip()
	if tooltip then
		tooltip.Visible = false
	end
end

-- ------------------------------------------------------------------ buttons

export type ButtonProps = {
	size: UDim2?,
	position: UDim2?,
	anchor: Vector2?,
	textSize: number?,
	font: EnumFont?,
	tooltip: string?,
	primary: boolean?,
	order: number?,
}

function Kit.button(parent: Instance, text: string, onClick: () -> (), props: ButtonProps?): TextButton
	local p: ButtonProps = props or {}
	local b = Instance.new("TextButton") :: TextButton
	b.Size = p.size or UDim2.new(0, 110, 0, 30)
	b.Position = p.position or UDim2.new(0, 0, 0, 0)
	b.AnchorPoint = p.anchor or Vector2.new(0, 0)
	b.BackgroundColor3 = if p.primary then Kit.INK else Kit.PANEL_DARK
	b.TextColor3 = if p.primary then Kit.CREAM else Kit.INK
	b.Font = p.font or Enum.Font.Gotham
	b.TextSize = p.textSize or 14
	b.Text = text
	b.AutoButtonColor = true
	b.BorderSizePixel = 0
	b.LayoutOrder = p.order or 0
	b.Active = true
	b.Parent = parent
	local c = Instance.new("UICorner") :: UICorner
	c.CornerRadius = UDim.new(0, 3)
	c.Parent = b
	local s = Instance.new("UIStroke") :: UIStroke
	s.Color = Kit.INK
	s.Thickness = 1
	s.Transparency = 0.6
	s.Parent = b
	b:SetAttribute("reason", "")
	b:SetAttribute("tip", p.tooltip or "")
	b.Activated:Connect(function()
		if b:GetAttribute("disabled") == true then
			return
		end
		onClick()
	end)
	b.MouseEnter:Connect(function()
		local reason = b:GetAttribute("reason")
		local tip = b:GetAttribute("tip")
		if type(reason) == "string" and reason ~= "" then
			showTooltip(reason)
		elseif type(tip) == "string" and tip ~= "" then
			showTooltip(tip)
		end
	end)
	b.MouseLeave:Connect(hideTooltip)
	return b
end

-- Hover text for any GUI object; the text is computed when the pointer arrives.
function Kit.hoverTip(obj: GuiObject, text: () -> string)
	obj.MouseEnter:Connect(function()
		local t = text()
		if t ~= "" then
			showTooltip(t)
		end
	end)
	obj.MouseLeave:Connect(hideTooltip)
end

-- Disabled buttons stay visible (dimmed) and explain themselves on hover.
function Kit.setEnabled(b: TextButton, enabled: boolean, reason: string?)
	b:SetAttribute("disabled", not enabled)
	b:SetAttribute("reason", if enabled then "" else (reason or ""))
	b.TextTransparency = if enabled then 0 else 0.55
	b.AutoButtonColor = enabled
end

function Kit.setActiveLook(b: TextButton, active: boolean)
	b.BackgroundColor3 = if active then Kit.INK else Kit.PANEL_DARK
	b.TextColor3 = if active then Kit.CREAM else Kit.INK
end

-- ------------------------------------------------------------------ slider

function Kit.slider(parent: Instance, labelText: string, value: number, onChange: (v: number) -> ()): Frame
	local row = Instance.new("Frame") :: Frame
	row.Size = UDim2.new(1, 0, 0, 36)
	row.BackgroundTransparency = 1
	row.Parent = parent
	local l = Kit.label(row, labelText, { size = UDim2.new(1, 0, 0, 16) })
	local valueLabel = Kit.label(row, "", { size = UDim2.new(0, 48, 0, 16), position = UDim2.new(1, -48, 0, 0), align = Enum.TextXAlignment.Right })
	local track = Instance.new("TextButton") :: TextButton
	track.Size = UDim2.new(1, 0, 0, 12)
	track.Position = UDim2.new(0, 0, 0, 20)
	track.BackgroundColor3 = Kit.PANEL_DARK
	track.BorderSizePixel = 0
	track.Text = ""
	track.AutoButtonColor = false
	track.Parent = row
	local fill = Instance.new("Frame") :: Frame
	fill.BackgroundColor3 = Kit.INK
	fill.BorderSizePixel = 0
	fill.Size = UDim2.new(value, 0, 1, 0)
	fill.Parent = track
	local dragging = false
	local function apply(px: number)
		local v = math.clamp((px - track.AbsolutePosition.X) / math.max(track.AbsoluteSize.X, 1), 0, 1)
		fill.Size = UDim2.new(v, 0, 1, 0)
		valueLabel.Text = string.format("%d%%", math.round(v * 100))
		onChange(v)
	end
	valueLabel.Text = string.format("%d%%", math.round(value * 100))
	track.InputBegan:Connect(function(input: InputObject)
		if input.UserInputType == Enum.UserInputType.MouseButton1 then
			dragging = true
			apply(input.Position.X)
		end
	end)
	track.InputEnded:Connect(function(input: InputObject)
		if input.UserInputType == Enum.UserInputType.MouseButton1 then
			dragging = false
		end
	end)
	local c1 = UserInputService.InputChanged:Connect(function(input: InputObject)
		if dragging and input.UserInputType == Enum.UserInputType.MouseMovement then
			apply(input.Position.X)
		end
	end)
	local c2 = UserInputService.InputEnded:Connect(function(input: InputObject)
		if input.UserInputType == Enum.UserInputType.MouseButton1 then
			dragging = false
		end
	end)
	row.Destroying:Connect(function()
		c1:Disconnect()
		c2:Disconnect()
	end)
	l.Name = "Label"
	return row
end

function Kit.toggle(parent: Instance, labelText: string, value: boolean, onChange: (v: boolean) -> ()): TextButton
	local b: TextButton
	local function text(v: boolean): string
		return (if v then "[x] " else "[ ] ") .. labelText
	end
	b = Kit.button(parent, text(value), function()
		value = not value
		b.Text = text(value)
		onChange(value)
	end, { size = UDim2.new(1, 0, 0, 28) })
	b.TextXAlignment = Enum.TextXAlignment.Left
	return b
end

-- Horizontal bar: dark track with a fill sized by `frac` (0..1). Returns the fill.
function Kit.bar(parent: Instance, size: UDim2, position: UDim2, colour: Color3): Frame
	local track = Instance.new("Frame") :: Frame
	track.Size = size
	track.Position = position
	track.BackgroundColor3 = Kit.INK
	track.BackgroundTransparency = 0.65
	track.BorderSizePixel = 0
	track.Parent = parent
	local fill = Instance.new("Frame") :: Frame
	fill.Size = UDim2.fromScale(1, 1)
	fill.BackgroundColor3 = colour
	fill.BorderSizePixel = 0
	fill.Parent = track
	return fill
end

function Kit.setBar(fill: Frame, frac: number)
	fill.Size = UDim2.fromScale(math.clamp(frac, 0, 1), 1)
end

function Kit.formatClock(seconds: number): string
	local s = math.max(0, math.floor(seconds))
	return string.format("%02d:%02d", s // 60, s % 60)
end

function Kit.hideTooltip()
	hideTooltip()
end

return Kit
]]></ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX00000053"><Properties><bool name="Disabled">false</bool><string name="Name">Loading</string><ProtectedString name="Source"><![CDATA[--!strict
-- Full-screen loading overlay with a progress bar (terrain + props build).

local Kit = require(script.Parent.Kit)

local Loading = {}

local gui: ScreenGui? = nil
local fill: Frame? = nil
local caption: TextLabel? = nil

local function build()
	if gui then
		return
	end
	local sg = Kit.screen("EoELoading", 40, true)
	local back = Instance.new("Frame") :: Frame
	back.Size = UDim2.fromScale(1, 1)
	back.BackgroundColor3 = Kit.CREAM
	back.BorderSizePixel = 0
	back.Active = true
	back.Parent = sg
	Kit.title(back, "Eagles of Empire", { size = UDim2.new(1, 0, 0, 60), position = UDim2.new(0, 0, 0.38, 0), textSize = 48, align = Enum.TextXAlignment.Center })
	local c = Kit.label(back, "Surveying the ground…", { size = UDim2.new(1, 0, 0, 22), position = UDim2.new(0, 0, 0.38, 64), align = Enum.TextXAlignment.Center, colour = Kit.MUTED })
	local track = Instance.new("Frame") :: Frame
	track.Size = UDim2.new(0, 420, 0, 10)
	track.Position = UDim2.new(0.5, -210, 0.38, 100)
	track.BackgroundColor3 = Kit.PANEL_DARK
	track.BorderSizePixel = 0
	track.Parent = back
	local f = Instance.new("Frame") :: Frame
	f.Size = UDim2.new(0, 0, 1, 0)
	f.BackgroundColor3 = Kit.INK
	f.BorderSizePixel = 0
	f.Parent = track
	gui = sg
	fill = f
	caption = c
end

function Loading.show(text: string?)
	build()
	if gui then
		gui.Enabled = true
	end
	Loading.setProgress(0, text)
end

function Loading.setProgress(fraction: number, text: string?)
	if fill then
		fill.Size = UDim2.new(math.clamp(fraction, 0, 1), 0, 1, 0)
	end
	if caption and text then
		caption.Text = text
	end
end

function Loading.hide()
	if gui then
		gui.Enabled = false
	end
end

function Loading.destroy()
	if gui then
		gui:Destroy()
		gui = nil
		fill = nil
		caption = nil
	end
end

return Loading
]]></ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX00000054"><Properties><bool name="Disabled">false</bool><string name="Name">Menu</string><ProtectedString name="Source"><![CDATA[--!strict
-- Main menu over the live battlefield. Buttons call back into Main.

local Kit = require(script.Parent.Kit)

local Menu = {}

export type Callbacks = {
	play: () -> (),
	campaign: () -> (),
	help: () -> (),
	settings: () -> (),
}

local gui: ScreenGui? = nil
local campaignBtn: TextButton? = nil
local playBtn: TextButton? = nil
local note: TextLabel? = nil

function Menu.show(cb: Callbacks, isCommander: boolean, campaignAvailable: boolean)
	if not gui then
		local sg = Kit.screen("EoEMenu", 30)
		local panel = Kit.panel(sg, { size = UDim2.fromOffset(380, 400), position = UDim2.new(0, 48, 0.5, 0), anchor = Vector2.new(0, 0.5), padding = 24 })
		Kit.title(panel, "Eagles of Empire", { size = UDim2.new(1, 0, 0, 48), textSize = 40 })
		Kit.label(panel, "Napoleonic real-time tactics · Jena, 1806", { size = UDim2.new(1, 0, 0, 20), position = UDim2.new(0, 0, 0, 50), colour = Kit.MUTED })
		local list = Instance.new("Frame") :: Frame
		list.Size = UDim2.new(1, 0, 0, 200)
		list.Position = UDim2.new(0, 0, 0, 90)
		list.BackgroundTransparency = 1
		list.Parent = panel
		Kit.list(list, 8)
		playBtn = Kit.button(list, "Play Battle", cb.play, { size = UDim2.new(1, 0, 0, 40), primary = true, order = 1, textSize = 16 })
		campaignBtn = Kit.button(list, "Campaign", cb.campaign, { size = UDim2.new(1, 0, 0, 40), order = 2, textSize = 16 })
		Kit.button(list, "How to Command", cb.help, { size = UDim2.new(1, 0, 0, 40), order = 3, textSize = 16 })
		Kit.button(list, "Settings", cb.settings, { size = UDim2.new(1, 0, 0, 40), order = 4, textSize = 16 })
		note = Kit.label(panel, "", { size = UDim2.new(1, 0, 0, 40), position = UDim2.new(0, 0, 1, -44), wrap = true, colour = Kit.MUTED, textSize = 13 })
		gui = sg
	end
	if campaignBtn then
		campaignBtn.Visible = campaignAvailable
	end
	if playBtn then
		Kit.setEnabled(playBtn, isCommander, "Another player commands this battlefield; you are spectating.")
	end
	if note then
		note.Text = if isCommander then "WASD pan · Q/E rotate · wheel zoom · F1 help" else "Spectating: the commander controls the match."
	end
	if gui then
		gui.Enabled = true
	end
end

function Menu.hide()
	if gui then
		gui.Enabled = false
	end
end

function Menu.destroy()
	if gui then
		gui:Destroy()
		gui = nil
		campaignBtn = nil
		playBtn = nil
		note = nil
	end
end

return Menu
]]></ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX00000055"><Properties><bool name="Disabled">false</bool><string name="Name">Minimap</string><ProtectedString name="Source"><![CDATA[--!strict
-- Minimap: terrain classes painted as run-length Frames (2 px per 16 studs), formation dots,
-- objectives, camera frustum, click to pan. North (+z) is up.

local Shared = game:GetService("ReplicatedStorage"):WaitForChild("EoE")
local Config = require(Shared.Config)
local Grid = require(Shared.Grid)
local Kit = require(script.Parent.Kit)
local BattleState = require(script.Parent.Parent.BattleState)
local Camera = require(script.Parent.Parent.Camera)

local Minimap = {}

local P = Config.Visual.Palette
local IDS = Config.TerrainIds
local function rgb(t: { number }): Color3
	return Color3.fromRGB(t[1], t[2], t[3])
end

local CLASS_COLOUR: { [number]: Color3 } = {
	[IDS.open] = rgb(P.TerrainGrass),
	[IDS.road] = rgb(P.Road),
	[IDS.woods] = rgb(P.TreeCrown),
	[IDS.village] = rgb(P.Roof),
	[IDS.water] = rgb(P.Water),
	[IDS.bridge] = rgb(P.Road),
	[IDS.steep] = rgb(P.TerrainSlope),
	[IDS.cliff] = Color3.fromRGB(96, 84, 70),
}

local SAMPLE = 16 -- studs per painted cell
local PX = 2 -- pixels per painted cell

local root: Frame? = nil
local terrainLayer: Frame? = nil
local dotLayer: Frame? = nil
local dots: { Frame } = {}
local objectiveDots: { [string]: Frame } = {}
local frustum: { Frame } = {}
local connection: RBXScriptConnection? = nil
local mapW, mapD = 1600, 1200

local function toPixel(x: number, z: number): (number, number)
	local w = (root :: Frame).AbsoluteSize.X
	local h = (root :: Frame).AbsoluteSize.Y
	return x / mapW * w, (1 - z / mapD) * h
end

local function dot(parent: Instance, size: number): Frame
	local d = Instance.new("Frame") :: Frame
	d.Size = UDim2.fromOffset(size, size)
	d.AnchorPoint = Vector2.new(0.5, 0.5)
	d.BorderSizePixel = 0
	d.Parent = parent
	return d
end

function Minimap.create(parent: Instance, size: UDim2, position: UDim2, anchor: Vector2)
	Minimap.destroy()
	local r = Instance.new("TextButton") :: TextButton
	r.Size = size
	r.Position = position
	r.AnchorPoint = anchor
	r.BackgroundColor3 = Kit.INK
	r.BorderSizePixel = 0
	r.Text = ""
	r.AutoButtonColor = false
	r.ClipsDescendants = true
	r.Active = true
	r.Parent = parent
	local stroke = Instance.new("UIStroke") :: UIStroke
	stroke.Color = Kit.CREAM
	stroke.Thickness = 1
	stroke.Parent = r
	local tl = Instance.new("Frame") :: Frame
	tl.Size = UDim2.fromScale(1, 1)
	tl.BackgroundTransparency = 1
	tl.Parent = r
	local dl = Instance.new("Frame") :: Frame
	dl.Size = UDim2.fromScale(1, 1)
	dl.BackgroundTransparency = 1
	dl.ZIndex = 3
	dl.Parent = r
	for i = 1, 4 do
		local l = Instance.new("Frame") :: Frame
		l.AnchorPoint = Vector2.new(0.5, 0.5)
		l.BackgroundColor3 = Kit.CREAM
		l.BackgroundTransparency = 0.2
		l.BorderSizePixel = 0
		l.ZIndex = 4
		l.Parent = dl
		frustum[i] = l
	end
	connection = r.InputBegan:Connect(function(input: InputObject)
		if input.UserInputType == Enum.UserInputType.MouseButton1 then
			local lx = (input.Position.X - r.AbsolutePosition.X) / math.max(r.AbsoluteSize.X, 1)
			local ly = (input.Position.Y - r.AbsolutePosition.Y) / math.max(r.AbsoluteSize.Y, 1)
			Camera.focusOn(lx * mapW, (1 - ly) * mapD)
		end
	end)
	root = r :: any
	terrainLayer = tl
	dotLayer = dl
end

-- Paints terrain classes once per map. Yields every few rows.
function Minimap.paint(map: any)
	local tl = terrainLayer
	if not tl then
		return
	end
	tl:ClearAllChildren()
	table.clear(objectiveDots)
	mapW, mapD = map.width, map.depth
	local g = map.grid
	local cols = math.floor(map.width / SAMPLE)
	local rows = math.floor(map.depth / SAMPLE)
	local w, h = cols * PX, rows * PX
	for r = 0, rows - 1 do
		local z = (rows - 1 - r + 0.5) * SAMPLE -- top row is north
		local runStart = 0
		local runCls = Grid.classAt(g, 0.5 * SAMPLE, z)
		local function flush(endCol: number)
			local f = Instance.new("Frame") :: Frame
			f.BorderSizePixel = 0
			f.BackgroundColor3 = CLASS_COLOUR[runCls] or Kit.MUTED
			f.Position = UDim2.new(runStart * PX / w, 0, r * PX / h, 0)
			f.Size = UDim2.new((endCol - runStart) * PX / w, 0, PX / h, 0)
			f.Parent = tl
		end
		for c = 1, cols - 1 do
			local cls = Grid.classAt(g, (c + 0.5) * SAMPLE, z)
			if cls ~= runCls then
				flush(c)
				runStart = c
				runCls = cls
			end
		end
		flush(cols)
		if r % 12 == 11 then
			task.wait()
		end
	end
	for _, o in map.objectives do
		local d = dot(dotLayer :: Frame, 7)
		d.BackgroundColor3 = Kit.CREAM
		local px, py = toPixel(o.pos.x, o.pos.z)
		d.Position = UDim2.fromOffset(px, py)
		d.ZIndex = 5
		local c = Instance.new("UICorner") :: UICorner
		c.CornerRadius = UDim.new(1, 0)
		c.Parent = d
		objectiveDots[o.id] = d
	end
end

local function line(f: Frame, x0: number, y0: number, x1: number, y1: number)
	local dx, dy = x1 - x0, y1 - y0
	local len = math.sqrt(dx * dx + dy * dy)
	f.Position = UDim2.fromOffset((x0 + x1) / 2, (y0 + y1) / 2)
	f.Size = UDim2.fromOffset(len, 1)
	f.Rotation = math.deg(math.atan2(dy, dx))
end

-- Ground points under the four viewport corners, projected to the focus plane.
local function frustumCorners(): { { number } }?
	local cam = workspace.CurrentCamera
	if not cam then
		return nil
	end
	local vp = cam.ViewportSize
	local fx, fz = Camera.getFocus()
	local planeY = Camera.groundHeight(fx, fz)
	local out = {}
	for _, c in { { 0, 0 }, { vp.X, 0 }, { vp.X, vp.Y }, { 0, vp.Y } } do
		local ray = cam:ViewportPointToRay(c[1], c[2])
		local dir = ray.Direction
		local t
		if dir.Y < -0.02 then
			t = (planeY - ray.Origin.Y) / dir.Y
		else
			t = 3000 -- horizon: clamp far away
		end
		t = math.min(t, 3000)
		local p = ray.Origin + dir * t
		table.insert(out, { p.X, p.Z })
	end
	return out
end

function Minimap.update()
	local r = root
	local dl = dotLayer
	if not r or not dl then
		return
	end
	-- formation dots (pooled)
	local i = 0
	local function place(x: number, z: number, colour: Color3, alpha: number, size: number)
		i += 1
		local d = dots[i]
		if not d then
			d = dot(dl, size)
			dots[i] = d
		end
		d.Size = UDim2.fromOffset(size, size)
		d.BackgroundColor3 = colour
		d.BackgroundTransparency = alpha
		local px, py = toPixel(x, z)
		d.Position = UDim2.fromOffset(px, py)
		d.Visible = true
	end
	for _, f in BattleState.formations do
		place(f.x, f.z, Kit.factionColour(f.faction), 0, if f.class == "hq" then 6 else 4)
	end
	for _, lk in BattleState.lastKnown do
		place(lk.x, lk.z, Kit.factionColour(lk.faction):Lerp(Kit.MUTED, 0.6), 0.3, 4)
	end
	for j = i + 1, #dots do
		dots[j].Visible = false
	end
	for _, o in BattleState.objectives do
		local d = objectiveDots[o.id]
		if d then
			d.BackgroundColor3 = if o.contested then Kit.HOSTILE else Kit.factionColour(o.owner)
			if not o.owner and not o.contested then
				d.BackgroundColor3 = Kit.CREAM
			end
		end
	end
	local corners = frustumCorners()
	if corners then
		for k = 1, 4 do
			local a = corners[k]
			local b = corners[k % 4 + 1]
			local ax, ay = toPixel(a[1], a[2])
			local bx, by = toPixel(b[1], b[2])
			line(frustum[k], ax, ay, bx, by)
		end
	end
end

function Minimap.destroy()
	if connection then
		connection:Disconnect()
		connection = nil
	end
	if root then
		root:Destroy()
		root = nil
	end
	terrainLayer = nil
	dotLayer = nil
	table.clear(dots)
	table.clear(objectiveDots)
	table.clear(frustum)
end

return Minimap
]]></ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX00000056"><Properties><bool name="Disabled">false</bool><string name="Name">Results</string><ProtectedString name="Source"><![CDATA[--!strict
-- End-of-battle screen in the Napoleon: Total War manner: the verdict, casualties per side as
-- bars, the objectives with their final owners, notes from the field and the way out.

local Kit = require(script.Parent.Kit)
local BattleState = require(script.Parent.Parent.BattleState)

local Results = {}

export type Callbacks = { restart: () -> (), menu: () -> (), campaign: (() -> ())? }

local gui: ScreenGui? = nil

local function thousands(n: number): string
	local s = tostring(math.floor(n))
	local out = s
	repeat
		local k
		out, k = string.gsub(out, "^(-?%d+)(%d%d%d)", "%1,%2")
	until k == 0
	return out
end

-- Decisive when the enemy army collapsed or we lost less than half what they lost.
function Results.verdict(results: any, own: any, enemy: any): string
	local outcome = results.outcome or "draw"
	if outcome == "victory" then
		local collapsed = string.find(string.lower(tostring(results.reason or "")), "enemy army has collapsed", 1, true) ~= nil
		local cheap = own ~= nil and enemy ~= nil and (own.casualties or 0) < 0.5 * (enemy.casualties or 0)
		return if collapsed or cheap then "Decisive Victory" else "Close Victory"
	elseif outcome == "defeat" then
		return "Defeat"
	end
	return "Draw"
end

local function sideBlock(parent: Instance, faction: string, name: string, s: any, order: number)
	local f = Kit.panel(parent, { size = UDim2.new(0.5, -6, 1, 0), position = UDim2.new(), dark = true, padding = 10 })
	f.LayoutOrder = order
	local colour = Kit.factionColour(faction)
	local t = Kit.title(f, name, { size = UDim2.new(1, 0, 0, 26), textSize = 24, colour = colour })
	t.Name = "Title"
	local deployed = math.max(s.deployed or 0, 1)
	local lost = s.casualties or 0
	-- the bar is the army: faction colour for those still standing, red for the fallen
	local track = Instance.new("Frame") :: Frame
	track.Size = UDim2.new(1, 0, 0, 14)
	track.Position = UDim2.fromOffset(0, 32)
	track.BackgroundColor3 = colour
	track.BorderSizePixel = 0
	track.Parent = f
	local ts = Instance.new("UIStroke") :: UIStroke
	ts.Color = Kit.INK
	ts.Transparency = 0.3
	ts.Parent = track
	local fallen = Instance.new("Frame") :: Frame
	fallen.AnchorPoint = Vector2.new(1, 0)
	fallen.Position = UDim2.fromScale(1, 0)
	fallen.Size = UDim2.fromScale(math.clamp(lost / deployed, 0, 1), 1)
	fallen.BackgroundColor3 = Kit.MORALE.routing
	fallen.BorderSizePixel = 0
	fallen.Parent = track
	Kit.label(f, string.format("Casualties  %s of %s  (%d%%)", thousands(lost), thousands(s.deployed or 0), math.floor(100 * lost / deployed + 0.5)), { size = UDim2.new(1, 0, 0, 18), position = UDim2.fromOffset(0, 50), textSize = 13, font = Enum.Font.GothamBold })
	local rows = {
		{ "Remaining", thousands(s.remaining or 0) },
		{ "Formations surviving", tostring(s.surviving or 0) },
		{ "Routed / shattered", string.format("%d / %d", s.routed or 0, s.shattered or 0) },
		{ "Destroyed / exited", string.format("%d / %d", s.destroyed or 0, s.exited or 0) },
	}
	for i, r in rows do
		local y = 52 + i * 20
		Kit.label(f, r[1], { size = UDim2.new(0.65, 0, 0, 18), position = UDim2.new(0, 0, 0, y), textSize = 12, colour = Kit.MUTED })
		Kit.label(f, r[2], { size = UDim2.new(0.35, 0, 0, 18), position = UDim2.new(0.65, 0, 0, y), textSize = 12, align = Enum.TextXAlignment.Right, font = Enum.Font.GothamBold })
	end
end

local function objectiveChip(parent: Instance, o: any, names: { [string]: string }, order: number)
	local f = Kit.panel(parent, { size = UDim2.fromOffset(170, 26), position = UDim2.new(), transparency = 0.1, plain = true })
	f.LayoutOrder = order
	local pennant = Instance.new("Frame") :: Frame
	pennant.Size = UDim2.new(0, 8, 1, 0)
	pennant.BackgroundColor3 = if o.owner then Kit.factionColour(o.owner) else Kit.PANEL_DARK
	pennant.BorderSizePixel = 0
	pennant.Parent = f
	local owner = if o.owner then (names[o.owner] or Kit.factionName(o.owner)) else "unclaimed"
	local l = Kit.label(f, string.format("%s — %s", tostring(o.name), owner), { size = UDim2.new(1, -16, 1, 0), position = UDim2.fromOffset(13, 0), textSize = 12 })
	l.TextTruncate = Enum.TextTruncate.AtEnd
end

function Results.show(results: any, cb: Callbacks)
	Results.destroy()
	local sg = Kit.screen("EoEResults", 38)
	local panel = Kit.panel(sg, { size = UDim2.fromOffset(760, 640), position = UDim2.fromScale(0.5, 0.5), anchor = Vector2.new(0.5, 0.5), padding = 22 })
	local cap = Instance.new("UISizeConstraint") :: UISizeConstraint
	cap.MaxSize = Vector2.new(760, 640)
	cap.Parent = panel
	local names = if BattleState.scenario and BattleState.scenario.factionNames then BattleState.scenario.factionNames else {}
	local sides = results.sides or {}
	local own, enemy = sides[BattleState.viewerFaction], sides[BattleState.enemyFaction]
	local outcome = results.outcome or "draw"
	local word = Results.verdict(results, own, enemy)
	Kit.title(panel, word, { size = UDim2.new(1, 0, 0, 52), textSize = 50, align = Enum.TextXAlignment.Center, colour = if outcome == "victory" then Kit.GOLD elseif outcome == "defeat" then Kit.HOSTILE else Kit.INK })
	local sub = BattleState.scenario and BattleState.scenario.name or ""
	Kit.title(panel, string.format("%s%s · %s", if sub ~= "" then sub .. " · " else "", tostring(results.reason or ""), Kit.formatClock(results.clock or 0)), { size = UDim2.new(1, 0, 0, 20), position = UDim2.new(0, 0, 0, 54), textSize = 17, colour = Kit.MUTED, align = Enum.TextXAlignment.Center })
	local rule = Instance.new("Frame") :: Frame
	rule.Size = UDim2.new(0.6, 0, 0, 1)
	rule.Position = UDim2.new(0.2, 0, 0, 82)
	rule.BackgroundColor3 = Kit.GOLD
	rule.BorderSizePixel = 0
	rule.Parent = panel

	local sidesRow = Instance.new("Frame") :: Frame
	sidesRow.Size = UDim2.new(1, 0, 0, 160)
	sidesRow.Position = UDim2.new(0, 0, 0, 94)
	sidesRow.BackgroundTransparency = 1
	sidesRow.Parent = panel
	Kit.list(sidesRow, 12, true)
	local order = 0
	for _, faction in { BattleState.viewerFaction, BattleState.enemyFaction } do
		local s = sides[faction]
		if s then
			order += 1
			sideBlock(sidesRow, faction, names[faction] or Kit.factionName(faction), s, order)
		end
	end

	Kit.title(panel, "Objectives", { size = UDim2.new(1, 0, 0, 24), position = UDim2.new(0, 0, 0, 264), textSize = 21 })
	local objRow = Instance.new("Frame") :: Frame
	objRow.Size = UDim2.new(1, 0, 0, 26)
	objRow.Position = UDim2.new(0, 0, 0, 290)
	objRow.BackgroundTransparency = 1
	objRow.Parent = panel
	local ol = Kit.list(objRow, 6, true)
	ol.Wraps = true
	local objs = results.objectives or {}
	for i, o in objs do
		objectiveChip(objRow, o, names, i)
	end
	if #objs == 0 then
		Kit.label(objRow, "None on this field.", { size = UDim2.new(1, 0, 1, 0), textSize = 12, colour = Kit.MUTED })
	end

	Kit.title(panel, "Notes from the field", { size = UDim2.new(1, 0, 0, 24), position = UDim2.new(0, 0, 0, 326), textSize = 21 })
	local fb = Instance.new("ScrollingFrame") :: ScrollingFrame
	fb.Size = UDim2.new(1, 0, 1, -352 - 52)
	fb.Position = UDim2.new(0, 0, 0, 352)
	fb.BackgroundTransparency = 1
	fb.BorderSizePixel = 0
	fb.ScrollBarThickness = 4
	fb.ScrollBarImageColor3 = Kit.INK
	fb.AutomaticCanvasSize = Enum.AutomaticSize.Y
	fb.CanvasSize = UDim2.new()
	fb.Parent = panel
	Kit.list(fb, 4)
	local lines = results.feedback or {}
	if #lines == 0 then
		lines = { "No particular lessons this time." }
	end
	for i, line in lines do
		local l = Kit.label(fb, "· " .. tostring(line), { size = UDim2.new(1, -8, 0, 20), textSize = 13, wrap = true })
		l.AutomaticSize = Enum.AutomaticSize.Y
		l.LayoutOrder = i
	end

	local buttons = Instance.new("Frame") :: Frame
	buttons.Size = UDim2.new(1, 0, 0, 42)
	buttons.Position = UDim2.new(0, 0, 1, -42)
	buttons.BackgroundTransparency = 1
	buttons.Parent = panel
	local bl = Kit.list(buttons, 10, true)
	bl.HorizontalAlignment = Enum.HorizontalAlignment.Center
	local campaign = cb.campaign
	local returnBtn: TextButton? = nil
	if campaign then
		returnBtn = Kit.button(buttons, "Return to Campaign", campaign, { size = UDim2.fromOffset(200, 42), primary = true, order = 1, textSize = 20, font = Enum.Font.Garamond })
	end
	-- Restart stays available for a campaign battle until the server refuses it.
	local restart = Kit.button(buttons, "Restart", cb.restart, { size = UDim2.fromOffset(160, 42), primary = campaign == nil, order = 2, textSize = 20, font = Enum.Font.Garamond })
	local menu = Kit.button(buttons, "Main Menu", cb.menu, { size = UDim2.fromOffset(160, 42), order = 3, textSize = 20, font = Enum.Font.Garamond })
	if not BattleState.isCommander then
		Kit.setEnabled(restart, false, "Only the commander can restart")
		Kit.setEnabled(menu, false, "Only the commander can leave")
		if returnBtn then
			Kit.setEnabled(returnBtn, false, "Only the commander runs the campaign")
		end
	end
	gui = sg
end

function Results.hide()
	if gui then
		gui.Enabled = false
	end
end

function Results.destroy()
	if gui then
		gui:Destroy()
		gui = nil
	end
end

return Results
]]></ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX00000057"><Properties><bool name="Disabled">false</bool><string name="Name">SettingsPanel</string><ProtectedString name="Source"><![CDATA[--!strict
-- Settings: quality, volumes, reduced shake/effects, AI difficulty. Applies live via Settings.

local Kit = require(script.Parent.Kit)
local Settings = require(script.Parent.Parent.Settings)
local Audio = require(script.Parent.Parent.Audio)
local Net = require(script.Parent.Parent.Net)
local BattleState = require(script.Parent.Parent.BattleState)

local SettingsPanel = {}

local gui: ScreenGui? = nil
local qualityButtons: { TextButton } = {}
local difficultyButtons: { [string]: TextButton } = {}

local function refreshQuality()
	for i, b in qualityButtons do
		Kit.setActiveLook(b, Settings.get().quality == i)
	end
end

local function refreshDifficulty()
	for key, b in difficultyButtons do
		Kit.setActiveLook(b, BattleState.difficulty == key)
		Kit.setEnabled(b, BattleState.isCommander and (BattleState.state == "menu" or BattleState.state == "deployment"), "Difficulty is set before the battle starts")
	end
end

function SettingsPanel.show()
	if not gui then
		local sg = Kit.screen("EoESettings", 36)
		local panel = Kit.panel(sg, { size = UDim2.fromOffset(420, 540), position = UDim2.fromScale(0.5, 0.5), anchor = Vector2.new(0.5, 0.5), padding = 20 })
		Kit.title(panel, "Settings", { size = UDim2.new(1, 0, 0, 36), textSize = 30 })
		Kit.button(panel, "Close (Esc)", SettingsPanel.hide, { size = UDim2.fromOffset(110, 28), position = UDim2.new(1, 0, 0, 0), anchor = Vector2.new(1, 0) })
		local list = Instance.new("Frame") :: Frame
		list.Size = UDim2.new(1, 0, 1, -48)
		list.Position = UDim2.new(0, 0, 0, 44)
		list.BackgroundTransparency = 1
		list.Parent = panel
		Kit.list(list, 10)
		local order = 0
		local function next(): number
			order += 1
			return order
		end

		local q = Kit.label(list, "Quality (figure count, trees, effects)", { size = UDim2.new(1, 0, 0, 18) })
		q.LayoutOrder = next()
		local qRow = Instance.new("Frame") :: Frame
		qRow.Size = UDim2.new(1, 0, 0, 30)
		qRow.BackgroundTransparency = 1
		qRow.LayoutOrder = next()
		qRow.Parent = list
		Kit.list(qRow, 6, true)
		for i, name in { "Low", "Medium", "High" } do
			local b = Kit.button(qRow, name, function()
				Settings.set("quality", i)
				refreshQuality()
			end, { size = UDim2.new(0.32, 0, 1, 0), order = i })
			qualityButtons[i] = b
		end
		refreshQuality()

		local v = Settings.get()
		Kit.slider(list, "Master volume", v.master, function(x)
			Settings.set("master", x)
		end).LayoutOrder = next()
		Kit.slider(list, "Effects volume", v.sfx, function(x)
			Settings.set("sfx", x)
		end).LayoutOrder = next()
		Kit.slider(list, "Music volume", v.music, function(x)
			Settings.set("music", x)
		end).LayoutOrder = next()
		if Audio.isSilent() then
			local n = Kit.label(list, "No sound assets installed: the game is silent. Volumes are kept for when they are.", { size = UDim2.new(1, 0, 0, 32), wrap = true, colour = Kit.MUTED, textSize = 12 })
			n.LayoutOrder = next()
		end
		Kit.toggle(list, "Reduced screen shake", v.reducedShake, function(x)
			Settings.set("reducedShake", x)
		end).LayoutOrder = next()
		Kit.toggle(list, "Reduced effects (half the smoke and dust)", v.reducedEffects, function(x)
			Settings.set("reducedEffects", x)
		end).LayoutOrder = next()

		local d = Kit.label(list, "AI difficulty (Hard: the enemy gets +5 morale)", { size = UDim2.new(1, 0, 0, 18) })
		d.LayoutOrder = next()
		local dRow = Instance.new("Frame") :: Frame
		dRow.Size = UDim2.new(1, 0, 0, 30)
		dRow.BackgroundTransparency = 1
		dRow.LayoutOrder = next()
		dRow.Parent = list
		Kit.list(dRow, 6, true)
		for i, key in { "easy", "normal", "hard" } do
			local b = Kit.button(dRow, string.upper(string.sub(key, 1, 1)) .. string.sub(key, 2), function()
				Net.control("difficulty", key)
				BattleState.difficulty = key
				refreshDifficulty()
			end, { size = UDim2.new(0.32, 0, 1, 0), order = i })
			difficultyButtons[key] = b
		end
		gui = sg
	end
	refreshQuality()
	refreshDifficulty()
	if gui then
		gui.Enabled = true
	end
end

function SettingsPanel.hide()
	if gui then
		gui.Enabled = false
	end
end

function SettingsPanel.isOpen(): boolean
	return gui ~= nil and (gui :: ScreenGui).Enabled
end

function SettingsPanel.destroy()
	if gui then
		gui:Destroy()
		gui = nil
	end
	table.clear(qualityButtons)
	table.clear(difficultyButtons)
end

return SettingsPanel
]]></ProtectedString></Properties></Item></Item><Item class="Folder" referent="RBX00000063"><Properties><string name="Name">World</string></Properties><Item class="ModuleScript" referent="RBX00000059"><Properties><bool name="Disabled">false</bool><string name="Name">Lighting</string><ProtectedString name="Source"><![CDATA[--!strict
-- Morning battlefield light: warm sun from the south-east, light haze, soft clouds, slight
-- warmth and contrast. Built-in defaults only (no asset ids). Quality 1 drops the costly bits.

local LightingService = game:GetService("Lighting") :: Lighting

local Lighting = {}

local NAME = "EoE"
local applied: { Instance } = {}

local function clearOwned()
	for _, i in applied do
		i:Destroy()
	end
	table.clear(applied)
end

local function own<T>(i: T & Instance, parent: Instance): T
	i.Name = NAME .. i.ClassName
	i.Parent = parent
	table.insert(applied, i)
	return i
end

-- Technology is not writable from every context; try Future, then ShadowMap, else keep the place's.
local function setTechnology()
	local ok = pcall(function()
		(LightingService :: any).Technology = Enum.Technology.Future
	end)
	if not ok then
		pcall(function()
			(LightingService :: any).Technology = Enum.Technology.ShadowMap
		end)
	end
end

function Lighting.apply(quality: number)
	clearOwned()
	setTechnology()
	local L = LightingService
	-- ~10:12, latitude 50: the sun stands in the south-east, so north/west slopes read darker
	L.ClockTime = 10.2
	L.GeographicLatitude = 50
	L.Brightness = 2.4
	L.ShadowSoftness = 0.2
	L.GlobalShadows = true
	L.EnvironmentDiffuseScale = 0.5
	L.EnvironmentSpecularScale = 0.25
	L.Ambient = Color3.fromRGB(88, 92, 82)
	L.OutdoorAmbient = Color3.fromRGB(126, 128, 112)
	L.ExposureCompensation = 0.1

	local sky = own(Instance.new("Sky") :: Sky, L)
	sky.CelestialBodiesShown = true
	sky.StarCount = 0
	sky.SunAngularSize = 14

	local cc = own(Instance.new("ColorCorrectionEffect") :: ColorCorrectionEffect, L)
	cc.TintColor = Color3.fromRGB(255, 248, 236) -- slight warmth
	cc.Contrast = 0.08
	cc.Saturation = 0.04
	cc.Brightness = 0.0

	local bloom = own(Instance.new("BloomEffect") :: BloomEffect, L)
	bloom.Intensity = 0.15
	bloom.Size = 18
	bloom.Threshold = 1.6

	if quality >= 2 then
		local atmo = own(Instance.new("Atmosphere") :: Atmosphere, L)
		atmo.Density = 0.28
		atmo.Offset = 0.12
		atmo.Color = Color3.fromRGB(214, 206, 186)
		atmo.Decay = Color3.fromRGB(120, 118, 104)
		atmo.Glare = 0.15
		atmo.Haze = 1.2

		local rays = own(Instance.new("SunRaysEffect") :: SunRaysEffect, L)
		rays.Intensity = 0.04
		rays.Spread = 0.6

		local clouds = own(Instance.new("Clouds") :: Clouds, workspace.Terrain)
		clouds.Cover = 0.45
		clouds.Density = 0.25
		clouds.Color = Color3.fromRGB(246, 242, 232)
	else
		-- without Atmosphere, plain distance fog hides the horizon past the map edge
		L.FogColor = Color3.fromRGB(200, 198, 182)
		L.FogStart = 1400
		L.FogEnd = 3400
	end
end

function Lighting.destroy()
	clearOwned()
end

return Lighting
]]></ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX00000060"><Properties><bool name="Disabled">false</bool><string name="Name">Props</string><ProtectedString name="Source"><![CDATA[--!strict
-- Decorative props derived from MapData: trees, houses, bridges, ground labels, objective
-- markers and the deployment zone outline. Anchored, non-colliding, non-queryable parts.

local Shared = game:GetService("ReplicatedStorage"):WaitForChild("EoE")
local Config = require(Shared.Config)
local Grid = require(Shared.Grid)
local Vec = require(Shared.Vec)
local Factions = require(script.Parent.Parent.Factions)

local Props = {}

local P = Config.Visual.Palette
local function rgb(t: { number }): Color3
	return Color3.fromRGB(t[1], t[2], t[3])
end

local folder: Folder? = nil
local zoneFolder: Folder? = nil
local labelParts: { { part: Part, size: number, len: number } } = {}
local objectiveMarks: { [string]: { ring: { Part }, flag: Part } } = {}
local generation = 0
local currentMap: any = nil

local TREE_PRIORITY = { [1] = 0.55, [2] = 0.25, [3] = 0.0 } -- keep trees with priority >= this
local CROWNS = { [1] = 2, [2] = 3, [3] = 3 }
local CROWN = Color3.fromRGB(52, 74, 36) -- dense dark green (reference), not the lighter palette crown
local ROOF = Color3.fromRGB(58, 40, 30) -- very dark brown pitched roofs
local WALL = Color3.fromRGB(104, 78, 58)

local function part(parent: Instance, shape: EnumPartType?, size: Vector3, cf: CFrame, color: Color3, material: EnumMaterial?): Part
	local p = Instance.new("Part") :: Part
	if shape then
		p.Shape = shape
	end
	p.Size = size
	p.CFrame = cf
	p.Color = color
	p.Material = material or Enum.Material.SmoothPlastic
	p.Anchored = true
	p.CanCollide = false
	p.CanTouch = false
	p.CanQuery = false
	p.CastShadow = true
	p.TopSurface = Enum.SurfaceType.Smooth
	p.BottomSurface = Enum.SurfaceType.Smooth
	p.Parent = parent
	return p
end

local function wedge(parent: Instance, size: Vector3, cf: CFrame, color: Color3): WedgePart
	local p = Instance.new("WedgePart") :: WedgePart
	p.Size = size
	p.CFrame = cf
	p.Color = color
	p.Material = Enum.Material.SmoothPlastic
	p.Anchored = true
	p.CanCollide = false
	p.CanTouch = false
	p.CanQuery = false
	p.CastShadow = true
	p.Parent = parent
	return p
end

-- Yaw so that local +X points along a sim heading (Roblox rotates +X toward -Z for +angle).
local function yaw(x: number, y: number, z: number, heading: number): CFrame
	return CFrame.new(x, y, z) * CFrame.Angles(0, -heading, 0)
end

local function groundY(x: number, z: number): number
	return Grid.heightAt(currentMap.grid, x, z)
end

local function buildTree(parent: Instance, t: any, crowns: number)
	local r = t.r
	local y = groundY(t.x, t.z)
	local trunkH = r * 1.1
	part(parent, Enum.PartType.Cylinder, Vector3.new(trunkH, r * 0.28, r * 0.28), CFrame.new(t.x, y + trunkH / 2, t.z) * CFrame.Angles(0, 0, math.pi / 2), rgb(P.TreeTrunk))
	-- dark disc underneath gives the "depth beneath the canopy"
	part(parent, Enum.PartType.Cylinder, Vector3.new(0.3, r * 2.1, r * 2.1), CFrame.new(t.x, y + 0.2, t.z) * CFrame.Angles(0, 0, math.pi / 2), Color3.fromRGB(38, 46, 28))
	local crown = CROWN
	local seed = (t.x * 7 + t.z * 13) % 10 / 10
	for i = 1, crowns do
		local f = (i - 1) / math.max(crowns - 1, 1)
		local cr = r * (1.0 - f * 0.35)
		local off = (i - 1) * r * 0.35
		local ang = seed * math.pi * 2 + i * 2.1
		part(parent, Enum.PartType.Ball, Vector3.new(cr * 2, cr * 2, cr * 2), CFrame.new(t.x + math.cos(ang) * off, y + trunkH + cr * 0.6 + off * 0.8, t.z + math.sin(ang) * off), crown:Lerp(Color3.fromRGB(30, 46, 22), f * 0.35))
	end
end

local function buildBuilding(parent: Instance, b: any)
	local y = groundY(b.pos.x, b.pos.z)
	local base = yaw(b.pos.x, y + b.h / 2 - 0.5, b.pos.z, b.heading)
	part(parent, nil, Vector3.new(b.w, b.h, b.d), base, WALL)
	local roofH = b.h * 0.55
	local roofColor = if (b.w * 3 + b.d) % 2 < 1 then ROOF else ROOF:Lerp(Color3.fromRGB(28, 22, 18), 0.4)
	local roofBase = yaw(b.pos.x, y + b.h - 0.5 + roofH / 2, b.pos.z, b.heading)
	-- two wedges back to back along local Z form a gable with the ridge along local X
	wedge(parent, Vector3.new(b.w + 0.6, roofH, b.d / 2 + 0.3), roofBase * CFrame.new(0, 0, -b.d / 4), roofColor)
	wedge(parent, Vector3.new(b.w + 0.6, roofH, b.d / 2 + 0.3), roofBase * CFrame.new(0, 0, b.d / 4) * CFrame.Angles(0, math.pi, 0), roofColor)
end

local function buildBridge(parent: Instance, br: any)
	local a, b = br.a, br.b
	local len = Vec.dist(a, b)
	local dir = Vec.normalize(Vec.sub(b, a))
	local h = math.max(groundY(a.x, a.z), groundY(b.x, b.z))
	local mid = Vec.lerp(a, b, 0.5)
	local heading = Vec.heading(dir)
	local stone = Color3.fromRGB(150, 140, 125)
	part(parent, nil, Vector3.new(len + 4, 1.2, br.width), yaw(mid.x, h + 0.4, mid.z, heading), stone, Enum.Material.Slate)
	for side = -1, 1, 2 do
		part(parent, nil, Vector3.new(len + 4, 1.4, 0.8), yaw(mid.x, h + 1.5, mid.z, heading) * CFrame.new(0, 0, side * (br.width / 2 - 0.4)), stone, Enum.Material.Slate)
	end
	-- piers down to the water bed
	for i = 0, 2 do
		local t = 0.2 + i * 0.3
		local px, pz = a.x + (b.x - a.x) * t, a.z + (b.z - a.z) * t
		local bottom = groundY(px, pz)
		local ph = math.max(h - bottom, 1)
		part(parent, nil, Vector3.new(3, ph, br.width - 1), yaw(px, bottom + ph / 2, pz, heading), stone:Lerp(Color3.new(0, 0, 0), 0.2), Enum.Material.Slate)
	end
end

local LABEL_MAX_K = 2.0 -- largest camera-height scale applied in updateLabels
local LABEL_MAX_RISE = 5 -- studs of terrain rise tolerated under a plate before it is shortened

-- Highest ground under a plate of half-length `hl` (world X) and half-depth `hd` (world Z).
local function maxGroundUnder(x: number, z: number, hl: number, hd: number): (number, number)
	local hi, lo = -math.huge, math.huge
	for i = -6, 6 do
		for j = -1, 1 do
			local h = groundY(x + hl * i / 6, z + hd * j)
			hi = math.max(hi, h)
			lo = math.min(lo, h)
		end
	end
	return hi, lo
end

local function buildLabel(parent: Instance, l: any)
	local size = 20 * l.size -- modest, mixed case, cream serif
	-- Shorten the plate on steep ground (it clipped at the ends on slopes in Studio), then lift it
	-- above the highest terrain under its largest scaled footprint.
	local len = size * 4
	local hi, lo = maxGroundUnder(l.pos.x, l.pos.z, len * LABEL_MAX_K / 2, size * LABEL_MAX_K / 2)
	while hi - lo > LABEL_MAX_RISE and len > size * 2.2 do
		len *= 0.85
		hi, lo = maxGroundUnder(l.pos.x, l.pos.z, len * LABEL_MAX_K / 2, size * LABEL_MAX_K / 2)
	end
	local y = hi
	-- A Top-face gui runs its text along the part's -Z (checked in Studio), so the plate is long
	-- in Z and turned 90° to read left-to-right from the default north-facing camera.
	local p = part(parent, nil, Vector3.new(size, 0.2, len), CFrame.new(l.pos.x, y + 0.5, l.pos.z) * CFrame.Angles(0, math.pi / 2, 0), Color3.new(1, 1, 1))
	p.Transparency = 1
	p.CastShadow = false
	local gui = Instance.new("SurfaceGui") :: SurfaceGui
	gui.Face = Enum.NormalId.Top
	gui.CanvasSize = Vector2.new(400, 100) -- TextScaled stops at 100 px, so the canvas is 100 tall
	gui.LightInfluence = 0
	gui.AlwaysOnTop = false
	gui.Parent = p
	local text = Instance.new("TextLabel") :: TextLabel
	text.Size = UDim2.fromScale(1, 1)
	text.BackgroundTransparency = 1
	text.Font = Enum.Font.Garamond
	text.TextScaled = true
	text.Text = l.text
	text.TextColor3 = rgb(P.Cream)
	text.TextTransparency = 0.4
	text.Parent = gui
	table.insert(labelParts, { part = p, size = size, len = len })
end

local function buildObjective(parent: Instance, o: any)
	local y = groundY(o.pos.x, o.pos.z)
	local ring: { Part } = {}
	local n = 20
	local r = o.radius
	for i = 1, n do
		local a0 = (i - 1) / n * math.pi * 2
		local a1 = i / n * math.pi * 2
		local x0, z0 = o.pos.x + math.cos(a0) * r, o.pos.z + math.sin(a0) * r
		local x1, z1 = o.pos.x + math.cos(a1) * r, o.pos.z + math.sin(a1) * r
		local mx, mz = (x0 + x1) / 2, (z0 + z1) / 2
		local seg = part(parent, nil, Vector3.new(Vec.dist({ x = x0, z = z0 }, { x = x1, z = z1 }) + 0.4, 0.3, 1.2), yaw(mx, groundY(mx, mz) + 0.4, mz, math.atan2(z1 - z0, x1 - x0)), rgb(P.Cream))
		seg.Transparency = 0.5
		seg.CastShadow = false
		ring[i] = seg
	end
	part(parent, Enum.PartType.Cylinder, Vector3.new(22, 0.5, 0.5), CFrame.new(o.pos.x, y + 11, o.pos.z) * CFrame.Angles(0, 0, math.pi / 2), rgb(P.Ink))
	local flag = part(parent, nil, Vector3.new(7, 4.5, 0.3), CFrame.new(o.pos.x + 3.7, y + 19.5, o.pos.z), rgb(P.Cream))
	flag.CastShadow = false
	objectiveMarks[o.id] = { ring = ring, flag = flag }
end

-- Builds everything for a map. Yields. Returns false when superseded by clear()/rebuild.
function Props.build(map: any, quality: number, onProgress: ((fraction: number) -> ())?): boolean
	Props.clear()
	generation += 1
	local myGen = generation
	currentMap = map
	local f = Instance.new("Folder") :: Folder
	f.Name = "EoEProps"
	f.Parent = workspace
	folder = f
	local q = math.clamp(quality, 1, 3)
	local threshold = TREE_PRIORITY[q]
	local crowns = CROWNS[q]

	local jobs: { () -> () } = {}
	for _, w in map.woods do
		for _, t in w.trees do
			if t.priority >= threshold then
				table.insert(jobs, function()
					buildTree(f, t, crowns)
				end)
			end
		end
	end
	for _, v in map.villages do
		for _, b in v.buildings do
			table.insert(jobs, function()
				buildBuilding(f, b)
			end)
		end
	end
	for _, br in map.bridges do
		table.insert(jobs, function()
			buildBridge(f, br)
		end)
	end
	for _, l in map.labels do
		table.insert(jobs, function()
			buildLabel(f, l)
		end)
	end
	for _, o in map.objectives do
		table.insert(jobs, function()
			buildObjective(f, o)
		end)
	end
	local total = #jobs
	for i, job in jobs do
		if generation ~= myGen then
			return false
		end
		job()
		if i % 120 == 0 then
			if onProgress then
				onProgress(i / total)
			end
			task.wait()
		end
	end
	if onProgress then
		onProgress(1)
	end
	return generation == myGen
end

-- Ground labels grow with camera height so they stay readable from any zoom.
local lastLabelK = -1
function Props.updateLabels(cameraHeight: number)
	local k = math.clamp(cameraHeight / 420, 0.7, LABEL_MAX_K)
	if math.abs(k - lastLabelK) < 0.05 then
		return
	end
	lastLabelK = k
	for _, l in labelParts do
		l.part.Size = Vector3.new(l.size * k, 0.2, l.len * k)
	end
end

local function factionColour(faction: string?): Color3
	if faction == nil or faction == "" then
		return rgb(P.Cream)
	end
	return Factions.colour(faction)
end

function Props.updateObjectives(objectives: { any })
	for _, o in objectives do
		local m = objectiveMarks[o.id]
		if m then
			local c = factionColour(o.owner)
			m.flag.Color = c
			local ringC = if o.contested then rgb(P.Hostile) else c
			local t = if o.contested then 0.2 else 0.55
			for _, seg in m.ring do
				seg.Color = ringC
				seg.Transparency = t
			end
		end
	end
end

-- Rect {x0,z0,x1,z1} or nil to hide. Translucent wall segments following the terrain.
function Props.setDeployZone(rect: any?, faction: string?)
	if zoneFolder then
		zoneFolder:Destroy()
		zoneFolder = nil
	end
	if not rect or not currentMap then
		return
	end
	local zf = Instance.new("Folder") :: Folder
	zf.Name = "EoEDeployZone"
	zf.Parent = workspace
	zoneFolder = zf
	local c = factionColour(faction)
	local step = 32
	local function edge(ax: number, az: number, bx: number, bz: number)
		local len = Vec.dist({ x = ax, z = az }, { x = bx, z = bz })
		local n = math.max(1, math.ceil(len / step))
		local heading = math.atan2(bz - az, bx - ax)
		for i = 1, n do
			local t0, t1 = (i - 1) / n, i / n
			local mx = ax + (bx - ax) * (t0 + t1) / 2
			local mz = az + (bz - az) * (t0 + t1) / 2
			local seg = part(zf, nil, Vector3.new(len / n + 0.5, 6, 0.6), yaw(mx, groundY(mx, mz) + 3, mz, heading), c)
			seg.Transparency = 0.65
			seg.CastShadow = false
		end
	end
	edge(rect.x0, rect.z0, rect.x1, rect.z0)
	edge(rect.x1, rect.z0, rect.x1, rect.z1)
	edge(rect.x1, rect.z1, rect.x0, rect.z1)
	edge(rect.x0, rect.z1, rect.x0, rect.z0)
end

function Props.clear()
	generation += 1
	if folder then
		folder:Destroy()
		folder = nil
	end
	if zoneFolder then
		zoneFolder:Destroy()
		zoneFolder = nil
	end
	table.clear(labelParts)
	lastLabelK = -1
	table.clear(objectiveMarks)
end

return Props
]]></ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX00000061"><Properties><bool name="Disabled">false</bool><string name="Name">Soldiers</string><ProtectedString name="Source"><![CDATA[--!strict
-- Near-LOD figure builders: NTW-style silhouettes from plain parts (no meshes, no asset ids).
-- Builders call `add(part, localCFrame, anim, pivot)`; Figures parents, places and animates.
-- Local frame: +X forward, +Y up, +Z right; origin on the ground under the figure. ~3.2 studs tall.
--
-- anim codes: 0 static · 1/2 leg (opposite phases, swing about the hip at `pivot`)
--             3 musket chain (lc is an offset along the musket; pose by state)
--             4/5 horse leg (diagonal pairs, swing about the shoulder at `pivot`)

local Factions = require(script.Parent.Parent.Factions)

local Soldiers = {}

export type Add = (p: BasePart, cf: CFrame, anim: number, pivot: number) -> ()

local INK = Color3.fromRGB(32, 30, 28)
local SKIN = Color3.fromRGB(214, 180, 140)
local WHITE = Color3.fromRGB(236, 234, 226)
local WOOD = Color3.fromRGB(92, 64, 40)
local DARK_WOOD = Color3.fromRGB(64, 46, 32)
local STEEL = Color3.fromRGB(176, 180, 186)
local BRONZE = Color3.fromRGB(150, 112, 62)
local HORSES = { Color3.fromRGB(96, 66, 44), Color3.fromRGB(70, 48, 34), Color3.fromRGB(120, 90, 60), Color3.fromRGB(46, 38, 34) }
local FUR = Color3.fromRGB(52, 40, 32)
local RED = Color3.fromRGB(176, 40, 44)
local GOLD = Color3.fromRGB(205, 168, 62)

local TROUSERS: { [string]: Color3 } = {
	france = Color3.fromRGB(226, 222, 208),
	prussia = Color3.fromRGB(214, 210, 198),
	britain = Color3.fromRGB(98, 100, 108),
	russia = Color3.fromRGB(220, 218, 206),
	austria = Color3.fromRGB(224, 222, 214),
}

-- Musket poses: shouldered (slanted at the right shoulder) and levelled (firing / charging).
local SHOULDER = CFrame.new(0.02, 1.95, 0.4) * CFrame.Angles(0, 0, math.rad(8))
local LEVEL = CFrame.new(0.75, 1.85, 0.22) * CFrame.Angles(0, 0, math.rad(-90))

local function mk(size: Vector3, color: Color3, className: string?): BasePart
	local p = Instance.new(className or "Part") :: BasePart
	p.Size = size
	p.Color = color
	p.Material = Enum.Material.SmoothPlastic
	p.Anchored = true
	p.CanCollide = false
	p.CanTouch = false
	p.CanQuery = false
	p.CastShadow = true
	p.TopSurface = Enum.SurfaceType.Smooth
	p.BottomSurface = Enum.SurfaceType.Smooth
	return p
end

local function ball(d: number, color: Color3): BasePart
	local p = mk(Vector3.new(d, d, d), color) :: Part
	p.Shape = Enum.PartType.Ball
	return p
end

-- Cylinder whose axis is local X (Roblox default); callers rotate as needed.
local function cyl(length: number, radius: number, color: Color3): BasePart
	local p = mk(Vector3.new(length, radius * 2, radius * 2), color) :: Part
	p.Shape = Enum.PartType.Cylinder
	return p
end

local function steel(p: BasePart): BasePart
	p.Material = Enum.Material.Metal
	return p
end

-- Pose for an animated part. swing in radians; armed = muskets levelled.
function Soldiers.partCFrame(anim: number, lc: CFrame, pivot: number, swing: number, armed: boolean): CFrame
	if anim == 1 or anim == 2 or anim == 4 or anim == 5 then
		if swing == 0 then
			return lc
		end
		local a = if anim == 1 or anim == 4 then swing else -swing
		local p = lc.Position
		return CFrame.new(p.X, pivot, p.Z) * CFrame.Angles(0, 0, a) * CFrame.new(0, p.Y - pivot, 0)
	elseif anim == 3 then
		return (if armed then LEVEL else SHOULDER) * lc
	end
	return lc
end

-- ------------------------------------------------------------------ headgear

local function headgear(add: Add, faction: string, y: number, detail: boolean)
	if faction == "britain" then
		add(mk(Vector3.new(0.4, 0.62, 0.4), INK), CFrame.new(0, y + 0.1, 0), 0, 0) -- stovepipe
		if detail then
			add(mk(Vector3.new(0.07, 0.24, 0.07), WHITE), CFrame.new(0.14, y + 0.5, 0), 0, 0)
		end
	elseif faction == "russia" then
		add(mk(Vector3.new(0.42, 0.44, 0.42), INK), CFrame.new(0, y, 0), 0, 0) -- kiwer
		add(mk(Vector3.new(0.56, 0.08, 0.56), INK), CFrame.new(0, y + 0.25, 0), 0, 0)
		if detail then
			add(mk(Vector3.new(0.05, 0.18, 0.2), GOLD), CFrame.new(0.22, y, 0), 0, 0)
		end
	else
		add(mk(Vector3.new(0.42, 0.48, 0.42), INK), CFrame.new(0, y + 0.02, 0), 0, 0) -- shako
		if detail then
			if faction == "france" then
				add(mk(Vector3.new(0.08, 0.32, 0.08), RED), CFrame.new(0.12, y + 0.42, 0), 0, 0) -- plume
			elseif faction == "austria" then
				add(ball(0.15, GOLD), CFrame.new(0.18, y + 0.26, 0), 0, 0)
			else
				add(ball(0.14, WHITE), CFrame.new(0.18, y + 0.26, 0), 0, 0) -- pompom
			end
		end
	end
end

-- ------------------------------------------------------------------ flag

-- Flag in the local X-Y plane, hoist at x = 0, flying toward -X.
function Soldiers.flag(add: Add, faction: string, origin: CFrame, w: number, h: number)
	local design = Factions.flag(faction)
	local bands = design.bands
	if bands then
		local n = #bands
		for i, c in bands do
			add(mk(Vector3.new(w / n, h, 0.05), c), origin * CFrame.new(-(i - 0.5) * w / n, 0, 0), 0, 0)
		end
	else
		add(mk(Vector3.new(w, h, 0.05), design.field or WHITE), origin * CFrame.new(-w / 2, 0, 0), 0, 0)
	end
	local c = origin * CFrame.new(-w / 2, 0, 0)
	local mc = design.markColour
	local t = 0.08
	if design.mark == "diamond" then
		add(mk(Vector3.new(h * 0.32, h * 0.32, t), mc), c * CFrame.Angles(0, 0, math.rad(45)), 0, 0)
	elseif design.mark == "x" then
		for _, a in { 35, -35 } do
			add(mk(Vector3.new(w * 1.15, h * 0.12, t), mc), c * CFrame.Angles(0, 0, math.rad(a)), 0, 0)
		end
	elseif design.mark == "plus" then
		add(mk(Vector3.new(w, h * 0.16, t), mc), c, 0, 0)
		add(mk(Vector3.new(w * 0.12, h, t), mc), c, 0, 0)
	elseif design.mark == "double" then
		add(mk(Vector3.new(w, h * 0.1, t), mc), c * CFrame.new(0, h * 0.18, 0), 0, 0)
		add(mk(Vector3.new(w, h * 0.1, t), mc), c * CFrame.new(0, -h * 0.18, 0), 0, 0)
	elseif design.mark == "diagonal" then
		add(mk(Vector3.new(w * 1.15, h * 0.12, t), mc), c * CFrame.Angles(0, 0, math.rad(35)), 0, 0)
	end
end

-- ------------------------------------------------------------------ infantry

export type InfantryRole = "line" | "colour" | "drummer"

function Soldiers.infantry(add: Add, faction: string, coat: Color3, detail: boolean, role: InfantryRole)
	local legs = TROUSERS[faction] or Color3.fromRGB(150, 148, 140)
	add(mk(Vector3.new(0.3, 1.1, 0.26), legs), CFrame.new(0, 0.55, -0.16), 1, 1.1)
	add(mk(Vector3.new(0.3, 1.1, 0.26), legs), CFrame.new(0, 0.55, 0.16), 2, 1.1)
	add(mk(Vector3.new(0.42, 1.05, 0.66), coat), CFrame.new(0, 1.6, 0), 0, 0)
	if detail then
		-- white cross-belts over the coat front
		add(mk(Vector3.new(0.05, 1.15, 0.09), WHITE), CFrame.new(0.22, 1.6, 0) * CFrame.Angles(0.6, 0, 0), 0, 0)
		add(mk(Vector3.new(0.05, 1.15, 0.09), WHITE), CFrame.new(0.22, 1.6, 0) * CFrame.Angles(-0.6, 0, 0), 0, 0)
	end
	add(ball(0.46, SKIN), CFrame.new(0, 2.38, 0), 0, 0)
	headgear(add, faction, 2.82, detail)
	if role == "line" then
		add(mk(Vector3.new(0.08, 1.7, 0.08), WOOD), CFrame.new(), 3, 0)
		if detail then
			add(steel(mk(Vector3.new(0.04, 0.4, 0.04), STEEL)), CFrame.new(0, 1.03, 0), 3, 0)
		end
	elseif role == "colour" then
		add(mk(Vector3.new(0.07, 4.2, 0.07), DARK_WOOD), CFrame.new(0.05, 2.1, 0.35), 0, 0)
		add(ball(0.16, GOLD), CFrame.new(0.05, 4.25, 0.35), 0, 0)
		Soldiers.flag(add, faction, CFrame.new(0.02, 3.55, 0.35), 1.5, 1.1)
	elseif role == "drummer" then
		add(cyl(0.42, 0.3, WHITE), CFrame.new(0.32, 1.25, 0.12) * CFrame.Angles(0, 0, math.pi / 2), 0, 0)
		add(cyl(0.44, 0.31, coat), CFrame.new(0.32, 1.25, 0.12) * CFrame.Angles(0, 0, math.pi / 2), 0, 0)
	end
end

-- ------------------------------------------------------------------ cavalry

export type RiderKind = "cuirassier" | "hussar" | "trooper" | "officer"

function Soldiers.riderKind(name: string?): RiderKind
	local n = string.lower(name or "")
	if string.find(n, "cuirass", 1, true) or string.find(n, "kürass", 1, true) or string.find(n, "kurass", 1, true) then
		return "cuirassier"
	elseif string.find(n, "hussar", 1, true) or string.find(n, "husar", 1, true) then
		return "hussar"
	end
	return "trooper"
end

-- Horse alone (also used for limber teams). `seed` picks a coat colour.
function Soldiers.horse(add: Add, origin: CFrame, seed: number, cloth: Color3?)
	local hide = HORSES[seed % #HORSES + 1]
	add(mk(Vector3.new(2.0, 0.85, 0.75), hide), origin * CFrame.new(0, 1.55, 0), 0, 0)
	add(mk(Vector3.new(0.45, 0.95, 0.4), hide), origin * CFrame.new(0.95, 2.1, 0) * CFrame.Angles(0, 0, math.rad(-35)), 0, 0)
	add(mk(Vector3.new(0.75, 0.36, 0.34), hide), origin * CFrame.new(1.38, 2.5, 0) * CFrame.Angles(0, 0, math.rad(-25)), 0, 0)
	add(mk(Vector3.new(0.5, 0.12, 0.12), INK), origin * CFrame.new(-1.05, 1.6, 0) * CFrame.Angles(0, 0, math.rad(60)), 0, 0) -- tail
	for _, l in { { 0.75, -0.25, 4 }, { 0.75, 0.25, 5 }, { -0.75, -0.25, 5 }, { -0.75, 0.25, 4 } } do
		add(mk(Vector3.new(0.18, 1.15, 0.18), hide), origin * CFrame.new(l[1], 0.58, l[2]), l[3], 1.15)
	end
	if cloth then
		add(mk(Vector3.new(0.95, 0.1, 0.98), cloth), origin * CFrame.new(-0.1, 2.0, 0), 0, 0)
	end
end

function Soldiers.rider(add: Add, faction: string, coat: Color3, kind: RiderKind, detail: boolean, seed: number)
	Soldiers.horse(add, CFrame.new(), seed, if detail then coat else nil)
	local legs = TROUSERS[faction] or Color3.fromRGB(150, 148, 140)
	add(mk(Vector3.new(0.35, 0.6, 0.9), legs), CFrame.new(-0.05, 2.0, 0), 0, 0)
	add(mk(Vector3.new(0.4, 0.85, 0.58), coat), CFrame.new(-0.05, 2.65, 0), 0, 0)
	add(ball(0.42, SKIN), CFrame.new(-0.05, 3.3, 0), 0, 0)
	if kind == "cuirassier" then
		add(steel(mk(Vector3.new(0.46, 0.55, 0.62), STEEL)), CFrame.new(-0.03, 2.78, 0), 0, 0)
		add(steel(ball(0.48, STEEL)), CFrame.new(-0.05, 3.4, 0), 0, 0)
		if detail then
			add(mk(Vector3.new(0.6, 0.14, 0.1), INK), CFrame.new(-0.12, 3.66, 0), 0, 0) -- crest
		end
	elseif kind == "hussar" then
		add(mk(Vector3.new(0.42, 0.48, 0.42), FUR), CFrame.new(-0.05, 3.7, 0), 0, 0) -- busby
		if detail then
			add(mk(Vector3.new(0.1, 0.3, 0.12), RED), CFrame.new(-0.24, 3.62, 0.14), 0, 0)
		end
	elseif kind == "officer" then
		add(mk(Vector3.new(0.32, 0.28, 0.95), INK), CFrame.new(-0.05, 3.58, 0), 0, 0) -- bicorne
		if detail then
			add(mk(Vector3.new(0.05, 0.2, 0.2), WHITE), CFrame.new(0.12, 3.62, 0.2), 0, 0)
		end
	else
		add(mk(Vector3.new(0.4, 0.45, 0.4), INK), CFrame.new(-0.05, 3.7, 0), 0, 0)
	end
	if detail and kind ~= "officer" then
		-- sabre at the shoulder
		add(steel(mk(Vector3.new(0.05, 1.1, 0.05), STEEL)), CFrame.new(0.15, 3.15, 0.36) * CFrame.Angles(0, 0, math.rad(20)), 0, 0)
	end
end

-- ------------------------------------------------------------------ artillery

local function gunner(add: Add, faction: string, coat: Color3, at: CFrame)
	local legs = TROUSERS[faction] or Color3.fromRGB(150, 148, 140)
	add(mk(Vector3.new(0.3, 1.1, 0.5), legs), at * CFrame.new(0, 0.55, 0), 0, 0)
	add(mk(Vector3.new(0.42, 1.05, 0.62), coat), at * CFrame.new(0, 1.6, 0), 0, 0)
	add(ball(0.44, SKIN), at * CFrame.new(0, 2.36, 0), 0, 0)
	add(mk(Vector3.new(0.4, 0.4, 0.4), INK), at * CFrame.new(0, 2.76, 0), 0, 0)
end

-- One gun on a two-wheeled carriage with trail, crew of 4; limbered: hooked to a limber
-- with a two-horse team, crew walking alongside.
function Soldiers.gun(add: Add, faction: string, coat: Color3, limbered: boolean, detail: boolean, seed: number)
	local g = if limbered then CFrame.new(-1.4, 0, 0) * CFrame.Angles(0, math.pi, 0) else CFrame.new()
	for side = -1, 1, 2 do
		add(cyl(0.22, 0.75, DARK_WOOD), g * CFrame.new(0, 0.75, side * 0.7) * CFrame.Angles(0, math.pi / 2, 0), 0, 0)
	end
	add(mk(Vector3.new(0.15, 0.15, 1.3), DARK_WOOD), g * CFrame.new(0, 0.75, 0), 0, 0)
	add(mk(Vector3.new(1.95, 0.22, 0.32), WOOD), g * CFrame.new(-0.95, 0.43, 0) * CFrame.Angles(0, 0, math.rad(19)), 0, 0)
	add(steel(cyl(2.3, 0.17, if faction == "france" then BRONZE else Color3.fromRGB(70, 70, 66))), g * CFrame.new(0.45, 1.05, 0) * CFrame.Angles(0, 0, math.rad(4)), 0, 0)
	if limbered then
		for side = -1, 1, 2 do
			add(cyl(0.2, 0.65, DARK_WOOD), CFrame.new(1.0, 0.65, side * 0.65) * CFrame.Angles(0, math.pi / 2, 0), 0, 0)
		end
		add(mk(Vector3.new(1.0, 0.55, 1.0), WOOD), CFrame.new(1.0, 1.2, 0), 0, 0)
		if detail then
			add(mk(Vector3.new(2.6, 0.12, 0.12), DARK_WOOD), CFrame.new(2.6, 0.95, 0), 0, 0)
		end
		Soldiers.horse(add, CFrame.new(3.6, 0, -0.55), seed, nil)
		Soldiers.horse(add, CFrame.new(3.6, 0, 0.55), seed + 1, nil)
		for _, p in { { 0.2, -1.6 }, { 0.2, 1.6 }, { -1.8, -1.5 }, { -1.8, 1.5 } } do
			gunner(add, faction, coat, CFrame.new(p[1], 0, p[2]))
		end
	else
		for _, p in { { -1.7, -1.1 }, { -1.7, 1.1 }, { 0.3, -1.45 }, { 0.3, 1.45 } } do
			gunner(add, faction, coat, CFrame.new(p[1], 0, p[2]))
		end
	end
end

return Soldiers
]]></ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX00000062"><Properties><bool name="Disabled">false</bool><string name="Name">Terrain</string><ProtectedString name="Source"><![CDATA[--!strict
-- Writes the MapGen heightmap into workspace.Terrain as 4-stud voxels, chunk by chunk,
-- yielding between chunks. Everything comes from MapData; nothing is authored here.

local Shared = game:GetService("ReplicatedStorage"):WaitForChild("EoE")
local Config = require(Shared.Config)
local Vec = require(Shared.Vec)

local Terrain = {}

local IDS = Config.TerrainIds
local VOXEL = 4
local CHUNK = 32 -- columns per chunk side
local CHUNKS_PER_YIELD = 2

local generation = 0
local pickPlane: Part? = nil
local bounds: { minY: number, maxY: number } = { minY = 0, maxY = 0 }

local function rgb(t: { number }): Color3
	return Color3.fromRGB(t[1], t[2], t[3])
end

local function materialFor(cls: number, isBank: boolean): EnumMaterial
	if cls == IDS.woods then
		return Enum.Material.LeafyGrass
	elseif cls == IDS.village then
		return Enum.Material.Ground
	elseif cls == IDS.road then
		return Enum.Material.Mud -- flat and smooth; Cobblestone read as rubble walls in Studio
	elseif cls == IDS.steep then
		return Enum.Material.Ground
	elseif cls == IDS.cliff then
		return Enum.Material.Rock
	elseif isBank then
		return Enum.Material.Sand
	end
	return Enum.Material.Grass
end

local function applyPalette()
	local P = Config.Visual.Palette
	local t = workspace.Terrain
	-- Studio showed the palette olive reading brown under warm low light; these are tuned with
	-- World/Lighting (ClockTime 10.2) toward the reference's olive-gold and green.
	t:SetMaterialColor(Enum.Material.Grass, Color3.fromRGB(150, 150, 70)) -- olive-gold on lit plateaus
	t:SetMaterialColor(Enum.Material.LeafyGrass, Color3.fromRGB(58, 78, 38))
	t:SetMaterialColor(Enum.Material.Ground, Color3.fromRGB(120, 104, 62)) -- slopes: darker olive-brown
	t:SetMaterialColor(Enum.Material.Rock, Color3.fromRGB(104, 94, 76))
	t:SetMaterialColor(Enum.Material.Mud, Color3.fromRGB(190, 176, 138)) -- roads: thin pale lines
	t:SetMaterialColor(Enum.Material.Sand, rgb(P.Bank))
	t.WaterColor = rgb(P.Water)
	t.WaterTransparency = 0.35
	t.WaterWaveSize = 0.05
	t.WaterWaveSpeed = 4
	t.WaterReflectance = 0.2
end

-- Water surface level for a cell, or nil when the cell is not inside a river channel.
local function waterLevelAt(map: any, x: number, z: number): number?
	local best: number? = nil
	for _, river in map.rivers do
		local pts = river.points
		local half = river.width / 2 + 1
		for i = 1, #pts - 1 do
			if Vec.distToSegment({ x = x, z = z }, pts[i], pts[i + 1]) < half then
				if best == nil or river.level > best then
					best = river.level
				end
				break
			end
		end
	end
	return best
end

-- Precompute per-cell water level and bank flags (cheap: only water/bridge cells scan rivers).
local function analyse(map: any): ({ [number]: number }, { [number]: boolean })
	local g = map.grid
	local cols, rows = g.cols, g.rows
	local water: { [number]: number } = {}
	local bank: { [number]: boolean } = {}
	for cz = 0, rows - 1 do
		for cx = 0, cols - 1 do
			local idx = cz * cols + cx + 1
			local cls = g.class[idx]
			if cls == IDS.water or cls == IDS.bridge then
				local c = { x = (cx + 0.5) * g.cell, z = (cz + 0.5) * g.cell }
				local lvl = waterLevelAt(map, c.x, c.z)
				if lvl then
					water[idx] = lvl
					if cls == IDS.water then
						for dz = -2, 2 do
							for dx = -2, 2 do
								local nx, nz = cx + dx, cz + dz
								if nx >= 0 and nz >= 0 and nx < cols and nz < rows then
									local j = nz * cols + nx + 1
									if g.class[j] == IDS.open then
										bank[j] = true
									end
								end
							end
						end
					end
				end
			end
		end
	end
	return water, bank
end

local function ensurePickPlane(map: any, minY: number)
	if pickPlane then
		pickPlane:Destroy()
	end
	local p = Instance.new("Part") :: Part
	p.Name = "EoEPickPlane"
	p.Anchored = true
	p.CanCollide = false
	p.CanTouch = false
	p.CanQuery = true
	p.Transparency = 1
	p.CastShadow = false
	p.Size = Vector3.new(map.width + 4000, 1, map.depth + 4000)
	p.CFrame = CFrame.new(map.width / 2, minY - 1, map.depth / 2)
	p.Parent = workspace
	pickPlane = p
end

function Terrain.pickPlane(): Part?
	return pickPlane
end

function Terrain.bounds()
	return bounds
end

-- Builds the whole map. Yields. Returns false if cleared/superseded mid-build.
function Terrain.build(map: any, onProgress: ((fraction: number) -> ())?): boolean
	generation += 1
	local myGen = generation
	local terrain = workspace.Terrain
	terrain:Clear()
	applyPalette()

	local g = map.grid
	local cols, rows = g.cols, g.rows
	local minH, maxH = math.huge, -math.huge
	for i = 1, cols * rows do
		local h = g.height[i]
		if h < minH then
			minH = h
		end
		if h > maxH then
			maxH = h
		end
	end
	local water, bank = analyse(map)
	for _, lvl in water do
		if lvl > maxH then
			maxH = lvl
		end
	end
	local y0 = math.floor((minH - 8) / VOXEL) * VOXEL
	local y1 = math.ceil((maxH + 4) / VOXEL) * VOXEL
	local ny = (y1 - y0) // VOXEL
	bounds = { minY = y0, maxY = y1 }
	ensurePickPlane(map, minH)

	local AIR = Enum.Material.Air
	local WATER = Enum.Material.Water
	local nChunksX = math.ceil(cols / CHUNK)
	local nChunksZ = math.ceil(rows / CHUNK)
	local total = nChunksX * nChunksZ
	local done = 0

	for chz = 0, nChunksZ - 1 do
		for chx = 0, nChunksX - 1 do
			if generation ~= myGen then
				return false
			end
			local cx0 = chx * CHUNK
			local cz0 = chz * CHUNK
			local nx = math.min(CHUNK, cols - cx0)
			local nz = math.min(CHUNK, rows - cz0)
			local mats: { { { EnumMaterial } } } = {}
			local occs: { { { number } } } = {}
			for ix = 1, nx do
				local mx: { { EnumMaterial } } = {}
				local ox: { { number } } = {}
				mats[ix] = mx
				occs[ix] = ox
				for iy = 1, ny do
					mx[iy] = table.create(nz, AIR)
					ox[iy] = table.create(nz, 0)
				end
			end
			for iz = 1, nz do
				local cz = cz0 + iz - 1
				for ix = 1, nx do
					local cx = cx0 + ix - 1
					local idx = cz * cols + cx + 1
					local cls = g.class[idx]
					local lvl = water[idx]
					-- a bridge cell carries the deck height; its voxels are the river bed beneath
					local h = if cls == IDS.bridge and lvl ~= nil then lvl - 3 else g.height[idx]
					local mat = materialFor(cls, bank[idx] == true)
					for iy = 1, ny do
						-- + half a voxel: Roblox draws the surface VOXEL/2 above a linear fill (measured
						-- in Studio: +2.0 everywhere), and props/figures sit on Grid.heightAt
						local yBase = y0 + (iy - 1) * VOXEL + VOXEL / 2
						local groundOcc = math.clamp((h - yBase) / VOXEL, 0, 1)
						if lvl ~= nil then
							-- river bed below, water column up to the surface level
							local waterOcc = math.clamp((lvl - yBase) / VOXEL, 0, 1)
							if groundOcc > 0.5 then
								mats[ix][iy][iz] = Enum.Material.Sand
								occs[ix][iy][iz] = groundOcc
							elseif waterOcc > 0 then
								mats[ix][iy][iz] = WATER
								occs[ix][iy][iz] = waterOcc
							end
						elseif groundOcc > 0 then
							mats[ix][iy][iz] = mat
							occs[ix][iy][iz] = groundOcc
						end
					end
				end
			end
			local region = Region3.new(
				Vector3.new(cx0 * VOXEL, y0, cz0 * VOXEL),
				Vector3.new((cx0 + nx) * VOXEL, y1, (cz0 + nz) * VOXEL)
			)
			terrain:WriteVoxels(region, VOXEL, mats, occs)
			done += 1
			if onProgress then
				onProgress(done / total)
			end
			if done % CHUNKS_PER_YIELD == 0 then
				task.wait()
			end
		end
	end
	return generation == myGen
end

function Terrain.clear()
	generation += 1
	workspace.Terrain:Clear()
	if pickPlane then
		pickPlane:Destroy()
		pickPlane = nil
	end
end

return Terrain
]]></ProtectedString></Properties></Item></Item></Item></Item></Item><Item class="Players" referent="RBX00000067"><Properties><string name="Name">Players</string><bool name="CharacterAutoLoads">false</bool></Properties></Item><Item class="Workspace" referent="RBX00000068"><Properties><string name="Name">Workspace</string><bool name="StreamingEnabled">false</bool></Properties></Item><Item class="Lighting" referent="RBX00000069"><Properties><string name="Name">Lighting</string><float name="ClockTime">9.5</float><float name="Brightness">2.2</float><bool name="GlobalShadows">true</bool><float name="EnvironmentDiffuseScale">0.6</float><float name="EnvironmentSpecularScale">0.4</float></Properties></Item></roblox>