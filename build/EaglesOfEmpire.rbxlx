<roblox xmlns:xmime="http://www.w3.org/2005/05/xmlmime" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="http://www.roblox.com/roblox.xsd" version="4"><Meta name="ExplicitAutoJoints">true</Meta><External>null</External><External>nil</External><Item class="ReplicatedStorage" referent="RBX00000017"><Properties><string name="Name">ReplicatedStorage</string></Properties><Item class="Folder" referent="RBX00000016"><Properties><string name="Name">EoE</string></Properties><Item class="ModuleScript" referent="RBX00000001"><Properties><bool name="Disabled">false</bool><string name="Name">Assets</string><ProtectedString name="Source"><![CDATA[--!strict
-- Named slots for Creator Store assets (no ids are checked in). A slot with a mesh id makes
-- the client build that object as one Part with a SpecialMesh (FileMesh) instead of the part
-- assembly; an empty slot keeps the procedural build. Fill `mesh`/`texture` with
-- "rbxassetid://<id>" and set `scale` so the mesh fits the figure's studs (the Studio session
-- does this from the asset's native size). Add keys only; both the figures (Soldiers) and
-- the world (Props/WorldGen) read this table.

export type Slot = {
	mesh: string, -- "rbxassetid://..." or ""
	texture: string,
	scale: { number }, -- SpecialMesh.Scale (x, y, z)
	offset: { number }, -- SpecialMesh.Offset (x, y, z), studs
	native: { number }?, -- the mesh's own size in studs (Studio shows it on import); world meshes are
	-- then fitted to each object's box, so one oak mesh serves every oak size
}

local function slot(texture: string?): Slot
	return { mesh = "", texture = texture or "", scale = { 1, 1, 1 }, offset = { 0, 0, 0 } }
end

local Assets = {}

-- Figures (Soldiers.luau): one mesh per figure, origin on the ground, facing +X, sized in studs.
Assets.slots = {
	soldierInfantry = slot(), -- a standing musketeer ~3.2 studs tall
	soldierCavalry = slot(), -- horse and rider ~4 studs tall, 3.6 long
	horse = slot(), -- a horse alone (limber teams)
	gun = slot(), -- field gun on its carriage, muzzle toward +X
	limber = slot(), -- limber with its chest
	shako = slot(), -- headgear swaps, worn on top of the procedural head
	bearskin = slot(),
	helmet = slot(),
	-- World (WorldGen): one mesh per object, origin on the ground, facing +X (the road side),
	-- scaled to the procedural object's bounds given in WorldGen's meshObject calls.
	treeOak = { -- original 848-triangle oak; native bounds 12 x 13 x 12 studs
		mesh = "rbxassetid://73559467519799",
		texture = "rbxassetid://139915483990126",
		scale = { 1, 1, 1 },
		offset = { 0, 0, 0 },
		native = { 12, 13, 12 },
	},
	treeBeech = { -- original 600-triangle beech; native bounds confirmed in Studio
		mesh = "rbxassetid://112134639390683",
		texture = "rbxassetid://107894282230802",
		scale = { 1, 1, 1 },
		offset = { 0, 0, 0 },
		native = { 10, 16, 10 },
	},
	treePine = { -- original 444-triangle pine; native bounds confirmed in Studio
		mesh = "rbxassetid://82857667018871",
		texture = "rbxassetid://130754173408547",
		scale = { 1, 1, 1 },
		offset = { 0, 0, 0 },
		native = { 8, 18, 8 },
	},
	treePoplar = { -- original 200-triangle poplar; native bounds confirmed in Studio
		mesh = "rbxassetid://140076983958671",
		texture = "rbxassetid://130600435597827",
		scale = { 1, 1, 1 },
		offset = { 0, 0, 0 },
		native = { 4, 16, 4 },
	},
	treeWillow = slot(),
	houseA = slot(), -- cottage ~5 x 5 footprint, 2.6 eaves, gable ridge along +X
	houseB = slot(),
	houseC = slot(),
	barn = slot(),
	church = slot(), -- nave 13 long with a west tower, ~22 tall
	windmill = slot(), -- post mill ~20 tall
	bridgeStone = slot(), -- deck along +X, length = the span given
	bridgeTimber = slot(),
	-- World textures (Texture instances on part faces; `texture` only, mesh stays "")
	-- image ids (not the store's decal ids), free on the Creator Store, picked in Studio (qa round 22)
	bark = slot("rbxassetid://6490108541"), -- "TexturesCom_PineBark2_512_albedo", DarthRevan404
	roofTile = slot("rbxassetid://18708362091"), -- "roof_tile_texture4127", Phatgamingsk2
	wall = slot("rbxassetid://762795527"), -- "Seamless wall white paint stucco plaster", yumahap
	thatch = slot("rbxassetid://4125863236"), -- "Seamless Hay Texture", DjordyKK (tried on Austerlitz)
}

-- Sounds (client Audio.luau). `id` is "rbxassetid://<id>" or, for a slot with `variants` > 1, a
-- list of them (`id = { "rbxassetid://a", "rbxassetid://b" }`); a single id still gets pitch
-- variation. `pitch` is the PlaybackSpeed range rolled per play, `volume` the slot's level before
-- the buses. An empty id plays nothing and creates nothing. Keep keys; fill ids in Studio
-- (docs/vision.md, Audio).
export type Sound = { id: string | { string }, volume: number, pitch: { number }, variants: number, loop: boolean? }

local function sound(volume: number, pitch: { number }, variants: number?, loop: boolean?): Sound
	return { id = "", volume = volume, pitch = pitch, variants = variants or 1, loop = loop }
end

Assets.sounds = {
	-- battle, positional (anchored at the event, rolled off by camera height)
	musketVolley = sound(0.8, { 0.92, 1.08 }, 3), -- a battalion's volley, ~1 s of crackle
	musketScatter = sound(0.5, { 0.9, 1.1 }), -- scattered skirmish fire
	cannonFire = sound(1, { 0.9, 1.05 }, 3),
	cannonBounce = sound(0.6, { 0.9, 1.1 }), -- roundshot graze / earth
	canister = sound(0.9, { 0.95, 1.05 }), -- the shotgun blast of a canister round
	cavalryCharge = sound(0.8, { 0.95, 1.05 }), -- hooves at the gallop, ~4 s
	cavalryImpact = sound(0.9, { 0.95, 1.05 }), -- horses into a line
	meleeClash = sound(0.6, { 1, 1 }, 1, true), -- steel and shouting, loop
	drumsMarchFr = sound(0.5, { 1, 1 }, 1, true), -- pas de charge, loop per faction
	drumsMarchPr = sound(0.5, { 1, 1 }, 1, true),
	drumsMarchAt = sound(0.5, { 1, 1 }, 1, true),
	drumsMarchRu = sound(0.5, { 1, 1 }, 1, true),
	drumsMarchGb = sound(0.5, { 1, 1 }, 1, true),
	fifeMarch = sound(0.4, { 1, 1 }, 1, true),
	bugleCharge = sound(0.7, { 0.97, 1.03 }),
	bugleRally = sound(0.6, { 0.97, 1.03 }),
	rout = sound(0.6, { 0.95, 1.05 }), -- cries, a line breaking
	unitDestroyed = sound(0.6, { 0.95, 1.05 }),
	-- battle, 2D
	capture = sound(0.7, { 1, 1 }),
	objectiveLost = sound(0.7, { 1, 1 }),
	victory = sound(0.9, { 1, 1 }),
	defeat = sound(0.9, { 1, 1 }),
	momentSting = sound(0.8, { 1, 1 }), -- under a moment card; music ducks
	ping = sound(0.6, { 1, 1 }), -- co-op map ping
	-- interface
	uiClick = sound(0.5, { 0.97, 1.03 }),
	uiHover = sound(0.25, { 0.97, 1.03 }),
	uiPaper = sound(0.5, { 0.95, 1.05 }), -- a sheet laid on the desk
	uiSeal = sound(0.5, { 0.97, 1.03 }), -- wax seal / stamp
	-- ambience loops by weather grade
	ambienceField = sound(0.5, { 1, 1 }, 1, true), -- wind and birds
	ambienceRain = sound(0.6, { 1, 1 }, 1, true),
	ambienceFog = sound(0.4, { 1, 1 }, 1, true), -- muffled, close
	-- music (loops, crossfaded by the state machine)
	menuMusic = sound(0.6, { 1, 1 }, 1, true),
	battleMusicCalm = sound(0.5, { 1, 1 }, 1, true),
	battleMusicTense = sound(0.6, { 1, 1 }, 1, true),
	campaignMusic = sound(0.5, { 1, 1 }, 1, true),
}

-- A texture id for a slot, or nil when the slot has none.
function Assets.textureOf(key: string): string?
	local s = (Assets.slots :: { [string]: Slot })[key]
	if s and s.texture ~= "" then
		return s.texture
	end
	return nil
end

function Assets.get(key: string): Slot?
	local s = (Assets.slots :: { [string]: Slot })[key]
	if s and s.mesh ~= "" then
		return s
	end
	return nil
end

return Assets
]]></ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX00000002"><Properties><bool name="Disabled">false</bool><string name="Name">CampaignData</string><ProtectedString name="Source"><![CDATA[--!strict
-- Authored campaign map: Thuringia / Saxony, October 1806 (inspired by the Jena campaign; names
-- are real towns, borders and numbers are balance choices). Region `pos` is on a 0..1000 client
-- map (x east, z south). `terrain` names the tactical map variant used when a battle happens there.

export type Region = {
	id: string,
	name: string,
	pos: { x: number, z: number },
	adjacent: { string },
	terrain: string, -- "jena" | "bridge" | "village" (MapGen.list())
	owner: string,
	income: number, -- treasury per turn
	manpower: number, -- manpower per turn
	isCity: boolean,
}

export type UnitType = {
	name: string,
	class: "infantry" | "cavalry" | "artillery" | "hq",
	strength: number,
	cost: number,
	turns: number,
	upkeep: number,
	recruitable: boolean,
}

export type StartUnit = { type: string, name: string, experience: number }
export type StartArmy = { faction: string, name: string, regionId: string, units: { StartUnit } }

local CampaignData = {}

CampaignData.Factions = { player = "france", enemy = "prussia" }
CampaignData.FactionNames = { france = "France", prussia = "Prussia" } :: { [string]: string }
CampaignData.Capitals = { france = "rudolstadt", prussia = "weimar" } :: { [string]: string }

local function r(id: string, name: string, x: number, z: number, adjacent: { string }, terrain: string, owner: string, isCity: boolean): Region
	return {
		id = id,
		name = name,
		pos = { x = x, z = z },
		adjacent = adjacent,
		terrain = terrain,
		owner = owner,
		income = if isCity then 120 else 80,
		manpower = if isCity then 80 else 40,
		isCity = isCity,
	}
end

-- North (Prussia) at low z, south (France) at high z. Adjacency is a road graph and must be symmetric.
CampaignData.Regions = {
	r("erfurt", "Erfurt", 150, 250, { "weimar" }, "village", "prussia", true),
	r("weimar", "Weimar", 350, 230, { "erfurt", "apolda", "jena" }, "village", "prussia", true),
	r("apolda", "Apolda", 480, 150, { "weimar", "naumburg", "jena" }, "village", "prussia", false),
	r("naumburg", "Naumburg", 700, 80, { "apolda", "gera" }, "bridge", "prussia", true),
	r("jena", "Jena", 500, 420, { "weimar", "apolda", "kahla", "gera" }, "jena", "prussia", true),
	r("gera", "Gera", 850, 450, { "naumburg", "jena", "kahla" }, "bridge", "france", true),
	r("kahla", "Kahla", 470, 620, { "jena", "gera", "rudolstadt" }, "bridge", "france", false),
	r("rudolstadt", "Rudolstadt", 300, 800, { "kahla" }, "village", "france", false),
} :: { Region }

CampaignData.UnitTypes = {
	line = { name = "Line infantry", class = "infantry", strength = 600, cost = 400, turns = 2, upkeep = 30, recruitable = true },
	light = { name = "Light infantry", class = "infantry", strength = 600, cost = 450, turns = 2, upkeep = 30, recruitable = true },
	cavalry = { name = "Cavalry", class = "cavalry", strength = 400, cost = 500, turns = 3, upkeep = 40, recruitable = true },
	artillery = { name = "Foot artillery", class = "artillery", strength = 120, cost = 450, turns = 3, upkeep = 35, recruitable = true },
	hq = { name = "Headquarters", class = "hq", strength = 40, cost = 0, turns = 0, upkeep = 20, recruitable = false },
} :: { [string]: UnitType }

CampaignData.Economy = {
	StartTreasury = { france = 800, prussia = 700 } :: { [string]: number },
	StartManpower = { france = 600, prussia = 600 } :: { [string]: number },
	MaxManpower = 2000,
	MaxTreasury = 20000,
	ReplenishCostPerMan = 0.5, -- treasury per man restored (plus one manpower per man)
	SupplyRecovery = 20, -- supply gained per fully paid turn (0..100)
	SupplyShortage = 25, -- supply lost per turn upkeep cannot be paid
	AttritionFraction = 0.05, -- strength lost per turn while supply is 0
	MaxQueue = 6, -- recruitment orders per faction
	MaxArmies = 10,
	MaxUnitsPerArmy = 12,
	AIReserve = 200, -- treasury the AI keeps before recruiting
}

CampaignData.Victory = {
	TurnLimit = 20,
	Objectives = { "jena", "weimar", "naumburg" },
	MinArmyStrength = 1500, -- total French strength required at the moment the objectives are held
}

local function su(t: string, name: string, exp: number): StartUnit
	return { type = t, name = name, experience = exp }
end

CampaignData.StartArmies = {
	{
		faction = "france", name = "Armée · Lannes", regionId = "kahla",
		units = {
			su("hq", "Napoléon — Imperial HQ", 3),
			su("light", "17e Légère", 2),
			su("line", "34e de Ligne", 1),
			su("line", "40e de Ligne", 1),
			su("cavalry", "5e Hussards", 1),
			su("artillery", "Batterie 5e Corps", 1),
		},
	},
	{
		faction = "france", name = "Corps · Soult", regionId = "gera",
		units = { su("line", "26e Légère", 1), su("line", "36e de Ligne", 0), su("cavalry", "1er Cuirassiers", 2) },
	},
	{
		faction = "prussia", name = "Armee · Hohenlohe", regionId = "jena",
		units = {
			su("hq", "Hohenlohe — Army HQ", 2),
			su("line", "IR Nr. 29 Treuenfels", 2),
			su("line", "IR Nr. 49 Müffling", 1),
			su("light", "Füsilier-Bataillon Pelet", 1),
			su("cavalry", "Kürassier-Regiment Henckel", 2),
			su("artillery", "Batterie Grawert", 1),
		},
	},
	{
		faction = "prussia", name = "Korps · Rüchel", regionId = "weimar",
		units = { su("line", "IR Nr. 20 Prinz Louis Ferdinand", 1), su("line", "IR Nr. 51 Kauffberg", 1), su("cavalry", "Husaren-Regiment Gettkandt", 1) },
	},
} :: { StartArmy }

function CampaignData.region(id: string): Region?
	for _, reg in CampaignData.Regions do
		if reg.id == id then
			return reg
		end
	end
	return nil
end

return CampaignData
]]></ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX00000003"><Properties><bool name="Disabled">false</bool><string name="Name">Config</string><ProtectedString name="Source"><![CDATA[--!strict
-- Single source of every live balance / timing / visual constant.
-- docs/rules.md explains the formulas that consume these numbers. Change values here only.

local Config = {}

Config.Sim = {
	DT = 0.05, -- logical seconds per tick (20 Hz)
	TickRate = 20,
	MaxTicksPerFrame = 6, -- beyond this the sim lags instead of taking a giant step
	SnapshotEveryTicks = 2, -- 10 Hz
	VisibilityEveryTicks = 4,
	Speeds = { 1, 2, 4 },
	CommandDelayTicks = 1, -- accepted commands take effect next tick
}

Config.Map = {
	Width = 1600,
	Depth = 1200,
	CellSize = 4,
	NavCellSize = 16,
	MaxHeight = 80,
}

-- Terrain classes. speed multiplies base unit speed; cover reduces incoming fire;
-- sightHeight is added to terrain height for LOS when the cell is between observer and target.
Config.TerrainIds = { open = 1, road = 2, woods = 3, village = 4, water = 5, bridge = 6, steep = 7, cliff = 8 }
Config.Terrain = {
	[1] = { name = "open", speed = 1.0, cavalrySpeed = 1.0, passable = true, cover = 0.0, blocksSight = false, sightHeight = 0, fatigue = 1.0, cohesion = 0.0 },
	[2] = { name = "road", speed = 1.3, cavalrySpeed = 1.3, passable = true, cover = 0.0, blocksSight = false, sightHeight = 0, fatigue = 0.8, cohesion = 0.0 },
	[3] = { name = "woods", speed = 0.6, cavalrySpeed = 0.4, passable = true, cover = 0.35, blocksSight = true, sightHeight = 12, fatigue = 1.4, cohesion = 0.08 },
	[4] = { name = "village", speed = 0.7, cavalrySpeed = 0.5, passable = true, cover = 0.5, blocksSight = true, sightHeight = 10, fatigue = 1.1, cohesion = 0.05 },
	[5] = { name = "water", speed = 0.0, cavalrySpeed = 0.0, passable = false, cover = 0.0, blocksSight = false, sightHeight = 0, fatigue = 1.0, cohesion = 0.0 },
	[6] = { name = "bridge", speed = 0.9, cavalrySpeed = 0.8, passable = true, cover = 0.0, blocksSight = false, sightHeight = 0, fatigue = 1.0, cohesion = 0.0 },
	[7] = { name = "steep", speed = 0.5, cavalrySpeed = 0.45, passable = true, cover = 0.1, blocksSight = false, sightHeight = 0, fatigue = 1.8, cohesion = 0.06 },
	[8] = { name = "cliff", speed = 0.0, cavalrySpeed = 0.0, passable = false, cover = 0.0, blocksSight = false, sightHeight = 0, fatigue = 1.0, cohesion = 0.0 },
}

Config.Slope = {
	Steep = 0.42, -- rise/run above which open ground becomes "steep"
	Impassable = 0.95, -- rise/run above which ground is a cliff
	UphillPenalty = 0.6, -- speed *= 1 - penalty * max(0, slopeAlongMotion)
	DownhillBonus = 0.15,
	UphillFireBonus = 0.1, -- firing from higher ground
}

-- Visibility
Config.Vision = {
	EyeHeight = 4.0, -- mounted officers / colour party; sees over small bulges of a slope
	SightTolerance = 0.5, -- studs the terrain may rise above the sight line before it blocks
	WoodsReveal = 90, -- a formation inside woods/village is only spotted within this distance
	ContactReveal = 15, -- footprints this close (beyond touching) always see each other
	LastKnownForgetSeconds = 180,
}

Config.Visual = {
	SoldiersPerFigure = 25,
	CrewPerGun = 20,
	FarLodDistance = 420, -- camera distance beyond which ranks become blocks
	MaxFiguresHigh = 1200,
	MaxFiguresLow = 400,
	-- RGB 0-255 triples (plain tables so the sim/tests never need Roblox datatypes);
	-- the client converts with Color3.fromRGB.
	Palette = {
		TerrainGrass = { 154, 138, 78 },
		TerrainSlope = { 122, 92, 58 },
		TerrainWoodsFloor = { 62, 78, 42 },
		Water = { 90, 95, 168 },
		Bank = { 196, 180, 140 },
		Road = { 140, 122, 92 },
		Roof = { 138, 74, 50 },
		Wall = { 190, 170, 140 },
		TreeCrown = { 70, 96, 48 },
		TreeTrunk = { 78, 58, 40 },
		Cream = { 237, 228, 204 },
		Ink = { 42, 36, 32 },
		France = { 44, 79, 166 },
		Prussia = { 58, 61, 66 },
		Saxony = { 108, 113, 128 },
		Russia = { 40, 72, 52 }, -- dark green coat
		Austria = { 214, 208, 190 }, -- off-white
		Britain = { 160, 52, 44 }, -- brick red
		Bavaria = { 96, 128, 200 }, -- cornflower
		Netherlands = { 150, 112, 80 }, -- orange-tinged slate
		Select = { 240, 226, 180 },
		Hostile = { 170, 60, 48 },
		Spain = { 196, 150, 40 },
		Portugal = { 40, 110, 70 },
		Italy = { 60, 120, 70 },
		Naples = { 150, 160, 180 },
		Wurttemberg = { 170, 50, 50 },
		Sweden = { 50, 90, 160 },
		Denmark = { 180, 40, 50 },
		Ottoman = { 120, 30, 40 },
	},
}

-- Formation shapes. ranks: files are derived from figure count / ranks. figureSpacing = studs between
-- files (frontage per figure), rankSpacing = studs between ranks.
-- fire: fraction of strength that can fire. shock: multiplier on cavalry charge impact received.
-- artillery: multiplier on artillery casualties received. speed: multiplier on base speed.
Config.Shapes = {
	line = { ranks = 3, fire = 1.0, melee = 1.0, speed = 0.75, shock = 1.0, artillery = 1.0, turnRate = 0.45, figureSpacing = 5, rankSpacing = 3 },
	column = { ranks = 8, fire = 0.3, melee = 1.15, speed = 1.0, shock = 1.3, artillery = 1.9, turnRate = 0.9, figureSpacing = 4, rankSpacing = 3 },
	square = { ranks = 0, fire = 0.5, melee = 0.9, speed = 0.3, shock = 0.15, artillery = 2.2, turnRate = 1.2, figureSpacing = 4, rankSpacing = 4 },
	travel = { ranks = 12, fire = 0.0, melee = 0.6, speed = 1.0, shock = 1.8, artillery = 2.0, turnRate = 1.0, figureSpacing = 4, rankSpacing = 3 }, -- forced column at choke points
	limbered = { ranks = 1, fire = 0.0, melee = 0.3, speed = 1.0, shock = 3.0, artillery = 1.5, turnRate = 0.8, figureSpacing = 8, rankSpacing = 10 },
	deployed = { ranks = 1, fire = 1.0, melee = 0.3, speed = 0.0, shock = 3.0, artillery = 1.0, turnRate = 0.0, figureSpacing = 8, rankSpacing = 8 },
	wedge = { ranks = 4, fire = 0.0, melee = 1.0, speed = 1.0, shock = 1.0, artillery = 1.6, turnRate = 1.1, figureSpacing = 5, rankSpacing = 6 },
	staff = { ranks = 2, fire = 0.0, melee = 0.4, speed = 1.0, shock = 2.0, artillery = 1.5, turnRate = 1.5, figureSpacing = 4, rankSpacing = 4 },
}

-- Seconds to change shape (from any shape to the key). Square from column is faster.
Config.ReformTime = { line = 12, column = 8, square = 15, travel = 6, limbered = 25, deployed = 20, wedge = 4, staff = 2 }
Config.SquareFromColumnTime = 10

Config.Units = {
	infantry = {
		speed = 5.5, chargeSpeed = 7.5,
		defaultShape = "line", legalShapes = { line = true, column = true, square = true, travel = true },
		musket = { range = 90, reload = 15, accuracy = 0.07, minReadiness = 0.4 },
		melee = { attack = 1.0, defense = 1.0 },
		baseMorale = 70, fatigueMove = 0.35, fatigueCharge = 6.0, fatigueMelee = 2.0, rest = 1.5,
		spot = 260, halfWidthFactor = 1.0,
	},
	cavalry = {
		speed = 14.0, chargeSpeed = 20.0,
		defaultShape = "wedge", legalShapes = { wedge = true, line = true },
		musket = nil,
		melee = { attack = 1.4, defense = 0.8 },
		charge = { runUp = 80, base = 0.06, recovery = 40, maxMeleeSeconds = 25, frontFactor = 1.0, flankFactor = 1.8, rearFactor = 2.5 },
		baseMorale = 72, fatigueMove = 0.5, fatigueCharge = 7.0, fatigueMelee = 2.5, rest = 1.5,
		spot = 320,
	},
	artillery = {
		speed = 4.5, chargeSpeed = 4.5,
		defaultShape = "limbered", legalShapes = { limbered = true, deployed = true },
		musket = nil,
		melee = { attack = 0.2, defense = 0.4 },
		gun = {
			arcHalfAngle = 0.52, -- radians (30°)
			roundShot = { range = 450, minRange = 60, reload = 20, hit = 0.5, casualtiesPerHit = 3, morale = 3 },
			canister = { range = 120, minRange = 0, reload = 18, hit = 0.9, casualtiesPerHit = 7, morale = 5 },
			ammo = 40,
		},
		baseMorale = 60, fatigueMove = 0.3, fatigueCharge = 0.3, fatigueMelee = 2.0, rest = 1.5,
		spot = 240,
	},
	hq = {
		speed = 12.0, chargeSpeed = 12.0,
		defaultShape = "staff", legalShapes = { staff = true },
		musket = nil,
		melee = { attack = 0.3, defense = 0.5 },
		influence = { radius = 120, moraleBonus = 10, recoveryBonus = 0.3 },
		rally = { cooldown = 90, radius = 100, moraleRestore = 30, minRoutingSeconds = 5 },
		lossMoralePenalty = 15, -- to every friendly formation when the HQ is destroyed/exited
		baseMorale = 80, fatigueMove = 0.3, fatigueCharge = 0.3, fatigueMelee = 2.0, rest = 2.0,
		spot = 300,
	},
}

Config.Combat = {
	RangeFalloff = 0.65, -- hit factor at max range = 1 - falloff
	MaxHitChance = 0.30,
	TargetShapeFactor = { line = 1.0, column = 1.5, square = 1.3, travel = 1.6, limbered = 1.2, deployed = 1.0, wedge = 1.2, staff = 1.0 },
	FlankFireFactor = 1.35,
	RearFireFactor = 1.6,
	FriendlyBlocksFire = true, -- a friendly formation inside the fire lane blocks the volley
	FireLaneHalfWidth = 10,
	MeleeRatePerSecond = 0.0025, -- casualties = attackerStrength * rate * factors * dt
	MeleeDirFactor = { front = 1.0, flank = 1.6, rear = 2.2 },
	MeleeContactDistance = 6, -- studs between footprints
	BayonetBonus = 1.3,
	BayonetBonusSeconds = 10,
	BayonetMoraleShock = { front = 10, flank = 20 },
	ChargeShapeFactor = { line = 1.0, column = 1.3, square = 0.15, travel = 1.8, limbered = 3.0, deployed = 3.0, wedge = 1.0, staff = 2.0 },
	ChargeRoutingFactor = 1.5,
	SquareReturnsDamage = 2.0, -- cavalry in melee with a square takes x2
	MinRunUpFactor = 0.3,
	ExperienceAccuracy = 0.08, -- per experience level
	ExperienceMelee = 0.08,
	ExperienceMorale = 4,
	FatigueSpeedPenalty = 0.4,
	FatigueAccuracyPenalty = 0.3,
	FatigueMeleePenalty = 0.4,
	VolleyMinStrength = 10,
	ShakenFireFactor = 0.7,
	ShakenMeleeFactor = 0.8,
}

Config.Morale = {
	CasualtyFactor = 1.0, -- morale -= (casualties/strength) * 100 * factor
	FlankHitPenalty = 6, -- once per flank volley / cannonade / charge received
	RearHitPenalty = 12,
	FlankMeleePerSecond = 1.5,
	RearMeleePerSecond = 3,
	FriendRoutPenalty = 2, FriendRoutRadius = 80, FriendRoutMax = 6, FriendRoutInterval = 5,
	IsolationRadius = 150, IsolationPenalty = 1, IsolationInterval = 5,
	FatigueThreshold = 70, FatiguePenaltyPerSecond = 0.2,
	RecoveryPerSecond = 0.5, RecoveryDelay = 10, -- seconds without taking damage
	ShakenEnter = 40, ShakenExit = 50,
	RoutEnter = 20, RallyMorale = 35, MinRoutSeconds = 20,
	RallyNoEnemyRadius = 120,
	ShatterStrengthFraction = 0.3, MaxRouts = 2,
	RoutSpeedFactor = 1.3,
	RoutExitMargin = 20, -- studs outside map edge => exited
	CapturedGunsMorale = 5, -- penalty to the army when an artillery formation is destroyed
}

Config.Objectives = {
	CaptureRadius = 60,
	CaptureSeconds = 30,
	HoldAllSeconds = 120,
	HoldAllEarliest = 600, -- holding every objective only wins after this many seconds (gives the attacker a chance)
	EligibleClasses = { infantry = true, cavalry = true },
}

-- Weather / ground state per scenario (`scenario.weather`, optional `scenario.weatherUntil` seconds
-- after which it clears). Multipliers on musket accuracy, artillery hit chance, movement speed and
-- spotting distance.
Config.Weather = {
	clear = { accuracy = 1.0, cannon = 1.0, speed = 1.0, spot = 1.0, label = "Clear" },
	rain = { accuracy = 0.6, cannon = 0.85, speed = 0.9, spot = 0.8, label = "Rain" },
	mud = { accuracy = 0.9, cannon = 0.7, speed = 0.8, spot = 1.0, label = "Sodden ground" },
	fog = { accuracy = 0.9, cannon = 0.8, speed = 1.0, spot = 0.45, label = "Fog" },
	snow = { accuracy = 0.85, cannon = 0.9, speed = 0.8, spot = 0.7, label = "Snow" },
}

Config.Victory = {
	CollapseFraction = 0.7, -- fraction of formations routing/shattered/destroyed/exited
	CollapseStrengthFraction = 0.35,
	TimeLimitSeconds = 25 * 60,
}

Config.Match = {
	ReconnectGrace = 120,
	DeploymentMinSpacing = 8,
	MaxQueue = 4,
	LeashDistance = 160, -- engage/attack-move chase limit
	StuckSeconds = 4,
	AvoidanceRadius = 12,
}

Config.AI = {
	DecisionTicks = 10,
	PerceptionTicks = 10,
	CommitSeconds = 20,
	Difficulties = {
		easy = { reaction = 2.0, planQuality = 0.6, moraleBonus = 0 },
		normal = { reaction = 1.0, planQuality = 1.0, moraleBonus = 0 },
		hard = { reaction = 0.6, planQuality = 1.0, moraleBonus = 5 }, -- disclosed in settings
	},
}

Config.Net = {
	RequestsPerSecond = 30,
	MaxBatch = 24,
	MaxQueueDepth = 4,
	DedupeWindow = 4096,
}

return Config
]]></ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX00000004"><Properties><bool name="Disabled">false</bool><string name="Name">EuropeData</string><ProtectedString name="Source"><![CDATA[--!strict
-- Grand campaign data: Europe, January 1805 – December 1815 (docs/grand-campaign-contract.md).
-- Pure data plus a few pure helpers; shared by the server rules and the client campaign map.
--
-- Map units: 0..2000 (x, east) × 0..1500 (z, north). Province centres come from real towns via
-- `ll(lon, lat)` (x = (lon + 10) * 40, z = (lat - 36) * 62.5). Outlines are the Voronoi cells of
-- the province centres plus unlisted "sea sites", clipped to the map: they tile the land with no
-- gaps and leave the seas open. Rough by design, not a survey. Owners, armies, commanders,
-- wars and event dates are historical; incomes, manpower, unit numbers and every rule number are
-- balance choices (docs/campaign.md).

export type Vec = { x: number, z: number }

export type Nation = {
	id: string,
	name: string,
	adjective: string,
	colour: string, -- palette key (Config.Visual.Palette / client Factions)
	capital: string,
	playable: boolean,
	major: boolean,
	treasury: number, -- start
	manpower: number, -- start
	peaceResolve: number, -- AI accepts a losing peace at war score <= -peaceResolve
	quality: number, -- army fighting value multiplier (gameplay: French corps system, British infantry)
}

export type Province = {
	id: string,
	name: string,
	owner1805: string,
	occupied1805: string?, -- held by this nation in January 1805 (Hanover)
	centre: Vec,
	outline: { Vec },
	neighbours: { string },
	terrain: string,
	income: number,
	manpower: number,
	isCapital: boolean,
	isPort: boolean,
	fort: number, -- 0..2
	towns: { string }, -- real places in the province, for the battle map's villages and labels
	river: string?, -- the river a battle there is fought over, if any
}

export type UnitClass = {
	name: string,
	class: "infantry" | "cavalry" | "artillery", -- tactical sim class
	strength: number,
	cost: number,
	manpower: number,
	turns: number,
	upkeep: number,
	power: number, -- auto-resolve weight per man
	needs: "any" | "fort" | "capital",
	majorOnly: boolean,
	experience: number, -- experience on recruitment
}

export type StartArmy = { nation: string, name: string, province: string, general: { name: string, rating: number }?, experience: number, units: { [string]: number } }

export type Condition = { any }
export type Effect = { [string]: any }
export type Choice = { id: string, label: string, effects: { Effect } }
export type Event = {
	id: string,
	turn: number, -- earliest turn
	untilTurn: number?, -- latest turn (defaults to `turn`); fires at the first turn in the window whose conditions hold
	title: string,
	text: string,
	condition: { Condition }?, -- all must hold
	effects: { Effect },
	chooser: string?, -- nation that picks among `choices` (the player gets a pop-up, an AI takes choices[1])
	choices: { Choice }?,
	historical: string, -- what actually happened
}

export type SetPiece = { scenarioId: string, province: string, turnFrom: number, turnTo: number, attacker: string, defender: string }

local EuropeData = {}

EuropeData.TurnLength = "2 months"
EuropeData.StartTurn = 1 -- Jan 1805
EuropeData.EndTurn = 66 -- Nov–Dec 1815
EuropeData.StartYear = 1805
EuropeData.Width = 2000
EuropeData.Depth = 1500

local MONTHS = { "Jan", "Feb", "Mar", "Apr", "May", "Jun", "Jul", "Aug", "Sep", "Oct", "Nov", "Dec" }

-- "May 1805" for the first month of the turn.
function EuropeData.dateOf(turn: number): string
	local m = (turn - 1) * 2
	return MONTHS[m % 12 + 1] .. " " .. tostring(EuropeData.StartYear + m // 12)
end

-- First turn of a given month/year (1-based month).
function EuropeData.turnOf(month: number, year: number): number
	return ((year - EuropeData.StartYear) * 12 + month - 1) // 2 + 1
end

local function ll(lon: number, lat: number): Vec
	return { x = math.floor((lon + 10) * 40 + 0.5), z = math.floor((lat - 36) * 62.5 + 0.5) }
end

-- Nations -----------------------------------------------------------------------------------------

local function nation(id: string, name: string, adjective: string, colour: string, capital: string, major: boolean, treasury: number, manpower: number, peaceResolve: number?): Nation
	return { id = id, name = name, adjective = adjective, colour = colour, capital = capital, playable = major, major = major, treasury = treasury, manpower = manpower, peaceResolve = peaceResolve or 20, quality = if id == "france" then 1.15 elseif id == "britain" then 1.1 else 1 }
end

-- Turn order: majors first, then minors, in this order.
EuropeData.NationOrder = { "france", "britain", "austria", "prussia", "russia", "spain", "portugal", "netherlands", "italy", "naples", "bavaria", "saxony", "wurttemberg", "sweden", "denmark", "ottoman" }

EuropeData.Nations = {
	france = nation("france", "French Empire", "French", "France", "paris", true, 1500, 6000, 25),
	britain = nation("britain", "United Kingdom", "British", "Britain", "england", true, 2500, 3000, 60),
	austria = nation("austria", "Austrian Empire", "Austrian", "Austria", "vienna", true, 900, 5000, 20),
	prussia = nation("prussia", "Kingdom of Prussia", "Prussian", "Prussia", "brandenburg", true, 900, 4000, 20),
	russia = nation("russia", "Russian Empire", "Russian", "Russia", "stpetersburg", true, 900, 6000, 35),
	spain = nation("spain", "Kingdom of Spain", "Spanish", "Spain", "madrid", false, 500, 2500),
	portugal = nation("portugal", "Kingdom of Portugal", "Portuguese", "Portugal", "lisbon", false, 300, 1000),
	netherlands = nation("netherlands", "Batavian Republic", "Dutch", "Netherlands", "holland", false, 400, 1000),
	italy = nation("italy", "Kingdom of Italy", "Italian", "Italy", "lombardy", false, 400, 1500),
	naples = nation("naples", "Kingdom of Naples", "Neapolitan", "Naples", "naples", false, 300, 1200),
	bavaria = nation("bavaria", "Electorate of Bavaria", "Bavarian", "Bavaria", "bavaria", false, 300, 1200),
	saxony = nation("saxony", "Electorate of Saxony", "Saxon", "Saxony", "saxony", false, 300, 1200),
	wurttemberg = nation("wurttemberg", "Electorate of Württemberg", "Württemberg", "Wurttemberg", "wurttemberg", false, 250, 800),
	sweden = nation("sweden", "Kingdom of Sweden", "Swedish", "Sweden", "stockholm", false, 300, 1000),
	denmark = nation("denmark", "Denmark–Norway", "Danish", "Denmark", "denmark", false, 300, 1000),
	ottoman = nation("ottoman", "Ottoman Empire", "Ottoman", "Ottoman", "constantinople", false, 500, 2500),
} :: { [string]: Nation }

EuropeData.Majors = { "france", "britain", "austria", "prussia", "russia" }

-- Provinces ---------------------------------------------------------------------------------------

type POpts = { capital: boolean?, port: boolean?, fort: number?, occupied: string? }

local function prov(id: string, name: string, lon: number, lat: number, owner: string, terrain: string, income: number, manpower: number, neighbours: { string }, o: POpts?): Province
	local opts: POpts = o or {}
	return {
		id = id,
		name = name,
		owner1805 = owner,
		occupied1805 = opts.occupied,
		centre = ll(lon, lat),
		outline = {},
		neighbours = neighbours,
		terrain = terrain,
		income = income,
		manpower = manpower,
		isCapital = opts.capital == true,
		isPort = opts.port == true,
		fort = opts.fort or 0,
		towns = {},
		river = nil,
	}
end

-- Neighbours are land borders plus the sea lanes listed in EuropeData.SeaLanes (port to port).
EuropeData.Provinces = {
	-- France (with Belgium, the left bank of the Rhine and Piedmont)
	prov("paris", "Île-de-France", 2.35, 48.85, "france", "village", 300, 1500, { "normandy", "champagne", "belgium", "aquitaine", "provence" }, { capital = true, fort = 1 }),
	prov("normandy", "Normandy & Brittany", -1.6, 48.6, "france", "waterloo", 140, 900, { "paris", "aquitaine", "belgium", "england" }, { port = true }),
	prov("aquitaine", "Aquitaine", -0.4, 44.9, "france", "waterloo", 120, 800, { "normandy", "paris", "provence", "madrid" }, { port = true }),
	prov("provence", "Provence & Lyonnais", 5.2, 44.3, "france", "austerlitz", 130, 900, { "paris", "aquitaine", "champagne", "piedmont", "catalonia" }, { port = true, fort = 1 }),
	prov("champagne", "Champagne & Lorraine", 5.2, 48.6, "france", "auerstedt", 110, 800, { "paris", "belgium", "rhineland", "provence", "wurttemberg" }, { fort = 2 }),
	prov("belgium", "Belgium", 4.3, 50.8, "france", "waterloo", 130, 600, { "paris", "normandy", "champagne", "rhineland", "holland", "england" }, { port = true, fort = 1 }),
	prov("rhineland", "Rhineland", 7.3, 50.3, "france", "bridge", 100, 600, { "belgium", "champagne", "holland", "westphalia", "wurttemberg", "thuringia" }, { fort = 1 }),
	prov("piedmont", "Piedmont", 7.4, 44.9, "france", "jena", 80, 500, { "provence", "lombardy" }, { fort = 1 }),
	-- French satellites
	prov("holland", "Holland", 5.0, 52.3, "netherlands", "waterloo", 160, 400, { "belgium", "rhineland", "westphalia", "england" }, { capital = true, port = true, fort = 1 }),
	prov("lombardy", "Lombardy", 10.2, 45.2, "italy", "bridge", 140, 700, { "piedmont", "venetia", "tyrol", "naples" }, { capital = true, fort = 1 }),
	-- Britain (Hanover in personal union, occupied by Mortier's French since 1803)
	prov("england", "England & Scotland", -2.0, 53.3, "britain", "waterloo", 450, 900, { "ireland", "normandy", "belgium", "holland", "denmark", "lisbon" }, { capital = true, port = true, fort = 1 }),
	prov("ireland", "Ireland", -8.0, 53.3, "britain", "waterloo", 80, 700, { "england" }, { port = true }),
	prov("hanover", "Hanover", 10.0, 53.0, "britain", "waterloo", 70, 400, { "westphalia", "thuringia", "brandenburg", "denmark" }, { port = true, occupied = "france" }),
	-- Austria
	prov("vienna", "Lower Austria", 15.8, 47.9, "austria", "bridge", 200, 1000, { "tyrol", "venetia", "bavaria", "bohemia", "moravia", "hungary" }, { capital = true, fort = 1 }),
	prov("venetia", "Venetia", 12.6, 45.9, "austria", "village", 100, 500, { "lombardy", "tyrol", "dalmatia", "vienna" }, { port = true, fort = 1 }),
	prov("dalmatia", "Dalmatia & Croatia", 16.5, 44.3, "austria", "jena", 40, 300, { "venetia", "hungary", "serbia" }, { port = true }),
	prov("tyrol", "Tyrol", 11.2, 46.9, "austria", "jena", 50, 300, { "lombardy", "venetia", "bavaria", "wurttemberg", "vienna" }),
	prov("bohemia", "Bohemia", 14.2, 50.0, "austria", "jena", 120, 900, { "vienna", "bavaria", "saxony", "silesia", "moravia" }, { fort = 1 }),
	prov("moravia", "Moravia", 17.2, 49.5, "austria", "austerlitz", 80, 600, { "vienna", "bohemia", "silesia", "hungary", "galicia" }, { fort = 1 }),
	prov("hungary", "Hungary", 19.5, 47.2, "austria", "auerstedt", 130, 1200, { "vienna", "moravia", "galicia", "dalmatia", "serbia" }),
	prov("galicia", "Galicia", 22.5, 49.8, "austria", "austerlitz", 80, 900, { "moravia", "hungary", "silesia", "warsaw", "ukraine" }),
	-- Prussia
	prov("brandenburg", "Brandenburg & Pomerania", 13.0, 52.8, "prussia", "auerstedt", 160, 900, { "saxony", "silesia", "warsaw", "eastprussia", "hanover", "thuringia" }, { capital = true, fort = 1 }),
	prov("silesia", "Silesia", 17.0, 51.0, "prussia", "auerstedt", 120, 800, { "brandenburg", "saxony", "bohemia", "moravia", "galicia", "warsaw" }, { fort = 1 }),
	prov("eastprussia", "East Prussia", 21.0, 54.3, "prussia", "bridge", 80, 600, { "brandenburg", "warsaw", "lithuania", "stockholm" }, { port = true, fort = 2 }),
	prov("westphalia", "Westphalia", 7.8, 51.6, "prussia", "waterloo", 70, 500, { "holland", "rhineland", "hanover", "thuringia" }),
	prov("warsaw", "South Prussia (Warsaw)", 19.5, 52.3, "prussia", "bridge", 70, 700, { "brandenburg", "silesia", "galicia", "eastprussia", "lithuania", "ukraine" }),
	-- German minors
	prov("saxony", "Saxony", 13.5, 51.4, "saxony", "jena", 90, 500, { "brandenburg", "silesia", "bohemia", "thuringia", "bavaria" }, { capital = true, fort = 1 }),
	prov("thuringia", "Thuringia", 11.0, 50.9, "saxony", "jena", 60, 400, { "saxony", "brandenburg", "hanover", "westphalia", "rhineland", "bavaria" }),
	prov("bavaria", "Bavaria", 11.8, 48.3, "bavaria", "bridge", 100, 600, { "wurttemberg", "tyrol", "vienna", "bohemia", "saxony", "thuringia" }, { capital = true, fort = 1 }),
	prov("wurttemberg", "Württemberg & Baden", 9.0, 48.6, "wurttemberg", "village", 70, 400, { "champagne", "rhineland", "bavaria", "tyrol" }, { capital = true }),
	-- Russia
	prov("stpetersburg", "St Petersburg", 30.3, 59.5, "russia", "waterloo", 180, 800, { "lithuania", "smolensk", "moscow", "stockholm" }, { capital = true, port = true, fort = 2 }),
	prov("lithuania", "Lithuania & Courland", 24.0, 55.8, "russia", "auerstedt", 80, 800, { "eastprussia", "warsaw", "smolensk", "stpetersburg", "ukraine" }, { port = true }),
	prov("smolensk", "Smolensk", 31.0, 54.5, "russia", "bridge", 70, 900, { "lithuania", "stpetersburg", "moscow", "ukraine" }, { fort = 1 }),
	prov("moscow", "Moscow", 37.6, 55.75, "russia", "auerstedt", 160, 1400, { "smolensk", "stpetersburg", "ukraine" }),
	prov("ukraine", "Volhynia & Ukraine", 29.0, 50.0, "russia", "austerlitz", 90, 1300, { "warsaw", "galicia", "lithuania", "smolensk", "moscow", "serbia" }),
	-- Iberia
	prov("madrid", "Castile", -3.7, 40.4, "spain", "jena", 150, 800, { "aquitaine", "catalonia", "andalusia", "lisbon" }, { capital = true }),
	prov("catalonia", "Catalonia & Aragon", 1.0, 41.7, "spain", "jena", 90, 500, { "madrid", "provence", "andalusia" }, { port = true, fort = 1 }),
	prov("andalusia", "Andalusia", -5.0, 37.6, "spain", "austerlitz", 110, 600, { "madrid", "catalonia", "lisbon" }, { port = true, fort = 1 }),
	prov("lisbon", "Portugal", -8.3, 39.6, "portugal", "waterloo", 90, 400, { "madrid", "andalusia", "england" }, { capital = true, port = true, fort = 1 }),
	-- Italy south
	prov("naples", "Naples & the Papal States", 14.0, 41.8, "naples", "austerlitz", 90, 500, { "lombardy", "sicily" }, { capital = true, port = true }),
	prov("sicily", "Sicily", 14.2, 37.6, "naples", "waterloo", 50, 300, { "naples" }, { port = true }),
	-- North and east
	prov("stockholm", "Sweden", 16.5, 59.0, "sweden", "waterloo", 80, 400, { "stpetersburg", "denmark", "eastprussia" }, { capital = true, port = true, fort = 1 }),
	prov("denmark", "Denmark & Holstein", 10.3, 55.6, "denmark", "waterloo", 90, 400, { "hanover", "stockholm", "england" }, { capital = true, port = true, fort = 1 }),
	prov("constantinople", "Rumelia", 26.5, 41.6, "ottoman", "austerlitz", 140, 1000, { "serbia" }, { capital = true, port = true, fort = 2 }),
	prov("serbia", "Serbia & the Danube", 21.5, 44.3, "ottoman", "bridge", 50, 600, { "dalmatia", "hungary", "constantinople", "ukraine" }),
}

-- Real places for province battle maps (`MapGen.generate("province:<id>")`, docs/campaign.md):
-- three towns each (first = main village) and the river, if the landscape has one.
