<roblox xmlns:xmime="http://www.w3.org/2005/05/xmlmime" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="http://www.roblox.com/roblox.xsd" version="4"><Meta name="ExplicitAutoJoints">true</Meta><External>null</External><External>nil</External><Item class="ReplicatedStorage" referent="RBX00000011"><Properties><string name="Name">ReplicatedStorage</string></Properties><Item class="Folder" referent="RBX00000010"><Properties><string name="Name">EoE</string></Properties><Item class="ModuleScript" referent="RBX00000001"><Properties><bool name="Disabled">false</bool><string name="Name">CampaignData</string><ProtectedString name="Source"><![CDATA[--!strict
-- Authored campaign map: Thuringia / Saxony, October 1806 (inspired by the Jena campaign; names
-- are real towns, borders and numbers are balance choices). Region `pos` is on a 0..1000 client
-- map (x east, z south). `terrain` names the tactical map variant used when a battle happens there.

export type Region = {
	id: string,
	name: string,
	pos: { x: number, z: number },
	adjacent: { string },
	terrain: string, -- "jena" | "bridge" | "village" (MapGen.list())
	owner: string,
	income: number, -- treasury per turn
	manpower: number, -- manpower per turn
	isCity: boolean,
}

export type UnitType = {
	name: string,
	class: "infantry" | "cavalry" | "artillery" | "hq",
	strength: number,
	cost: number,
	turns: number,
	upkeep: number,
	recruitable: boolean,
}

export type StartUnit = { type: string, name: string, experience: number }
export type StartArmy = { faction: string, name: string, regionId: string, units: { StartUnit } }

local CampaignData = {}

CampaignData.Factions = { player = "france", enemy = "prussia" }
CampaignData.FactionNames = { france = "France", prussia = "Prussia" } :: { [string]: string }
CampaignData.Capitals = { france = "rudolstadt", prussia = "weimar" } :: { [string]: string }

local function r(id: string, name: string, x: number, z: number, adjacent: { string }, terrain: string, owner: string, isCity: boolean): Region
	return {
		id = id,
		name = name,
		pos = { x = x, z = z },
		adjacent = adjacent,
		terrain = terrain,
		owner = owner,
		income = if isCity then 120 else 80,
		manpower = if isCity then 80 else 40,
		isCity = isCity,
	}
end

-- North (Prussia) at low z, south (France) at high z. Adjacency is a road graph and must be symmetric.
CampaignData.Regions = {
	r("erfurt", "Erfurt", 150, 250, { "weimar" }, "village", "prussia", true),
	r("weimar", "Weimar", 350, 230, { "erfurt", "apolda", "jena" }, "village", "prussia", true),
	r("apolda", "Apolda", 480, 150, { "weimar", "naumburg", "jena" }, "village", "prussia", false),
	r("naumburg", "Naumburg", 700, 80, { "apolda", "gera" }, "bridge", "prussia", true),
	r("jena", "Jena", 500, 420, { "weimar", "apolda", "kahla", "gera" }, "jena", "prussia", true),
	r("gera", "Gera", 850, 450, { "naumburg", "jena", "kahla" }, "bridge", "france", true),
	r("kahla", "Kahla", 470, 620, { "jena", "gera", "rudolstadt" }, "bridge", "france", false),
	r("rudolstadt", "Rudolstadt", 300, 800, { "kahla" }, "village", "france", false),
} :: { Region }

CampaignData.UnitTypes = {
	line = { name = "Line infantry", class = "infantry", strength = 600, cost = 400, turns = 2, upkeep = 30, recruitable = true },
	light = { name = "Light infantry", class = "infantry", strength = 600, cost = 450, turns = 2, upkeep = 30, recruitable = true },
	cavalry = { name = "Cavalry", class = "cavalry", strength = 400, cost = 500, turns = 3, upkeep = 40, recruitable = true },
	artillery = { name = "Foot artillery", class = "artillery", strength = 120, cost = 450, turns = 3, upkeep = 35, recruitable = true },
	hq = { name = "Headquarters", class = "hq", strength = 40, cost = 0, turns = 0, upkeep = 20, recruitable = false },
} :: { [string]: UnitType }

CampaignData.Economy = {
	StartTreasury = { france = 800, prussia = 700 } :: { [string]: number },
	StartManpower = { france = 600, prussia = 600 } :: { [string]: number },
	MaxManpower = 2000,
	MaxTreasury = 20000,
	ReplenishCostPerMan = 0.5, -- treasury per man restored (plus one manpower per man)
	SupplyRecovery = 20, -- supply gained per fully paid turn (0..100)
	SupplyShortage = 25, -- supply lost per turn upkeep cannot be paid
	AttritionFraction = 0.05, -- strength lost per turn while supply is 0
	MaxQueue = 6, -- recruitment orders per faction
	MaxArmies = 10,
	MaxUnitsPerArmy = 12,
	AIReserve = 200, -- treasury the AI keeps before recruiting
}

CampaignData.Victory = {
	TurnLimit = 20,
	Objectives = { "jena", "weimar", "naumburg" },
	MinArmyStrength = 1500, -- total French strength required at the moment the objectives are held
}

local function su(t: string, name: string, exp: number): StartUnit
	return { type = t, name = name, experience = exp }
end

CampaignData.StartArmies = {
	{
		faction = "france", name = "Armée · Lannes", regionId = "kahla",
		units = {
			su("hq", "Napoléon — Imperial HQ", 3),
			su("light", "17e Légère", 2),
			su("line", "34e de Ligne", 1),
			su("line", "40e de Ligne", 1),
			su("cavalry", "5e Hussards", 1),
			su("artillery", "Batterie 5e Corps", 1),
		},
	},
	{
		faction = "france", name = "Corps · Soult", regionId = "gera",
		units = { su("line", "26e Légère", 1), su("line", "36e de Ligne", 0), su("cavalry", "1er Cuirassiers", 2) },
	},
	{
		faction = "prussia", name = "Armee · Hohenlohe", regionId = "jena",
		units = {
			su("hq", "Hohenlohe — Army HQ", 2),
			su("line", "IR Nr. 29 Treuenfels", 2),
			su("line", "IR Nr. 49 Müffling", 1),
			su("light", "Füsilier-Bataillon Pelet", 1),
			su("cavalry", "Kürassier-Regiment Henckel", 2),
			su("artillery", "Batterie Grawert", 1),
		},
	},
	{
		faction = "prussia", name = "Korps · Rüchel", regionId = "weimar",
		units = { su("line", "IR Nr. 20 Prinz Louis Ferdinand", 1), su("line", "IR Nr. 51 Kauffberg", 1), su("cavalry", "Husaren-Regiment Gettkandt", 1) },
	},
} :: { StartArmy }

function CampaignData.region(id: string): Region?
	for _, reg in CampaignData.Regions do
		if reg.id == id then
			return reg
		end
	end
	return nil
end

return CampaignData
]]></ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX00000002"><Properties><bool name="Disabled">false</bool><string name="Name">Config</string><ProtectedString name="Source"><![CDATA[--!strict
-- Single source of every live balance / timing / visual constant.
-- docs/rules.md explains the formulas that consume these numbers. Change values here only.

local Config = {}

Config.Sim = {
	DT = 0.05, -- logical seconds per tick (20 Hz)
	TickRate = 20,
	MaxTicksPerFrame = 6, -- beyond this the sim lags instead of taking a giant step
	SnapshotEveryTicks = 2, -- 10 Hz
	VisibilityEveryTicks = 4,
	Speeds = { 1, 2, 4 },
	CommandDelayTicks = 1, -- accepted commands take effect next tick
}

Config.Map = {
	Width = 1600,
	Depth = 1200,
	CellSize = 4,
	NavCellSize = 16,
	MaxHeight = 80,
}

-- Terrain classes. speed multiplies base unit speed; cover reduces incoming fire;
-- sightHeight is added to terrain height for LOS when the cell is between observer and target.
Config.TerrainIds = { open = 1, road = 2, woods = 3, village = 4, water = 5, bridge = 6, steep = 7, cliff = 8 }
Config.Terrain = {
	[1] = { name = "open", speed = 1.0, cavalrySpeed = 1.0, passable = true, cover = 0.0, blocksSight = false, sightHeight = 0, fatigue = 1.0, cohesion = 0.0 },
	[2] = { name = "road", speed = 1.3, cavalrySpeed = 1.3, passable = true, cover = 0.0, blocksSight = false, sightHeight = 0, fatigue = 0.8, cohesion = 0.0 },
	[3] = { name = "woods", speed = 0.6, cavalrySpeed = 0.4, passable = true, cover = 0.35, blocksSight = true, sightHeight = 12, fatigue = 1.4, cohesion = 0.08 },
	[4] = { name = "village", speed = 0.7, cavalrySpeed = 0.5, passable = true, cover = 0.5, blocksSight = true, sightHeight = 10, fatigue = 1.1, cohesion = 0.05 },
	[5] = { name = "water", speed = 0.0, cavalrySpeed = 0.0, passable = false, cover = 0.0, blocksSight = false, sightHeight = 0, fatigue = 1.0, cohesion = 0.0 },
	[6] = { name = "bridge", speed = 0.9, cavalrySpeed = 0.8, passable = true, cover = 0.0, blocksSight = false, sightHeight = 0, fatigue = 1.0, cohesion = 0.0 },
	[7] = { name = "steep", speed = 0.5, cavalrySpeed = 0.45, passable = true, cover = 0.1, blocksSight = false, sightHeight = 0, fatigue = 1.8, cohesion = 0.06 },
	[8] = { name = "cliff", speed = 0.0, cavalrySpeed = 0.0, passable = false, cover = 0.0, blocksSight = false, sightHeight = 0, fatigue = 1.0, cohesion = 0.0 },
}

Config.Slope = {
	Steep = 0.42, -- rise/run above which open ground becomes "steep"
	Impassable = 0.95, -- rise/run above which ground is a cliff
	UphillPenalty = 0.6, -- speed *= 1 - penalty * max(0, slopeAlongMotion)
	DownhillBonus = 0.15,
	UphillFireBonus = 0.1, -- firing from higher ground
}

-- Visibility
Config.Vision = {
	EyeHeight = 4.0, -- mounted officers / colour party; sees over small bulges of a slope
	SightTolerance = 0.5, -- studs the terrain may rise above the sight line before it blocks
	WoodsReveal = 60, -- a formation inside woods/village is only spotted within this distance
	LastKnownForgetSeconds = 180,
}

Config.Visual = {
	SoldiersPerFigure = 25,
	CrewPerGun = 20,
	FarLodDistance = 420, -- camera distance beyond which ranks become blocks
	MaxFiguresHigh = 1200,
	MaxFiguresLow = 400,
	-- RGB 0-255 triples (plain tables so the sim/tests never need Roblox datatypes);
	-- the client converts with Color3.fromRGB.
	Palette = {
		TerrainGrass = { 154, 138, 78 },
		TerrainSlope = { 122, 92, 58 },
		TerrainWoodsFloor = { 62, 78, 42 },
		Water = { 90, 95, 168 },
		Bank = { 196, 180, 140 },
		Road = { 140, 122, 92 },
		Roof = { 138, 74, 50 },
		Wall = { 190, 170, 140 },
		TreeCrown = { 70, 96, 48 },
		TreeTrunk = { 78, 58, 40 },
		Cream = { 237, 228, 204 },
		Ink = { 42, 36, 32 },
		France = { 44, 79, 166 },
		Prussia = { 58, 61, 66 },
		Saxony = { 108, 113, 128 },
		Russia = { 40, 72, 52 }, -- dark green coat
		Austria = { 214, 208, 190 }, -- off-white
		Britain = { 160, 52, 44 }, -- brick red
		Bavaria = { 96, 128, 200 }, -- cornflower
		Netherlands = { 150, 112, 80 }, -- orange-tinged slate
		Select = { 240, 226, 180 },
		Hostile = { 170, 60, 48 },
	},
}

-- Formation shapes. ranks: files are derived from figure count / ranks. figureSpacing = studs between
-- files (frontage per figure), rankSpacing = studs between ranks.
-- fire: fraction of strength that can fire. shock: multiplier on cavalry charge impact received.
-- artillery: multiplier on artillery casualties received. speed: multiplier on base speed.
Config.Shapes = {
	line = { ranks = 3, fire = 1.0, melee = 1.0, speed = 0.75, shock = 1.0, artillery = 1.0, turnRate = 0.45, figureSpacing = 5, rankSpacing = 3 },
	column = { ranks = 8, fire = 0.3, melee = 1.15, speed = 1.0, shock = 1.3, artillery = 1.9, turnRate = 0.9, figureSpacing = 4, rankSpacing = 3 },
	square = { ranks = 0, fire = 0.5, melee = 0.9, speed = 0.3, shock = 0.15, artillery = 2.2, turnRate = 1.2, figureSpacing = 4, rankSpacing = 4 },
	travel = { ranks = 12, fire = 0.0, melee = 0.6, speed = 1.0, shock = 1.8, artillery = 2.0, turnRate = 1.0, figureSpacing = 4, rankSpacing = 3 }, -- forced column at choke points
	limbered = { ranks = 1, fire = 0.0, melee = 0.3, speed = 1.0, shock = 3.0, artillery = 1.5, turnRate = 0.8, figureSpacing = 8, rankSpacing = 10 },
	deployed = { ranks = 1, fire = 1.0, melee = 0.3, speed = 0.0, shock = 3.0, artillery = 1.0, turnRate = 0.0, figureSpacing = 8, rankSpacing = 8 },
	wedge = { ranks = 4, fire = 0.0, melee = 1.0, speed = 1.0, shock = 1.0, artillery = 1.6, turnRate = 1.1, figureSpacing = 5, rankSpacing = 6 },
	staff = { ranks = 2, fire = 0.0, melee = 0.4, speed = 1.0, shock = 2.0, artillery = 1.5, turnRate = 1.5, figureSpacing = 4, rankSpacing = 4 },
}

-- Seconds to change shape (from any shape to the key). Square from column is faster.
Config.ReformTime = { line = 12, column = 8, square = 15, travel = 6, limbered = 25, deployed = 20, wedge = 4, staff = 2 }
Config.SquareFromColumnTime = 10

Config.Units = {
	infantry = {
		speed = 5.5, chargeSpeed = 7.5,
		defaultShape = "line", legalShapes = { line = true, column = true, square = true, travel = true },
		musket = { range = 90, reload = 15, accuracy = 0.07, minReadiness = 0.4 },
		melee = { attack = 1.0, defense = 1.0 },
		baseMorale = 70, fatigueMove = 0.35, fatigueCharge = 6.0, fatigueMelee = 2.0, rest = 1.5,
		spot = 260, halfWidthFactor = 1.0,
	},
	cavalry = {
		speed = 14.0, chargeSpeed = 20.0,
		defaultShape = "wedge", legalShapes = { wedge = true, line = true },
		musket = nil,
		melee = { attack = 1.4, defense = 0.8 },
		charge = { runUp = 80, base = 0.06, recovery = 40, maxMeleeSeconds = 25, frontFactor = 1.0, flankFactor = 1.8, rearFactor = 2.5 },
		baseMorale = 72, fatigueMove = 0.5, fatigueCharge = 7.0, fatigueMelee = 2.5, rest = 1.5,
		spot = 320,
	},
	artillery = {
		speed = 4.5, chargeSpeed = 4.5,
		defaultShape = "limbered", legalShapes = { limbered = true, deployed = true },
		musket = nil,
		melee = { attack = 0.2, defense = 0.4 },
		gun = {
			arcHalfAngle = 0.52, -- radians (30°)
			roundShot = { range = 450, minRange = 60, reload = 20, hit = 0.5, casualtiesPerHit = 3, morale = 3 },
			canister = { range = 120, minRange = 0, reload = 18, hit = 0.9, casualtiesPerHit = 7, morale = 5 },
			ammo = 40,
		},
		baseMorale = 60, fatigueMove = 0.3, fatigueCharge = 0.3, fatigueMelee = 2.0, rest = 1.5,
		spot = 240,
	},
	hq = {
		speed = 12.0, chargeSpeed = 12.0,
		defaultShape = "staff", legalShapes = { staff = true },
		musket = nil,
		melee = { attack = 0.3, defense = 0.5 },
		influence = { radius = 120, moraleBonus = 10, recoveryBonus = 0.3 },
		rally = { cooldown = 90, radius = 100, moraleRestore = 30, minRoutingSeconds = 5 },
		lossMoralePenalty = 15, -- to every friendly formation when the HQ is destroyed/exited
		baseMorale = 80, fatigueMove = 0.3, fatigueCharge = 0.3, fatigueMelee = 2.0, rest = 2.0,
		spot = 300,
	},
}

Config.Combat = {
	RangeFalloff = 0.65, -- hit factor at max range = 1 - falloff
	MaxHitChance = 0.30,
	TargetShapeFactor = { line = 1.0, column = 1.5, square = 1.3, travel = 1.6, limbered = 1.2, deployed = 1.0, wedge = 1.2, staff = 1.0 },
	FlankFireFactor = 1.35,
	RearFireFactor = 1.6,
	FriendlyBlocksFire = true, -- a friendly formation inside the fire lane blocks the volley
	FireLaneHalfWidth = 10,
	MeleeRatePerSecond = 0.0025, -- casualties = attackerStrength * rate * factors * dt
	MeleeDirFactor = { front = 1.0, flank = 1.6, rear = 2.2 },
	MeleeContactDistance = 6, -- studs between footprints
	BayonetBonus = 1.3,
	BayonetBonusSeconds = 10,
	BayonetMoraleShock = { front = 10, flank = 20 },
	ChargeShapeFactor = { line = 1.0, column = 1.3, square = 0.15, travel = 1.8, limbered = 3.0, deployed = 3.0, wedge = 1.0, staff = 2.0 },
	ChargeRoutingFactor = 1.5,
	SquareReturnsDamage = 2.0, -- cavalry in melee with a square takes x2
	MinRunUpFactor = 0.3,
	ExperienceAccuracy = 0.08, -- per experience level
	ExperienceMelee = 0.08,
	ExperienceMorale = 4,
	FatigueSpeedPenalty = 0.4,
	FatigueAccuracyPenalty = 0.3,
	FatigueMeleePenalty = 0.4,
	VolleyMinStrength = 10,
	ShakenFireFactor = 0.7,
	ShakenMeleeFactor = 0.8,
}

Config.Morale = {
	CasualtyFactor = 1.0, -- morale -= (casualties/strength) * 100 * factor
	FlankHitPenalty = 6, -- once per flank volley / cannonade / charge received
	RearHitPenalty = 12,
	FlankMeleePerSecond = 1.5,
	RearMeleePerSecond = 3,
	FriendRoutPenalty = 2, FriendRoutRadius = 80, FriendRoutMax = 6, FriendRoutInterval = 5,
	IsolationRadius = 150, IsolationPenalty = 1, IsolationInterval = 5,
	FatigueThreshold = 70, FatiguePenaltyPerSecond = 0.2,
	RecoveryPerSecond = 0.5, RecoveryDelay = 10, -- seconds without taking damage
	ShakenEnter = 40, ShakenExit = 50,
	RoutEnter = 20, RallyMorale = 35, MinRoutSeconds = 20,
	RallyNoEnemyRadius = 120,
	ShatterStrengthFraction = 0.3, MaxRouts = 2,
	RoutSpeedFactor = 1.3,
	RoutExitMargin = 20, -- studs outside map edge => exited
	CapturedGunsMorale = 5, -- penalty to the army when an artillery formation is destroyed
}

Config.Objectives = {
	CaptureRadius = 60,
	CaptureSeconds = 30,
	HoldAllSeconds = 120,
	HoldAllEarliest = 600, -- holding every objective only wins after this many seconds (gives the attacker a chance)
	EligibleClasses = { infantry = true, cavalry = true },
}

-- Weather / ground state per scenario (`scenario.weather`, optional `scenario.weatherUntil` seconds
-- after which it clears). Multipliers on musket accuracy, artillery hit chance, movement speed and
-- spotting distance.
Config.Weather = {
	clear = { accuracy = 1.0, cannon = 1.0, speed = 1.0, spot = 1.0, label = "Clear" },
	rain = { accuracy = 0.6, cannon = 0.85, speed = 0.9, spot = 0.8, label = "Rain" },
	mud = { accuracy = 0.9, cannon = 0.7, speed = 0.8, spot = 1.0, label = "Sodden ground" },
	fog = { accuracy = 0.9, cannon = 0.8, speed = 1.0, spot = 0.45, label = "Fog" },
	snow = { accuracy = 0.85, cannon = 0.9, speed = 0.8, spot = 0.7, label = "Snow" },
}

Config.Victory = {
	CollapseFraction = 0.7, -- fraction of formations routing/shattered/destroyed/exited
	CollapseStrengthFraction = 0.35,
	TimeLimitSeconds = 25 * 60,
}

Config.Match = {
	ReconnectGrace = 120,
	DeploymentMinSpacing = 8,
	MaxQueue = 4,
	LeashDistance = 160, -- engage/attack-move chase limit
	StuckSeconds = 4,
	AvoidanceRadius = 12,
}

Config.AI = {
	DecisionTicks = 10,
	PerceptionTicks = 10,
	CommitSeconds = 20,
	Difficulties = {
		easy = { reaction = 2.0, planQuality = 0.6, moraleBonus = 0 },
		normal = { reaction = 1.0, planQuality = 1.0, moraleBonus = 0 },
		hard = { reaction = 0.6, planQuality = 1.0, moraleBonus = 5 }, -- disclosed in settings
	},
}

Config.Net = {
	RequestsPerSecond = 30,
	MaxBatch = 24,
	MaxQueueDepth = 4,
	DedupeWindow = 4096,
}

return Config
]]></ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX00000003"><Properties><bool name="Disabled">false</bool><string name="Name">Grid</string><ProtectedString name="Source"><![CDATA[--!strict
-- Authoritative terrain grid: heights, terrain classes and clearance at Config.Map.CellSize.
-- Used by the server for navigation / LOS / placement and by the client to build visuals.
-- Flat arrays, 0-based cell coordinates, index = cz * cols + cx + 1.

local Config = require(script.Parent.Config)
local Vec = require(script.Parent.Vec)

type Vec = Vec.Vec

export type Grid = {
	cols: number,
	rows: number,
	cell: number,
	width: number,
	depth: number,
	height: { number },
	class: { number },
	clearance: { number }, -- studs to nearest impassable cell / map edge
}

local Grid = {}

local IDS = Config.TerrainIds
local TERRAIN = Config.Terrain

function Grid.new(cols: number, rows: number, cell: number): Grid
	local n = cols * rows
	local height = table.create(n, 0)
	local class = table.create(n, IDS.open)
	local clearance = table.create(n, 0)
	return {
		cols = cols,
		rows = rows,
		cell = cell,
		width = cols * cell,
		depth = rows * cell,
		height = height,
		class = class,
		clearance = clearance,
	}
end

function Grid.index(g: Grid, cx: number, cz: number): number
	return cz * g.cols + cx + 1
end

-- Cell containing world point, clamped to the grid.
function Grid.cellOf(g: Grid, x: number, z: number): (number, number)
	local cx = math.clamp(math.floor(x / g.cell), 0, g.cols - 1)
	local cz = math.clamp(math.floor(z / g.cell), 0, g.rows - 1)
	return cx, cz
end

function Grid.cellCenter(g: Grid, cx: number, cz: number): Vec
	return { x = (cx + 0.5) * g.cell, z = (cz + 0.5) * g.cell }
end

function Grid.inBounds(g: Grid, x: number, z: number): boolean
	return x >= 0 and z >= 0 and x < g.width and z < g.depth
end

function Grid.classAt(g: Grid, x: number, z: number): number
	local cx, cz = Grid.cellOf(g, x, z)
	return g.class[cz * g.cols + cx + 1]
end

function Grid.terrainAt(g: Grid, x: number, z: number)
	return TERRAIN[Grid.classAt(g, x, z)]
end

-- Bilinear height between cell centres.
function Grid.heightAt(g: Grid, x: number, z: number): number
	local fx = math.clamp(x / g.cell - 0.5, 0, g.cols - 1)
	local fz = math.clamp(z / g.cell - 0.5, 0, g.rows - 1)
	local x0 = math.floor(fx)
	local z0 = math.floor(fz)
	local x1 = math.min(x0 + 1, g.cols - 1)
	local z1 = math.min(z0 + 1, g.rows - 1)
	local tx = fx - x0
	local tz = fz - z0
	local h = g.height
	local c = g.cols
	local h00 = h[z0 * c + x0 + 1]
	local h10 = h[z0 * c + x1 + 1]
	local h01 = h[z1 * c + x0 + 1]
	local h11 = h[z1 * c + x1 + 1]
	local a = h00 + (h10 - h00) * tx
	local b = h01 + (h11 - h01) * tx
	return a + (b - a) * tz
end

-- Rise per stud along x and z (central differences over one cell).
function Grid.gradient(g: Grid, x: number, z: number): (number, number)
	local d = g.cell
	local gx = (Grid.heightAt(g, x + d, z) - Grid.heightAt(g, x - d, z)) / (2 * d)
	local gz = (Grid.heightAt(g, x, z + d) - Grid.heightAt(g, x, z - d)) / (2 * d)
	return gx, gz
end

function Grid.slopeMagnitude(g: Grid, x: number, z: number): number
	local gx, gz = Grid.gradient(g, x, z)
	return math.sqrt(gx * gx + gz * gz)
end

-- Signed rise per stud when moving in direction dir (unit vector). Positive = uphill.
function Grid.slopeAlong(g: Grid, x: number, z: number, dir: Vec): number
	local gx, gz = Grid.gradient(g, x, z)
	return gx * dir.x + gz * dir.z
end

function Grid.isPassableCell(g: Grid, cx: number, cz: number): boolean
	if cx < 0 or cz < 0 or cx >= g.cols or cz >= g.rows then
		return false
	end
	return TERRAIN[g.class[cz * g.cols + cx + 1]].passable
end

function Grid.clearanceAt(g: Grid, x: number, z: number): number
	if not Grid.inBounds(g, x, z) then
		return 0
	end
	local cx, cz = Grid.cellOf(g, x, z)
	return g.clearance[cz * g.cols + cx + 1]
end

-- A footprint of the given half-width fits at (x, z).
function Grid.fits(g: Grid, x: number, z: number, halfWidth: number): boolean
	return Grid.clearanceAt(g, x, z) >= halfWidth
end

-- Multi-source BFS (8-neighbour, Chebyshev) from impassable cells and the map border.
-- clearance = cells * cell size; an impassable cell has clearance 0.
function Grid.computeClearance(g: Grid)
	local cols, rows = g.cols, g.rows
	local n = cols * rows
	local dist = table.create(n, -1)
	local queue = table.create(n, 0)
	local head, tail = 1, 0
	local class = g.class
	for i = 1, n do
		local cx = (i - 1) % cols
		local cz = (i - 1) // cols
		local border = cx == 0 or cz == 0 or cx == cols - 1 or cz == rows - 1
		if not TERRAIN[class[i]].passable then
			dist[i] = 0
			tail += 1
			queue[tail] = i
		elseif border then
			dist[i] = 1
			tail += 1
			queue[tail] = i
		end
	end
	while head <= tail do
		local i = queue[head]
		head += 1
		local cx = (i - 1) % cols
		local cz = (i - 1) // cols
		local d = dist[i] + 1
		for dz = -1, 1 do
			local nz = cz + dz
			if nz >= 0 and nz < rows then
				for dx = -1, 1 do
					local nx = cx + dx
					if nx >= 0 and nx < cols then
						local j = nz * cols + nx + 1
						if dist[j] < 0 then
							dist[j] = d
							tail += 1
							queue[tail] = j
						end
					end
				end
			end
		end
	end
	local clearance = g.clearance
	local cell = g.cell
	for i = 1, n do
		clearance[i] = math.max(dist[i], 0) * cell
	end
end

-- Line of sight between two ground points. Intermediate samples use terrain height plus the
-- class sightHeight (woods/village block). Samples within `skip` studs of either end are
-- ignored so a unit at a wood's edge can see out; spotting units *inside* cover is handled by
-- Config.Vision.WoodsReveal in the visibility module.
function Grid.lineOfSight(g: Grid, a: Vec, b: Vec, eyeA: number?, eyeB: number?): boolean
	local ea = (eyeA or Config.Vision.EyeHeight)
	local eb = (eyeB or Config.Vision.EyeHeight)
	local ha = Grid.heightAt(g, a.x, a.z) + ea
	local hb = Grid.heightAt(g, b.x, b.z) + eb
	local dx, dz = b.x - a.x, b.z - a.z
	local len = math.sqrt(dx * dx + dz * dz)
	if len < g.cell then
		return true
	end
	local step = g.cell
	local skip = 8
	local steps = math.floor(len / step)
	for i = 1, steps - 1 do
		local t = i / steps
		local s = t * len
		if s > skip and s < len - skip then
			local x = a.x + dx * t
			local z = a.z + dz * t
			local cx, cz = Grid.cellOf(g, x, z)
			local cls = g.class[cz * g.cols + cx + 1]
			local terrainH = Grid.heightAt(g, x, z) + TERRAIN[cls].sightHeight
			local lineH = ha + (hb - ha) * t
			if terrainH > lineH + Config.Vision.SightTolerance then
				return false
			end
		end
	end
	return true
end

Grid.Ids = IDS

return Grid
]]></ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX00000004"><Properties><bool name="Disabled">false</bool><string name="Name">MapGen</string><ProtectedString name="Source"><![CDATA[--!strict
-- Deterministic battlefield generator. The same call on server and client yields identical
-- grids and feature lists; the server treats the grid as the only terrain truth, the client
-- renders it. Authored feature lists live in MAPS below; everything else is derived.

local Config = require(script.Parent.Config)
local Grid = require(script.Parent.Grid)
local RNG = require(script.Parent.RNG)
local Vec = require(script.Parent.Vec)

type Vec = Vec.Vec
type Grid = Grid.Grid

export type Hill = { name: string?, pos: Vec, rx: number, rz: number, h: number, k: number }
export type Building = { pos: Vec, heading: number, w: number, d: number, h: number }
export type Village = { name: string, pos: Vec, radius: number, buildings: { Building }, count: number }
export type Tree = { x: number, z: number, r: number, priority: number }
export type Woods = { name: string?, pos: Vec, rx: number, rz: number, trees: { Tree } }
export type Road = { points: { Vec }, width: number }
export type River = { name: string, points: { Vec }, width: number, level: number }
export type Bridge = { a: Vec, b: Vec, width: number }
export type Label = { text: string, pos: Vec, size: number }
export type Objective = { id: string, name: string, pos: Vec, radius: number }
export type Rect = { x0: number, z0: number, x1: number, z1: number }

export type MapData = {
	id: string,
	name: string,
	width: number,
	depth: number,
	grid: Grid,
	hills: { Hill },
	villages: { Village },
	woods: { Woods },
	roads: { Road },
	rivers: { River },
	bridges: { Bridge },
	labels: { Label },
	objectives: { Objective },
	deployZones: { [string]: Rect },
	seed: number,
}

type MapDef = {
	name: string,
	seed: number,
	width: number?, -- studs, multiple of 16; defaults to Config.Map.Width
	depth: number?,
	baseHeight: number,
	hills: { Hill },
	villages: { { name: string, pos: Vec, radius: number, count: number } },
	woods: { { name: string?, pos: Vec, rx: number, rz: number } },
	roads: { Road },
	rivers: { River },
	bridges: { Bridge },
	labels: { Label },
	objectives: { Objective },
	deployZones: { [string]: Rect },
	valley: { x0: number, x1: number, floor: number }?,
}

local IDS = Config.TerrainIds
local MapGen = {}

local function v(x: number, z: number): Vec
	return { x = x, z = z }
end

local function smooth(t: number): number
	t = math.clamp(t, 0, 1)
	return t * t * (3 - 2 * t)
end

-- Lattice hashes are memoised per generate() call: neighbouring cells share corners, and the
-- hash dominates pass 1 otherwise. Keys are exact integers so results stay deterministic.
local memo: { [number]: number } = {}
local function corner(ix: number, iz: number, seed: number): number
	local key = (seed * 8192 + iz + 4096) * 8192 + ix + 4096
	local h = memo[key]
	if h == nil then
		h = RNG.hash(ix, iz, seed)
		memo[key] = h
	end
	return h
end

-- Value noise in [0,1).
local function noise(x: number, z: number, scale: number, seed: number): number
	local fx, fz = x / scale, z / scale
	local ix, iz = math.floor(fx), math.floor(fz)
	local tx, tz = smooth(fx - ix), smooth(fz - iz)
	local a = corner(ix, iz, seed)
	local b = corner(ix + 1, iz, seed)
	local c = corner(ix, iz + 1, seed)
	local d = corner(ix + 1, iz + 1, seed)
	local top = a + (b - a) * tx
	local bottom = c + (d - c) * tx
	return top + (bottom - top) * tz
end

-- Irregular ellipse membership in [0, inf): < 1 inside.
local function blobDistance(p: Vec, pos: Vec, rx: number, rz: number, seed: number): number
	local dx, dz = (p.x - pos.x) / rx, (p.z - pos.z) / rz
	local d = math.sqrt(dx * dx + dz * dz)
	local wobble = (noise(p.x, p.z, 48, seed) - 0.5) * 0.5
	return d + wobble
end

local function bbox(points: { Vec }, pad: number): Rect
	local r = { x0 = math.huge, z0 = math.huge, x1 = -math.huge, z1 = -math.huge }
	for _, p in points do
		r.x0 = math.min(r.x0, p.x - pad)
		r.z0 = math.min(r.z0, p.z - pad)
		r.x1 = math.max(r.x1, p.x + pad)
		r.z1 = math.max(r.z1, p.z + pad)
	end
	return r
end

local function inRect(r: Rect, x: number, z: number): boolean
	return x >= r.x0 and x <= r.x1 and z >= r.z0 and z <= r.z1
end

