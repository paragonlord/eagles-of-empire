MAPS.village = {
	name = "Defence of Vierzehnheiligen",
	seed = 3307,
	baseHeight = 24,
	hills = {
		{ name = "Village rise", pos = v(800, 700), rx = 260, rz = 180, h = 14, k = 0.6 },
		{ pos = v(800, 150), rx = 500, rz = 160, h = 18, k = 0.5 },
	},
	villages = { { name = "Vierzehnheiligen", pos = v(800, 700), radius = 60, count = 24 }, { name = "Krippendorf", pos = v(500, 1050), radius = 42, count = 14 } },
	woods = { { pos = v(260, 600), rx = 160, rz = 120 }, { pos = v(1330, 760), rx = 150, rz = 110 } },
	roads = {
		{ points = { v(800, 0), v(800, 700), v(500, 1050), v(480, 1200) }, width = 6 },
		{ points = { v(0, 760), v(800, 700), v(1600, 720) }, width = 5 },
	},
	rivers = {},
	bridges = {},
	labels = {},
	objectives = { { id = "village", name = "Vierzehnheiligen", pos = v(800, 700), radius = 60 } },
	deployZones = {
		france = { x0 = 200, z0 = 60, x1 = 1400, z1 = 380 },
		prussia = { x0 = 300, z0 = 560, x1 = 1300, z1 = 1000 },
	},
	valley = nil,
}

function MapGen.list(): { string }
	return { "jena", "auerstedt", "austerlitz", "waterloo", "bridge", "village" }
end

function MapGen.generate(mapId: string): MapData
	local def = MAPS[mapId]
	assert(def, "unknown map " .. tostring(mapId))
	local cell = Config.Map.CellSize
	local cols = (def.width or Config.Map.Width) // cell
	local rows = (def.depth or Config.Map.Depth) // cell
	local g = Grid.new(cols, rows, cell)
	local seed = def.seed
	memo = {}

	-- Precomputed bounding boxes for feature culling. Polylines are culled per segment so a
	-- road or river crossing the whole map does not cost a distance test on every cell.
	local hillBox: { Rect } = {}
	for i, h in def.hills do
		hillBox[i] = { x0 = h.pos.x - h.rx, z0 = h.pos.z - h.rz, x1 = h.pos.x + h.rx, z1 = h.pos.z + h.rz }
	end
	local woodBox: { Rect } = {}
	for i, w in def.woods do
		woodBox[i] = { x0 = w.pos.x - w.rx * 1.3, z0 = w.pos.z - w.rz * 1.3, x1 = w.pos.x + w.rx * 1.3, z1 = w.pos.z + w.rz * 1.3 }
	end
	type Seg = { a: Vec, b: Vec, box: Rect }
	local function segments(points: { Vec }, pad: number): { Seg }
		local out: { Seg } = {}
		for i = 1, #points - 1 do
			out[i] = { a = points[i], b = points[i + 1], box = bbox({ points[i], points[i + 1] }, pad) }
		end
		return out
	end
	local function nearest(segs: { Seg }, p: Vec): number
		local best = math.huge
		for _, s in segs do
			if inRect(s.box, p.x, p.z) then
				local d = Vec.distToSegment(p, s.a, s.b)
				if d < best then
					best = d
				end
			end
		end
		return best
	end
	local roadSegs: { { Seg } } = {}
	for i, r in def.roads do
		roadSegs[i] = segments(r.points, r.width)
	end
	local riverSegs: { { Seg } } = {}
	for i, r in def.rivers do
		riverSegs[i] = segments(r.points, r.width / 2 + 30)
	end
	local bridgeBox: { Rect } = {}
	for i, b in def.bridges do
		bridgeBox[i] = bbox({ b.a, b.b }, b.width / 2 + 2)
	end

	local function woodsInside(p: Vec, i: number): boolean
		local w = def.woods[i]
		return blobDistance(p, w.pos, w.rx, w.rz, seed + 11 + i) < 1
	end

	local function villageInside(p: Vec, i: number): boolean
		local vl = def.villages[i]
		local d = Vec.dist(p, vl.pos) / vl.radius
		return d + (noise(p.x, p.z, 30, seed + 31 + i) - 0.5) * 0.4 < 1
	end

	-- Pass 1: heights and classes.
	local heightArr = g.height
	local classArr = g.class
	for cz = 0, rows - 1 do
		for cx = 0, cols - 1 do
			local x = (cx + 0.5) * cell
			local z = (cz + 0.5) * cell
			local p = v(x, z)
			local h = def.baseHeight + (noise(x, z, 150, seed + 1) - 0.5) * 10 + (noise(x, z, 42, seed + 2) - 0.5) * 3
			for i, hill in def.hills do
				if inRect(hillBox[i], x, z) then
					local dx, dz = (x - hill.pos.x) / hill.rx, (z - hill.pos.z) / hill.rz
					local d = math.sqrt(dx * dx + dz * dz) + (noise(x, z, 90, seed + 100 + i) - 0.5) * 0.18
					if d < 1 then
						h += hill.h * smooth((1 - d) / hill.k)
					end
				end
			end
			if def.valley then
				local t = smooth((x - def.valley.x0) / (def.valley.x1 - def.valley.x0))
				h = h + (def.valley.floor - h) * t
			end
			local cls = IDS.open
			for i = 1, #def.woods do
				if inRect(woodBox[i], x, z) and woodsInside(p, i) then
					cls = IDS.woods
					break
				end
			end
			for i = 1, #def.villages do
				if Vec.dist2(p, def.villages[i].pos) < (def.villages[i].radius * 1.3) ^ 2 and villageInside(p, i) then
					cls = IDS.village
					break
				end
			end
			for i, river in def.rivers do
				local d = nearest(riverSegs[i], p)
				local half = river.width / 2
				if d < half then
					cls = IDS.water
					h = math.min(h, river.level - 3)
				elseif d < half + 24 then
					local t = smooth((d - half) / 24)
					h = math.min(h, (river.level + 0.5) + (h - (river.level + 0.5)) * t)
				end
			end
			for i, road in def.roads do
				if cls ~= IDS.village and cls ~= IDS.water and nearest(roadSegs[i], p) < road.width / 2 then
					cls = IDS.road
				end
			end
			for i, bridge in def.bridges do
				if inRect(bridgeBox[i], x, z) and Vec.distToSegment(p, bridge.a, bridge.b) < bridge.width / 2 then
					cls = IDS.bridge
					local hb = math.max(Grid.heightAt(g, bridge.a.x, bridge.a.z), 0)
					h = math.max(h, hb)
				end
			end
			local idx = cz * cols + cx + 1
			heightArr[idx] = h
			classArr[idx] = cls
		end
	end

	-- Bridges sit at bank height: resample now that heights exist.
	for i, bridge in def.bridges do
		local ha = Grid.heightAt(g, bridge.a.x, bridge.a.z)
		local hb = Grid.heightAt(g, bridge.b.x, bridge.b.z)
		local deck = math.max(ha, hb)
		local box = bridgeBox[i]
		local cx0, cz0 = Grid.cellOf(g, box.x0, box.z0)
		local cx1, cz1 = Grid.cellOf(g, box.x1, box.z1)
		for cz = cz0, cz1 do
			for cx = cx0, cx1 do
				local idx = cz * cols + cx + 1
				if classArr[idx] == IDS.bridge then
					local p = Grid.cellCenter(g, cx, cz)
					if Vec.distToSegment(p, bridge.a, bridge.b) < bridge.width / 2 then
						heightArr[idx] = deck
					end
				end
			end
		end
	end

	-- Pass 2: slope classes on natural ground.
	for cz = 0, rows - 1 do
		for cx = 0, cols - 1 do
			local idx = cz * cols + cx + 1
			local cls = classArr[idx]
			if cls == IDS.open or cls == IDS.woods then
				local p = Grid.cellCenter(g, cx, cz)
				local s = Grid.slopeMagnitude(g, p.x, p.z)
				if s > Config.Slope.Impassable then
					classArr[idx] = IDS.cliff
				elseif s > Config.Slope.Steep and cls == IDS.open then
					classArr[idx] = IDS.steep
				end
			end
		end
	end

	Grid.computeClearance(g)

	-- Feature lists for the client (trees, buildings) derived deterministically.
	local woods: { Woods } = {}
	for i, w in def.woods do
		local trees: { Tree } = {}
		local spacing = 9
		local x0 = math.floor((w.pos.x - w.rx * 1.3) / spacing) * spacing
		local z0 = math.floor((w.pos.z - w.rz * 1.3) / spacing) * spacing
		local x = x0
		while x <= w.pos.x + w.rx * 1.3 do
			local z = z0
			while z <= w.pos.z + w.rz * 1.3 do
				local jx = (RNG.hash(x, z, seed + 500 + i) - 0.5) * spacing * 0.9
				local jz = (RNG.hash(z, x, seed + 600 + i) - 0.5) * spacing * 0.9
				local px, pz = x + jx, z + jz
				if Grid.inBounds(g, px, pz) and Grid.classAt(g, px, pz) == IDS.woods then
					trees[#trees + 1] = {
						x = px,
						z = pz,
						r = 4.5 + RNG.hash(x, z, seed + 700) * 3.5,
						priority = RNG.hash(x, z, seed + 800),
					}
				end
				z += spacing
			end
			x += spacing
		end
		woods[i] = { name = w.name, pos = w.pos, rx = w.rx, rz = w.rz, trees = trees }
	end

	local villages: { Village } = {}
	for i, vl in def.villages do
		local buildings: { Building } = {}
		-- Houses line the road segments that pass through the village.
		for ri, road in def.roads do
			for si = 1, #road.points - 1 do
				local a, b = road.points[si], road.points[si + 1]
				local segLen = Vec.dist(a, b)
				local dir = Vec.normalize(Vec.sub(b, a))
				local right = Vec.right(dir)
				local s = 6
				while s < segLen do
					local c = Vec.add(a, Vec.scale(dir, s))
					if Vec.dist(c, vl.pos) < vl.radius then
						for side = -1, 1, 2 do
							local k = RNG.hash(ri * 1000 + si, math.floor(s), seed + 900 + side)
							if k < 0.8 then
								local off = side * (road.width / 2 + 6 + k * 4)
								local pos = Vec.add(c, Vec.scale(right, off))
								if Grid.inBounds(g, pos.x, pos.z) then
									local cls = Grid.classAt(g, pos.x, pos.z)
									if cls == IDS.village or cls == IDS.open then
										buildings[#buildings + 1] = {
											pos = pos,
											heading = Vec.heading(dir),
											w = 8 + k * 5,
											d = 6 + RNG.hash(math.floor(s), ri, seed + 950) * 4,
											h = 5 + RNG.hash(ri, math.floor(s), seed + 960) * 3,
										}
									end
								end
							end
						end
					end
					s += 14
				end
			end
		end
		-- Fill the rest of the quota with houses scattered around the centre.
		local attempts = 0
		while #buildings < vl.count and attempts < vl.count * 6 do
			attempts += 1
			local ang = RNG.hash(i, attempts, seed + 970) * math.pi * 2
			local rad = 10 + RNG.hash(attempts, i, seed + 980) * (vl.radius - 14)
			local pos = v(vl.pos.x + math.cos(ang) * rad, vl.pos.z + math.sin(ang) * rad)
			local ok = Grid.inBounds(g, pos.x, pos.z) and Grid.classAt(g, pos.x, pos.z) == IDS.village
			if ok then
				for _, bld in buildings do
					if Vec.dist2(bld.pos, pos) < 12 * 12 then
						ok = false
						break
					end
				end
			end
			if ok then
				buildings[#buildings + 1] = {
					pos = pos,
					heading = RNG.hash(attempts, i, seed + 990) * math.pi,
					w = 8 + RNG.hash(i, attempts, seed + 991) * 4,
					d = 6 + RNG.hash(i, attempts, seed + 992) * 3,
					h = 5 + RNG.hash(i, attempts, seed + 993) * 3,
				}
			end
		end
		villages[i] = { name = vl.name, pos = vl.pos, radius = vl.radius, buildings = buildings, count = vl.count }
	end

	local labels: { Label } = {}
	for _, l in def.labels do
		labels[#labels + 1] = l
	end
	for _, vl in def.villages do
		labels[#labels + 1] = { text = vl.name, pos = v(vl.pos.x, vl.pos.z - vl.radius - 14), size = 1.0 }
	end

	return {
		id = mapId,
		name = def.name,
		width = g.width,
		depth = g.depth,
		grid = g,
		hills = def.hills,
		villages = villages,
		woods = woods,
		roads = def.roads,
		rivers = def.rivers,
		bridges = def.bridges,
		labels = labels,
		objectives = def.objectives,
		deployZones = def.deployZones,
		seed = seed,
	}
end

function MapGen.inZone(map: MapData, faction: string, p: Vec): boolean
	local r = map.deployZones[faction]
	if not r then
		return false
	end
	return inRect(r, p.x, p.z)
end

return MapGen
]]></ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX00000005"><Properties><bool name="Disabled">false</bool><string name="Name">Protocol</string><ProtectedString name="Source"><![CDATA[--!strict
-- Client ↔ server protocol: remote names, command kinds, limits and the pure validator.
-- The server is the only authority; the client may run the same validator for early feedback.

local Config = require(script.Parent.Config)
local Vec = require(script.Parent.Vec)

type Vec = Vec.Vec

local Protocol = {}

Protocol.Remotes = {
	Command = "Command",
	Control = "Control",
	CommandResult = "CommandResult",
	Snapshot = "Snapshot",
	MatchState = "MatchState",
	Campaign = "Campaign",
	Debug = "Debug",
}

-- kind -> allowed unit classes (false = any class)
Protocol.CommandKinds = {
	Move = false,
	AttackMove = { infantry = true, cavalry = true },
	Engage = { infantry = true, cavalry = true, artillery = true },
	Stop = false,
	Hold = false,
	Face = false,
	Retreat = false,
	Shape = { infantry = true, cavalry = true },
	Stance = { infantry = true, artillery = true },
	Charge = { infantry = true, cavalry = true },
	Rally = { hq = true },
	Limber = { artillery = true },
	Deploy = false, -- pre-battle placement
	Ammo = { artillery = true }, -- choose roundShot / canister preference
} :: { [string]: { [string]: boolean } | false }

Protocol.ControlActions = {
	start = true,
	pause = true,
	resume = true,
	speed = true,
	restart = true,
	ready = true,
	difficulty = true,
	quit = true,
	spectate = true,
}

Protocol.Reasons = {
	ok = "ok",
	badRequest = "Malformed request",
	wrongMatch = "Request is for a different match",
	notCommander = "Only the commander may issue orders",
	badKind = "Unknown command",
	badIds = "Formation list is empty or too long",
	notOwned = "That formation is not yours",
	wrongClass = "That unit cannot take this order",
	badPosition = "Position is off the battlefield",
	badHeading = "Invalid facing",
	badTarget = "Invalid target",
	badShape = "That formation cannot adopt this shape",
	badState = "Not available in this match state",
	rateLimited = "Too many requests",
	duplicate = "Duplicate request",
	routing = "A routing formation cannot take orders",
	destroyed = "That formation is no longer in the field",
	cooldown = "Ability is recharging",
	noSpace = "Not enough room there",
	unreachable = "No route to that position",
	deployZone = "Outside your deployment zone",
	notPaused = "Only the commander may pause",
}

export type ValidateContext = {
	matchId: string,
	state: string, -- deployment | running | paused | ...
	mapWidth: number,
	mapDepth: number,
	isOwned: (id: number) -> boolean,
	classOf: (id: number) -> string?,
	legalShapes: (id: number) -> { [string]: boolean }?,
}

local MAX_REQUEST_ID = 48

local function finiteNumber(n: any): boolean
	return type(n) == "number" and n == n and math.abs(n) ~= math.huge
end

local function checkIds(ids: any, ctx: ValidateContext, kind: string): (boolean, string?)
	if type(ids) ~= "table" then
		return false, Protocol.Reasons.badIds
	end
	local n = #ids
	if n < 1 or n > Config.Net.MaxBatch then
		return false, Protocol.Reasons.badIds
	end
	local allowed = Protocol.CommandKinds[kind]
	local seen: { [number]: boolean } = {}
	for i = 1, n do
		local id = ids[i]
		if type(id) ~= "number" or id ~= math.floor(id) or id < 1 or seen[id] then
			return false, Protocol.Reasons.badIds
		end
		seen[id] = true
		if not ctx.isOwned(id) then
			return false, Protocol.Reasons.notOwned
		end
		if type(allowed) == "table" then
			local cls = ctx.classOf(id)
			if not cls or not allowed[cls] then
				return false, Protocol.Reasons.wrongClass
			end
		end
	end
	return true, nil
end

local function checkPos(p: any, ctx: ValidateContext): (boolean, string?)
	if not Vec.isFinite(p) then
		return false, Protocol.Reasons.badPosition
	end
	if p.x < 0 or p.z < 0 or p.x >= ctx.mapWidth or p.z >= ctx.mapDepth then
		return false, Protocol.Reasons.badPosition
	end
	return true, nil
end

local function checkHeading(h: any, optional: boolean): (boolean, string?)
	if h == nil and optional then
		return true, nil
	end
	if not finiteNumber(h) then
		return false, Protocol.Reasons.badHeading
	end
	return true, nil
end

-- Returns ok, reason. Structural + ownership validation only; game-state validity
-- (reachability, cooldowns, routing) is decided by the simulation when the command applies.
function Protocol.validateCommand(cmd: any, ctx: ValidateContext): (boolean, string?)
	if type(cmd) ~= "table" then
		return false, Protocol.Reasons.badRequest
	end
	if type(cmd.requestId) ~= "string" or #cmd.requestId == 0 or #cmd.requestId > MAX_REQUEST_ID then
		return false, Protocol.Reasons.badRequest
	end
	if cmd.matchId ~= ctx.matchId then
		return false, Protocol.Reasons.wrongMatch
	end
	local kind = cmd.kind
	if type(kind) ~= "string" or Protocol.CommandKinds[kind] == nil then
		return false, Protocol.Reasons.badKind
	end
	local okIds, reasonIds = checkIds(cmd.ids, ctx, kind)
	if not okIds then
		return false, reasonIds
	end
	local data = cmd.data
	if data ~= nil and type(data) ~= "table" then
		return false, Protocol.Reasons.badRequest
	end
	data = data or {}
	if data.queue ~= nil and type(data.queue) ~= "boolean" then
		return false, Protocol.Reasons.badRequest
	end

	if kind == "Deploy" then
		if ctx.state ~= "deployment" then
			return false, Protocol.Reasons.badState
		end
		local okP, rP = checkPos(data.pos, ctx)
		if not okP then
			return false, rP
		end
		return checkHeading(data.heading, false)
	end

	if ctx.state ~= "running" and ctx.state ~= "paused" then
		return false, Protocol.Reasons.badState
	end

	if kind == "Move" or kind == "AttackMove" or kind == "Retreat" then
		if kind ~= "Retreat" or data.pos ~= nil then
			local okP, rP = checkPos(data.pos, ctx)
			if not okP then
				return false, rP
			end
		end
		local okH, rH = checkHeading(data.heading, true)
		if not okH then
			return false, rH
		end
		if data.frontage ~= nil and (not finiteNumber(data.frontage) or data.frontage < 0 or data.frontage > ctx.mapWidth) then
			return false, Protocol.Reasons.badRequest
		end
		return true, nil
	elseif kind == "Engage" or kind == "Charge" then
		local t = data.targetId
		if kind == "Charge" and t == nil then
			-- bayonet/cavalry charge toward a position is allowed
			local okP, rP = checkPos(data.pos, ctx)
			if not okP then
				return false, rP
			end
			return true, nil
		end
		if type(t) ~= "number" or t ~= math.floor(t) or t < 1 then
			return false, Protocol.Reasons.badTarget
		end
		if ctx.isOwned(t) then
			return false, Protocol.Reasons.badTarget
		end
		return true, nil
	elseif kind == "Face" then
		return checkHeading(data.heading, false)
	elseif kind == "Shape" then
		if type(data.shape) ~= "string" then
			return false, Protocol.Reasons.badShape
		end
		for _, id in cmd.ids do
			local legal = ctx.legalShapes(id)
			if not legal or not legal[data.shape] then
				return false, Protocol.Reasons.badShape
			end
		end
		return true, nil
	elseif kind == "Stance" then
		if type(data.fireAtWill) ~= "boolean" then
			return false, Protocol.Reasons.badRequest
		end
		return true, nil
	elseif kind == "Limber" then
		if type(data.limbered) ~= "boolean" then
			return false, Protocol.Reasons.badRequest
		end
		return true, nil
	elseif kind == "Ammo" then
		if data.ammo ~= "roundShot" and data.ammo ~= "canister" and data.ammo ~= "auto" then
			return false, Protocol.Reasons.badRequest
		end
		return true, nil
	elseif kind == "Rally" then
		return true, nil
	elseif kind == "Stop" or kind == "Hold" then
		return true, nil
	end
	return false, Protocol.Reasons.badKind
end

function Protocol.validateControl(msg: any, ctx: { matchId: string }): (boolean, string?)
	if type(msg) ~= "table" then
		return false, Protocol.Reasons.badRequest
	end
	if type(msg.requestId) ~= "string" or #msg.requestId == 0 or #msg.requestId > MAX_REQUEST_ID then
		return false, Protocol.Reasons.badRequest
	end
	if type(msg.action) ~= "string" or not Protocol.ControlActions[msg.action] then
		return false, Protocol.Reasons.badKind
	end
	-- spectate / quit are state requests that do not depend on knowing the current match id
	if msg.action ~= "spectate" and msg.action ~= "quit" and msg.matchId ~= nil and msg.matchId ~= ctx.matchId then
		return false, Protocol.Reasons.wrongMatch
	end
	if msg.action == "speed" then
		local ok = false
		for _, s in Config.Sim.Speeds do
			if msg.value == s then
				ok = true
			end
		end
		if not ok then
			return false, Protocol.Reasons.badRequest
		end
	elseif msg.action == "difficulty" then
		if type(msg.value) ~= "string" or not (Config.AI.Difficulties :: any)[msg.value] then
			return false, Protocol.Reasons.badRequest
		end
	elseif msg.action == "start" or msg.action == "restart" then
		if msg.value ~= nil and type(msg.value) ~= "string" then
			return false, Protocol.Reasons.badRequest
		end
	end
	return true, nil
end

return Protocol
]]></ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX00000006"><Properties><bool name="Disabled">false</bool><string name="Name">RNG</string><ProtectedString name="Source"><![CDATA[--!strict
-- Deterministic xorshift32 RNG with a serializable integer state. All simulation randomness
-- goes through one instance owned by the sim; cosmetic randomness uses separate instances.

local RNG = {}
RNG.__index = RNG

export type RNG = typeof(setmetatable({} :: { state: number }, RNG))

function RNG.new(seed: number): RNG
	local s = bit32.band(math.floor(seed), 0xFFFFFFFF)
	if s == 0 then
		s = 0x9E3779B9
	end
	return setmetatable({ state = s }, RNG)
end

function RNG.fromState(state: number): RNG
	return RNG.new(state)
end

function RNG.nextU32(self: RNG): number
	local x = self.state
	x = bit32.bxor(x, bit32.lshift(x, 13))
	x = bit32.bxor(x, bit32.rshift(x, 17))
	x = bit32.bxor(x, bit32.lshift(x, 5))
	self.state = x
	return x
end

-- [0, 1)
function RNG.float(self: RNG): number
	return RNG.nextU32(self) / 4294967296
end

-- integer in [lo, hi]
function RNG.int(self: RNG, lo: number, hi: number): number
	return lo + RNG.nextU32(self) % (hi - lo + 1)
end

-- float in [lo, hi)
function RNG.range(self: RNG, lo: number, hi: number): number
	return lo + RNG.float(self) * (hi - lo)
end

function RNG.chance(self: RNG, p: number): boolean
	return RNG.float(self) < p
end

function RNG.serialize(self: RNG): number
	return self.state
end

-- 32-bit multiply without exceeding 2^53 in intermediates (keeps results exact everywhere).
local function mul32(a: number, b: number): number
	local lo = bit32.band(a, 0xFFFF) * b
	local hi = (bit32.rshift(a, 16) * b) % 4294967296
	return (lo + bit32.lshift(hi, 16)) % 4294967296
end

-- Stateless hash in [0,1) for keyed event randomness and noise (no RNG state needed).
-- Inputs are floored and reduced mod 2^32; typical callers pass small integers.
function RNG.hash(a: number, b: number, c: number): number
	local h = (math.floor(a) % 4294967296 * 73856093 + math.floor(b) % 4294967296 * 19349663 + math.floor(c) % 4294967296 * 83492791) % 4294967296
	h = bit32.bxor(h, bit32.rshift(h, 13))
	h = mul32(h, 0x5bd1e995)
	h = bit32.bxor(h, bit32.rshift(h, 15))
	h = mul32(h, 0x27d4eb2f)
	h = bit32.bxor(h, bit32.rshift(h, 16))
	return h / 4294967296
end

return RNG
]]></ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX00000007"><Properties><bool name="Disabled">false</bool><string name="Name">Scenarios</string><ProtectedString name="Source"><![CDATA[--!strict
-- Orders of battle. Condensed and partly representative: regiment names are drawn from
-- formations present at each battle where known (docs/battles.md says which names are attested
-- and which are representative), strengths are balance choices (docs/rules.md), not returns.
-- Positions are initial deployment inside the zones; `arrival` units start off the map.

local Vec = require(script.Parent.Vec)

type Vec = Vec.Vec

export type UnitDef = {
	name: string,
	class: "infantry" | "cavalry" | "artillery" | "hq",
	corps: string,
	strength: number,
	experience: number,
	pos: Vec,
	heading: number,
	faction: string,
	colour: string?, -- palette key override (Saxony, Austria, Netherlands, Prussia under britain...)
	commander: boolean?, -- is the army HQ
	key: string?, -- campaign identity of this unit (nil for standalone battles)
	arrival: { seconds: number, pos: Vec }?, -- off-map reinforcement: enters at pos at that sim time
}

export type Scenario = {
	id: string,
	name: string,
	map: string,
	briefing: string,
	factions: { player: string, enemy: string },
	factionNames: { [string]: string },
	units: { UnitDef },
	timeLimit: number?,
	date: string?, -- display date, e.g. "14 October 1806"
	year: number?,
	summary: string?, -- what happened historically and the result
	difficultyNote: string?, -- e.g. "Hard: you are outnumbered 2:1"
	weather: string?, -- key into Config.Weather; nil = clear
	weatherUntil: number?, -- sim seconds after which the weather clears
}

export type ListEntry = { id: string, name: string, date: string?, map: string, factionNames: { [string]: string }, summary: string?, difficultyNote: string? }

local NORTH = math.pi / 2
local SOUTH = -math.pi / 2
local EAST = 0
local WEST = math.pi

type Extra = { colour: string?, commander: boolean?, arrival: { seconds: number, pos: Vec }? }

local function u(faction: string, corps: string, class: "infantry" | "cavalry" | "artillery" | "hq", name: string, strength: number, exp: number, x: number, z: number, heading: number, extra: Extra?): UnitDef
	local def: UnitDef = {
		name = name,
		class = class,
		corps = corps,
		strength = strength,
		experience = exp,
		pos = { x = x, z = z },
		heading = heading,
		faction = faction,
	}
	if extra then
		def.colour = extra.colour
		def.commander = extra.commander
		def.arrival = extra.arrival
	end
	return def
end

local Scenarios = {}

local JENA_FRENCH = {
	u("france", "HQ", "hq", "Napoléon — Imperial HQ", 40, 3, 800, 200, NORTH, { commander = true }),
	-- V Corps (Lannes) — centre
	u("france", "V Corps · Lannes", "infantry", "17e Légère", 600, 2, 700, 320, NORTH),
	u("france", "V Corps · Lannes", "infantry", "34e de Ligne", 600, 1, 780, 320, NORTH),
	u("france", "V Corps · Lannes", "infantry", "40e de Ligne", 600, 1, 860, 320, NORTH),
	u("france", "V Corps · Lannes", "artillery", "Batterie 5e Corps", 120, 1, 780, 270, NORTH),
	-- VII Corps (Augereau) — left
	u("france", "VII Corps · Augereau", "infantry", "7e Légère", 600, 1, 500, 300, NORTH),
	u("france", "VII Corps · Augereau", "infantry", "44e de Ligne", 600, 0, 580, 300, NORTH),
	-- VI Corps (Ney) — reserve centre
	u("france", "VI Corps · Ney", "infantry", "6e Légère", 600, 1, 740, 240, NORTH),
	u("france", "VI Corps · Ney", "infantry", "39e de Ligne", 600, 1, 820, 240, NORTH),
	u("france", "VI Corps · Ney", "artillery", "Batterie 6e Corps", 120, 1, 900, 270, NORTH),
	-- IV Corps (Soult) — right
	u("france", "IV Corps · Soult", "infantry", "26e Légère", 600, 1, 1000, 300, NORTH),
	u("france", "IV Corps · Soult", "infantry", "36e de Ligne", 600, 0, 1080, 300, NORTH),
	-- Imperial Guard
	u("france", "Garde Impériale", "infantry", "Grenadiers à pied de la Garde", 700, 3, 800, 150, NORTH),
	u("france", "Garde Impériale", "artillery", "Artillerie de la Garde", 120, 2, 720, 170, NORTH),
	-- Cavalry reserve (Murat)
	u("france", "Réserve de cavalerie · Murat", "cavalry", "1er Cuirassiers", 400, 2, 1150, 230, NORTH),
	u("france", "Réserve de cavalerie · Murat", "cavalry", "5e Hussards", 400, 1, 450, 220, NORTH),
	u("france", "Réserve de cavalerie · Murat", "cavalry", "9e Chasseurs à cheval", 400, 1, 950, 200, NORTH),
}

local JENA_PRUSSIAN = {
	u("prussia", "HQ", "hq", "Hohenlohe — Army HQ", 40, 2, 760, 860, SOUTH, { commander = true }),
	-- Tauentzien's advance guard — forward, Closewitz/Cospeda
	u("prussia", "Avantgarde · Tauentzien", "infantry", "Füsilier-Bataillon Pelet", 600, 1, 980, 580, SOUTH),
	u("prussia", "Avantgarde · Tauentzien", "infantry", "IR Nr. 20 Prinz Louis Ferdinand", 600, 1, 1060, 600, SOUTH),
	u("prussia", "Avantgarde · Tauentzien", "infantry", "IR Nr. 38 Pelchrzim", 600, 1, 900, 620, SOUTH),
	u("prussia", "Avantgarde · Tauentzien", "artillery", "Batterie Tauentzien", 120, 1, 980, 640, SOUTH),
	-- Grawert's division — main line at Vierzehnheiligen
	u("prussia", "Division Grawert", "infantry", "IR Nr. 29 Treuenfels", 600, 2, 640, 720, SOUTH),
	u("prussia", "Division Grawert", "infantry", "IR Nr. 49 Müffling", 600, 1, 720, 700, SOUTH),
	u("prussia", "Division Grawert", "infantry", "Grenadier-Bataillon Hahn", 600, 2, 820, 700, SOUTH),
	u("prussia", "Division Grawert", "artillery", "Batterie Grawert", 120, 1, 740, 790, SOUTH),
	-- Saxon contingent (Zezschwitz) — left, Isserstedt
	u("prussia", "Sächsisches Korps · Zezschwitz", "infantry", "IR Prinz Clemens (Sachsen)", 600, 1, 420, 700, SOUTH, { colour = "Saxony" }),
	u("prussia", "Sächsisches Korps · Zezschwitz", "infantry", "IR Rechten (Sachsen)", 600, 0, 500, 720, SOUTH, { colour = "Saxony" }),
	-- Holtzendorff — right, Dornberg
	u("prussia", "Detachement Holtzendorff", "infantry", "IR Nr. 51 Kauffberg", 600, 1, 1180, 760, SOUTH),
	-- Cavalry
	u("prussia", "Kavallerie · Prinz Wilhelm", "cavalry", "Kürassier-Regiment Henckel", 400, 2, 600, 820, SOUTH),
	u("prussia", "Kavallerie · Prinz Wilhelm", "cavalry", "Dragoner-Regiment Prinz Johann (Sachsen)", 400, 1, 1000, 820, SOUTH, { colour = "Saxony" }),
	u("prussia", "Kavallerie · Prinz Wilhelm", "cavalry", "Husaren-Regiment Gettkandt", 400, 1, 380, 800, SOUTH),
}

Scenarios.jena = {
	id = "jena",
	name = "Jena, 14 October 1806",
	map = "jena",
	briefing = "Dawn, 14 October 1806. Your corps crossed the Saale in the night and stand on the Landgrafenberg above Jena in thick morning mist, which will lift within five minutes. Hohenlohe's Prussians and Saxons hold the villages to the north. Take Vierzehnheiligen, Closewitz and the Dornberg, or break the Prussian army. You have twenty-five minutes before Hohenlohe is reinforced.",
	factions = { player = "france", enemy = "prussia" },
	factionNames = { france = "France", prussia = "Prussia" },
	units = {},
	timeLimit = nil,
	date = "14 October 1806",
	year = 1806,
	summary = "Napoleon's corps debouched from the Landgrafenberg through the fog and, after Ney's premature rush on Vierzehnheiligen was rescued, rolled Hohenlohe's line back through the villages. Rüchel's late counter-attack was shattered and Murat's cavalry turned the retreat into a rout; the same morning Davout beat the Prussian main army at Auerstedt, and within weeks Prussia had lost its fortresses and its army.",
	difficultyNote = "Even: the opening battle. Equal numbers, the French hold the high ground.",
	weather = "fog",
	weatherUntil = 300,
} :: Scenario

for _, d in JENA_FRENCH do
	table.insert(Scenarios.jena.units, d)
end
for _, d in JENA_PRUSSIAN do
	table.insert(Scenarios.jena.units, d)
end

-- ---------------------------------------------------------------------------------------------
-- Auerstedt, 14 October 1806. Davout's III Corps (player) faces the Prussian main army.
-- French face west; Prussians arrive from the west over the Lissbach. Morand's division is still
-- on the road from Kösen and enters as reinforcements.
-- ---------------------------------------------------------------------------------------------
